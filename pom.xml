<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>am.ik.rontolisp</groupId>
	<artifactId>rontolisp</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>rontolisp</name>
	<description>A minimal Common Lisp subset for JVM and WASM</description>

	<properties>
		<java.version>25</java.version>
		<maven.compiler.release>${java.version}</maven.compiler.release>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<spring-boot.version>4.1.0</spring-boot.version>
		<version-generate-skip>false</version-generate-skip>
	</properties>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<scm>
		<url>https://github.com/making/rontolisp</url>
		<connection>scm:git:git@github.com:making/rontolisp.git</connection>
		<developerConnection>scm:git:git@github.com:making/rontolisp.git
		</developerConnection>
	</scm>
	<url>https://github.com/making/rontolisp</url>

	<developers>
		<developer>
			<id>making</id>
			<name>Toshiaki Maki</name>
			<email>makingx@gmail.com</email>
			<url>https://ik.am</url>
		</developer>
	</developers>
	<dependencies>
		<dependency>
			<groupId>org.jline</groupId>
			<artifactId>jline</artifactId>
			<version>4.3.1</version>
		</dependency>
		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>tools.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-yaml</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
				<version>10.0.0</version>
				<executions>
					<execution>
						<id>get-git-info</id>
						<goals>
							<goal>revision</goal>
						</goals>
						<phase>initialize</phase>
					</execution>
				</executions>
				<configuration>
					<generateGitPropertiesFile>false</generateGitPropertiesFile>
					<failOnNoGitDirectory>false</failOnNoGitDirectory>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>gen-build-info</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<skip>${version-generate-skip}</skip>
							<target>
								<echo file="${project.build.directory}/generated-sources/java/am/ik/rontolisp/Version.java">
package am.ik.rontolisp;

/** Build-time version information generated by Maven. */
public final class Version {

	private Version() {
	}

	/**
	 * Returns the project version.
	 * @return the project version
	 */
	public static String getVersion() {
		return "${project.version}";
	}

	/**
	 * Returns the build timestamp.
	 * @return the build timestamp
	 */
	public static String getBuild() {
		return "${maven.build.timestamp}";
	}

	/**
	 * Returns the abbreviated git commit id.
	 * @return the abbreviated git commit id
	 */
	public static String getGitCommit() {
		return "${git.commit.id.abbrev}";
	}

	/**
	 * Returns the git branch name.
	 * @return the git branch name
	 */
	public static String getGitBranch() {
		return "${git.branch}";
	}

	/**
	 * Returns the version information as a JSON string.
	 * @return the version information as a JSON string
	 */
	public static String getVersionAsJson() {
		return "{\"version\": \"${project.version}\", \"buildTimestamp\": \"${maven.build.timestamp}\", \"gitCommit\": \"${git.commit.id.abbrev}\", \"gitBranch\": \"${git.branch}\"}";
	}

}
								</echo>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>add-generated-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
			</plugin>
			<plugin>
				<groupId>am.ik.maven</groupId>
				<artifactId>nullability-maven-plugin</artifactId>
				<version>0.4.2</version>
				<extensions>true</extensions>
				<executions>
					<execution>
						<goals>
							<goal>configure</goal>
							<goal>generate-package-info</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<checking>tests</checking>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>exec</shadedClassifierName>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>am.ik.rontolisp.cli.RontoLispCli</mainClass>
									<manifestEntries>
										<Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
									</manifestEntries>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>io.spring.javaformat</groupId>
				<artifactId>spring-javaformat-maven-plugin</artifactId>
				<version>0.0.47</version>
				<executions>
					<execution>
						<phase>validate</phase>
						<inherited>true</inherited>
						<goals>
							<goal>validate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.sonatype.central</groupId>
				<artifactId>central-publishing-maven-plugin</artifactId>
				<version>0.11.0</version>
				<extensions>true</extensions>
				<configuration>
					<publishingServerId>central</publishingServerId>
					<autoPublish>true</autoPublish>
					<waitUntil>published</waitUntil>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>1.1.3</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<mainClass>am.ik.rontolisp.cli.RontoLispCli</mainClass>
							<imageName>rontolisp</imageName>
							<buildArgs>
								<buildArg>--no-fallback</buildArg>
								<buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
								<!-- JLine 4.1+ FFM terminal provider closes a shared Arena
									 (Arena.ofShared) from its signal handler. Native Image
									 disables shared-arena support by default, so enable it
									 explicitly or the REPL crashes on the first readLine. -->
								<buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
								<buildArg>-H:+SharedArenaSupport</buildArg>
							</buildArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!--
			Build the browser playground: compile src/web/java (RontoPlayground)
			to a WebAssembly module with the GraalVM Native Image Web Image backend.
			Usage: ./mvnw -Pweb -DskipTests package
			Requires a GraalVM with the svm-wasm tool and Binaryen (wasm-as) 119+.
		-->
		<profile>
			<id>web</id>
			<properties>
				<!-- src/web/java uses the GraalVM-only org.graalvm.webimage.api module,
					 which the ct.sym used by the release flag hides. Use source/target. -->
				<maven.compiler.release/>
			</properties>
			<build>
				<plugins>
					<!-- Add src/web/java to the compile sources only for this profile. -->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>add-web-source</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>add-source</goal>
								</goals>
								<configuration>
									<sources>
										<source>${project.basedir}/src/web/java</source>
									</sources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<!-- @JS needs parameter names recorded in bytecode. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<parameters>true</parameters>
						</configuration>
					</plugin>
					<!-- Compile rontolisp itself to wasm. The svm-wasm tool must be the
						 first native-image argument, so it is passed via buildArgs. -->
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>1.1.3</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-web-playground</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<mainClass>am.ik.rontolisp.web.RontoPlayground</mainClass>
							<imageName>rontoplayground</imageName>
							<!-- RontoPlayground does not use jline; skip the reachability
								 metadata repository so jline is not force-included. -->
							<metadataRepository>
								<enabled>false</enabled>
							</metadataRepository>
							<buildArgs>
								<buildArg>--tool:svm-wasm</buildArg>
								<!-- jline is on the classpath only so JLineRepl compiles; it is
									 unused here. Ignore its embedded META-INF/native-image config,
									 which would otherwise force-include jline (~5x larger image). -->
								<buildArg>--exclude-config</buildArg>
								<buildArg>.*jline.*\.jar</buildArg>
								<buildArg>META-INF/native-image/.*</buildArg>
								<buildArg>-H:-AutoRunVM</buildArg>
							</buildArgs>
						</configuration>
					</plugin>
					<!-- Stage the generated wasm/js next to playground.html for serving. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<id>stage-web-dist</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<property name="web.dist" location="${project.basedir}/web/dist"/>
										<delete dir="${web.dist}"/>
										<mkdir dir="${web.dist}"/>
										<copy todir="${web.dist}">
											<fileset dir="${project.build.directory}">
												<include name="rontoplayground.js"/>
												<include name="rontoplayground.js.wasm"/>
											</fileset>
											<fileset dir="${project.basedir}/web">
												<!-- index.html redirects to the docs (docs/en); the
													 playground UI is served at playground.html. The
													 interpreter runs inside ronto-worker.js;
													 coi-serviceworker supplies the COOP/COEP headers
													 SharedArrayBuffer needs on GitHub Pages. -->
												<include name="index.html"/>
												<include name="playground.html"/>
												<include name="compile-run.html"/>
												<include name="ronto-worker.js"/>
												<include name="coi-serviceworker.min.js"/>
											</fileset>
										</copy>
										<!-- Stage the standalone "run user WASM in the browser" example as a
											 subpath of the same Pages site (/wasm-browser/). Its .wasm files
											 are checked in, so no compilation is needed here; the example's
											 index.html uses relative URLs and works under any subpath. -->
										<copy todir="${web.dist}/wasm-browser">
											<fileset dir="${project.basedir}/examples/browser/wasm-browser"/>
										</copy>
										<!-- Stage the handwritten-hiragana recognition demo as another
											 subpath (/hiragana/). Only the four runtime files the browser
											 loads are copied; the offline training artifacts (train.lisp,
											 weights.lisp, prototypes.lisp, infer.lisp, glyphgen/, samples/)
											 are excluded to keep the Pages payload small. The demo's
											 index.html uses relative URLs and works under any subpath. -->
										<copy todir="${web.dist}/hiragana">
											<fileset dir="${project.basedir}/examples/browser/hiragana">
												<include name="index.html"/>
												<include name="wasi-shim.js"/>
												<include name="glyphs.js"/>
												<include name="infer.wasm"/>
											</fileset>
										</copy>
										<!-- Stage the WebGL galaxy demo as another subpath (/webgl-galaxy/).
											 Its .wasm is checked in, so no compilation is needed here. Only
											 the two runtime files the browser loads are copied; the demo's
											 index.html uses relative URLs and works under any subpath. -->
										<copy todir="${web.dist}/webgl-galaxy">
											<fileset dir="${project.basedir}/examples/browser/webgl-galaxy">
												<include name="index.html"/>
												<include name="galaxy.wasm"/>
											</fileset>
										</copy>
										<!-- Stage the WebGL hello-world triangle and the rotating cube as
											 further subpaths (/webgl-triangle/, /webgl-cube/), same shape as
											 the galaxy demo above. -->
										<copy todir="${web.dist}/webgl-triangle">
											<fileset dir="${project.basedir}/examples/browser/webgl-triangle">
												<include name="index.html"/>
												<include name="triangle.wasm"/>
											</fileset>
										</copy>
										<copy todir="${web.dist}/webgl-cube">
											<fileset dir="${project.basedir}/examples/browser/webgl-cube">
												<include name="index.html"/>
												<include name="cube.wasm"/>
											</fileset>
										</copy>
										<copy todir="${web.dist}/webgl-heat3d">
											<fileset dir="${project.basedir}/examples/browser/webgl-heat3d">
												<include name="index.html"/>
												<include name="heat3d.wasm"/>
											</fileset>
										</copy>
										<copy todir="${web.dist}/webgl-robot-arm">
											<fileset dir="${project.basedir}/examples/browser/webgl-robot-arm">
												<include name="index.html"/>
												<include name="robot-arm.wasm"/>
											</fileset>
										</copy>
										<copy todir="${web.dist}/webgl-platformer">
											<fileset dir="${project.basedir}/examples/browser/webgl-platformer">
												<include name="index.html"/>
												<include name="platformer.wasm"/>
											</fileset>
										</copy>
										<!-- Stage the Minesweeper demo as another subpath (/minesweeper/).
											 Its .wasm is checked in, so no compilation is needed here. The
											 page is copied to index.html so the demo is reachable at
											 /minesweeper/; its fetch of ./minesweeper.wasm uses a relative
											 URL and works under any subpath. The .lisp source is not shipped
											 (the page links to it on GitHub). -->
										<copy file="${project.basedir}/examples/browser/minesweeper/minesweeper.html"
											  tofile="${web.dist}/minesweeper/index.html"/>
										<copy file="${project.basedir}/examples/browser/minesweeper/minesweeper.wasm"
											  todir="${web.dist}/minesweeper"/>
										<echo message="Web playground staged in ${web.dist} (examples at ${web.dist}/wasm-browser, ${web.dist}/hiragana and ${web.dist}/minesweeper)"/>
										<echo message="Serve it: cd web/dist &amp;&amp; jwebserver -p 8000"/>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
