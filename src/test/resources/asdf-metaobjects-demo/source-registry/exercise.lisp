;; What a program sees of the search: the same text runs on SBCL 2.2.9's ASDF 3.3.1
;; (*print-pretty* nil), and source-registry.expected is what it prints there, line for
;; line. It is loaded, so :here is this directory.
(require :asdf)
(require "asdf")
(require 'uiop)
(asdf:initialize-source-registry
 '(:source-registry
   (:directory :here)
   (:directory (:here "dir/"))
   (:tree (:here "tree/"))
   :inherit-configuration))
(print (asdf::source-registry-initialized-p))
(print asdf:*source-registry-parameter*)
(print (pathname-name (uiop:load-pathname)))
(print (pathname-name (uiop:current-lisp-file-pathname)))
(asdf:load-system "registry-here")
(print (registry-here-fn))
(asdf:load-system "registry-dir")
(print (registry-dir-fn))
(asdf:load-system "registry-tree")
(print (registry-tree-fn))
(asdf:load-system "registry-both")
;; The shallowest of a tree's two files wins.
(print (asdf:system-description (asdf:find-system "registry-both")))
;; A :directory does not recurse, and a tree stops at the exclusions.
(print (asdf:find-system "registry-below" nil))
(print (asdf:find-system "registry-hidden" nil))
(print (list (eq 'asdf:initialize-source-registry 'asdf/source-registry:initialize-source-registry)
             (eq 'asdf/source-registry:*source-registry* 'asdf::*source-registry*)
             (eq 'asdf/system-registry:sysdef-source-registry-search
                 'asdf/source-registry:sysdef-source-registry-search)))
;; The configuration language.
(print (asdf/source-registry:parse-source-registry-string "/a/b/:/c/d//:"))
(print (asdf/source-registry:parse-source-registry-string "/a/b/"))
(print (asdf/source-registry:parse-source-registry-string ""))
(print (asdf/source-registry:parse-source-registry-string "(:source-registry :ignore-inherited-configuration)"))
(print (handler-case (asdf/source-registry:parse-source-registry-string "a/b/") (error () :relative-refused)))
(print (handler-case (asdf/source-registry:parse-source-registry-string "::") (error () :two-inherits-refused)))
(print (mapcar (lambda (form)
                 (handler-case (asdf/source-registry:validate-source-registry-form form)
                   (asdf/source-registry:invalid-source-registry () :invalid)))
               '((:source-registry :inherit-configuration)
                 (:source-registry (:tree (:home "x/")) (:exclude "y") :ignore-inherited-configuration)
                 (:source-registry (:directory "/x/"))
                 (:source-registry :inherit-configuration :ignore-inherited-configuration)
                 (:nope :inherit-configuration)
                 (:source-registry (:frob "x") :inherit-configuration))))
(print (list (uiop:location-designator-p :here) (uiop:location-designator-p '(:home "x/"))
             (uiop:location-designator-p '("/a/" "b/" :implementation-type))
             (uiop:location-designator-p :nope) (uiop:location-designator-p nil)))
(print (list (namestring (uiop:resolve-location '("/a/" "b/" "c") :ensure-directory t))
             (namestring (uiop:resolve-location '("/a/" "b/" "c")))
             (namestring (uiop:resolve-absolute-location "/a/b" :ensure-directory t))
             (namestring (uiop:resolve-relative-location '("a/" "b") :ensure-directory t))))
(print (handler-case (uiop:resolve-location "rel/") (error () :relative-refused)))
;; Clearing leaves the parameter until the next search initializes without one.
(asdf:clear-source-registry)
(print (list (asdf::source-registry-initialized-p) (and asdf:*source-registry-parameter* t)))
(asdf/source-registry:sysdef-source-registry-search "registry-absent")
(print (list (asdf::source-registry-initialized-p) asdf:*source-registry-parameter*))
(uiop:clear-configuration)
(print (asdf::source-registry-initialized-p))
;; The list is three names, walked in order with a name each function can answer.
(print (mapcar #'symbol-name asdf:*system-definition-search-functions*))
(defvar *registry-asked* nil)
(defvar *registry-made* (make-instance 'asdf:system :name "registry-made"))
(defun registry-search (name)
  (setq *registry-asked* (cons name *registry-asked*))
  (when (equal name "registry-made") *registry-made*))
(push 'registry-search asdf:*system-definition-search-functions*)
(print (eq *registry-made* (asdf:find-system "registry-made")))
(print (asdf:find-system "registry-unknown" nil))
(print (reverse *registry-asked*))
(print (asdf:component-name (asdf:registered-system "registry-made")))
(print (car (multiple-value-list (asdf:locate-system "registry-made"))))
(print (car (multiple-value-list (asdf:locate-system "registry-nowhere"))))
(setq asdf:*system-definition-search-functions* (cdr asdf:*system-definition-search-functions*))
(print (mapcar #'symbol-name asdf:*system-definition-search-functions*))
(print (asdf/package-inferred-system:sysdef-package-inferred-system-search "registry-made"))
