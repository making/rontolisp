;; What a program sees walking meta-demo-tree: the same text runs on SBCL 2.2.9's
;; ASDF 3.3.1 (with the registry directory on asdf:*central-registry*, *print-pretty*
;; nil), and meta-demo-tree.expected is what it prints there, line for line.
(asdf:load-system "meta-demo-tree")
(print (reverse *tree-log*))
(print (asdf:component-name (asdf:find-system "meta-demo-tree-sub" nil)))
(defun tree-kind (c)
  (typecase c
    (asdf:system :system)
    (asdf:module :module)
    (asdf:html-file :html)
    (asdf:doc-file :doc)
    (asdf:static-file :static)
    (asdf:cl-source-file.cl :cl)
    (asdf:cl-source-file :lisp)))
(defun tree-tail (path)
  (subseq (namestring path)
          (length (namestring (asdf:system-source-directory "meta-demo-tree")))))
(defun tree-entry (c)
  (list (asdf:component-name c) (tree-kind c) (tree-tail (asdf:component-pathname c))
        (namestring (asdf:component-relative-pathname c))
        (slot-value c 'asdf::relative-pathname)
        (asdf:component-sideway-dependencies c)
        (and (typep c 'asdf:file-component) (asdf:file-type c))
        (asdf/component:component-if-feature c)
        (tree-tail (asdf/component:component-parent-pathname c))))
(defun tree-walk (c)
  (cons (tree-entry c)
        (and (typep c 'asdf:module)
             (mapcan #'tree-walk (copy-list (asdf:component-children c))))))
(defun tree-names (components)
  (mapcar #'asdf:component-find-path components))
(defun tree-shape (dependencies)
  (mapcar (lambda (dependency)
            (mapcar (lambda (item)
                      (cond ((typep item 'asdf:component) (asdf:component-name item))
                            ((symbolp item) (symbol-name item))
                            ((stringp item) item)
                            (t (symbol-name (class-name (class-of item))))))
                    dependency))
          dependencies))
(let* ((s (asdf:find-system "meta-demo-tree"))
       (m (asdf:find-component s "m"))
       (two (asdf:find-component s '("m" "two"))))
  (print (mapcar #'asdf:component-name (asdf:component-children s)))
  (print (mapcan #'tree-walk (copy-list (asdf:component-children s))))
  (print (list (tree-tail (asdf:component-pathname s))
               (tree-tail (asdf:component-pathname (asdf:find-system "meta-demo-tree")))
               (tree-tail (asdf:component-relative-pathname s))
               (tree-tail (slot-value s 'asdf::relative-pathname))
               (tree-tail (asdf:system-relative-pathname s "x.txt"))
               (asdf:component-find-path two)
               (eq m (asdf:component-parent two))
               (eq s (asdf:component-parent m))
               (eq s (asdf:component-system two))))
  (print (tree-names
          (list (asdf:find-component s :m)
                (asdf:find-component s '(:m :two))
                (asdf:find-component "meta-demo-tree" '("m" "two"))
                (asdf:find-component :meta-demo-tree "m" :registered t)
                (asdf:find-component '("meta-demo-tree" "m") "two")
                (asdf:find-component '("meta-demo-tree" "m" "deep") "three")
                (asdf:find-component nil '("meta-demo-tree" "m" "two"))
                (asdf:find-component m "two")
                (asdf:find-component m '("deep" "three"))
                (asdf:find-component s two)
                (asdf:find-component s "README.md")
                (asdf:find-component s "gated")
                (asdf:find-component s "flat"))))
  (print (list (asdf:find-component s "m/two") (asdf:find-component s "two")
               (asdf:find-component s '("m" "nope" "two"))
               (handler-case (asdf:find-component two "x") (error () :refused))
               (handler-case (asdf:component-children two) (error () :refused))
               (handler-case (asdf:module-components two) (error () :refused))))
  (print (mapcar #'asdf:component-name (asdf/component:sub-components s)))
  (print (mapcar #'asdf:component-name
                 (asdf/component:sub-components s :type 'asdf:static-file)))
  (print (mapcar #'tree-tail
                 (mapcar #'asdf:component-pathname
                         (remove-if-not (lambda (c) (typep c 'asdf:static-file))
                                        (asdf:module-components m)))))
  (print (tree-shape (asdf:component-depends-on 'asdf:load-op m)))
  (print (tree-shape (asdf:component-depends-on 'asdf:compile-op m)))
  (print (tree-shape (asdf:component-depends-on 'asdf:load-source-op m)))
  (print (tree-shape (asdf:component-depends-on 'asdf:prepare-op m)))
  (print (tree-shape (asdf:component-depends-on 'asdf:prepare-op (asdf:find-component s "later"))))
  (print (tree-shape (asdf:component-depends-on 'asdf:prepare-source-op (asdf:find-component s "later"))))
  (print (tree-shape (asdf:component-depends-on 'asdf:load-op (asdf:find-component s "README.md"))))
  (print (tree-shape (asdf:component-depends-on 'asdf:prepare-op s)))
  (print (mapcar #'tree-tail (asdf:input-files 'asdf:load-op (asdf:find-component s "README.md"))))
  (print (list (asdf:perform 'asdf:load-op m)
               (asdf:perform 'asdf:load-op (asdf:find-component s "README.md"))))
  (asdf:perform 'asdf:load-source-op two)
  (print (car *tree-log*)))
