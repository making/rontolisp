<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>test.profiles</groupId>
  <artifactId>jdk</artifactId>
  <version>1</version>
  <profiles>
    <profile><id>jdk11up</id><activation><jdk>[11,)</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>jdk11up</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>jdk8</id><activation><jdk>1.8</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>jdk8</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>notjdk8</id><activation><jdk>!1.8</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>notjdk8</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>jdk25prefix</id><activation><jdk>25</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>jdk25prefix</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>jdk2prefix</id><activation><jdk>2</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>jdk2prefix</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>below25</id><activation><jdk>[1.8,25)</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>below25</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>in25</id><activation><jdk>[25,26)</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>in25</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>upto25</id><activation><jdk>(,25]</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>upto25</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>upto2504</id><activation><jdk>(,25.0.4]</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>upto2504</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>below2504</id><activation><jdk>(,25.0.4)</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>below2504</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>above2504</id><activation><jdk>(25.0.4,)</jdk></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>above2504</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>bydefault</id><activation><activeByDefault>true</activeByDefault></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>bydefault</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
  </profiles>
</project>
