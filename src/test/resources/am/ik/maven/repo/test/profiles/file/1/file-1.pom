<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>test.profiles</groupId>
  <artifactId>file</artifactId>
  <version>1</version>
  <profiles>
    <profile><id>java-home</id><activation><file><exists>${java.home}</exists></file></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>java-home</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>missing</id><activation><file><missing>/definitely/not/here</missing></file></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>missing</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>root</id><activation><file><exists>/</exists></file></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>root</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>relative</id><activation><file><exists>relative/path</exists></file></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>relative</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>relative-missing</id><activation><file><missing>relative/path</missing></file></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>relative-missing</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>basedir</id><activation><file><exists>${basedir}/pom.xml</exists></file></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>basedir</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>basedir-missing</id><activation><file><missing>${basedir}/nothing</missing></file></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>basedir-missing</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>prop</id><activation><file><exists>${some.dir}</exists></file></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>prop</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
  </profiles>
  <properties>
    <some.dir>/</some.dir>
  </properties>
</project>
