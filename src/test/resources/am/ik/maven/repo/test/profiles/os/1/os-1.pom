<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>test.profiles</groupId>
  <artifactId>os</artifactId>
  <version>1</version>
  <profiles>
    <profile><id>unix</id><activation><os><family>unix</family></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>unix</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>windows</id><activation><os><family>windows</family></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>windows</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>notwindows</id><activation><os><family>!windows</family></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>notwindows</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>mac</id><activation><os><family>mac</family></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>mac</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>name</id><activation><os><name>LINUX</name></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>name</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>notname</id><activation><os><name>!linux</name></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>notname</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>arch</id><activation><os><arch>amd64</arch></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>arch</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>version</id><activation><os><version>6.8.0</version></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>version</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>regex</id><activation><os><version>regex:6\..*</version></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>regex</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>unix-arm</id><activation><os><family>unix</family><arch>aarch64</arch></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>unix-arm</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>family-other</id><activation><os><family>lin</family></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>family-other</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
  </profiles>
</project>
