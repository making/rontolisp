<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>test.profiles</groupId>
  <artifactId>combined</artifactId>
  <version>1</version>
  <profiles>
    <profile><id>jdk-and-flag</id><activation><jdk>[11,)</jdk><property><name>flag</name></property></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>jdk-and-flag</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
    <profile><id>jdk-and-unix</id><activation><jdk>[11,)</jdk><os><family>unix</family></os></activation>
  <dependencies>
      <dependency><groupId>test.lib</groupId><artifactId>jdk-and-unix</artifactId><version>1</version></dependency>
  </dependencies>
    </profile>
  </profiles>
</project>
