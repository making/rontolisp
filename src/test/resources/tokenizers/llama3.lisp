;;;; llama3 -- a tokenizer fixture of the :llama3 pre-tokenizer shape with ignore_merges.
;;;; The vocabulary and the merge list are this repository's own: a byte-level BPE the
;;;; Python `tokenizers` library trained on the corpus below (no published model's data),
;;;; plus one whole word no merge reaches, whose id only ignore_merges gives. The
;;;; expectations are what that library produces. Corpus strings are code-point lists
;;;; so that no editor, encoding or line-ending can rewrite them.

(defparameter *fixture-kind* :llama3)
(defparameter *fixture-ignore-merges* t)
(defparameter *fixture-vocabulary-size* 481)

