{
  "resources": {
    "includes": [
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.codegen.wasm.WasmComponentBuilder"
        },
        "pattern": "am/ik/rontolisp/codegen/wasm/component/.*\\.bin"
      },
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.codegen.wasm.WasmComponentBuilder"
        },
        "pattern": "am/ik/rontolisp/codegen/wasm/component/.*\\.wasm"
      },
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.codegen.wasm.NoGcWasmComponentBuilder"
        },
        "pattern": "am/ik/rontolisp/codegen/wasm/component/.*\\.bin"
      },
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.codegen.wasm.NoGcWasmComponentBuilder"
        },
        "pattern": "am/ik/rontolisp/codegen/wasm/component/.*\\.wasm"
      },
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.codegen.jvm.JvmJavaRuntimeBuilder"
        },
        "pattern": "am/ik/rontolisp/codegen/jvm/JavaBridgeTemplate\\.class"
      },
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.codegen.jvm.JvmSimdRuntimeBuilder"
        },
        "pattern": "am/ik/rontolisp/codegen/jvm/JvmSimdVectorTemplate\\.class"
      },
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.eval.JsonLibrary"
        },
        "pattern": "am/ik/rontolisp/eval/json\\.lisp"
      },
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.eval.VecLibrary"
        },
        "pattern": "am/ik/rontolisp/eval/vec\\.lisp"
      },
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.eval.LinalgLibrary"
        },
        "pattern": "am/ik/rontolisp/eval/linalg\\.lisp"
      },
      {
        "condition": {
          "typeReachable": "am.ik.rontolisp.eval.UrlLibrary"
        },
        "pattern": "am/ik/rontolisp/eval/url\\.lisp"
      }
    ]
  }
}
