package root:clocks;

// The wasi:clocks@0.3.0 monotonic-clock surface wait.lisp binds (vendored from the
// official WASI 0.3.0 WIT, trimmed to the bound member). Keep in lockstep with the
// regen source in src/wasm-component/deps/clocks: the member set here must stay a
// subset of what src/wasm-component/core*.wat imports, because the component binds
// the interface FROM the fixed import block's already-declared instance.

package wasi:clocks@0.3.0 {
  /// This interface common types used throughout wasi:clocks.
  interface types {
    /// A duration of time, in nanoseconds.
    type duration = u64;
  }

  /// WASI Monotonic Clock is a clock API intended to let users measure elapsed
  /// time.
  interface monotonic-clock {
    use types.{duration};

    /// Wait for the specified duration to elapse.
    wait-for: async func(
      how-long: duration,
    );
  }
}
