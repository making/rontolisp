package root:tls;

// The wasi:tls@0.3.0-draft surface tls.lisp binds (vendored verbatim from
// wasmtime v47.0.2's crates/wasi-tls/src/p3/wit/deps/tls/{types,client}.wit --
// the DRAFT interface, so re-check this file against the wasmtime release the
// runtime targets on every wasmtime floor bump), plus rontolisp's transparent
// async type alias at the end of the `client` interface. The proposal is
// CLIENT-ONLY by design: there is no server/accept interface in any draft,
// which is why the tls-listen family stays off every WASM target.

package wasi:tls@0.3.0-draft {
  interface types {
    resource error {
      to-debug-string: func() -> string;
    }
  }

  interface client {
    use types.{error};

    resource connector {
      constructor();

      /// Set up the encryption stream transform.
      /// This takes an unprotected `cleartext` application data stream and
      /// returns an encrypted data stream, ready to be sent out over the network.
      /// Closing the `cleartext` stream will cause a `close_notify` packet to be emitted on the returned output stream.
      send: func(cleartext: stream<u8>) -> tuple<stream<u8>, future<result<_, error>>>;

      /// Set up the decryption stream transform.
      /// This takes an encrypted data stream, as received via e.g. the network,
      /// and returns a decrypted application data stream.
      receive: func(ciphertext: stream<u8>) -> tuple<stream<u8>, future<result<_, error>>>;

      /// Perform the handshake.
      /// The `send` & `receive` streams must be set up before calling this method.
      connect: static async func(this: connector, server-name: string) -> result<_, error>;
    }

    /// rontolisp-only TRANSPARENT type alias: it drives a derived binding of the
    /// async canonical ABI (the tls-future-drop-readable built-in for the
    /// futures connector.send/receive return). It changes no instance type and
    /// no host contract -- an alias is structural and it is referenced by no
    /// function.
    type tls-future = future<result<_, error>>;
  }
}
