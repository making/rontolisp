(defun rontolisp::%clojure-io-m-get-absolute-path (x)
  (rontolisp::%clojure-io-absolute-path
   (rontolisp::%clojure-io-recv x :C%FILE "getAbsolutePath" 0)))

(defun rontolisp::%clojure-io-m-get-absolute-file (x)
