  ";Cn:g0;Lu:g1|g1.2.3;Ll:g2|g1.2.3;Lt:g3|g1.2.3;Lm:g4;Lo:g5;Mn:g6;Me:g7;Mc:g8;Nd:g9;Nl:g10;No:g11;Zs:g12;Zl:g13;Zp:g14;Cc:g15;Cf:g16;Co:g18;Cs:g19;Pd:g20;Ps:g21;Pe:g22;Pc:g23;Po:g24;Sm:g25;Sc:g26;Sk:g27;So:g28;Pi:g29;Pf:g30;L:g1.2.3.4.5;M:g6.7.8;N:g9.10.11;Z:g12.13.14;C:g15.16.18.19.0;P:g20.21.22.23.24.29.30;S:g25.26.27.28;LC:g1.2.3;LD:g1.2.3.4.5.9;L1:r0.255;all:r0.1114111;ASCII:r0.127;Alnum:r48.57.65.90.97.122;Alpha:r65.90.97.122;Blank:r32.32.9.9;Cntrl:r0.31.127.127;Digit:r48.57;Graph:r33.126;Lower:r97.122|r65.90.97.122;Print:r32.126;Punct:r33.47.58.64.91.96.123.126;Space:r32.32.9.13;Upper:r65.90|r65.90.97.122;XDigit:r48.57.65.70.97.102;javaLowerCase:u6|u6.7.8;javaUpperCase:u7|u6.7.8;javaAlphabetic:u5;javaIdeographic:u9;javaTitleCase:u8|u6.7.8;javaDigit:u10;javaDefined:u13;javaLetter:u11;javaLetterOrDigit:u12;javaJavaIdentifierStart:u15;javaJavaIdentifierPart:u16;javaUnicodeIdentifierStart:u17;javaUnicodeIdentifierPart:u18;javaIdentifierIgnorable:u19;javaSpaceChar:u20;javaWhitespace:u21;javaISOControl:u22;javaMirrored:u14;")

(defun rontolisp::%clojure-re-uni-atom (spec)
  "The class item of the atom SPEC: its letter, then its numbers."
  (let ((nums nil) (n 0) (kind (char spec 0)) (items nil))
    (dotimes (i (- (length spec) 1))
      (let ((c (char spec (+ i 1))))
        (if (char= c #\.)
            (progn
              (setq nums (cons n nums))
              (setq n 0))
            (setq n (+ (* n 10) (- (char-code c) 48))))))
    (setq nums (reverse (cons n nums)))
    (if (char= kind #\g)
        (let ((mask 0))
          (dolist (g nums) (setq mask (logior mask (ash 1 g))))
          (list :gc mask))
        (progn
          (cond ((char= kind #\u)
                 (dolist (b nums) (setq items (cons (list :ub b) items))))
                ((char= kind #\r)
                 (do ((rest nums (cdr (cdr rest))))
                     ((null rest))
                   (setq items
                         (cons (list :r (car rest) (car (cdr rest))) items))))
                (t
                 ;; the noncharacters: U+FDD0 to U+FDEF, the last two of each plane
                 (setq items (list (list :r 64976 65007)))
                 (dotimes (plane 17)
                   (setq items
                         (cons (list :r (+ (* plane 65536) 65534)
                                     (+ (* plane 65536) 65535)) items)))))
          (if (cdr items) (list :cls nil (reverse items)) (car items))))))

(defun rontolisp::%clojure-re-uni-spec (spec ci)
  "The class item SPEC describes, case-insensitively under CI."
  (let ((bar (position #\| spec))
        (amp (position #\& spec))
        (plus (position #\+ spec)))
    (cond (bar (rontolisp::%clojure-re-uni-spec
                (if ci (subseq spec (+ bar 1)) (subseq spec 0 bar)) nil))
          (amp
           (list :and (rontolisp::%clojure-re-uni-spec (subseq spec 0 amp) nil)
                 (rontolisp::%clojure-re-uni-spec (subseq spec (+ amp 1)) nil)))
          (plus (list :cls nil
                      (list (rontolisp::%clojure-re-uni-spec
                             (subseq spec 0 plus) nil)
                            (rontolisp::%clojure-re-uni-spec
                             (subseq spec (+ plus 1)) nil))))
          ((char= (char spec 0) #\!)
           (list :cls t
                 (list (rontolisp::%clojure-re-uni-spec (subseq spec 1) nil))))
          (t (rontolisp::%clojure-re-uni-atom spec)))))

(defun rontolisp::%clojure-re-uni-lookup (name table ci)
  "The item TABLE names NAME (as spelled), or nil."
  (if (or (= (length name) 0) (position #\: name) (position #\; name))
      nil
      (let ((at (search (concatenate 'string ";" name ":") table)))
        (if at
            (let* ((from (+ at (length name) 2))
                   (to (position #\; table :start from)))
              (rontolisp::%clojure-re-uni-spec (subseq table from to) ci))
            nil))))

(defun rontolisp::%clojure-re-uni-posix (name ci)
  "CharPredicates.getPosixPredicate: the item of the POSIX class NAME (upper
   case) over Unicode, or nil."
  (rontolisp::%clojure-re-uni-lookup name
                                     (rontolisp::%clojure-re-uni-posix-names)
                                     ci))

(defun rontolisp::%clojure-re-uni-property (name ci)
  "CharPredicates.forUnicodeProperty of NAME, already upper case: a binary
   property (getUnicodePredicate), else a POSIX class over Unicode, or nil."
  (or (rontolisp::%clojure-re-uni-lookup name
       (rontolisp::%clojure-re-uni-unicode-names) ci)
      (rontolisp::%clojure-re-uni-posix name ci)))

(defun rontolisp::%clojure-re-uni-java-property (name ci)
  "CharPredicates.forProperty: the item NAME, as spelled, names -- a general
   category or a group of them, a POSIX class over ASCII, a java Character
   method -- or nil; under CI Lu, Ll and Lt are any cased letter, the case
   methods any case and the ASCII Lower and Upper any ASCII letter."
  (rontolisp::%clojure-re-uni-lookup name
                                     (rontolisp::%clojure-re-uni-java-names)
                                     ci))

(defun rontolisp::%clojure-re-uni-spaced (s)
  "S with its underscores spaces."
  (let ((out (subseq s 0)))
    (dotimes (i (length out) out)
      (if (char= (char out i) #\_) (setf (char out i) #\Space)))))

(defun rontolisp::%clojure-re-uni-unspaced (s)
  "S without its spaces."
  (let ((out (make-string-output-stream)))
    (dotimes (i (length s))
      (if (not (char= (char s i) #\Space)) (write-char (char s i) out)))
    (get-output-stream-string out)))

(defun rontolisp::%clojure-re-uni-named (name table)
  "The index of the entry of TABLE that names NAME, or nil. The entries are
   separated by commas, an entry's names by equals signs: the first as it is,
   each other one also without its spaces, * standing for the first with its
   underscores spaces (Character.UnicodeBlock's canonical name)."
  (let ((n (length table)) (i 0) (entry 0) (first nil) (found nil))
    (loop
      (if (or found (> i n)) (return found))
      (let ((end i))
        (do ()
            ((or (>= end n) (char= (char table end) #\,)
                 (char= (char table end) #\=)))
          (setq end (+ end 1)))
        (let ((part (subseq table i end)))
          (if (null first)
              (progn
                (setq first part)
                (if (string= name part) (setq found entry)))
              (let ((canonical
                     (if (string= part "*")
                         (rontolisp::%clojure-re-uni-spaced first)
                         part)))
                (if (or (string= name canonical)
                        (string= name
                         (rontolisp::%clojure-re-uni-unspaced canonical)))
                    (setq found entry)))))
        (if (or (>= end n) (char= (char table end) #\,))
            (progn
              (setq first nil)
              (setq entry (+ entry 1))))
        (setq i (+ end 1))))))

(defun rontolisp::%clojure-re-uni-script-item (name)
  "CharPredicates.forUnicodeScript: the item of the script
   Character.UnicodeScript.forName finds for NAME -- its constant's name or
   its ISO 15924 alias, in any case -- or nil."
  (let ((ordinal
         (rontolisp::%clojure-re-uni-named (rontolisp::%clojure-upper-case name)
          (rontolisp::%clojure-re-uni-script-names))))
    (if ordinal (list :sc ordinal) nil)))

(defun rontolisp::%clojure-re-uni-block-item (name)
  "CharPredicates.forUnicodeBlock: the item of the block
   Character.UnicodeBlock.forName finds for NAME, in any case, or nil."
  (let ((index
         (rontolisp::%clojure-re-uni-named (rontolisp::%clojure-upper-case name)
          (rontolisp::%clojure-re-uni-block-names))))
    (if index (list :blk (+ index 1)) nil)))

(defun rontolisp::%clojure-rp-prefix-p (prefix name)
  "Whether NAME starts with PREFIX."
  (and (>= (length name) (length prefix))
       (string= prefix (subseq name 0 (length prefix)))))

(defun rontolisp::%clojure-rp-family-name (st single)
  "Java's family's name: the one letter under the cursor when SINGLE, else
   the characters up to the }, the oracle's refusal when there is none or
   none before it."
  (rontolisp::%clojure-rp-next st)
  (if single
      (let ((c (rontolisp::%clojure-rp-at st (rontolisp::%clojure-rp-cur st))))
        (rontolisp::%clojure-rp-read st)
        (string (code-char c)))
      (let ((i (rontolisp::%clojure-rp-cur st))
            (codes (svref st 0))
            (plen (svref st 4))
            (chars nil))
        ;; the oracle's mark: a } where the pattern ends stops the read there
        (setf (svref codes plen) 125)
        (do () ((= (rontolisp::%clojure-rp-read st) 125)))
        (setf (svref codes plen) 0)
        (let ((j (rontolisp::%clojure-rp-cur st)))
          (if (> j plen)
              (rontolisp::%clojure-rp-error st "Unclosed character family"))
          (if (>= (+ i 1) j)
              (rontolisp::%clojure-rp-error st "Empty character family"))
          (do ((k (- j 2) (- k 1)))
              ((< k i))
            (setq chars (cons (code-char (svref codes k)) chars)))
          (coerce chars 'string)))))

(defun rontolisp::%clojure-rp-family (st single negated)
  "Java's family: the item of the property after \\p or \\P (NEGATED) --
   one letter when SINGLE, else up to the } -- as the oracle resolves its
   name: name=value (sc or script, blk or block, gc or general_category), In
   and a block, Is and a binary property, a category or a script, else (a
   POSIX class over Unicode first under (?U)) a category, a POSIX ASCII class
   or a java Character method."
  (let* ((name (rontolisp::%clojure-rp-family-name st single))
         (ci (rontolisp::%clojure-rp-has st 2))
         (eqpos (position #\= name))
         (item nil))
    (if eqpos
        (let ((value (subseq name (+ eqpos 1)))
              (key (rontolisp::%clojure-lower-case (subseq name 0 eqpos))))
          (setq item
                (cond ((or (string= key "sc") (string= key "script"))
                       (rontolisp::%clojure-re-uni-script-item value))
                      ((or (string= key "blk") (string= key "block"))
                       (rontolisp::%clojure-re-uni-block-item value))
                      ((or (string= key "gc") (string= key "general_category"))
                       (rontolisp::%clojure-re-uni-java-property value ci))
                      (t nil)))
          (if (null item)
              (rontolisp::%clojure-rp-error st
                                            (concatenate 'string
                                             "Unknown Unicode property {name=<"
                                             key ">, value=<" value ">}"))))
        (progn
          (setq item
                (cond ((rontolisp::%clojure-rp-prefix-p "In" name)
                       (rontolisp::%clojure-re-uni-block-item (subseq name 2)))
                      ((rontolisp::%clojure-rp-prefix-p "Is" name)
                       (let ((short (subseq name 2)))
                         (or (rontolisp::%clojure-re-uni-property
                              (rontolisp::%clojure-upper-case short) ci)
                             (rontolisp::%clojure-re-uni-java-property short ci)
                             (rontolisp::%clojure-re-uni-script-item short))))
                      (t (or
                          (and (rontolisp::%clojure-rp-has st 256)
                               (rontolisp::%clojure-re-uni-posix
                                (rontolisp::%clojure-upper-case name) ci))
                          (rontolisp::%clojure-re-uni-java-property name ci)))))
          (if (null item)
              (rontolisp::%clojure-rp-error st
                                            (concatenate 'string
                                             "Unknown character property name {"
                                             name "}")))))
    (if negated (list :cls t (list item)) item)))

(defun rontolisp::%clojure-rp-property (st negated)
  "\\p or \\P (NEGATED), the cursor on its letter: the item of the property
   it names, a { after it consumed (Java's family). Refused where no pattern
   can name one: the regex-unicode family's arm."
  (if (rontolisp::%clojure-re-unicode-p st)
      (let ((single (not (= (rontolisp::%clojure-rp-next st) 123))))
        (if single (rontolisp::%clojure-rp-unread st))
        (rontolisp::%clojure-rp-family st single negated))
      (error "unsupported regex: \\p is not supported")))

(defun rontolisp::%clojure-rp-property-op (st negated)
  "The one-character op of \\p or \\P (NEGATED) outside a class."
  (rontolisp::%clojure-rp-canon st
                                (rontolisp::%clojure-rp-class-op
                                 (rontolisp::%clojure-rp-property st negated))))

(defun rontolisp::%clojure-rp-unicode-class (ch)
  "The class of \\d \\D \\s \\S \\w or \\W (the letter CH) under (?U):
   CharPredicates' DIGIT, WHITE_SPACE and WORD, an upper-case letter negating."
  (let ((name
         (cond ((or (= ch 68) (= ch 100)) "DIGIT")
               ((or (= ch 83) (= ch 115)) "WHITE_SPACE")
               (t "WORD"))))
    (list :cls (or (= ch 68) (= ch 83) (= ch 87))
          (list (rontolisp::%clojure-re-uni-property name nil)))))

(defun rontolisp::%clojure-rp-canon (st op)
  "The class or property OP, refused under (?c), where the oracle matches it
   against the NFC normalization of the input."
  (if (rontolisp::%clojure-rp-has st 128)
      (error "unsupported regex: a character class under (?c) is not supported")
      op))

;;; Grapheme clusters: \X and \b{g}, jdk.internal.util.regex.Grapheme's
;;; nextBoundary (JDK 25, Unicode 16's extended grapheme cluster rules of UAX
;;; #29) over clojure-unicode.lisp's grapheme table, a code point's break type
;;; times four plus its Indic conjunct class (0 none, 1 consonant, 2 extend, 3
;;; linker; GB9c). The table is generated by probing the JDK's own \X, since the
;;; JDK's type and conjunct lists are internal: the break types are 0 Other, 1
;;; CR, 2 LF, 3 Control, 4 Extend (the oracle's SpacingMark too, which no rule
;;; tells apart), 5 ZWJ, 6 Regional_Indicator, 7 Prepend, 8 L, 9 V, 10 T, 11 LV,
;;; 12 LVT, 13 Extended_Pictographic. They sit behind the arms of the
;;; regex-grapheme family (%clojure-re-grapheme-p in the parser,
;;; %clojure-re-grapheme-op-p in the matcher), made by a literal naming \X or
;;; \b{g} and by every pattern made at run time.

(defun rontolisp::%clojure-re-grapheme-source (source)
  "The SOURCE of a regex literal that may name \\X or \\b{g}: the producer of
   the regex-grapheme family."
  source)

(defun rontolisp::%clojure-re-grapheme-p (st)
  "Whether the parse ST reads grapheme clusters: the regex-grapheme family's
   test in the parser, folded away where no pattern can name one."
  (declare (ignore st))
  t)

(defun rontolisp::%clojure-re-grapheme-op-p (op)
  "Whether OP is \\X or \\b{g}: the regex-grapheme family's test in the
   matcher."
  (let ((tag (car op))) (or (eq tag :graph) (eq tag :gbound))))

(defun rontolisp::%clojure-re-gr-class (code)
  "The break type of CODE times four plus its Indic conjunct class."
  (rontolisp::%clojure-re-uni-run-value (rontolisp::%clojure-re-uni-graphemes)
                                        code))

(defun rontolisp::%clojure-re-gr-break-p (t0 t1)
  "Whether the rules break between the break types T0 and T1 (Grapheme's
   rules table): GB3, GB4 and GB5, then GB6 to GB9b, else GB999."
  (cond ((and (= t0 1) (= t1 2)) nil)
        ((or (and (<= 1 t0) (<= t0 3)) (and (<= 1 t1) (<= t1 3))) t)
        ((or (= t1 4) (= t1 5) (= t0 7)) nil)
        ((= t0 8) (not (or (= t1 8) (= t1 9) (= t1 11) (= t1 12))))
        ((or (= t0 9) (= t0 11)) (not (or (= t1 9) (= t1 10))))
        ((or (= t0 10) (= t0 12)) (not (= t1 10)))
        (t t)))

(defun rontolisp::%clojure-re-gr-conjunct (s index limit g)
  "Grapheme's checkIndicConjunctBreak after a consonant: how far from INDEX of
   S the extends and linkers up to the consonant a linker joins reach, or -1
   (G marked when the scan read where the input ends, short of LIMIT)."
  (let ((advance 0) (linker nil) (answer nil))
    (loop
      (if answer (return answer))
      (if (>= (+ index advance) limit)
          (progn
            (rontolisp::%clojure-re-hit-end g)
            (setq answer -1))
          (let ((c
                 (logand (rontolisp::%clojure-re-gr-class
                          (char-code (char s (+ index advance)))) 3)))
            (setq advance (+ advance 1))
            (cond ((= c 3) (setq linker t))
                  ((= c 1) (setq answer (if linker advance -1)))
                  ((= c 2) nil)
                  (t (setq answer -1))))))))

(defun rontolisp::%clojure-re-gr-next (s off limit g)
  "Grapheme.nextBoundary: the end of the extended grapheme cluster starting at
   OFF of S, before LIMIT (past OFF). A consonant's conjunct joins first
   (GB9c, the consonant staying the one asked about), then GB11's emoji
   sequence and GB12's regional indicator pairs, then the rules table. G is
   marked when the cluster reaches LIMIT, where more input could extend it."
  (let* ((v0 (rontolisp::%clojure-re-gr-class (char-code (char s off))))
         (t0 (ash v0 -2))
         (ret (+ off 1))
         (ri (if (= t0 6) 1 0))
         (gb11 (= t0 13))
         (done nil))
    (do ()
        ((or done (>= ret limit))
         (if (not done) (rontolisp::%clojure-re-hit-end g))
         ret)
      (let* ((v1 (rontolisp::%clojure-re-gr-class (char-code (char s ret))))
             (t1 (ash v1 -2))
             (advance
              (if (= (logand v0 3) 1)
                  (rontolisp::%clojure-re-gr-conjunct s ret limit g)
                  -1)))
        (cond ((>= advance 0) (setq ret (+ ret advance)))
              ((and (not (and gb11 (= t0 5) (= t1 13)))
                    (not (and (= (logand ri 1) 1) (= t0 6) (= t1 6)))
                    (rontolisp::%clojure-re-gr-break-p t0 t1))
               (setq done t))
              (t
               (if (= t1 6) (setq ri (+ ri 1)))
               (setq v0 v1)
               (setq t0 t1)
               (setq ret (+ ret 1))))))))

(defun rontolisp::%clojure-re-gr-bound-p (s len pos g)
  "The oracle's GraphemeBound at POS of S (LEN long): at the start, at the end,
   or at or past the end of the cluster that starts at the matcher's last
   (%clojure-re-last-of, which a search moves) -- the oracle asks no more.
   Where that last is LEN the oracle's nextBoundary reads past the input and
   throws; over the prefix a lazy matcher has read (G's :total, the whole
   length), the search reads on instead."
  (cond ((= pos 0) t)
        ((< pos len)
         (let ((last (rontolisp::%clojure-re-last-of g)))
           (if (>= last len)
               (progn
                 (rontolisp::%clojure-re-hit-end g)
                 (if (< len (or (cdr (assoc :total (svref g 1))) len))
                     nil
                     (rontolisp::%clojure-string-index-out-of-bounds-exception
                      (concatenate 'string "Index "
                                   (rontolisp::%clojure-re-decimal last)
                                   " out of bounds for length "
                                   (rontolisp::%clojure-re-decimal len)))))
               (not (> (rontolisp::%clojure-re-gr-next s last len g) pos)))))
        (t
         (rontolisp::%clojure-re-hit-end g)
         t)))

(defun rontolisp::%clojure-re-match-grapheme (op s len pos g k)
  "\\X (:graph), the oracle's XGrapheme: the cluster at POS, then K; or
   \\b{g} (:gbound), K at POS where it holds."
  (if (eq (car op) :graph)
      (if (< pos len)
          (funcall k (rontolisp::%clojure-re-gr-next s pos len g))
          (progn
            (rontolisp::%clojure-re-hit-end g)
            nil))
      (if (rontolisp::%clojure-re-gr-bound-p s len pos g) (funcall k pos) nil)))

;;; The matcher: java.util.regex's match nodes over the group vector of one
;;; search (start and end of group N at 2N and 2N+1, -1 for none), which a group
;;; sets as its body ends and restores when what follows fails (GroupHead and
;;; GroupTail), so a capture made inside a lookaround, an atomic group or a
;;; quantified unit stays when the match backs out past it, as in the oracle.

(defun rontolisp::%clojure-re-item-test (item code)
  "Whether the class ITEM matches CODE."
  (cond ((integerp item) (= item code))
        ((eq item :w) (rontolisp::%clojure-re-word-char-p code))
        ((eq item :s) (rontolisp::%clojure-re-space-code-p code))
        ((eq item :d) (rontolisp::%clojure-re-digit-code-p code))
        ((eq item :h) (rontolisp::%clojure-re-horiz-p code))
        ((eq item :v) (rontolisp::%clojure-re-vert-p code))
        ((not (consp item)) nil)
        ((eq (car item) :r)
         (and (<= (car (cdr item)) code) (<= code (car (cdr (cdr item))))))
        ;; a Unicode property: an arm of the regex-unicode family
        ((rontolisp::%clojure-re-uni-item-p item)
         (rontolisp::%clojure-re-uni-item-test item code))
        ;; a \s \d \w member (or its negation), a nested class or union
        ((eq (car item) :cls)
         (rontolisp::%clojure-re-cls-test (car (cdr item))
                                          (car (cdr (cdr item))) code))
        ((eq (car item) :ri)
         (let ((lo (car (cdr item))) (hi (car (cdr (cdr item)))))
           (or (and (<= lo code) (<= code hi))
               (and (< code 128)
                    (or (let ((u (rontolisp::%clojure-re-ascii-upper code)))
                          (and (<= lo u) (<= u hi)))
                        (let ((l (rontolisp::%clojure-re-ascii-lower code)))
                          (and (<= lo l) (<= l hi))))))))
        ((eq (car item) :ru)
         (let ((lo (car (cdr item))) (hi (car (cdr (cdr item)))))
           (or (and (<= lo code) (<= code hi))
               (let ((up (rontolisp::%clojure-re-upcase code)))
                 (or (and (<= lo up) (<= up hi))
                     (let ((down (rontolisp::%clojure-re-downcase up)))
                       (and (<= lo down) (<= down hi))))))))
        ((eq (car item) :u)
         (or (= code (car (cdr item)))
             (= (rontolisp::%clojure-re-fold code) (car (cdr item)))))
        ((eq (car item) :and)
         (and (rontolisp::%clojure-re-item-test (car (cdr item)) code)
              (rontolisp::%clojure-re-item-test (car (cdr (cdr item))) code)))
        (t nil)))

(defun rontolisp::%clojure-re-any-item (items code)
  "Whether any member of ITEMS matches CODE."
  (if (null items)
      nil
      (or (rontolisp::%clojure-re-item-test (car items) code)
          (rontolisp::%clojure-re-any-item (cdr items) code))))

(defun rontolisp::%clojure-re-cls-test (neg items code)
  "Whether CODE is in the class (NEG negated)."
  (let ((hit (rontolisp::%clojure-re-any-item items code)))
    (if neg (not hit) hit)))

(defun rontolisp::%clojure-re-char-test (op code)
  "Whether the one-character op OP matches CODE."
  (let ((tag (car op)))
    (cond ((eq tag :lit) (= code (car (cdr op))))
          ((eq tag :cls)
           (rontolisp::%clojure-re-cls-test (car (cdr op)) (car (cdr (cdr op)))
                                            code))
          ((eq tag :dot) (not (rontolisp::%clojure-re-line-term-p code)))
          ((eq tag :ilit)
           (= (rontolisp::%clojure-re-ascii-lower code) (car (cdr op))))
          ((eq tag :ulit)
           (or (= code (car (cdr op)))
               (= (rontolisp::%clojure-re-fold code) (car (cdr op)))))
          ((eq tag :udot) (not (= code 10)))
          (t t))))

(defun rontolisp::%clojure-re-word-boundary-p (s len pos unicode)
  "Whether POS is a word boundary, as the oracle's Bound checks one: between
   a word character and another character, a word character an ASCII one
   (Unicode's under UNICODE) or a non-spacing mark after a letter or digit."
  (let ((left
         (and (> pos 0)
              (rontolisp::%clojure-re-bound-word-p s (- pos 1) unicode)))
        (right
         (and (< pos len) (rontolisp::%clojure-re-bound-word-p s pos unicode))))
    (if left (not right) right)))

(defun rontolisp::%clojure-re-bound-word-p (s i unicode)
  "Whether the character at I of S counts as a word character for \\b: an
   ASCII one, or past ASCII the regex-category family's test."
  (cond ((rontolisp::%clojure-re-word-char-p (char-code (char s i))) t)
        ((rontolisp::%clojure-re-cat-word-p s i unicode) t)
        (t nil)))

(defun rontolisp::%clojure-re-anchor-p (tag s len pos g)
  "Whether the zero-width anchor TAG holds at POS of S (LEN long), as the
   oracle's Begin, Caret, UnixCaret, Dollar, UnixDollar, End, Bound and
   LastMatch do: a line ends at \\n (not after a \\r), \\r, U+0085, U+2028 or
   U+2029 (\\n alone under UNIX_LINES), ^ in MULTILINE never holds at the very
   end, \\G holds where the group vector G says the matcher's last match
   ended. Any anchor but ^ and \\G within two characters of the end reads
   where the input ends (G's mark, %clojure-re-hit-end)."
  (if (and (not (eq tag :bol)) (not (eq tag :glast)) (>= (+ pos 2) len))
      (rontolisp::%clojure-re-hit-end g))
  (cond ((eq tag :bol) (= pos 0))
   ((eq tag :eol)
    (cond ((< pos (- len 2)) nil)
          ((= pos (- len 2))
           (and (= (char-code (char s pos)) 13)
                (= (char-code (char s (+ pos 1))) 10)))
          ((< pos len)
           (let ((c (char-code (char s pos))))
             (if (= c 10)
                 (not (and (> pos 0) (= (char-code (char s (- pos 1))) 13)))
                 (rontolisp::%clojure-re-line-term-p c))))
          (t t)))
   ((eq tag :zend) (= pos len))
   ((eq tag :wb) (rontolisp::%clojure-re-word-boundary-p s len pos nil))
   ((eq tag :nwb) (not (rontolisp::%clojure-re-word-boundary-p s len pos nil)))
   ((eq tag :uwb) (rontolisp::%clojure-re-word-boundary-p s len pos t))
   ((eq tag :unwb) (not (rontolisp::%clojure-re-word-boundary-p s len pos t)))
   ((eq tag :glast) (= pos (cdr (assoc :glast (svref g 1)))))
   ((eq tag :mbol)
    (cond ((= pos len) nil)
          ((> pos 0)
           (let ((c (char-code (char s (- pos 1)))))
             (and (rontolisp::%clojure-re-line-term-p c)
                  (not (and (= c 13) (= (char-code (char s pos)) 10))))))
          (t t)))
   ((eq tag :meol)
    (if (< pos len)
        (let ((c (char-code (char s pos))))
          (if (= c 10)
              (not (and (> pos 0) (= (char-code (char s (- pos 1))) 13)))
              (rontolisp::%clojure-re-line-term-p c)))
        t))
   ((eq tag :ubol)
    (cond ((= pos len) nil)
          ((> pos 0) (= (char-code (char s (- pos 1))) 10))
          (t t)))
   ((eq tag :ueol)
    (if (< pos len) (and (= (char-code (char s pos)) 10) (= pos (- len 1))) t))
   ((eq tag :umeol) (if (< pos len) (= (char-code (char s pos)) 10) t))
   (t nil)))

(defun rontolisp::%clojure-re-set-group (g idx start end)
  "Set the bounds of the group IDX in the group vector G."
  (setf (svref g (* 2 idx)) start)
  (setf (svref g (+ (* 2 idx) 1)) end))

;; Slot 0 of a search's group vector -- group 0's start, which no group sets (the
;; whole match is the search's own answer) -- marks that the search read where the
;; input ends: a test of a position at or near LEN that more input could answer
;; otherwise (the oracle's Matcher.hitEnd). Every engine step that reads the end
;; marks it, so a search that did not would answer the same over a longer input:
;; what lets a matcher over a CharSequence type read only a prefix
;; (%clojure-re-lazy-search). Marking more than that costs a longer prefix, never
;; a wrong answer.
(defun rontolisp::%clojure-re-hit-end (g)
  "Marks that the search of the group vector G read where its input ends."
  (setf (svref g 0) t))

(defun rontolisp::%clojure-re-match (op s len pos g k)
  "Match OP at POS of S (LEN long) over the group vector G: the continuation
   K's answer for the end position, or NIL. Backtracking rides OR: a
   continuation answering NIL retries the next alternative, so each
   combinator tries every choice in order."
  (let ((tag (car op)))
    (cond
     ((eq tag :lit)
      (if (< pos len)
          (if (= (char-code (char s pos)) (car (cdr op)))
              (funcall k (+ pos 1))
              nil)
          (progn
            (rontolisp::%clojure-re-hit-end g)
            nil)))
     ((eq tag :seq) (rontolisp::%clojure-re-match-seq (cdr op) s len pos g k))
     ((eq tag :rep) (rontolisp::%clojure-re-match-rep op s len pos g k))
     ((rontolisp::%clojure-re-char-op-p op)
      (if (< pos len)
          (if (rontolisp::%clojure-re-char-test op (char-code (char s pos)))
              (funcall k (+ pos 1))
              nil)
          (progn
            (rontolisp::%clojure-re-hit-end g)
            nil)))
     ((eq tag :grp)
      (rontolisp::%clojure-re-match-group (car (cdr op)) (car (cdr (cdr op))) s
                                          len pos g k))
     ((eq tag :alt)
      (or (rontolisp::%clojure-re-match (car (cdr op)) s len pos g k)
          (rontolisp::%clojure-re-match (car (cdr (cdr op))) s len pos g k)))
     ((eq tag :look)
      (if (rontolisp::%clojure-re-first (car (cdr op)) s len pos g)
          (funcall k pos)
          nil))
     ((eq tag :nlook)
      (if (rontolisp::%clojure-re-first (car (cdr op)) s len pos g)
          nil
          (funcall k pos)))
     ((eq tag :behind)
      (if (rontolisp::%clojure-re-behind op s len pos g) (funcall k pos) nil))
     ((eq tag :nbehind)
      (if (rontolisp::%clojure-re-behind op s len pos g) nil (funcall k pos)))
     ((eq tag :atomic)
      (let ((end (rontolisp::%clojure-re-first (car (cdr op)) s len pos g)))
        (if end (funcall k end) nil)))
     ((or (eq tag :backref) (eq tag :ibackref) (eq tag :ubackref))
      (rontolisp::%clojure-re-match-backref op s len pos g k))
     ((eq tag :lb) (rontolisp::%clojure-re-match-linebreak s len pos g k))
     ;; \X and \b{g}: an arm of the regex-grapheme family
     ((rontolisp::%clojure-re-grapheme-op-p op)
      (rontolisp::%clojure-re-match-grapheme op s len pos g k))
     ((rontolisp::%clojure-re-anchor-p tag s len pos g) (funcall k pos))
     (t nil))))

(defun rontolisp::%clojure-re-match-seq (ops s len pos g k)
  "Match the OPS list in order at POS."
  (if (null ops)
      (funcall k pos)
      (rontolisp::%clojure-re-match (car ops) s len pos g
                                    (lambda (p2)
                                      (rontolisp::%clojure-re-match-seq
                                       (cdr ops) s len p2 g k)))))

(defun rontolisp::%clojure-re-match-group (idx body s len pos g k)
  "The group IDX over BODY at POS (the oracle's GroupHead and GroupTail): the
   group takes POS to where BODY ends before K runs, and its old bounds come
   back when K fails."
  (rontolisp::%clojure-re-match body s len pos g
                                (lambda (end)
                                  (let ((old-start (svref g (* 2 idx)))
                                        (old-end (svref g (+ (* 2 idx) 1))))
                                    (rontolisp::%clojure-re-set-group g idx pos
                                                                      end)
                                    (or (funcall k end)
                                        (progn
                                          (rontolisp::%clojure-re-set-group g
                                           idx old-start old-end)
                                          nil))))))

(defun rontolisp::%clojure-re-first (op s len pos g)
  "OP's first success at POS: its end, or NIL. Its captures stay (the match
   behind it is never retried). The end becomes the matcher's last, as the
   oracle's accept node (or a group's tail where GroupCurly iterates it)
   makes it when the chain of a Curly's or a Ques's atom, a lookahead or an
   independent group completes (%clojure-re-set-last)."
  (rontolisp::%clojure-re-match op s len pos g
                                (lambda (end)
                                  (rontolisp::%clojure-re-set-last g end)
                                  end)))

(defun rontolisp::%clojure-re-behind (op s len pos g)
  "Whether the look-behind OP (:behind body min max) holds at POS as the
   oracle's Behind tries it: its body from POS - min back to POS - max (not
   before 0), the first start one of whose matches ends at POS."
  (let ((body (car (cdr op)))
        (from (rontolisp::%clojure-rp-i32 (- pos (car (cdr (cdr (cdr op)))))))
        (j (rontolisp::%clojure-rp-i32 (- pos (car (cdr (cdr op))))))
        (found nil))
    (if (< from 0) (setq from 0))
    (if (> j pos) (setq j pos))
    (do ()
        ((or found (< j from)) found)
      (setq found
            (rontolisp::%clojure-re-match body s len j g
             (lambda (end) (if (= end pos) t nil))))
      (setq j (- j 1)))))

(defun rontolisp::%clojure-re-match-backref (op s len pos g k)
  "Match at POS the text the group of the back reference OP took: exactly,
   or case-insensitively (:ibackref ASCII, :ubackref Unicode); fail past a
   group that took no part or that the pattern lacks."
  (let ((i2 (* 2 (car (cdr op)))) (tag (car op)))
    (if (or (>= i2 (length g)) (< (svref g i2) 0))
        nil
        (let* ((gs (svref g i2))
               (n (- (svref g (+ i2 1)) gs))
               (ok (<= (+ pos n) len))
               (i 0))
          (if (not ok) (rontolisp::%clojure-re-hit-end g))
          (do ()
              ((or (not ok) (>= i n)))
            (let ((c1 (char-code (char s (+ pos i))))
                  (c2 (char-code (char s (+ gs i)))))
              (if (not (= c1 c2))
                  (cond ((eq tag :ibackref)
                         (if (not
                              (= (rontolisp::%clojure-re-ascii-lower c1)
                                 (rontolisp::%clojure-re-ascii-lower c2)))
                             (setq ok nil)))
                        ((eq tag :ubackref)
                         (let ((u1 (rontolisp::%clojure-re-upcase c1))
                               (u2 (rontolisp::%clojure-re-upcase c2)))
                           (if (not
                                (or (= u1 u2)
                                    (= (rontolisp::%clojure-re-downcase u1)
                                       (rontolisp::%clojure-re-downcase u2))))
                               (setq ok nil))))
                        (t (setq ok nil)))))
            (setq i (+ i 1)))
          (if ok (funcall k (+ pos n)) nil)))))

(defun rontolisp::%clojure-re-match-linebreak (s len pos g k)
  "\\R: \\r\\n, giving way to \\r alone when what follows fails, or one of
   \\n \\x0B \\f \\r U+0085 U+2028 U+2029 (the oracle's LineEnding)."
  (if (< pos len)
      (let ((c (char-code (char s pos))))
        (cond ((= c 13)
               (if (>= (+ pos 1) len) (rontolisp::%clojure-re-hit-end g))
               (or (and (< (+ pos 1) len) (= (char-code (char s (+ pos 1))) 10)
                        (funcall k (+ pos 2))) (funcall k (+ pos 1))))
              ((rontolisp::%clojure-re-vert-p c) (funcall k (+ pos 1)))
              (t nil)))
      (progn
        (rontolisp::%clojure-re-hit-end g)
        nil)))

(defun rontolisp::%clojure-re-match-rep (op s len pos g k)
  "Match the quantified op (:rep unit min max mode kind) as the oracle's node
   of that kind does."
  (let ((unit (nth 1 op))
        (lo (nth 2 op))
        (hi (nth 3 op))
        (mode (nth 4 op))
        (kind (nth 5 op)))
    (cond ((rontolisp::%clojure-re-char-op-p unit)
           (rontolisp::%clojure-re-match-run unit lo hi mode s len pos g k
                                             (not (eq kind :cpg))))
          ((or (eq kind :loop) (eq kind :loopm))
           (rontolisp::%clojure-re-loop op s len pos g k))
          ((eq kind :branch)
           (if (eq mode :reluctant)
               (or (funcall k pos)
                   (rontolisp::%clojure-re-match unit s len pos g k))
               (or (rontolisp::%clojure-re-match unit s len pos g k)
                   (funcall k pos))))
          ((eq kind :gcurly)
           (rontolisp::%clojure-re-group-curly (car (cdr unit))
                                               (car (cdr (cdr unit))) lo hi mode
                                               s len pos g k))
          (t (rontolisp::%clojure-re-curly unit lo hi mode s len pos g k)))))

(defun rontolisp::%clojure-re-match-run (unit lo hi mode s len pos g k writes)
  "A quantified one-character UNIT: the matching run from POS counted at
   once, then tried longest first (greedy), shortest first (reluctant) or
   only longest (possessive). A run the input's end stops reads the end
   (%clojure-re-hit-end). WRITES: the oracle built a Curly or a Ques, whose
   atom's every match makes its end the matcher's last (a CharPropertyGreedy
   makes none)."
  (let ((top (if hi (+ pos hi) len)) (capped (or (null hi) (> (+ pos hi) len))))
    (if (> top len) (setq top len))
    (if (eq mode :reluctant)
        (let ((end pos) (found nil) (stop nil))
          (do ()
              ((or stop (>= end (+ pos lo))))
            (if (and (< end len)
                     (rontolisp::%clojure-re-char-test unit
                      (char-code (char s end))))
                (setq end (+ end 1))
                (progn
                  (if (>= end len) (rontolisp::%clojure-re-hit-end g))
                  (setq stop t))))
          (if (and writes (> end pos)) (rontolisp::%clojure-re-set-last g end))
          (if stop
              nil
              (do ()
                  ((or found stop) found)
                (setq found (funcall k end))
                (if (not found)
                    (if (and (< end top)
                             (rontolisp::%clojure-re-char-test unit
                              (char-code (char s end))))
                        (progn
                          (setq end (+ end 1))
                          (if writes (rontolisp::%clojure-re-set-last g end)))
                        (progn
                          (if (and capped (>= end top))
                              (rontolisp::%clojure-re-hit-end g))
                          (setq stop t)))))))
        (let ((end pos))
          (do ()
              ((or (>= end top)
                   (not
                    (rontolisp::%clojure-re-char-test unit
                     (char-code (char s end))))))
            (setq end (+ end 1)))
          (if (and capped (>= end top)) (rontolisp::%clojure-re-hit-end g))
          (if (and writes (> end pos)) (rontolisp::%clojure-re-set-last g end))
          (cond ((< (- end pos) lo) nil)
                ((eq mode :possessive) (funcall k end))
                (t (let ((found nil) (least (+ pos lo)))
                     (do ()
                         ((or found (< end least)) found)
                       (setq found (funcall k end))
                       (setq end (- end 1))))))))))

(defun rontolisp::%clojure-re-iterate (unit lo s len pos g)
  "The first LO iterations of UNIT from POS, each its first success: where
   they end, or NIL. The oracle runs every one, an empty one too; an empty one
   that began where the matcher's last stood stands for the rest here, each
   after it beginning and ending in that same state (one that began elsewhere
   moved the last, which \\b{g} reads)."
  (let ((p pos) (n 0))
    (do ()
        ((or (null p) (>= n lo)) p)
      (let* ((before (rontolisp::%clojure-re-last-of g))
             (end (rontolisp::%clojure-re-first unit s len p g)))
        (setq n (if (and end (= end p) (eql before p)) lo (+ n 1)))
        (setq p end)))))

(defun rontolisp::%clojure-re-curly (unit lo hi mode s len pos g k)
  "The oracle's Curly: UNIT (no group, or a possessive one) repeated, each
   iteration its first success; the minimum first, then greedy takes every
   further one and gives them back one at a time, reluctant adds them one at
   a time, possessive keeps them all. An empty iteration ends the run."
  (let ((p (rontolisp::%clojure-re-iterate unit lo s len pos g)) (n lo))
    (cond ((null p) nil)
          ((eq mode :reluctant)
           (let ((found nil) (stop nil))
             (do ()
                 ((or found stop) found)
               (setq found (funcall k p))
               (if (not found)
                   (let ((end
                          (if (and hi (>= n hi))
                              nil
                              (rontolisp::%clojure-re-first unit s len p g))))
                     (if (or (null end) (= end p))
                         (setq stop t)
                         (progn
                           (setq p end)
                           (setq n (+ n 1)))))))))
          (t (let ((ends (list p)) (stop nil))
               (do ()
                   ((or stop (and hi (>= n hi))))
                 (let ((end (rontolisp::%clojure-re-first unit s len p g)))
                   (if (or (null end) (= end p))
                       (setq stop t)
                       (progn
                         (setq p end)
                         (setq n (+ n 1))
                         (setq ends (cons p ends))))))
               (if (eq mode :possessive)
                   (funcall k p)
                   (let ((found nil))
                     (do ((rest ends (cdr rest)))
                         ((or found (null rest)) found)
                       (setq found (funcall k (car rest)))))))))))

(defun rontolisp::%clojure-re-group-curly (idx body lo hi mode s len pos g k)
  "The oracle's GroupCurly: the group IDX whose BODY matches one way,
   repeated. Each iteration sets the group; greedy backs off resetting it to
   the iteration kept, and to what it was after the minimum at the minimum;
   an empty iteration ends the run (greedy: its bounds dropped); a failure
   restores the group."
  (let ((save-start (svref g (* 2 idx)))
        (save-end (svref g (+ (* 2 idx) 1)))
        (p pos)
        (n 0)
        (fail nil))
    (do ()
        ((or fail (>= n lo)))
      (let* ((before (rontolisp::%clojure-re-last-of g))
             (end (rontolisp::%clojure-re-first body s len p g)))
        (if (null end)
            (setq fail t)
            (progn
              (rontolisp::%clojure-re-set-group g idx p end)
              ;; an empty iteration stands for the rest as in
              ;; %clojure-re-iterate
              (setq n (if (and (= end p) (eql before p)) lo (+ n 1)))
              (setq p end)))))
    (let ((found
           (cond (fail nil)
                 ((eq mode :reluctant)
                  (rontolisp::%clojure-re-group-lazy idx body n hi s len p g k))
                 (t (rontolisp::%clojure-re-group-greedy idx body n hi s len p g
                                                         k)))))
      (if (not found)
          (rontolisp::%clojure-re-set-group g idx save-start save-end))
      found)))

(defun rontolisp::%clojure-re-group-greedy (idx body n hi s len pos g k)
  "GroupCurly's greedy pass from POS, N iterations done."
  (let ((save-start (svref g (* 2 idx)))
        (save-end (svref g (+ (* 2 idx) 1)))
        (p pos)
        (ends nil)
        (stop nil))
    (do ()
        ((or stop (and hi (>= n hi))))
      (let ((end (rontolisp::%clojure-re-first body s len p g)))
        (cond ((null end) (setq stop t))
              ((= end p) (setq stop t))
              (t
               (rontolisp::%clojure-re-set-group g idx p end)
               (setq ends (cons (cons p end) ends))
               (setq p end)
               (setq n (+ n 1))))))
    (let ((found nil))
      (do ((rest ends (cdr rest)))
          ((or found (null rest)))
        (rontolisp::%clojure-re-set-group g idx (car (car rest))
                                          (cdr (car rest)))
        (setq found (funcall k (cdr (car rest)))))
      (or found
          (progn
            (rontolisp::%clojure-re-set-group g idx save-start save-end)
            (funcall k pos))))))

(defun rontolisp::%clojure-re-group-lazy (idx body n hi s len pos g k)
  "GroupCurly's reluctant pass from POS, N iterations done: the continuation
   first, one more iteration on its failure; an empty one fails."
  (let ((p pos) (found nil) (stop nil))
    (do ()
        ((or found stop) found)
      (setq found (funcall k p))
      (if (not found)
          (let ((end
                 (if (and hi (>= n hi))
                     nil
                     (rontolisp::%clojure-re-first body s len p g))))
            (if (or (null end) (= end p))
                (setq stop t)
                (progn
                  (rontolisp::%clojure-re-set-group g idx p end)
                  (setq p end)
                  (setq n (+ n 1)))))))))

(defun rontolisp::%clojure-re-loop (op s len pos g k)
  "The oracle's Loop (LazyLoop under :reluctant) entry for the quantified
   group OP whose body matches in more than one way: each iteration
   backtracks with the ones after it."
  (let ((unit (nth 1 op))
        (lo (nth 2 op))
        (hi (nth 3 op))
        (lazy (eq (nth 4 op) :reluctant)))
    (cond ((> lo 0)
           (rontolisp::%clojure-re-match unit s len pos g
                                         (lambda (p2)
                                           (rontolisp::%clojure-re-loop-next op
                                            1 pos s len p2 g k))))
          ((and hi (= hi 0)) (funcall k pos))
          (lazy (or (funcall k pos)
                    (rontolisp::%clojure-re-match unit s len pos g
                     (lambda (p2)
                       (rontolisp::%clojure-re-loop-next op 1 pos s len p2 g
                                                         k)))))
          (t (or (rontolisp::%clojure-re-match unit s len pos g
                  (lambda (p2)
                    (rontolisp::%clojure-re-loop-next op 1 pos s len p2 g k)))
                 (funcall k pos))))))

(defun rontolisp::%clojure-re-loop-memo (op g len)
  "The positions the memoized loop OP failed to iterate from in this search
   (the oracle's localsPos): a vector over 0..LEN, kept in the slot of the
   group vector G no group uses (group 0's end)."
  (let ((entry (assoc op (svref g 1))))
    (if entry
        (cdr entry)
        (let ((memo (make-array (+ len 1) :initial-element nil)))
          (setf (svref g 1) (cons (cons op memo) (svref g 1)))
          memo))))

(defun rontolisp::%clojure-re-loop-next (op count start s len pos g k)
  "The oracle's Loop.match (LazyLoop.match when reluctant) for the quantified
   group OP after an iteration from START to POS, COUNT done: an iteration
   that consumed nothing ends the loop; below the minimum another must
   follow; past it greedy tries another before the continuation, lazy after.
   A memoized loop (:loopm) goes straight on from a position where another
   iteration already failed in this search."
  (let ((unit (nth 1 op)) (lo (nth 2 op)) (hi (nth 3 op)))
    (cond ((not (> pos start)) (funcall k pos))
          ((< count lo)
           (rontolisp::%clojure-re-match unit s len pos g
                                         (lambda (p2)
                                           (rontolisp::%clojure-re-loop-next op
                                            (+ count 1) pos s len p2 g k))))
          ((eq (nth 4 op) :reluctant)
           (or (funcall k pos)
               (and (or (null hi) (< count hi))
                    (rontolisp::%clojure-re-match unit s len pos g
                     (lambda (p2)
                       (rontolisp::%clojure-re-loop-next op (+ count 1) pos s
                                                         len p2 g k))))))
          ((eq (nth 5 op) :loopm)
           (let ((memo (rontolisp::%clojure-re-loop-memo op g len)))
             (if (svref memo pos)
                 (funcall k pos)
                 (or (rontolisp::%clojure-re-match unit s len pos g
                      (lambda (p2)
                        (rontolisp::%clojure-re-loop-next op (+ count 1) pos s
                                                          len p2 g k)))
                     (progn
                       (setf (svref memo pos) t)
                       (funcall k pos))))))
          (t (or (and (or (null hi) (< count hi))
                      (rontolisp::%clojure-re-match unit s len pos g
                       (lambda (p2)
                         (rontolisp::%clojure-re-loop-next op (+ count 1) pos s
                                                           len p2 g k))))
                 (funcall k pos))))))

(defun rontolisp::%clojure-re-groups-of (p anchor cell)
  "A fresh group vector for the pattern P: no group has matched, no loop
   memoized, \\G holding at ANCHOR (the oracle's oldLast), the matcher's last
   the car of CELL, the matcher's cell (%clojure-re-set-last). Slot 1, unused
   by any group, holds the loops' memos and those two under :glast and
   :last."
  (let ((g
         (make-array (* 2 (+ (rontolisp::%clojure-re-pat-ngroups p) 1))
                     :initial-element -1)))
    (setf (svref g 1) (list (cons :glast anchor) (cons :last cell)))
    g))

;; The oracle's Matcher.last is no constant of a search: the accept node ending
;; the chain of a Curly's or a Ques's atom, of a lookahead and of an independent
;; group sets it to where that chain ended (Curly and Ques read the atom's end
;; back from it), and so does a group's tail where GroupCurly iterates its body.
;; GraphemeBound (\b{g}) reads it as it stands, and a search that fails, or that
;; throws, leaves it where it was last set: the next find() starts there and \G
;; holds there. So the search moves the matcher's own: the car of its cell.
(defun rontolisp::%clojure-re-set-last (g pos)
  "Make POS the matcher's last in the search of the group vector G."
  (rplaca (cdr (assoc :last (svref g 1))) pos))

(defun rontolisp::%clojure-re-last-of (g)
  "The matcher's last in the search of the group vector G."
  (car (cdr (assoc :last (svref g 1)))))

(defun rontolisp::%clojure-re-search (p s len from g)
  "The leftmost match of the pattern P in S (LEN long) at or past FROM, over
   the fresh group vector G: (start end groups), GROUPS being G, or NIL. G
   marks whether the search read where S ends: one that tried every start
   position did, since more input brings more of them (the oracle's Start
   node). The groups start empty once per search, not per start position,
   like the oracle's."
  (let ((ops (rontolisp::%clojure-re-pat-ops p)))
    (do ((pos from (+ pos 1)) (found nil))
        ((or found (> pos len))
         (if (null found) (rontolisp::%clojure-re-hit-end g))
         found)
      (let ((end
             (rontolisp::%clojure-re-match ops s len pos g (lambda (end) end))))
        (if end (setq found (list pos end g)))))))

(defun rontolisp::%clojure-re-match-at-start (p s whole anchor)
  "The match of the pattern P at the start of S, the whole of it when WHOLE,
   \\G holding at ANCHOR: (0 end groups), or NIL."
  (rontolisp::%clojure-re-anchored p s (length s) whole
   (rontolisp::%clojure-re-groups-of p anchor (cons anchor nil))))

(defun rontolisp::%clojure-re-anchored (p s len whole g)
  "The match of the pattern P at the start of S (LEN long), the whole of it
   when WHOLE, over the fresh group vector G, which marks whether the match
   read where S ends: a whole match ending at LEN reads it, since more input
   would leave it short."
  (let ((end
         (rontolisp::%clojure-re-match (rontolisp::%clojure-re-pat-ops p) s len
                                       0 g
                                       (lambda (end)
                                         (cond ((not whole) end)
                                               ((= end len)
                                                (rontolisp::%clojure-re-hit-end
                                                 g)
                                                end)
                                               (t nil))))))
    (if end (list 0 end g) nil)))

(defun rontolisp::%clojure-re-group-span (found n)
  "The (start . end) the group N of the match FOUND took, NIL for one that
   took no part."
  (if (= n 0)
      (cons (car found) (car (cdr found)))
      (let ((g (car (cdr (cdr found)))) (i (* 2 n)))
        (if (or (>= (+ i 1) (length g)) (< (svref g i) 0))
            nil
            (cons (svref g i) (svref g (+ i 1)))))))

(defun rontolisp::%clojure-re-next (m)
  "The matcher's next match: (start end groups), or NIL. An empty match
   advances one character past itself, like the oracle. The cell's car is the
   oracle's last: where the last match ended (0 before any), or where a failed
   search left it (%clojure-re-set-last), so \\G holds there and a find after a
   failed one searches from there, as the oracle's does. Past an empty match
   at the end the oracle searches no more and keeps that match's bounds with
   no group: the cell's cdr is then (end end nil), which no reader takes for a
   match."
  (rontolisp::%clojure-re-next-from m nil))

(defun rontolisp::%clojure-re-next-from (m start)
  "%clojure-re-next, or under START the search of find(int) after its reset:
   from START, where \\G holds."
  (let ((cell (rontolisp::%clojure-re-match-cell m))
        (input (rontolisp::%clojure-re-match-input m))
        (pat (rontolisp::%clojure-re-match-pat m)))
    (let ((len
           ;; a CharSequence type's whole length, of which INPUT is the prefix
           ;; read so far: an arm of the char-sequence family
           (if (rontolisp::%clojure-re-lazy-p m)
               (rontolisp::%clojure-re-lazy-length m)
               (length input)))
          (pos (car cell))
          (last (cdr cell)))
      (if (and (null start) (> pos len))
          nil
          (let ((from
                 (cond (start start)
                       ((and last (= (car last) (car (cdr last)))) (+ pos 1))
                       (t pos))))
            (if (> from len)
                (progn
                  (rplacd cell (list pos pos nil))
                  nil)
                (let ((found
                       (if (rontolisp::%clojure-re-lazy-p m)
                           (rontolisp::%clojure-re-lazy-search m from
                            :find (or start pos))
                           (rontolisp::%clojure-re-search pat input len from
                            (rontolisp::%clojure-re-groups-of pat (or start pos)
                                                              cell)))))
                  (if (null found)
                      (progn
                        (rplacd cell nil)
                        nil)
                      (progn
                        (rplaca cell (car (cdr found)))
                        (rplacd cell found)
                        found)))))))))

(defun rontolisp::%clojure-re-last-match (m)
  "The matcher M's last match, (start end groups), or NIL: before any, after a
   failed one and past an empty one at the end."
  (let ((last (cdr (rontolisp::%clojure-re-match-cell m))))
    (if (and last (car (cdr (cdr last)))) last nil)))

(defun rontolisp::%clojure-re-group-strings (s found n i)
  "The strings of the groups I..N of the match FOUND (NIL for one that took no
   part)."
  (if (> i n)
      nil
      (cons (let ((span (rontolisp::%clojure-re-group-span found i)))
              (if (null span) nil (subseq s (car span) (cdr span))))
            (rontolisp::%clojure-re-group-strings s found n (+ i 1)))))

(defun rontolisp::%clojure-re-value (s found ngroups)
  "The match value for (start end groups) FOUND: the string without groups, a
   vector of the whole plus every group (NIL past no match) with them."
  (let ((start (car found)) (end (car (cdr found))))
    (if (= ngroups 0)
        (subseq s start end)
        (coerce (cons (subseq s start end)
                      (rontolisp::%clojure-re-group-strings s found ngroups 1))
                'vector))))

(defun rontolisp::%clojure-re-compile (source &optional charnames)
  "The pattern value for the SOURCE string (parsed eagerly, like the oracle).
   CHARNAMES: the (:names (name . code) ...) the lowering looked a literal's
   \\N{name} escapes up to, NIL for a source made at run time."
  (if (not (stringp source))
      (rontolisp::%clojure-class-cast-exception-of
       "re-pattern takes a pattern or a string" source)
      (let ((parsed (rontolisp::%clojure-re-parse source charnames)))
        (list :C%PATTERN (gensym "re") source (car parsed) (car (cdr parsed))
              (car (cdr (cdr parsed)))))))

(defun rontolisp::%clojure-re-pattern (x)
  "The pattern for X: itself for a pattern, compiled for a string."
  (rontolisp::%clojure-re-as-pattern
   (if (stringp x) (rontolisp::%clojure-re-compile x) x)
   "re-pattern takes a pattern or a string"))

(defun rontolisp::%clojure-string-value-of (x)
  "String/valueOf of one value: its toString; nil the NullPointerException the
   oracle's reflector meets, choosing valueOf(char[]) for it."
  (if (null x)
      (rontolisp::%clojure-null-pointer-exception
       "Cannot read the array length because \"value\" is null")
      (rontolisp::%clojure-str-of x "" nil)))

(defun rontolisp::%clojure-pattern-quote (s)
  "Pattern/quote: the source matching the string S literally, as Java spells
   it -- S inside \\Q...\\E, each \\E of S closed and reopened around an
   escaped one."
  (if (not (stringp s))
      (rontolisp::%clojure-class-cast-exception-of
       "Pattern/quote takes a string" s)
      (let ((out "\\Q") (from 0) (at (search "\\E" s)))
        (do ()
            ((null at))
          (setq out (concatenate 'string out (subseq s from at) "\\E\\\\E\\Q"))
          (setq from (+ at 2))
          (setq at (search "\\E" s :start2 from)))
        (concatenate 'string out (subseq s from) "\\E"))))

(defun rontolisp::%clojure-pattern-matches (regex input)
  "Pattern/matches: whether the regex source REGEX matches the whole of INPUT, a
   string or a type implementing CharSequence (read through its toString)."
  (if (rontolisp::%clojure-re-matches (rontolisp::%clojure-re-pattern regex)
       (if (stringp input) input (rontolisp::%clojure-str-of input "" nil)))
      t
      rontolisp::%clojure-false))

(defun rontolisp::%clojure-re-matcher (pat s)
  "A matcher of the pattern PAT over the string S (a pattern only, like the
   oracle), or over a type implementing CharSequence, read only as far as a
   match needs it."
  (let ((p
         (rontolisp::%clojure-re-as-pattern pat
          "re-matcher takes a pattern and a string")))
    (cond ((stringp s) (list :C%MATCHER (gensym "re") p s (cons 0 nil)))
          ;; an arm of the char-sequence family ("Host interfaces")
          ((rontolisp::%clojure-char-sequence-p s)
           (rontolisp::%clojure-re-lazy-matcher p s))
          (t (rontolisp::%clojure-class-cast-exception-of
              "re-matcher takes a pattern and a string" s)))))

(defun rontolisp::%clojure-re-find (pat s)
  "The first match of PAT in S, or NIL."
  (let ((p
         (rontolisp::%clojure-re-as-pattern pat
          "re-find takes a matcher, or a pattern and a string")))
    (cond ((stringp s)
           (let ((m (list :C%MATCHER (gensym "re") p s (cons 0 nil))))
             (let ((found (rontolisp::%clojure-re-next m)))
               (if (null found)
                   nil
                   (rontolisp::%clojure-re-value s found
                    (rontolisp::%clojure-re-pat-ngroups p))))))
          ;; a type implementing CharSequence, read as far as the first match: an
          ;; arm of the char-sequence family ("Host interfaces")
          ((rontolisp::%clojure-char-sequence-p s)
           (rontolisp::%clojure-re-find-m
            (rontolisp::%clojure-re-lazy-matcher p s)))
          (t (rontolisp::%clojure-class-cast-exception-of
              "re-find takes a matcher, or a pattern and a string" s)))))

;; A matcher over a type implementing CharSequence reads its characters only as
;; far as a match needs them, as the oracle's Matcher reads charAt: its INPUT is
;; the prefix read so far and its sixth slot (type . length) what the prefix is
;; read from. A search runs over the prefix; one that read where the prefix ends
;; (%clojure-re-hit-end) runs again over a prefix twice as long, until it did not
;; or the prefix is the whole input, and so answers what a search over the whole
;; input answers. instaparse's terminals, (re-matcher re (sub-sequence text i))
;; then .lookingAt, read a few characters each where the whole rest of the text
;; was read through charAt before.

(defun rontolisp::%clojure-re-lazy-matcher (p cs)
  "A matcher of the pattern P over the CharSequence type CS, its length read
   now (the oracle's Matcher reads it on reset) and no character yet."
  (list :C%MATCHER (gensym "re") p "" (cons 0 nil)
        (cons cs (rontolisp::%clojure-char-sequence-length cs))))

(defun rontolisp::%clojure-re-lazy-p (m)
  "Whether the matcher M reads a CharSequence type as it goes: the test of
   the char-sequence family's arms in the matcher verbs."
  (if (cdr (cdr (cdr (cdr (cdr m))))) t nil))

(defun rontolisp::%clojure-re-lazy-length (m)
  "The length of the CharSequence type the lazy matcher M reads."
  (cdr (car (cdr (cdr (cdr (cdr (cdr m))))))))

(defun rontolisp::%clojure-re-lazy-grow (m need)
  "The lazy matcher M's prefix, read on when it is shorter than NEED
   characters: to NEED and at least twice its length (16 from none), at most
   the whole input; stored in M and answered."
  (let* ((s (rontolisp::%clojure-re-match-input m))
         (source (car (cdr (cdr (cdr (cdr (cdr m)))))))
         (have (length s))
         (want (max need (if (= have 0) 16 (* 2 have)))))
    (if (> want (cdr source)) (setq want (cdr source)))
    (if (or (>= have need) (<= want have))
        s
        (let ((out (make-string want))
              (char-at
               (rontolisp::%clojure-interface-entry (car source) "charAt")))
          (replace out s)
          (do ((i have (+ i 1)))
              ((>= i want))
            (let ((c (funcall char-at (car source) i)))
              (if (characterp c)
                  (setf (char out i) c)
                  (rontolisp::%clojure-class-cast-exception
                   "the answer of charAt cannot be cast to class java.lang.Character"))))
          (rplaca (cdr (cdr (cdr m))) out)
          out))))

(defun rontolisp::%clojure-re-lazy-search (m from whole anchor)
  "The match of the lazy matcher M over its whole input: the leftmost at or
   past FROM when WHOLE is :find, else the one at the start (the whole input
   when WHOLE is true), each over a prefix grown until the search no longer
   reads its end; \\G holds at ANCHOR. Each search over a prefix starts from
   the matcher's last as it stood (the car of its cell, which a search
   moves)."
  (let* ((p (rontolisp::%clojure-re-match-pat m))
         (total (rontolisp::%clojure-re-lazy-length m))
         (cell (rontolisp::%clojure-re-match-cell m))
         (last (car cell))
         (found nil)
         (done nil))
    (rontolisp::%clojure-re-lazy-grow m (max from 1))
    (do ()
        (done found)
      (let* ((s (rontolisp::%clojure-re-match-input m))
             (len (length s))
             (g (rontolisp::%clojure-re-groups-of p anchor cell)))
        (rplaca cell last)
        (setf (svref g 1) (cons (cons :total total) (svref g 1)))
        (setq found
              (if (eq whole :find)
                  (rontolisp::%clojure-re-search p s len from g)
                  (rontolisp::%clojure-re-anchored p s len whole g)))
        (if (and (eq (svref g 0) t) (< len total))
            (rontolisp::%clojure-re-lazy-grow m (+ len 1))
            (setq done t))))))

(defun rontolisp::%clojure-re-find-m (m)
  "The matcher's next match, or NIL."
  (if (not (rontolisp::%clojure-re-matcher-p m))
      (rontolisp::%clojure-class-cast-exception-of
       "re-find takes a matcher, or a pattern and a string" m)
      (let ((found (rontolisp::%clojure-re-next m)))
        (if (null found)
            nil
            (rontolisp::%clojure-re-value (rontolisp::%clojure-re-match-input m)
                                          found
                                          (rontolisp::%clojure-re-pat-ngroups
                                           (rontolisp::%clojure-re-match-pat
                                            m)))))))

(defun rontolisp::%clojure-re-seq (pat s)
  "Every match of PAT in S as a strict list (the oracle answers lazy, which
   prints the same)."
  (let ((p
         (rontolisp::%clojure-re-as-pattern pat
          "re-seq takes a pattern and a string")))
    (if (not (stringp s))
        (rontolisp::%clojure-class-cast-exception-of
         "re-seq takes a pattern and a string" s)
        (let ((m (list :C%MATCHER (gensym "re") p s (cons 0 nil)))
              (ngroups (rontolisp::%clojure-re-pat-ngroups p)))
          (do ((found
                (rontolisp::%clojure-re-next m)
                (rontolisp::%clojure-re-next m))
               (acc nil))
              ((null found) (reverse acc))
            (setq acc
             (cons (rontolisp::%clojure-re-value s found ngroups) acc)))))))

(defun rontolisp::%clojure-re-matches (pat s)
  "The whole-string match of PAT against S, or NIL."
  (let ((p
         (rontolisp::%clojure-re-as-pattern pat
          "re-matches takes a pattern and a string")))
    (if (not (stringp s))
        (rontolisp::%clojure-class-cast-exception-of
         "re-matches takes a pattern and a string" s)
        (let ((hit (rontolisp::%clojure-re-match-at-start p s t 0)))
          (if (null hit)
              nil
              (rontolisp::%clojure-re-value s hit
               (rontolisp::%clojure-re-pat-ngroups p)))))))

(defun rontolisp::%clojure-re-groups (m)
  "The last match's groups as a vector (the whole first), or a signal past no
   match, like the oracle."
  (if (not (rontolisp::%clojure-re-matcher-p m))
      (rontolisp::%clojure-class-cast-exception-of "re-groups takes a matcher"
                                                   m)
      (let ((last (rontolisp::%clojure-re-last-match m)))
        (if (null last)
            (rontolisp::%clojure-illegal-state-exception "No match found")
            (rontolisp::%clojure-re-value (rontolisp::%clojure-re-match-input m)
                                          last
                                          (rontolisp::%clojure-re-pat-ngroups
                                           (rontolisp::%clojure-re-match-pat
                                            m)))))))

;; The matcher family's test (clojure/ClojureArms): the arm of a verb that must
;; read a matcher asks it ahead of its fall-through, and a program naming no
;; re-matcher, where no matcher exists, folds the arm away.
(defun rontolisp::%clojure-matcher-value-p (x)
  "Whether X is a matcher: the test of the matcher family's arms."
  (rontolisp::%clojure-re-matcher-p x))

;; (nth m i dflt) over a matcher M: Matcher.group(I) of its last match, nil for
;; a group that took no part, an IllegalStateException past no match. An index
;; the pattern has no group for (below zero or past its group count) answers
;; DFLT, where the oracle throws IndexOutOfBoundsException unless it is given a
;; default (nth answers its default past the end, "Deviations"). The oracle's
;; three-argument nth reads no group at all of a pattern without groups, and the
;; call without a default shares a shape with a nil default here, so only a
;; non-nil default tells them apart.
(defun rontolisp::%clojure-matcher-nth (m i dflt)
  (let ((g
         (rontolisp::%clojure-re-pat-ngroups
          (rontolisp::%clojure-re-match-pat m))))
    (if (or (< i 0) (> i g) (and (= g 0) dflt))
        dflt
        (let ((last (rontolisp::%clojure-re-last-match m))
              (s (rontolisp::%clojure-re-match-input m)))
          (cond ((null last)
                 (rontolisp::%clojure-illegal-state-exception "No match found"))
                ((= i 0) (subseq s (car last) (car (cdr last))))
                (t (car (rontolisp::%clojure-re-group-strings s last i i))))))))

(defun rontolisp::%clojure-re-fresh-matcher (p s)
  "A matcher of the pattern value P over S."
  (list :C%MATCHER (gensym "re") p s (cons 0 nil)))

;; Matcher methods: java.util.regex.Matcher's own methods on a matcher, the
;; instance calls of the matcher family's arm (clojure/ClojureValueMethodLowering).
;; find, lookingAt and matches record their match in the matcher's cell the way
;; re-find does -- the next find starts at its end, one past an empty one -- and a
;; failed one forgets the last match but not where the next find starts, like the
;; oracle's first/last pair; group, start and end read the match back, the oracle's
;; IllegalStateException without one and IndexOutOfBoundsException past the
;; pattern's groups; reset starts over. A boolean answers T or the false object.

(defun rontolisp::%clojure-matcher-find (m)
  "Matcher.find(): the next match, recorded."
  (if (rontolisp::%clojure-re-next m) t rontolisp::%clojure-false))

(defun rontolisp::%clojure-matcher-find-from (m start)
  "Matcher.find(int): the matcher reset, then a match searched from START
   (where \\G holds), the oracle's IndexOutOfBoundsException outside the
   input. A failed one leaves the next find at the start, as the reset did."
  (if (or (not (integerp start)) (< start 0)
          (> start
             (if (rontolisp::%clojure-re-lazy-p m)
                 (rontolisp::%clojure-re-lazy-length m)
                 (length (rontolisp::%clojure-re-match-input m)))))
      (rontolisp::%clojure-index-out-of-bounds-exception "Illegal start index")
      (let ((cell (rontolisp::%clojure-re-match-cell m)))
        (rplaca cell 0)
        (rplacd cell nil)
        (if (rontolisp::%clojure-re-next-from m start)
            t
            rontolisp::%clojure-false))))

(defun rontolisp::%clojure-matcher-anchored (m whole)
  "Matcher.lookingAt() (a match at the input's start) and, under WHOLE,
   Matcher.matches() (one spanning the whole input): the match recorded."
  (let* ((cell (rontolisp::%clojure-re-match-cell m))
         (found
          ;; a CharSequence type read as far as the match needs: an arm of the
          ;; char-sequence family
          (if (rontolisp::%clojure-re-lazy-p m)
              (rontolisp::%clojure-re-lazy-search m 0 whole (car cell))
              (let ((s (rontolisp::%clojure-re-match-input m))
                    (p (rontolisp::%clojure-re-match-pat m)))
                (rontolisp::%clojure-re-anchored p s (length s) whole
                 (rontolisp::%clojure-re-groups-of p (car cell) cell))))))
    (if found
        (progn
          (rplaca cell (car (cdr found)))
          (rplacd cell found)
          t)
        (progn
          (rplacd cell nil)
          rontolisp::%clojure-false))))

(defun rontolisp::%clojure-matcher-looking-at (m)
  "Matcher.lookingAt()."
  (rontolisp::%clojure-matcher-anchored m nil))

(defun rontolisp::%clojure-matcher-matches (m)
  "Matcher.matches()."
  (rontolisp::%clojure-matcher-anchored m t))

(defun rontolisp::%clojure-matcher-range (m n)
  "The (start . end) group N (a number or a group name) of matcher M's last
   match spans, (-1 . -1) for one that took no part; the oracle's refusals
   without a match, past the pattern's groups or for a name it lacks."
  (let ((last (rontolisp::%clojure-re-last-match m)))
    (cond ((null last)
           (rontolisp::%clojure-illegal-state-exception "No match found"))
          ((stringp n)
           (let ((idx
                  (rontolisp::%clojure-re-name-lookup n
                   (rontolisp::%clojure-re-pat-names
                    (rontolisp::%clojure-re-match-pat m)))))
             (if (null idx)
                 (rontolisp::%clojure-illegal-argument-exception
                  (concatenate 'string "No group with name <" n ">"))
                 (rontolisp::%clojure-matcher-range m idx))))
          ((not (integerp n))
           (rontolisp::%clojure-illegal-argument-exception
            "No matching method takes a group that is no int"))
          ((or (< n 0)
               (> n
                  (rontolisp::%clojure-re-pat-ngroups
                   (rontolisp::%clojure-re-match-pat m))))
           (rontolisp::%clojure-index-out-of-bounds-exception
            (concatenate 'string "No group "
                         (rontolisp::%clojure-re-decimal n))))
          (t (or (rontolisp::%clojure-re-group-span last n) (cons -1 -1))))))

(defun rontolisp::%clojure-matcher-group (m n)
  "Matcher.group(int), group(String): the text the group N (a number or a
   name) took, nil for one that took no part."
  (let ((r (rontolisp::%clojure-matcher-range m n)))
    (if (< (car r) 0)
        nil
        (subseq (rontolisp::%clojure-re-match-input m) (car r) (cdr r)))))

(defun rontolisp::%clojure-matcher-start (m n)
  "Matcher.start(int), start(String): where group N began, -1 for one that
   took no part."
  (car (rontolisp::%clojure-matcher-range m n)))

(defun rontolisp::%clojure-matcher-end (m n)
  "Matcher.end(int), end(String): where group N ended, -1 for one that took
   no part."
  (cdr (rontolisp::%clojure-matcher-range m n)))

(defun rontolisp::%clojure-matcher-group-count (m)
  "Matcher.groupCount(): the pattern's capturing groups."
  (rontolisp::%clojure-re-pat-ngroups (rontolisp::%clojure-re-match-pat m)))

(defun rontolisp::%clojure-matcher-reset (m)
  "Matcher.reset(): the matcher with no match, its next find from the start."
  (let ((cell (rontolisp::%clojure-re-match-cell m)))
    (rplaca cell 0)
    (rplacd cell nil)
    m))

(defun rontolisp::%clojure-matcher-pattern (m)
  "Matcher.pattern(): the matcher's pattern."
  (rontolisp::%clojure-re-match-pat m))

(defun rontolisp::%clojure-re-drop-empty (xs)
  "XS past its leading empty strings (trailing empties drop reversed)."
  (if (and xs (stringp (car xs)) (string= (car xs) ""))
      (rontolisp::%clojure-re-drop-empty (cdr xs))
      xs))

(defun rontolisp::%clojure-re-split-loop (m s len lim index count acc)
  "The split parts, reversed: every match cuts, a positive LIM caps (the last
   part holding the rest), and a zero-width match at the start cuts nothing
   (the oracle skips the leading empty the same way)."
  (if (and (integerp lim) (> lim 0) (= count (- lim 1)))
      (reverse (cons (subseq s index len) acc))
      (let ((found (rontolisp::%clojure-re-next m)))
        (if (null found)
            (reverse (cons (subseq s index len) acc))
            (let ((fs (car found)) (fe (car (cdr found))))
              (if (and (= index 0) (= fs 0) (= fe 0))
                  (rontolisp::%clojure-re-split-loop m s len lim index count
                                                     acc)
                  (rontolisp::%clojure-re-split-loop m s len lim fe (+ count 1)
                   (cons (subseq s index fs) acc))))))))

(defun rontolisp::%clojure-re-split (pat s lim)
  "S cut around the pattern PAT as a strict list: an empty input answers one
   empty part, a positive LIM caps, any other limit keeps every part but the
   trailing empties (like the literal arm)."
  (let ((p
         (rontolisp::%clojure-re-as-pattern pat
          "split takes a string and a pattern")))
    (if (not (stringp s))
        (rontolisp::%clojure-class-cast-exception-of
         "split takes a string and a pattern" s)
        (if (= (length s) 0)
            (list "")
            (let ((parts
                   (rontolisp::%clojure-re-split-loop
                    (rontolisp::%clojure-re-fresh-matcher p s) s (length s) lim
                    0 0 nil)))
              (if (and (integerp lim) (not (= lim 0)))
                  parts
                  (reverse
                   (rontolisp::%clojure-re-drop-empty (reverse parts)))))))))

(defun rontolisp::%clojure-re-found-span (found n ngroups)
  "The (start . end) the group N of the match FOUND spans, NIL for one that
   took no part; past the NGROUPS groups the oracle's refusal."
  (cond ((or (< n 0) (> n ngroups))
         (rontolisp::%clojure-index-out-of-bounds-exception
          (concatenate 'string "No group " (rontolisp::%clojure-re-decimal n))))
        (t (rontolisp::%clojure-re-group-span found n))))

(defun rontolisp::%clojure-re-group-ref (repl i p)
  "The group a $ reference at I of the replacement REPL names (past the $),
   as Matcher.appendReplacement reads it: ${name} a named group of the
   pattern P, else a digit and the digits after it while a group of the
   number they make exists. (group . index past the reference), or the
   oracle's IllegalArgumentException."
  (let ((n (length repl)) (d (char-code (char repl i))))
    (if (= d 123)
        (let ((j (+ i 1)) (next d))
          (do ()
              ((or (>= j n)
                   (not
                    (rontolisp::%clojure-re-alpha-code-p
                     (setq next (char-code (char repl j)))))))
            (setq j (+ j 1)))
          (if (= j (+ i 1))
              (rontolisp::%clojure-illegal-argument-exception
               "named capturing group has 0 length name"))
          (if (not (= next 125))
              (rontolisp::%clojure-illegal-argument-exception
               "named capturing group is missing trailing '}'"))
          (let ((name (subseq repl (+ i 1) j)))
            (if (rontolisp::%clojure-re-digit-code-p (char-code (char name 0)))
                (rontolisp::%clojure-illegal-argument-exception
                 (concatenate 'string "capturing group name {" name
                              "} starts with digit character")))
            (let ((idx
                   (rontolisp::%clojure-re-name-lookup name
                    (rontolisp::%clojure-re-pat-names p))))
              (if (null idx)
                  (rontolisp::%clojure-illegal-argument-exception
                   (concatenate 'string "No group with name {" name "}")))
              (cons idx (+ j 1)))))
        (if (not (rontolisp::%clojure-re-digit-code-p d))
            (rontolisp::%clojure-illegal-argument-exception
             "Illegal group reference")
            (let ((ref (- d 48))
                  (j (+ i 1))
                  (done nil)
                  (ngroups (rontolisp::%clojure-re-pat-ngroups p)))
              (do ()
                  ((or done (>= j n)))
                (let ((e (char-code (char repl j))))
                  (if (and (rontolisp::%clojure-re-digit-code-p e)
                           (<= (+ (* ref 10) (- e 48)) ngroups))
                      (progn
                        (setq ref (+ (* ref 10) (- e 48)))
                        (setq j (+ j 1)))
                      (setq done t))))
              (cons ref j))))))

(defun rontolisp::%clojure-re-interpolate (repl s found p)
  "The replacement string REPL for the match FOUND of the pattern P, as the
   oracle's Matcher.appendReplacement expands it: \\ quotes the character
   after it, $n and ${name} are a group's text (none for one that took no
   part)."
  (let ((out (make-string-output-stream))
        (n (length repl))
        (i 0)
        (ngroups (rontolisp::%clojure-re-pat-ngroups p)))
    (do ()
        ((>= i n) (get-output-stream-string out))
      (let ((c (char-code (char repl i))))
        (cond ((= c 92)
               (if (= (+ i 1) n)
                   (rontolisp::%clojure-illegal-argument-exception
                    "character to be escaped is missing"))
               (write-char (char repl (+ i 1)) out)
               (setq i (+ i 2)))
              ((= c 36)
               (if (= (+ i 1) n)
                   (rontolisp::%clojure-illegal-argument-exception
                    "Illegal group reference: group index is missing"))
               (let* ((ref (rontolisp::%clojure-re-group-ref repl (+ i 1) p))
                      (span
                       (rontolisp::%clojure-re-found-span found (car ref)
                                                          ngroups)))
                 (if span (write-string (subseq s (car span) (cdr span)) out))
                 (setq i (cdr ref))))
              (t
               (write-char (char repl i) out)
               (setq i (+ i 1))))))))

(defun rontolisp::%clojure-re-replacement (rep)
  "REP as %clojure-re-subst takes it: a string as itself, anything else as a
   real function (through the IFn dispatcher unless it is one)."
  (if (stringp rep) rep (rontolisp::%clojure-as-fn rep)))

(defun rontolisp::%clojure-re-subst (rep s found p)
  "The substitution for FOUND of the pattern P: a string interpolates, the
   real function REP applies through str (like the oracle's function arm,
   whose NIL is \"\")."
  (if (stringp rep)
      (rontolisp::%clojure-re-interpolate rep s found p)
      (rontolisp::%clojure-str-of (funcall rep
                                           (rontolisp::%clojure-re-value s found
                                            (rontolisp::%clojure-re-pat-ngroups
                                             p))) "" nil)))

(defun rontolisp::%clojure-re-replace (s pat rep once)
  "S with the pattern PAT swapped for REP: every match, or the first for ONCE.
   A string replacement interpolates $ groups (re-quote-replacement quotes
   them); anything else applies to the match through str."
  (let ((p
         (rontolisp::%clojure-re-as-pattern pat
          "replace takes a string, a match and a replacement")))
    (if (not (stringp s))
        (rontolisp::%clojure-class-cast-exception-of
         "replace takes a string, a match and a replacement" s)
        (let ((m (rontolisp::%clojure-re-fresh-matcher p s)) (len (length s)))
          (if once
              (let ((found (rontolisp::%clojure-re-next m)))
                (if (null found)
                    s
                    (let ((out (make-string-output-stream)))
                      (write-string (subseq s 0 (car found)) out)
                      (write-string (rontolisp::%clojure-re-subst rep s found p)
                                    out)
                      (write-string (subseq s (car (cdr found)) len) out)
                      (get-output-stream-string out))))
              (let ((out (make-string-output-stream)))
                (do ((found
                      (rontolisp::%clojure-re-next m)
                      (rontolisp::%clojure-re-next m))
                     (pos 0))
                    ((null found)
                     (write-string (subseq s pos len) out)
                     (get-output-stream-string out))
                  (write-string (subseq s pos (car found)) out)
                  (write-string (rontolisp::%clojure-re-subst rep s found p)
                                out)
                  (setq pos (car (cdr found))))))))))

;;;; The core backlog.
;;
;; The backlog verbs follow the lazy rows above: a lazy input answers a lazy
;; wrapper, a strict one a strict list (nil, never ()); dedupe and partition-by
;; compare with %clojure-equal. Each verb has a fixed-parameter worker the call
;; lowering calls after its own arity check and a -v entry the value lowering
;; names, which checks the count at run time with the oracle's wording. pmap is map (single-threaded, no entry of its own).

(defun rontolisp::%clojure-arity-error (n name)
  "Signal the oracle's arity error for the core fn NAME called with N args."
  (rontolisp::%clojure-arity-exception
   (format nil "Wrong number of args (~D) passed to: clojure.core/~A" n name)))

(defun rontolisp::%clojure-check-arity (args min max name)
  "The count of ARGS, or the oracle's arity error when it falls outside MIN..MAX
   (a nil MAX has no upper bound)."
  (let ((n (length args)))
    (if (or (< n min) (and max (> n max)))
        (rontolisp::%clojure-arity-error n name)
        n)))

(defun rontolisp::%clojure-truthy (v)
  "Whether V is truthy the Clojure way: neither nil nor the false object."
  (not (or (null v) (eq v rontolisp::%clojure-false))))

(defun rontolisp::%clojure-lazy-or-strict (coll lazy)
  "LAZY (a wrapper) when COLL is lazy, LAZY realized to a strict list otherwise."
  (if (rontolisp::%clojure-lazy-input-p coll)
      lazy
      (rontolisp::%clojure-realize-all lazy)))

(defun rontolisp::%clojure-drop-last (n coll)
  "COLL without its last N members (the oracle's map over COLL and its drop)."
  (rontolisp::%clojure-map (lambda (x y)
                             (declare (ignore y))
                             x) (list coll (rontolisp::%clojure-drop n coll))))

(defun rontolisp::%clojure-drop-last-v (&rest args)
  "drop-last as a value: [coll] or [n coll]."
  (if (= (rontolisp::%clojure-check-arity args 1 2 "drop-last") 1)
      (rontolisp::%clojure-drop-last 1 (car args))
      (rontolisp::%clojure-drop-last (car args) (car (cdr args)))))

(defun rontolisp::%clojure-split-at (n coll)
  "[(take n coll) (drop n coll)]."
  (vector (rontolisp::%clojure-take n coll) (rontolisp::%clojure-drop n coll)))

(defun rontolisp::%clojure-split-at-v (&rest args)
  "split-at as a value."
  (rontolisp::%clojure-check-arity args 2 2 "split-at")
  (rontolisp::%clojure-split-at (car args) (car (cdr args))))

(defun rontolisp::%clojure-split-with (pred coll)
  "[(take-while pred coll) (drop-while pred coll)] in one walk."
  (let ((s (rontolisp::%clojure-seq coll)) (acc nil))
    (do ()
        ((or (null s) (not (rontolisp::%clojure-filter-test pred (car s))))
         (vector (reverse acc) s))
      (setq acc (cons (car s) acc))
      (setq s (rontolisp::%clojure-seq (cdr s))))))

(defun rontolisp::%clojure-split-with-v (&rest args)
  "split-with as a value."
  (rontolisp::%clojure-check-arity args 2 2 "split-with")
  (rontolisp::%clojure-split-with (rontolisp::%clojure-as-fn (car args))
                                  (car (cdr args))))

(defun rontolisp::%clojure-take-last (n coll)
  "The last N members of COLL as a strict list (nil when none), walking a
   lead N ahead like the oracle."
  (let ((s (rontolisp::%clojure-seq coll))
        (lead (rontolisp::%clojure-seq (rontolisp::%clojure-drop n coll))))
    (do ()
        ((null lead) (rontolisp::%clojure-realize-all s))
      (setq s (rontolisp::%clojure-seq (cdr s)))
      (setq lead (rontolisp::%clojure-seq (cdr lead))))))

(defun rontolisp::%clojure-take-last-v (&rest args)
  "take-last as a value."
  (rontolisp::%clojure-check-arity args 2 2 "take-last")
  (rontolisp::%clojure-take-last (car args) (car (cdr args))))

(defun rontolisp::%clojure-nthnext (coll n)
  "The seq of COLL past its first N members, nil when nothing is left."
  (let ((s (rontolisp::%clojure-seq coll)) (left n))
    (do ()
        ((or (null s) (not (> left 0))) s)
      (setq s (rontolisp::%clojure-seq (cdr s)))
      (setq left (- left 1)))))

(defun rontolisp::%clojure-nthnext-v (&rest args)
  "nthnext as a value."
  (rontolisp::%clojure-check-arity args 2 2 "nthnext")
  (rontolisp::%clojure-nthnext (car args) (car (cdr args))))

(defun rontolisp::%clojure-nthrest (coll n)
  "COLL itself for a non-positive N, else the rest past its first N members
   (nil once it runs out, the oracle's ())."
  (let ((xs coll) (left n) (done nil))
    (do ()
        (done xs)
      (if (> left 0)
          (let ((s (rontolisp::%clojure-seq xs)))
            (if (null s)
                (progn
                  (setq xs nil)
                  (setq done t))
                (progn
                  (setq xs (cdr s))
                  (setq left (- left 1)))))
          (setq done t)))))

(defun rontolisp::%clojure-nthrest-v (&rest args)
  "nthrest as a value."
  (rontolisp::%clojure-check-arity args 2 2 "nthrest")
  (rontolisp::%clojure-nthrest (car args) (car (cdr args))))

(defun rontolisp::%clojure-stack-p (x)
  "Whether X is a stack for peek/pop: a non-string vector or a plain list (a
   cons headed by no wrapper tag; every wrapper starts with a keyword)."
  (or (and (vectorp x) (not (stringp x)))
      (and (consp x) (not (keywordp (car x))))))

;; peek and pop of a type implementing IPersistentStack call its methods: arms of
;; the stack-interface family ("Collection interfaces").
(defun rontolisp::%clojure-peek (coll)
  "A vector's last member, a list's first, nil of nil or an empty vector."
  (cond ((null coll) nil)
   ((rontolisp::%clojure-istack-p coll) (rontolisp::%clojure-istack-peek coll))
   ((not (rontolisp::%clojure-stack-p coll))
    (rontolisp::%clojure-class-cast-exception-of "peek needs a vector or a list"
                                                 coll))
   ((consp coll) (car coll))
   ((= (length coll) 0) nil)
   (t (aref coll (- (length coll) 1)))))

(defun rontolisp::%clojure-peek-v (&rest args)
  "peek as a value."
  (rontolisp::%clojure-check-arity args 1 1 "peek")
  (rontolisp::%clojure-peek (car args)))

(defun rontolisp::%clojure-pop (coll)
  "A vector without its last member, a list without its first; nil of nil."
  (cond ((null coll) nil)
   ((rontolisp::%clojure-istack-p coll) (rontolisp::%clojure-istack-pop coll))
   ((not (rontolisp::%clojure-stack-p coll))
    (rontolisp::%clojure-class-cast-exception-of "pop needs a vector or a list"
                                                 coll))
   ((consp coll) (cdr coll))
   ((= (length coll) 0)
    (rontolisp::%clojure-illegal-state-exception "Can't pop empty vector"))
   (t (subseq coll 0 (- (length coll) 1)))))

(defun rontolisp::%clojure-pop-v (&rest args)
  "pop as a value."
  (rontolisp::%clojure-check-arity args 1 1 "pop")
  (rontolisp::%clojure-pop (car args)))

(defun rontolisp::%clojure-not-empty (coll)
  "COLL itself when it has a member, else nil."
  (if (rontolisp::%clojure-seq coll) coll nil))

(defun rontolisp::%clojure-not-empty-v (&rest args)
  "not-empty as a value."
  (rontolisp::%clojure-check-arity args 1 1 "not-empty")
  (rontolisp::%clojure-not-empty (car args)))

;; empty carries X's metadata over, like the oracle's empty (a list, a lazy seq
;; and a seq answer nil, the empty-as-nil position of rest and next, so they have
;; none to carry). The sorted arm keeps the comparator and the kind.
(defun rontolisp::%clojure-empty (x)
  "The empty collection of X's kind: a vector, map, set or sorted collection
   answers a fresh empty one carrying X's metadata and, for a sorted one, its
   comparator; a record signals; a list, a seq, a string and anything that is
   no collection answer nil."
  (cond ((hash-table-p x)
         (rontolisp::%clojure-put-meta (make-hash-table :test 'equal)
                                       (rontolisp::%clojure-meta x)))
        ((rontolisp::%clojure-record-p x)
         (rontolisp::%clojure-unsupported-operation-exception
          (concatenate 'string "Can't create empty: "
                       (car (cdr (cdr (cdr (cdr x))))))))
        ((rontolisp::%clojure-set-p x)
         (rontolisp::%clojure-put-meta
          (list :C%SET (make-hash-table :test 'equal))
          (rontolisp::%clojure-meta x)))
        ((rontolisp::%clojure-sorted-p x)
         (rontolisp::%clojure-put-meta
          (rontolisp::%clojure-sorted-with x (vector))
          (rontolisp::%clojure-meta x)))
        ((and (vectorp x) (not (stringp x)))
         (rontolisp::%clojure-put-meta (vector) (rontolisp::%clojure-meta x)))
        ;; an IPersistentCollection's empty: an arm of the collection-interface
        ;; family ("Collection interfaces")
        ((rontolisp::%clojure-icollection-p x)
         (rontolisp::%clojure-collection-empty x))
        (t nil)))

(defun rontolisp::%clojure-empty-v (&rest args)
  "empty as a value."
  (rontolisp::%clojure-check-arity args 1 1 "empty")
  (rontolisp::%clojure-empty (car args)))

(defun rontolisp::%clojure-comparator (pred)
  "(comparator pred): a function answering -1 when (pred a b) holds, else 1 when
   (pred b a) does, else 0."
  (lambda (a b)
    (cond ((rontolisp::%clojure-truthy (funcall pred a b)) -1)
          ((rontolisp::%clojure-truthy (funcall pred b a)) 1)
          (t 0))))

(defun rontolisp::%clojure-comparator-v (&rest args)
  "comparator as a value."
  (rontolisp::%clojure-check-arity args 1 1 "comparator")
  (rontolisp::%clojure-comparator (car args)))

(defun rontolisp::%clojure-hash-set-v (&rest xs)
  "hash-set as a value: the set of its arguments, a repeated one kept once."
  (rontolisp::%clojure-set-of xs))

(defun rontolisp::%clojure-dedupe (coll)
  "COLL without consecutive = duplicates."
  (rontolisp::%clojure-lazy-or-strict coll
   (rontolisp::%clojure-dedupe-lazy coll nil nil)))

(defun rontolisp::%clojure-dedupe-lazy (coll have prev)
  "The lazy arm of %clojure-dedupe: PREV is the last kept member when HAVE."
  (rontolisp::%clojure-make-lazy
   (lambda ()
     (let ((s (rontolisp::%clojure-seq coll)))
       (do ()
           ((or (null s) (not have)
                (not (rontolisp::%clojure-equal prev (car s))))
            (if (null s)
                nil
                (cons (car s)
                      (rontolisp::%clojure-dedupe-lazy (cdr s) t (car s)))))
         (setq s (rontolisp::%clojure-seq (cdr s))))))))

(defun rontolisp::%clojure-dedupe-v (&rest args)
  "dedupe as a value: [] the transducer, [coll] the seq."
  (if (null args)
      (rontolisp::%clojure-xf-dedupe)
      (progn
        (rontolisp::%clojure-check-arity args 1 1 "dedupe")
        (rontolisp::%clojure-dedupe (car args)))))

(defun rontolisp::%clojure-replacer (smap)
  "The one-argument function replace maps with: X's value when SMAP holds X (a
   map's or record's key under =, a vector's index), else X itself. A nil SMAP
   holds nothing; anything else signals, like the oracle's find."
  (let ((table
         (cond ((hash-table-p smap) smap)
          ((rontolisp::%clojure-record-p smap) (car (cdr (cdr (cdr smap)))))
          (t nil)))
        (miss (list nil)))
    (cond (table (lambda (x)
                   (let ((v
                          (gethash (rontolisp::%clojure-table-key x table) table
                                   miss)))
                     (if (eq v miss) x v))))
          ((null smap) (lambda (x) x))
          ((and (vectorp smap) (not (stringp smap)))
           (lambda (x)
             (if (and (integerp x) (>= x 0) (< x (length smap)))
                 (aref smap x)
                 x)))
          ((rontolisp::%clojure-sorted-map-p smap)
           (lambda (x) (rontolisp::%clojure-sorted-get smap x x)))
          (t (rontolisp::%clojure-illegal-argument-exception
              "replace needs a map or a vector")))))

(defun rontolisp::%clojure-replace (smap coll)
  "(replace SMAP COLL): a vector COLL answers a vector, anything else its seq
   through the replacer, lazy or strict like map."
  (let ((f (rontolisp::%clojure-replacer smap)))
    (if (and (vectorp coll) (not (stringp coll)))
        (coerce (mapcar f (coerce coll 'list)) 'vector)
        (rontolisp::%clojure-map f (list coll)))))

(defun rontolisp::%clojure-xf-replace (smap)
  "(replace smap): each input through the replacer."
  (rontolisp::%clojure-xf-map (rontolisp::%clojure-replacer smap)))

(defun rontolisp::%clojure-replace-v (&rest args)
  "replace as a value: [smap] the transducer, [smap coll] the replacement."
  (if (= (rontolisp::%clojure-check-arity args 1 2 "replace") 1)
      (rontolisp::%clojure-xf-replace (car args))
      (rontolisp::%clojure-replace (car args) (car (cdr args)))))

(defun rontolisp::%clojure-subvec-index (x)
  "The subvec bound X as an integer: an integer, or a float truncated like the
   oracle's intValue; anything else (nil included) signals."
  (cond ((integerp x) x)
        ((floatp x) (truncate x))
        (t (rontolisp::%clojure-class-cast-exception-of
            "subvec needs integer bounds" x))))

;; A type implementing IPersistentVector answers the members its nth reads
;; between the bounds, the oracle's SubVector over it: arms of the
;; vector-interface family ("Collection interfaces").
(defun rontolisp::%clojure-subvec (v start end)
  "(subvec V START END): a fresh vector of V's members from START up to END; a
   non-vector V (a string included) signals, and so does a bound out of range or
   START past END, like the oracle's IndexOutOfBoundsException."
  (cond ((rontolisp::%clojure-ivector-p v)
         (rontolisp::%clojure-ivector-subvec v start end))
        (t
         (if (or (not (vectorp v)) (stringp v))
             (rontolisp::%clojure-class-cast-exception-of
              "subvec needs a vector" v))
         (let ((s (rontolisp::%clojure-subvec-index start))
               (e (rontolisp::%clojure-subvec-index end)))
           (if (or (< s 0) (< e s) (< (length v) e))
               (rontolisp::%clojure-index-out-of-bounds-exception
                (format nil "Index out of bounds for subvec ~D ~D of length ~D"
                        s e (length v))))
           (let ((out (make-array (- e s))))
             (dotimes (j (- e s) out) (setf (aref out j) (aref v (+ s j)))))))))

(defun rontolisp::%clojure-subvec-from (v start)
  "(subvec V START): V from START to its end."
  (cond ((rontolisp::%clojure-ivector-p v)
         (rontolisp::%clojure-ivector-subvec v start
          (funcall (rontolisp::%clojure-call-method v "count") v)))
        (t
         (if (or (not (vectorp v)) (stringp v))
             (rontolisp::%clojure-class-cast-exception-of
              "subvec needs a vector" v))
         (rontolisp::%clojure-subvec v start (length v)))))

(defun rontolisp::%clojure-ivector-subvec (v start end)
  "(subvec V START END) of the IPersistentVector V: a fresh vector of what its
   nth answers from START up to END, a bound out of its count's range the
   oracle's IndexOutOfBoundsException."
  (let ((s (rontolisp::%clojure-subvec-index start))
        (e (rontolisp::%clojure-subvec-index end))
        (n (funcall (rontolisp::%clojure-call-method v "count") v)))
    (if (or (< s 0) (< e s) (< n e))
        (rontolisp::%clojure-index-out-of-bounds-exception
         (format nil "Index out of bounds for subvec ~D ~D of length ~D" s e
                 n)))
    (let ((out (make-array (- e s))))
      (dotimes (j (- e s) out)
        (setf (aref out j)
              (funcall (rontolisp::%clojure-call-method v "nth") v (+ s j)))))))

(defun rontolisp::%clojure-subvec-v (&rest args)
  "subvec as a value: a vector, a start and an optional end."
  (if (= (rontolisp::%clojure-check-arity args 2 3 "subvec") 2)
      (rontolisp::%clojure-subvec-from (car args) (car (cdr args)))
      (rontolisp::%clojure-subvec (car args) (car (cdr args))
                                  (car (cdr (cdr args))))))

(defun rontolisp::%clojure-find (coll key)
  "(find COLL KEY): the entry [k v] as a vector, nil when COLL holds no KEY. A
   map or record answers the key it stores (the = representative of a structural
   one); a vector takes an integer index in range; nil is nil; a host Map
   looks KEY up itself; any other COLL (a set, a string, a list) signals like
   the oracle."
  (cond ((null coll) nil)
   ((or (hash-table-p coll) (rontolisp::%clojure-record-p coll))
    (let* ((table (rontolisp::%clojure-set-entries coll "find"))
           (miss (list nil))
           (k (rontolisp::%clojure-table-key key table))
           (v (gethash k table miss)))
      (if (eq v miss) nil (vector k v))))
   ((and (vectorp coll) (not (stringp coll)))
    (if (and (integerp key) (>= key 0) (< key (length coll)))
        (vector key (aref coll key))
        nil))
   ((rontolisp::%clojure-sorted-p coll)
    (rontolisp::%clojure-sorted-find coll key))
   ;; an Associative's entryAt, a java.util.Map's containsKey and get, the
   ;; oracle's RT.find: arms of their families ("Collection interfaces")
   ((rontolisp::%clojure-iassociative-p coll)
    (rontolisp::%clojure-associative-find coll key))
   ((rontolisp::%clojure-jmap-p coll) (rontolisp::%clojure-jmap-find coll key))
   ;; a transient's entryAt: an arm of the transient family ("Transients")
   ((rontolisp::%clojure-transient-p coll)
    (rontolisp::%clojure-transient-find coll key))
   ((rontolisp::%clojure-host-seqable-p coll)
    (rontolisp::%clojure-host-find coll key))
   (t (rontolisp::%clojure-illegal-argument-exception
       "find not supported on this type"))))

(defun rontolisp::%clojure-find-v (&rest args)
  "find as a value."
  (rontolisp::%clojure-check-arity args 2 2 "find")
  (rontolisp::%clojure-find (car args) (car (cdr args))))

;; A map entry is a plain two-member vector here (what first/seq of a map and find
;; answer), so key/val read a pair and map-entry? cannot tell one from a [k v] vector.
(defun rontolisp::%clojure-entry-p (x)
  "Whether X is a two-member non-string vector, the shape of a map entry."
  (and (vectorp x) (not (stringp x)) (= (length x) 2)))

(defun rontolisp::%clojure-key (e)
  "The key of the map entry E; anything but a two-member vector signals."
  (if (rontolisp::%clojure-entry-p e)
      (aref e 0)
      (rontolisp::%clojure-class-cast-exception-of "key needs a map entry" e)))

(defun rontolisp::%clojure-key-v (&rest args)
  "key as a value."
  (rontolisp::%clojure-check-arity args 1 1 "key")
  (rontolisp::%clojure-key (car args)))

(defun rontolisp::%clojure-val (e)
  "The value of the map entry E; anything but a two-member vector signals."
  (if (rontolisp::%clojure-entry-p e)
      (aref e 1)
      (rontolisp::%clojure-class-cast-exception-of "val needs a map entry" e)))

(defun rontolisp::%clojure-val-v (&rest args)
  "val as a value."
  (rontolisp::%clojure-check-arity args 1 1 "val")
  (rontolisp::%clojure-val (car args)))

(defun rontolisp::%clojure-map-entry-p (x)
  "(map-entry? X): true of any two-member vector (a deviation: the oracle's
   answer is false for a plain [k v])."
  (if (rontolisp::%clojure-entry-p x) t rontolisp::%clojure-false))

(defun rontolisp::%clojure-map-entry-p-v (&rest args)
  "map-entry? as a value."
  (rontolisp::%clojure-check-arity args 1 1 "map-entry?")
  (rontolisp::%clojure-map-entry-p (car args)))

;; A type implementing Reversible answers its rseq: an arm of the
;; reversible-interface family ("Collection interfaces").
(defun rontolisp::%clojure-rseq (v)
  "(rseq V): the members of the vector V, last first, as a list; nil when V is
   empty. Anything but a vector (nil, a list, a seq, a string, a map) signals,
   like the oracle."
  (cond ((rontolisp::%clojure-ireversible-p v)
         (rontolisp::%clojure-ireversible-rseq v))
        ((or (not (vectorp v)) (stringp v))
         (rontolisp::%clojure-class-cast-exception-of "rseq needs a vector" v))
        (t (let ((out nil))
             (dotimes (i (length v) out) (setq out (cons (aref v i) out)))))))

;; A sorted collection walks backwards through its items vector, like a call.
(defun rontolisp::%clojure-rseq-v (&rest args)
  "rseq as a value."
  (rontolisp::%clojure-check-arity args 1 1 "rseq")
  (rontolisp::%clojure-rseq (rontolisp::%clojure-sorted-items (car args))))

(defun rontolisp::%clojure-find-keyword (x)
  "(find-keyword X): the keyword for a keyword, symbol or string, nil for
   anything else. Keywords are not interned, so a never-seen spelling answers
   its keyword where the oracle answers nil (a deviation)."
  (rontolisp::%clojure-keyword-1 x))

(defun rontolisp::%clojure-find-keyword-2 (ns nm)
  "(find-keyword NS NM): the keyword NS/NM; a nil NS drops, a nil NM or a
   non-string part signals, like the oracle."
  (cond ((not (or (null ns) (stringp ns)))
         (rontolisp::%clojure-class-cast-exception
          "find-keyword needs strings"))
        ((not (stringp nm))
         (rontolisp::%clojure-class-cast-exception-of
          "find-keyword needs strings" nm))
        (t (rontolisp::%clojure-keyword-2 ns nm))))

(defun rontolisp::%clojure-find-keyword-v (&rest args)
  "find-keyword as a value: a name, or a namespace and a name."
  (if (= (rontolisp::%clojure-check-arity args 1 2 "find-keyword") 1)
      (rontolisp::%clojure-find-keyword (car args))
      (rontolisp::%clojure-find-keyword-2 (car args) (car (cdr args)))))

(defun rontolisp::%clojure-partition-all (n step coll)
  "COLL in runs of N every STEP members, the short tail kept. A non-positive
   size or step signals (the oracle answers an endless seq of ())."
  (if (and (> n 0) (> step 0))
      (rontolisp::%clojure-lazy-or-strict coll
       (rontolisp::%clojure-partition-all-lazy n step coll))
      (error "partition-all needs a positive size and step")))

(defun rontolisp::%clojure-partition-all-lazy (n step coll)
  "The lazy arm of %clojure-partition-all."
  (rontolisp::%clojure-make-lazy
   (lambda ()
     (let ((s (rontolisp::%clojure-seq coll)))
       (if (null s)
           nil
           (cons (rontolisp::%clojure-take n s)
                 (rontolisp::%clojure-partition-all-lazy n step
                  (rontolisp::%clojure-drop step s))))))))

(defun rontolisp::%clojure-partition-all-v (&rest args)
  "partition-all as a value: [n] the transducer, [n coll] or [n step coll]."
  (let ((n (rontolisp::%clojure-check-arity args 1 3 "partition-all")))
    (cond ((= n 1) (rontolisp::%clojure-xf-partition-all (car args)))
          ((= n 2)
           (rontolisp::%clojure-partition-all (car args) (car args)
                                              (car (cdr args))))
          (t (rontolisp::%clojure-partition-all (car args) (car (cdr args))
                                                (car (cdr (cdr args))))))))

(defun rontolisp::%clojure-partition-by (f coll)
  "COLL split into runs where (f member) stays =."
  (rontolisp::%clojure-lazy-or-strict coll
   (rontolisp::%clojure-partition-by-lazy f coll)))

(defun rontolisp::%clojure-partition-by-lazy (f coll)
  "The lazy arm of %clojure-partition-by: each run is strict."
  (rontolisp::%clojure-make-lazy
   (lambda ()
     (let ((s (rontolisp::%clojure-seq coll)))
       (if (null s)
           nil
           (let ((v (funcall f (car s)))
                 (run (list (car s)))
                 (more (rontolisp::%clojure-seq (cdr s))))
             (do ()
                 ((or (null more)
                   (not (rontolisp::%clojure-equal v (funcall f (car more)))))
                  (cons (reverse run)
                        (rontolisp::%clojure-partition-by-lazy f more)))
               (setq run (cons (car more) run))
               (setq more (rontolisp::%clojure-seq (cdr more))))))))))

(defun rontolisp::%clojure-partition-by-v (&rest args)
  "partition-by as a value: [f] the transducer, [f coll] the seq."
  (if (= (rontolisp::%clojure-check-arity args 1 2 "partition-by") 1)
      (rontolisp::%clojure-xf-partition-by
       (rontolisp::%clojure-as-fn (car args)))
      (rontolisp::%clojure-partition-by (rontolisp::%clojure-as-fn (car args))
                                        (car (cdr args)))))

(defun rontolisp::%clojure-extreme-key (k x more greatest)
  "The member of X and the list MORE whose (k member) is the greatest (GREATEST
   true) or the least, the last of equals winning, like the oracle: K runs once
   per member, and not at all for X alone."
  (if (null more)
      x
      (let ((v x) (kv (funcall k x)))
        (dolist (w more v)
          (let ((kw (funcall k w)))
            (if (if greatest (>= kw kv) (<= kw kv))
                (progn
                  (setq v w)
                  (setq kv kw))))))))

(defun rontolisp::%clojure-max-key-v (&rest args)
  "max-key as a value."
  (rontolisp::%clojure-check-arity args 2 nil "max-key")
  (rontolisp::%clojure-extreme-key (rontolisp::%clojure-as-fn (car args))
                                   (car (cdr args)) (cdr (cdr args)) t))

(defun rontolisp::%clojure-min-key-v (&rest args)
  "min-key as a value."
  (rontolisp::%clojure-check-arity args 2 nil "min-key")
  (rontolisp::%clojure-extreme-key (rontolisp::%clojure-as-fn (car args))
                                   (car (cdr args)) (cdr (cdr args)) nil))

(defun rontolisp::%clojure-juxt (fns)
  "A function answering the vector of every member of FNS applied to its
   arguments."
  (lambda (&rest args)
    (coerce (mapcar (lambda (f) (apply f args)) fns) 'vector)))

(defun rontolisp::%clojure-juxt-v (&rest fns)
  "juxt as a value."
  (rontolisp::%clojure-check-arity fns 1 nil "juxt")
  (rontolisp::%clojure-juxt (mapcar #'rontolisp::%clojure-as-fn fns)))

(defun rontolisp::%clojure-fnil-patch (args defaults)
  "ARGS with each leading nil replaced by its member of DEFAULTS."
  (if (null defaults)
      args
      (cons (if (null (car args)) (car defaults) (car args))
            (rontolisp::%clojure-fnil-patch (cdr args) (cdr defaults)))))

(defun rontolisp::%clojure-fnil (f defaults)
  "F behind nil-patching of its leading arguments: at least as many arguments
   as DEFAULTS, like the oracle's arities."
  (lambda (&rest args)
    (if (< (length args) (length defaults))
        (rontolisp::%clojure-arity-exception
         (format nil "Wrong number of args (~D) passed to: clojure.core/fnil/fn"
                 (length args)))
        (apply f (rontolisp::%clojure-fnil-patch args defaults)))))

(defun rontolisp::%clojure-fnil-v (&rest args)
  "fnil as a value: a function and one to three defaults."
  (rontolisp::%clojure-check-arity args 2 4 "fnil")
  (rontolisp::%clojure-fnil (rontolisp::%clojure-as-fn (car args)) (cdr args)))

(defun rontolisp::%clojure-every-pred (preds)
  "A predicate answering T when every member of PREDS holds for every argument
   (of none, T), else the false object."
  (lambda (&rest args)
    (let ((ok t))
      (dolist (p preds)
        (dolist (x args)
          (if (and ok (not (rontolisp::%clojure-filter-test p x)))
              (setq ok nil))))
      (if ok t rontolisp::%clojure-false))))

(defun rontolisp::%clojure-every-pred-v (&rest preds)
  "every-pred as a value."
  (rontolisp::%clojure-check-arity preds 1 nil "every-pred")
  (rontolisp::%clojure-every-pred (mapcar #'rontolisp::%clojure-as-fn preds)))

(defun rontolisp::%clojure-some-arg-major (preds args)
  "The first truthy (p x) over ARGS, every member of PREDS per argument, else the
   last (p x) tried (nil when none)."
  (let ((last nil) (found nil))
    (dolist (x args)
      (dolist (p preds)
        (if (not found)
            (progn
              (setq last (funcall p x))
              (if (rontolisp::%clojure-truthy last) (setq found t))))))
    last))

(defun rontolisp::%clojure-some-pred-major (preds args)
  "The first truthy (p x) over PREDS, every member of ARGS per predicate, else
   nil."
  (let ((found nil))
    (dolist (p preds)
      (dolist (x args)
        (if (not found)
            (let ((v (funcall p x)))
              (if (rontolisp::%clojure-truthy v) (setq found v))))))
    found))

(defun rontolisp::%clojure-some-pred-major-last (preds args)
  "The first truthy (p x) over PREDS, every member of ARGS per predicate, else
   the last (p x) tried (nil when none)."
  (let ((last nil) (found nil))
    (dolist (p preds)
      (dolist (x args)
        (if (not found)
            (progn
              (setq last (funcall p x))
              (if (rontolisp::%clojure-truthy last) (setq found t))))))
    last))

(defun rontolisp::%clojure-some-fn-apply (preds args)
  "The oracle's some-fn answer: one to three predicates walk the first three
   arguments predicate-major failing with the last (p x), and the arguments past
   three argument-major failing with nil; four or more walk both predicate-major
   and fail with nil."
  (let ((head nil) (tail args) (i 0))
    (do ()
        ((or (null tail) (= i 3)))
      (setq head (cons (car tail) head))
      (setq tail (cdr tail))
      (setq i (+ i 1)))
    (setq head (reverse head))
    (if (cdr (cdr (cdr preds)))
        (let ((v (rontolisp::%clojure-some-pred-major preds head)))
          (if v v (rontolisp::%clojure-some-pred-major preds tail)))
        (let ((v (rontolisp::%clojure-some-pred-major-last preds head)))
          (cond ((rontolisp::%clojure-truthy v) v)
                ((null tail) v)
                (t (let ((w (rontolisp::%clojure-some-arg-major preds tail)))
                     (if (rontolisp::%clojure-truthy w) w nil))))))))

(defun rontolisp::%clojure-some-fn (preds)
  "A function answering the first truthy (p x) over PREDS and its arguments."
  (lambda (&rest args) (rontolisp::%clojure-some-fn-apply preds args)))

(defun rontolisp::%clojure-some-fn-v (&rest preds)
  "some-fn as a value."
  (rontolisp::%clojure-check-arity preds 1 nil "some-fn")
  (rontolisp::%clojure-some-fn (mapcar #'rontolisp::%clojure-as-fn preds)))

(defun rontolisp::%clojure-kv-pairs (coll name)
  "The (key . value) pairs NAME walks: a map's or record's entries in the
   table's walk order, a vector's (index . member) pairs, none of nil, a host
   Map's entries (or a host seq's, each an entry); anything else signals."
  (cond ((null coll) nil)
        ((rontolisp::%clojure-record-p coll)
         (rontolisp::%clojure-record-entries coll))
        ((hash-table-p coll)
         (let ((acc nil))
           (maphash (lambda (k v) (setq acc (cons (cons k v) acc))) coll)
           (reverse acc)))
        ((and (vectorp coll) (not (stringp coll)))
         (let ((acc nil))
           (dotimes (i (length coll))
             (setq acc (cons (cons i (aref coll i)) acc)))
           (reverse acc)))
        ((rontolisp::%clojure-sorted-map-p coll)
         (rontolisp::%clojure-sorted-kv-pairs coll))
        ;; a type implementing IPersistentMap: the entries its reduction steps,
        ;; the oracle's IKVReduce of an IPersistentMap (an arm of the
        ;; map-interface family, "Collection interfaces")
        ((rontolisp::%clojure-imap-p coll)
         (reverse
          (rontolisp::%clojure-reduce-init (lambda (acc e)
                                             (cons (cons
                                                    (rontolisp::%clojure-key e)
                                                    (rontolisp::%clojure-val e))
                                                   acc)) nil coll)))
        ((rontolisp::%clojure-host-seqable-p coll)
         (mapcar (lambda (e) (cons (aref e 0) (aref e 1)))
                 (rontolisp::%clojure-host-entries coll name)))
        (t (rontolisp::%clojure-map-entry-refusal
            (format nil "~A needs a map or a vector" name) coll))))

;; A COLL reducing through its own IKVReduce row is handed to it, the oracle's
;; kv-reduce: an arm of the reducible family, "CollReduce and IKVReduce" below.
(defun rontolisp::%clojure-reduce-kv (f init coll)
  "(f acc k v) folded over COLL's pairs from INIT, stopping at a reduced
   answer (unwrapped)."
  (if (rontolisp::%clojure-kv-reducible-p coll)
      (rontolisp::%clojure-kv-reduce-3 coll f init)
      (let ((acc init) (pairs (rontolisp::%clojure-kv-pairs coll "reduce-kv")))
        (do ()
            ((null pairs) acc)
          (setq acc (funcall f acc (car (car pairs)) (cdr (car pairs))))
          (if (rontolisp::%clojure-reduced-p acc)
              (progn
                (setq acc (car (cdr acc)))
                (setq pairs nil))
              (setq pairs (cdr pairs)))))))

(defun rontolisp::%clojure-reduce-kv-v (&rest args)
  "reduce-kv as a value."
  (rontolisp::%clojure-check-arity args 3 3 "reduce-kv")
  (rontolisp::%clojure-reduce-kv (rontolisp::%clojure-as-fn (car args))
                                 (car (cdr args)) (car (cdr (cdr args)))))

(defun rontolisp::%clojure-extend-rows (entry raw remove fresh map methods)
  "extend's run-time rows from the computed method map MAP: nil removes the
   target's row (REMOVE), a map (or record, or sorted) replaces it with a
   fresh row (FRESH) holding ENTRY of each entry whose key is the keyword
   of one of METHODS (the protocol's method names) and its function, and
   anything else replaces the row as-is (RAW) -- the oracle's assoc-in of
   the map, like the head call (g43). Any other entry is never looked up,
   as in the oracle, so none is stored. Answers nil, like the oracle's
   extend."
  (cond ((null map) (funcall remove))
        ((or (hash-table-p map) (rontolisp::%clojure-record-p map)
             (rontolisp::%clojure-sorted-p map))
         (funcall fresh)
         (dolist (e (rontolisp::%clojure-kv-pairs map "extend"))
           (let ((k (car e)))
             (if (and (rontolisp::%clojure-keyword-p k)
                      (member (car (cdr k)) methods :test #'equal))
                 (funcall entry k (rontolisp::%clojure-as-fn (cdr e)))))))
        (t (funcall raw map)))
  nil)

;; update-keys and update-vals of an M reducing through its own IKVReduce row
;; build the fresh map through that reduction, the oracle's reduce-kv into an
;; empty map: arms of the reducible family, "CollReduce and IKVReduce" below.
(defun rontolisp::%clojure-update-keys (m f)
  "A fresh map of M's entries under (f key) (a colliding key keeps one entry)."
  (if (rontolisp::%clojure-kv-reducible-p m)
      (rontolisp::%clojure-kv-reduce-3 m
                                       (lambda (out k v)
                                         (setf (gethash
                                                (rontolisp::%clojure-store-key
                                                 (funcall f k) out) out) v)
                                         out) (make-hash-table :test 'equal))
      (let ((out (make-hash-table :test 'equal)))
        (dolist (kv (rontolisp::%clojure-kv-pairs m "update-keys") out)
          (setf (gethash
                 (rontolisp::%clojure-store-key (funcall f (car kv)) out) out)
                (cdr kv))))))

(defun rontolisp::%clojure-update-keys-v (&rest args)
  "update-keys as a value."
  (rontolisp::%clojure-check-arity args 2 2 "update-keys")
  (rontolisp::%clojure-update-keys (car args)
   (rontolisp::%clojure-as-fn (car (cdr args)))))

(defun rontolisp::%clojure-update-vals (m f)
  "M with (f value) for every value: a vector stays a vector, a map or record
   answers a fresh map, nil the empty map."
  (if (rontolisp::%clojure-kv-reducible-p m)
      (rontolisp::%clojure-kv-reduce-3 m
                                       (lambda (out k v)
                                         (setf (gethash
                                                (rontolisp::%clojure-store-key k
                                                 out) out) (funcall f v))
                                         out) (make-hash-table :test 'equal))
      (if (and (vectorp m) (not (stringp m)))
          (coerce (mapcar f (coerce m 'list)) 'vector)
          (let ((out (make-hash-table :test 'equal)))
            (dolist (kv (rontolisp::%clojure-kv-pairs m "update-vals") out)
              (setf (gethash (car kv) out) (funcall f (cdr kv))))))))

(defun rontolisp::%clojure-update-vals-v (&rest args)
  "update-vals as a value."
  (rontolisp::%clojure-check-arity args 2 2 "update-vals")
  (rontolisp::%clojure-update-vals (car args)
   (rontolisp::%clojure-as-fn (car (cdr args)))))

;;;; Struct definitions: create-struct and accessor.
;;
;; A struct definition is the key vector defstruct stores, so struct and
;; struct-map read a created one as they read a defined one. create-struct of
;; no keys is the oracle's refusal; any key goes, like the oracle's. An
;; accessor answers the function reading its key out of a struct map; of a
;; non-vector, or a key the definition lacks, it signals with the oracle's
;; class and message.

(defun rontolisp::%clojure-create-struct (&rest keys)
  "(create-struct keys...): the struct definition over KEYS, the key vector
   struct and struct-map read."
  (if (null keys)
      (rontolisp::%clojure-illegal-argument-exception "Must supply keys"))
  (apply #'vector keys))

(defun rontolisp::%clojure-create-struct-v (&rest args)
  "create-struct as a value."
  (apply #'rontolisp::%clojure-create-struct args))

(defun rontolisp::%clojure-accessor (s k)
  "(accessor s k): the function reading K out of a struct map of S."
  (if (or (not (vectorp s)) (stringp s))
      (rontolisp::%clojure-class-cast-exception-of
       (concatenate 'string "Cannot cast " (rontolisp::%clojure-class-name-of s)
                    " to clojure.lang.PersistentStructMap$Def") s))
  (let ((found nil))
    (dolist (e (coerce s 'list)) (if (equal e k) (setq found t)))
    (if found
        (lambda (m) (gethash (rontolisp::%clojure-table-key k m) m nil))
        (rontolisp::%clojure-illegal-argument-exception
         "Not a key of struct"))))

(defun rontolisp::%clojure-accessor-v (&rest args)
  "accessor as a value."
  (rontolisp::%clojure-check-arity args 2 2 "accessor")
  (rontolisp::%clojure-accessor (car args) (car (cdr args))))

;;;; Multimethod introspection: prefers.
;;
;; prefers reads the multimethod's prefers table: each dispatch value to the
;; set of values preferred over it, like the oracle's map. The stored keys are
;; the representatives the tables hold, = to the dispatch values prefer-method
;; was given.

(defun rontolisp::%clojure-prefers (table)
  "(prefers f): the map of each dispatch value to the set preferred over it."
  (let ((buckets (make-hash-table :test 'equal)) (order nil) (miss (list nil)))
    (maphash (lambda (pair ignored)
               (declare (ignore ignored))
               (let ((x (car pair)) (y (cdr pair)))
                 (if (eq (gethash x buckets miss) miss)
                     (progn
                       (setf (gethash x buckets) (list y))
                       (setq order (cons x order)))
                     (setf (gethash x buckets) (cons y (gethash x buckets))))))
             table)
    (let ((out (make-hash-table :test 'equal)))
      (dolist (x (reverse order) out)
        (setf (gethash x out)
              (rontolisp::%clojure-set-of (reverse (gethash x buckets))))))))

;;;; Multimethod values: the run-time registry behind the six value arms.
;;
;; A multimethod's tables live under the literal name the call names, so a
;; value holding only the dispatch function reaches none of them. Every
;; defmulti registers its tables beside the dispatch function here, and the
;; value arms of get-method, methods, remove-method, prefer-method, prefers
;; and remove-all-methods read through the registry, running what the call
;; runs (g40). The registry is keyed by the function itself: (function name)
;; answers the canonical box every site naming it shares, so eq finds it on
;; every backend. The record holds getters over the globals, never the tables
;; themselves: every mutation edits the tables in place (only a re-executed
;; defmulti rebinds them, and the getters then read the new ones, like the
;; calls do), so a captured old function introspects what it calls, like the
;; oracle's old multimethod object answering its own tables. The Object slot
;; is rebound (never edited), so the record carries only a clearer closure
;; over it.

(defvar rontolisp::%clojure-multimethods
  (make-hash-table :test 'eq)
  "A dispatch function to its (methods-getter prefers-getter clearer), made
   by every defmulti beside its tables.")

(defun rontolisp::%clojure-register-multimethod
    (name fn methods prefers clearer)
  "Register FN's table getters, answering NAME (what defun answers, so a
   defmulti answers what it answered before the registry existed). METHODS and
   PREFERS are zero-argument closures over the method and prefers globals,
   CLEARER one zeroing the Object slot."
  (setf (gethash fn rontolisp::%clojure-multimethods)
        (list methods prefers clearer))
  name)

;; Simple class names to the kind keyword spelling a class spelling stores
;; under (clojure/ClojureDispatchLowering, DISPATCH_CLASS_KEYWORDS): a
;; run-time class object or class designator reads back as the same keyword,
;; so a value arm finds the row the literal spelling stored. java.lang.Object
;; is not in the map (the lowering special-cases it to :object) and is tested
;; by its full name below.
(defvar rontolisp::%clojure-dispatch-class-names
  '(("String" . "string") ("CharSequence" . "string") ("Boolean" . "boolean")
    ("Keyword" . "keyword") ("Symbol" . "symbol") ("Character" . "char")
    ("Char" . "char") ("Map" . "map") ("IPersistentMap" . "map")
    ("Vector" . "vector") ("IPersistentVector" . "vector") ("Set" . "set")
    ("IPersistentSet" . "set") ("List" . "list") ("Seq" . "list")
    ("Sequential" . "list") ("Collection" . "list") ("IPersistentList" . "list")
    ("IPersistentCollection" . "list") ("Fn" . "function") ("IFn" . "function")
    ("Function" . "function") ("Atom" . "atom"))
  "Simple class names to the kind keyword spelling dispatch stores.")

(defun rontolisp::%clojure-dispatch-name (dv)
  "The host class name DV names, or nil: a class designator's name, else a
   host class object's (nil where no host object can exist, so the designator
   alone decides there)."
  (if (and (consp dv) (eq (car dv) :C%CLASS) (consp (cdr dv))
           (stringp (car (cdr dv))))
      (car (cdr dv))
      (rontolisp::%clojure-host-class-name dv)))

(defun rontolisp::%clojure-dispatch-simple-name (name)
  "NAME past its last dot: the simple name a host class object or class
   designator spells."
  (let ((dot (position #\. name :from-end t)))
    (if dot (subseq name (+ dot 1)) name)))

(defun rontolisp::%clojure-dispatch-value (dv)
  "The methods-table key a run-time dispatch value DV reads: nil to the
   (:C%NIL) marker (no table keys on nil, like the dispatcher's own mapping),
   a class object or designator to the kind keyword a class spelling stores
   (the full name's keyword where no kind answers, which is the row a spelled
   chained class keeps), anything else itself."
  (if (null dv)
      (list :C%NIL)
      (let ((name (rontolisp::%clojure-dispatch-name dv)))
        (if (null name)
            dv
            (let ((kind
                   (cdr
                    (assoc (rontolisp::%clojure-dispatch-simple-name name)
                           rontolisp::%clojure-dispatch-class-names
                           :test #'equal))))
              (if kind
                  (list :c%keyword kind)
                  (if (equal name "java.lang.Object")
                      (list :c%keyword "object")
                      (list :c%keyword name))))))))

(defun rontolisp::%clojure-dispatch-key (dv table)
  "The key TABLE holds DV's row under: the run-time dispatch value through
   the structural-key runtime, like a computed head call's lookup."
  (rontolisp::%clojure-table-key (rontolisp::%clojure-dispatch-value dv) table))

;;;; Protocol values: the run-time registry behind the three value arms.
;;
;; A protocol var holds its methods table, so a value holding only that
;; table reaches neither the inline-implementation table nor the Object
;; default (a table read alone would answer wrong booleans, so the arms
;; refused instead of approximating). Every defprotocol registers its
;; tables beside the methods table here, and the value arms of satisfies?,
;; extends? and extend read through the registry, running what the head
;; calls run (g42). The registry is keyed by the methods table itself: a
;; protocol value IS that table, so eq finds it on every backend. The
;; record holds getters over the globals, never the tables themselves:
;; every mutation edits the tables in place (only a re-executed
;; defprotocol rebinds them, and the getters then read the new ones, like
;; the calls do), so a captured old table reads what it reads like the
;; calls do. Beside the getters the record carries the walk flag the final
;; lowering pass settled, the guard closure over the interfaces' own tests
;; (nil where the head asks none), the protocol's method names (what an
;; extend entry must keyword-name to store), the reducing method's keyword
;; (nil except for clojure.core.protocols/CollReduce and IKVReduce), the
;; var key and interface name, and the default's setter (g43).
;; A defrecord or deftype registers its dispatch tag beside its
;; constructors, with the host class name and the var keys of the protocols
;; its body names, so an extend of (class value) stores under a typed key
;; with the reducing row where one applies, and one to a type whose body
;; already implements the protocol refuses like the oracle's (g43).

(defvar rontolisp::%clojure-protocols
  (make-hash-table :test 'eq)
  "A protocol's methods table to its (methods-getter inline-getter
   default-getter default-ensurer walks-p guard methods reducer pkey iface
   clearer) record, made by every defprotocol beside its tables: the
   reducing method's keyword a typed row filters on (nil for any other
   protocol), the protocol's var key and interface name (what the run-time
   extend's body-implementation refusal reports), and the closure dropping
   the Object row.")

(defvar rontolisp::%clojure-protocol-type-tags
  (make-hash-table :test 'equal)
  "A record's or deftype's dispatch-tag keyword to its (class . protocols)
   entry -- the host class name and the var keys of the protocols its body
   names -- made beside its constructors, so a run-time type value reads
   back as a typed key and a run-time extend to a type whose body already
   implements the protocol refuses like the oracle's.")

(defun rontolisp::%clojure-register-protocol (methods methods-getter
                                                      inline-getter
                                                      default-getter
                                                      default-ensurer walks
                                                      guard names reducer pkey
                                                      iface clearer)
  "Register METHODS' record beside the methods table, answering the table
   (what the protocol's setq answers, so a defprotocol answers what it
   answered before the registry existed)."
  (setf (gethash methods rontolisp::%clojure-protocols)
        (list methods-getter inline-getter default-getter default-ensurer walks
              guard names reducer pkey iface clearer))
  methods)

(defun rontolisp::%clojure-register-type-tag (tag class protocols)
  "Register the record or deftype dispatch-tag keyword TAG beside its CLASS
   name and the var keys of the protocols its body names (PROTOCOLS),
   answering TAG (what the constructors' defun answers, so a definition
   answers what it answered before the registry existed)."
  (setf (gethash tag rontolisp::%clojure-protocol-type-tags)
        (cons class protocols))
  tag)

;; The class spellings an extend target resolves to, by kind (clojure/
;; ClojureProtocolLowering, extendKeyForm): a class object or designator
;; reads back as the keyword a class spelling stores, java.lang.Object is
;; not in the map (the lowering special-cases it to the default) and is
;; tested by its full name below.
(defvar rontolisp::%clojure-extends-kind-names
  '(("String" . "string") ("CharSequence" . "string") ("Boolean" . "boolean")
    ("Keyword" . "keyword") ("Symbol" . "symbol") ("Character" . "char")
    ("Char" . "char") ("Map" . "map") ("IPersistentMap" . "map")
    ("Vector" . "vector") ("IPersistentVector" . "vector") ("Set" . "set")
    ("IPersistentSet" . "set") ("List" . "list") ("Seq" . "list")
    ("Sequential" . "list") ("Collection" . "list") ("IPersistentList" . "list")
    ("IPersistentCollection" . "list") ("Fn" . "function") ("IFn" . "function")
    ("Function" . "function") ("Atom" . "atom"))
  "Simple class names to the kind keyword spelling an extend target
   stores under.")

;; The instants' and the UUID's classes to the dispatch name an extend of
;; one stores under (the class's own, but for Calendar, whose one class
;; here is GregorianCalendar).
(defvar rontolisp::%clojure-extends-time-names
  '(("java.util.Date" . "java.util.Date")
    ("java.sql.Timestamp" . "java.sql.Timestamp")
    ("java.util.Calendar" . "java.util.GregorianCalendar")
    ("java.util.GregorianCalendar" . "java.util.GregorianCalendar")
    ("java.util.UUID" . "java.util.UUID"))
  "Instant and UUID class names to the dispatch name an extend stores.")

;; The clojure.java.io classes an extend target stores under its own name.
(defvar rontolisp::%clojure-extends-io-names
  '("java.io.File" "java.net.URL" "java.net.URI")
  "java.io class names an extend stores under their own keyword.")

;; The resolved class names whose kind-spelled target the lowering keys by
;; the class's own name instead (an interface values of other kinds
;; implement too, or an instant class): a run-time class of one refuses
;; where it cannot decide, like the head call's walk it has not got.
(defvar rontolisp::%clojure-extends-reaches
  '("java.util.List" "java.util.Collection" "clojure.lang.Sequential"
    "clojure.lang.IPersistentCollection" "clojure.lang.IFn" "java.util.Date"
    "java.sql.Timestamp" "java.util.Calendar" "java.util.GregorianCalendar"
    "java.util.UUID")
  "Resolved class names an extend target keys by the class's own name.")

;; The dotless spellings resolving to a clojure.lang class the kind tables
;; name (the lowering's clojureLang leniency): a run-time class under one
;; reads through the full name.
(defvar rontolisp::%clojure-extends-dotless-names
  '(("Atom" . "clojure.lang.Atom") ("Fn" . "clojure.lang.Fn")
    ("IFn" . "clojure.lang.IFn")
    ("IPersistentCollection" . "clojure.lang.IPersistentCollection")
    ("IPersistentList" . "clojure.lang.IPersistentList")
    ("IPersistentMap" . "clojure.lang.IPersistentMap")
    ("IPersistentSet" . "clojure.lang.IPersistentSet")
    ("IPersistentVector" . "clojure.lang.IPersistentVector")
    ("Keyword" . "clojure.lang.Keyword")
    ("Sequential" . "clojure.lang.Sequential")
    ("Symbol" . "clojure.lang.Symbol"))
  "Dotless class names to their clojure.lang class.")

(defun rontolisp::%clojure-extends-class-name (x)
  "The class name X, a class object or designator, spells, or nil: a class
   designator's name, else a host class object's (nil where no host object
   can exist, so only the designator decides there)."
  (if (and (consp x) (eq (car x) :C%CLASS) (consp (cdr x))
           (stringp (car (cdr x))))
      (car (cdr x))
      (rontolisp::%clojure-host-class-name x)))

(defun rontolisp::%clojure-extends-simple-name (name)
  "NAME past its last dot: the simple name a class object or designator
   spells."
  (let ((dot (position #\. name :from-end t)))
    (if dot (subseq name (+ dot 1)) name)))

(defun rontolisp::%clojure-extends-walked (name)
  "NAME through the dotless leniency: its clojure.lang class where one
   answers, else itself."
  (if (position #\. name)
      name
      (let ((full
             (cdr
              (assoc name rontolisp::%clojure-extends-dotless-names
                     :test #'equal))))
        (if full full name))))

(defun rontolisp::%clojure-extends-key (x)
  "The methods-table key a run-time type value X reads: nil to the nil
   keyword (no table keys on nil, like the dispatcher's own mapping), a
   class keyword to the keyword a class spelling stores (:object to the
   default marker), a class object or designator the same way -- what the
   head call's mapping answers. Anything but a class object, a designator
   or a class keyword is the oracle's cast failure."
  (cond ((null x) (list :c%keyword "nil"))
        ((rontolisp::%clojure-keyword-p x)
         (rontolisp::%clojure-extends-spelling (car (cdr x)) x))
        (t (let ((name (rontolisp::%clojure-extends-class-name x)))
             (if (null name)
                 (rontolisp::%clojure-host-cast-failure x "java.lang.Class")
                 (rontolisp::%clojure-extends-named name))))))

(defun rontolisp::%clojure-extends-spelling (spelling x)
  "The methods-table key the class keyword of SPELLING reads: itself for a
   tag, a kind, an instant, a java.io name or a nil, its kind for a class
   keyword, the keyword a class spelling stores for any other dotted
   class name. A dotless spelling naming none of those is no class, like
   the oracle's cast of it."
  (cond ((equal spelling "object") :default)
        ((or (gethash x rontolisp::%clojure-protocol-type-tags)
          (member spelling
                  '("string" "boolean" "keyword" "symbol" "char" "map" "vector"
                    "set" "list" "function" "atom" "nil" "reify" "pattern"
                    "matcher")
                  :test #'equal)
          (assoc spelling rontolisp::%clojure-extends-time-names :test #'equal)
          (member spelling rontolisp::%clojure-extends-io-names :test #'equal))
         x)
        ;; a class value's keyword reads back as its kind, like the type
        ;; designator does for the dispatcher's method table
        ((cdr
          (assoc spelling rontolisp::%clojure-type-class-names :test #'equal))
         (list :c%keyword (cdr
                           (assoc spelling rontolisp::%clojure-type-class-names
                                  :test #'equal))))
        ((position #\. spelling) (rontolisp::%clojure-extends-named spelling))
        (t (rontolisp::%clojure-host-cast-failure x "java.lang.Class"))))

(defun rontolisp::%clojure-extends-named (name)
  "The methods-table key the resolved class NAME reads: the keyword a
   class spelling stores -- the default marker for java.lang.Object, its
   own keyword where the lowering keys it so, else the kind keyword."
  (cond ((equal name "java.lang.Object") :default)
        ((member name rontolisp::%clojure-extends-io-names :test #'equal)
         (list :c%keyword name))
        (t
         (let ((kind
                (or (cdr
                     (assoc (rontolisp::%clojure-extends-simple-name name)
                            rontolisp::%clojure-extends-kind-names
                            :test #'equal))
                    (cdr
                     (assoc name rontolisp::%clojure-extends-time-names
                            :test #'equal)))))
           (if (and kind
                    (not
                     (member (rontolisp::%clojure-extends-walked name)
                             rontolisp::%clojure-extends-reaches
                             :test #'equal)))
               (list :c%keyword kind)
               (list :c%keyword (rontolisp::%clojure-extends-walked name)))))))

(defun rontolisp::%clojure-satisfies (p x)
  "satisfies? of the run-time protocol value P over X: the tag's row, the
   inline table's first where the protocol is extend-via-metadata, the
   walk behind the flag or the guard the registry settled, else the
   Object default -- what the head call runs. Nil never consults the
   default, like the oracle (g43). A value the registry holds
   no protocol for is the oracle's NullPointerException."
  (let ((record (gethash p rontolisp::%clojure-protocols)))
    (if (null record)
        (rontolisp::%clojure-null-pointer-exception
         "Cannot invoke \"java.lang.Class.isInstance(Object)\" because \"c\" is null")
        (let* ((methods (funcall (car record)))
               (inline-getter (car (cdr record)))
               (default (funcall (car (cdr (cdr record)))))
               (walks (car (cdr (cdr (cdr (cdr record))))))
               (guard (car (cdr (cdr (cdr (cdr (cdr record)))))))
               (tag (c%protocol-tag x))
               (miss (list nil))
               (inner (gethash tag methods miss)))
          (if inline-getter
              (let ((direct (gethash tag (funcall inline-getter) miss)))
                (if (eq direct miss) nil (setq inner direct))))
          (if (and (eq inner miss) (not (null x))
                   (or walks (and guard (funcall guard x))))
              (setq inner (c%protocol-super x methods nil miss)))
          (if (eq inner miss)
              (if (or (null x) (null default)) rontolisp::%clojure-false t)
              t)))))

(defun rontolisp::%clojure-extends-p (p x)
  "extends? of the run-time protocol value P over the run-time type X:
   the key's row, the inline table's too, else the Object default -- what
   the head call runs. A value the registry holds no protocol for is the
   oracle's NullPointerException."
  (let ((record (gethash p rontolisp::%clojure-protocols)))
    (if (null record)
        (rontolisp::%clojure-null-pointer-exception
         "Cannot invoke \"java.lang.Class.isAssignableFrom(java.lang.Class)\"")
        (let* ((methods (funcall (car record)))
               (inline-getter (car (cdr record)))
               (default (funcall (car (cdr (cdr record)))))
               (key (rontolisp::%clojure-extends-key x))
               (miss (list nil)))
          (if (eq key :default)
              (if (null default) rontolisp::%clojure-false t)
              (let ((inner (gethash key methods miss)))
                (if (and (eq inner miss) inline-getter)
                    (setq inner (gethash key (funcall inline-getter) miss)))
                (if (eq inner miss) rontolisp::%clojure-false t)))))))

(defun rontolisp::%clojure-extend-method (methods key method fn reducer typed)
  "Stores FN under METHOD of KEY's row in the methods TABLE, through the
   reducing row where TYPED names one -- the row a literal extend stores.
   REDUCER is the reducing method's keyword (nil for any other protocol)."
  (if (and typed reducer)
      (funcall (if (equal reducer '(:c%keyword "coll-reduce"))
                   #'rontolisp::%clojure-coll-reducer-row
                   #'rontolisp::%clojure-kv-reducer-row) methods key fn)
      (let* ((miss (list nil)) (inner (gethash key methods miss)))
        (if (eq inner miss)
            (progn
              (setq inner (make-hash-table :test 'equal))
              (setf (gethash key methods) inner)))
        (setf (gethash method inner) fn))))

(defun rontolisp::%clojure-extend (args)
  "extend of the run-time type over ARGS' protocol and method-map pairs:
   each pair in order, a trailing odd entry dropped -- what the head call
   runs. A pair whose protocol the registry holds none of is the oracle's
   IllegalArgumentException. Nil removes the type's row, a map replaces it
   with a fresh row holding each entry naming a method of the protocol, and
   anything else replaces it as-is: the oracle's assoc-in of the map,
   replacing the type's map, like the head call (g43). A type whose body
   already implements the protocol refuses like the oracle's. Answers nil
   like the oracle."
  (if (null args)
      (rontolisp::%clojure-fn-arity-error 0 "clojure.core/extend")
      (let ((key (rontolisp::%clojure-extends-key (car args)))
            (pairs (cdr args)))
        (do ((rest pairs (cdr (cdr rest))))
            ((or (null rest) (null (cdr rest))) nil)
          (let* ((proto (car rest))
                 (mmap (car (cdr rest)))
                 (record (gethash proto rontolisp::%clojure-protocols)))
            (if (null record)
                (rontolisp::%clojure-illegal-argument-exception
                 (concatenate 'string (rontolisp::%clojure-str-of proto "" nil)
                              " is not a protocol"))
                (let* ((methods (funcall (car record)))
                       (ensurer (car (cdr (cdr (cdr record)))))
                       (names (car (cdr (cdr (cdr (cdr (cdr (cdr record))))))))
                       (reducer
                        (car (cdr (cdr (cdr (cdr (cdr (cdr (cdr record)))))))))
                       (pkey
                        (car
                         (cdr
                          (cdr (cdr (cdr (cdr (cdr (cdr (cdr record))))))))))
                       (iface
                        (car
                         (cdr
                          (cdr
                           (cdr (cdr (cdr (cdr (cdr (cdr (cdr record)))))))))))
                       (clearer
                        (car
                         (cdr
                          (cdr
                           (cdr
                            (cdr
                             (cdr (cdr (cdr (cdr (cdr (cdr record))))))))))))
                       (typed
                        (and (consp key)
                         (gethash key rontolisp::%clojure-protocol-type-tags))))
                  ;; a body implementation holds the protocol's interface
                  ;; already: extending one refuses, like the oracle (g43)
                  (if (and typed (member pkey (cdr typed) :test #'equal))
                      (rontolisp::%clojure-illegal-argument-exception
                       (concatenate 'string "class " (car typed)
                                    " already directly implements interface "
                                    iface " for protocol:#'" pkey))
                      (if (eq key :default)
                          (cond ((null mmap) (funcall clearer))
                                ((or (hash-table-p mmap)
                                     (rontolisp::%clojure-record-p mmap)
                                     (rontolisp::%clojure-sorted-p mmap))
                                 (funcall clearer
                                          (make-hash-table :test 'equal))
                                 (dolist (e
                                          (rontolisp::%clojure-kv-pairs mmap
                                           "extend"))
                                   (let ((k (car e)))
                                     (if (and (rontolisp::%clojure-keyword-p k)
                                              (member (car (cdr k)) names
                                                      :test #'equal))
                                         (setf (gethash k (funcall ensurer))
                                               (cdr e))))))
                                (t (funcall clearer mmap)))
                          (cond ((null mmap) (remhash key methods))
                                ((or (hash-table-p mmap)
                                     (rontolisp::%clojure-record-p mmap)
                                     (rontolisp::%clojure-sorted-p mmap))
                                 (setf (gethash key methods)
                                       (make-hash-table :test 'equal))
                                 (dolist (e
                                          (rontolisp::%clojure-kv-pairs mmap
                                           "extend"))
                                   (let ((k (car e)))
                                     (if (and (rontolisp::%clojure-keyword-p k)
                                              (member (car (cdr k)) names
                                                      :test #'equal))
                                         (rontolisp::%clojure-extend-method
                                          methods key k (cdr e) reducer
                                          typed)))))
                                (t (setf (gethash key methods) mmap))))))))))))

;;;; Protocol introspection: extenders, find-protocol-impl, find-protocol-method.
;;
;; A protocol var holds its method table (a tag to its row of method keyword
;; to function), with the Object default in a table of its own nil until the
;; first Object extension. extenders answers the extended tags in their walk
;; order with :object for the default, like the oracle's seq of classes; of a
;; value holding no table (a non-protocol) it answers nil, where the oracle's
;; answers nil too. find-protocol-impl answers the tag row's map, else the
;; default's, else nil; find-protocol-method the row's function, else the
;; default's, else nil -- where the oracle answers the same, except that a
;; non-protocol is its NullPointerException there.

(defun rontolisp::%clojure-protocol-row (methods default x)
  "The method-keyword-to-function table X's tag has in METHODS, else the
   Object default's, else nil."
  (let ((row (and (hash-table-p methods) (gethash (c%protocol-tag x) methods))))
    (if (hash-table-p row) row (and (hash-table-p default) default))))

(defun rontolisp::%clojure-extenders (methods default)
  "(extenders p): the extended tags as a seq, :object last when the Object
   default exists; nil of none."
  (if (not (hash-table-p methods))
      nil
      (let ((out nil))
        (maphash (lambda (k ignored)
                   (declare (ignore ignored))
                   (setq out (cons k out))) methods)
        (setq out (nreverse out))
        (if (hash-table-p default)
            (setq out (append out (list (list :c%keyword "object")))))
        out)))

(defun rontolisp::%clojure-extenders-v (&rest args)
  "extenders as a value."
  (rontolisp::%clojure-check-arity args 1 1 "extenders")
  (rontolisp::%clojure-extenders (car args) nil))

(defun rontolisp::%clojure-find-protocol-impl (methods default x)
  "(find-protocol-impl p x): the map of X's implementation, else the Object
   default's, else nil."
  (let ((row (rontolisp::%clojure-protocol-row methods default x)))
    (and row (rontolisp::%clojure-plist-table row nil))))

(defun rontolisp::%clojure-find-protocol-impl-v (&rest args)
  "find-protocol-impl as a value."
  (rontolisp::%clojure-check-arity args 2 2 "find-protocol-impl")
  (rontolisp::%clojure-find-protocol-impl (car args) nil (car (cdr args))))

(defun rontolisp::%clojure-find-protocol-method (methods default m x)
  "(find-protocol-method p m x): X's function for the method key M, else the
   Object default's, else nil."
  (let ((row (rontolisp::%clojure-protocol-row methods default x)))
    (and row (gethash m row))))

(defun rontolisp::%clojure-find-protocol-method-v (&rest args)
  "find-protocol-method as a value."
  (rontolisp::%clojure-check-arity args 3 3 "find-protocol-method")
  (rontolisp::%clojure-find-protocol-method (car args) nil (car (cdr args))
                                            (car (cdr (cdr args)))))

;;;; Checked casts: cast of a computed class.
;;
;; cast of a class the lowering names is the instance test inline; of a
;; computed one this worker, like instance? of a class value: a class keyword
;; casts by the protocol tag (what class answers for every value but a host
;; object), a host class object by the kind its name has here (a number's
;; class by its keyword, any other numeric class by numberp: an int is a Long
;; here) else by asking the host, nil is the
;; oracle's NullPointerException and anything else its ClassCastException. nil
;; casts to nil past a class.

(defun rontolisp::%clojure-cast-kind (name)
  "The class keyword a value of the host class NAME has here, or nil: what
   c%protocol-tag answers for one, so cast of a computed host class takes the
   values it takes on every backend."
  (let ((kind
         (cond
          ((or (equal name "java.lang.String")
               (equal name "java.lang.CharSequence"))
           "string")
          ((or (equal name "java.lang.Long") (equal name "java.lang.Double")
               (equal name "clojure.lang.BigInt")
               (equal name "clojure.lang.Ratio"))
           name)
          ((or (equal name "java.lang.Integer") (equal name "java.lang.Short")
               (equal name "java.lang.Byte") (equal name "java.lang.Float")
               (equal name "java.lang.Number")
               (equal name "java.math.BigInteger")
               (equal name "java.math.BigDecimal") (equal name "long")
               (equal name "int") (equal name "short") (equal name "byte")
               (equal name "double") (equal name "float"))
           "number")
          ((or (equal name "java.lang.Character") (equal name "char")) "char")
          ((or (equal name "java.lang.Boolean") (equal name "boolean"))
           "boolean")
          ((equal name "clojure.lang.Keyword") "keyword")
          ((equal name "clojure.lang.Symbol") "symbol")
          ((equal name "clojure.lang.IPersistentVector") "vector")
          ((equal name "clojure.lang.IPersistentMap") "map")
          ((equal name "clojure.lang.IPersistentSet") "set")
          ((or (equal name "clojure.lang.ISeq")
               (equal name "clojure.lang.Sequential")
               (equal name "clojure.lang.IPersistentList"))
           "list")
          ((or (equal name "clojure.lang.IFn")
               (equal name "clojure.lang.AFunction"))
           "function")
          ((or (equal name "clojure.lang.Atom") (equal name "clojure.lang.Ref")
               (equal name "clojure.lang.Agent"))
           "atom")
          ((or (equal name "clojure.lang.PersistentTreeMap")
               (equal name "clojure.lang.Sorted"))
           "map")
          ((equal name "clojure.lang.PersistentTreeSet") "set")
          (t nil))))
    (and kind (list :c%keyword kind))))

(defun rontolisp::%clojure-cast (c x)
  "(cast c x): X when it is an instance of C, else the oracle's refusal."
  (cond
   ((rontolisp::%clojure-keyword-p c)
    (if (null x)
        nil
        (if (equal (c%protocol-tag x) c)
            x
            (rontolisp::%clojure-class-cast-exception
             (concatenate 'string "Cannot cast "
                          (rontolisp::%clojure-class-name-of x) " to "
                          (car (cdr c)))))))
   ((null c)
    (rontolisp::%clojure-null-pointer-exception
     "Cannot invoke \"java.lang.Class.cast(Object)\" because \"c\" is null"))
   (t (let ((name (rontolisp::%clojure-host-class-name c)))
        (if (null name)
            (rontolisp::%clojure-host-cast-failure c "java.lang.Class")
            (if (null x)
                nil
                (let ((kind (rontolisp::%clojure-cast-kind name)))
                  (if (or (equal name "java.lang.Object")
                       (and kind (equal (c%protocol-tag x) kind))
                       (and kind (equal (car (cdr kind)) "number") (numberp x))
                       (and (null kind)
                            (rontolisp::%clojure-host-class-instance-p c x)))
                      x
                      (rontolisp::%clojure-class-cast-exception
                       (concatenate 'string "Cannot cast "
                                    (rontolisp::%clojure-class-name-of x) " to "
                                    name))))))))))

(defun rontolisp::%clojure-cast-v (&rest args)
  "cast as a value."
  (rontolisp::%clojure-check-arity args 2 2 "cast")
  (rontolisp::%clojure-cast (car args) (car (cdr args))))

;;;; Type and collection predicates.
;;
;; Each answers a CL boolean; the lowering (ClojurePredicateLowering) wraps the
;; call in (if ... T false), so a predicate as a value is a one-argument lambda
;; over the same test. A tagged wrapper is a list whose car is a CL keyword,
;; which no user list holds, so a list test excludes keywords, atoms, vars,
;; records, patterns and the other wrappers. nil is the empty list here, so
;; every seq and collection test answers false for it, like the oracle's nil;
;; its () answers true there.

(defun rontolisp::%clojure-is-list (x)
  "list?: a list that is no tagged wrapper. A strict seq shares the
   representation (what map or filter of a strict input answers), so it is one
   too, where the oracle's is a LazySeq."
  (and (consp x) (not (keywordp (car x)))))

(defun rontolisp::%clojure-is-seq (x)
  "seq?: a list or a lazy seq."
  (or (rontolisp::%clojure-is-list x) (rontolisp::%clojure-lazy-p x)))

(defun rontolisp::%clojure-is-vector (x)
  "A Clojure vector: a CL vector that is no string (indexed?, reversible?)."
  (and (vectorp x) (not (stringp x))))

(defun rontolisp::%clojure-is-sequential (x)
  "sequential?: a list, a lazy seq or a vector."
  (or (rontolisp::%clojure-is-seq x) (rontolisp::%clojure-is-vector x)))

;; Every collection predicate takes a sorted map or set too (an arm).
(defun rontolisp::%clojure-is-map (x)
  "map?: a map or a record."
  (or (hash-table-p x) (rontolisp::%clojure-record-p x)
      (rontolisp::%clojure-sorted-map-p x)))

(defun rontolisp::%clojure-is-coll (x)
  "coll?: a list, lazy seq, vector, map, set or record."
  (or (rontolisp::%clojure-is-sequential x) (rontolisp::%clojure-is-map x)
      (rontolisp::%clojure-set-p x) (rontolisp::%clojure-sorted-set-p x)))

;; A type implementing the interface a predicate names answers true: arms of
;; the seqable, counted, indexed, invokable and char-sequence families ("Host
;; interfaces"), and of the iterable and java-map families ("Collection
;; interfaces").
(defun rontolisp::%clojure-is-seqable (x)
  "seqable?: what seq takes -- nil, a string or a collection."
  (or (null x) (stringp x) (rontolisp::%clojure-is-coll x)
      (rontolisp::%clojure-seqable-p x) (rontolisp::%clojure-iterable-p x)
      (rontolisp::%clojure-jmap-p x) (rontolisp::%clojure-bytes-p x)
      (rontolisp::%clojure-char-sequence-p x)))

;; The predicates over a type implementing a collection interface: each answers
;; the plain helper's test or the interface's, an arm of its family
;; ("Collection interfaces"). A program storing no row of the family calls the
;; plain helper in its place (the family's alias); the plain helpers stay what
;; the library itself asks.
(defun rontolisp::%clojure-is-coll-type (x)
  "coll?: a core collection, or a type implementing IPersistentCollection."
  (or (rontolisp::%clojure-is-coll x) (rontolisp::%clojure-icollection-p x)))

(defun rontolisp::%clojure-is-seq-type (x)
  "seq?: a list or a lazy seq, or a type implementing ISeq."
  (or (rontolisp::%clojure-is-seq x) (rontolisp::%clojure-iseq-p x)))

(defun rontolisp::%clojure-is-list-type (x)
  "list?: a list, or a type implementing IPersistentList."
  (or (rontolisp::%clojure-is-list x) (rontolisp::%clojure-ilist-p x)))

(defun rontolisp::%clojure-is-sequential-type (x)
  "sequential?: a list, a lazy seq or a vector, or a type implementing
   Sequential."
  (or (rontolisp::%clojure-is-sequential x)
      (rontolisp::%clojure-isequential-p x)))

(defun rontolisp::%clojure-is-map-type (x)
  "map?: a map or a record, or a type implementing IPersistentMap."
  (or (rontolisp::%clojure-is-map x) (rontolisp::%clojure-imap-p x)))

(defun rontolisp::%clojure-is-set-type (x)
  "set?: a set, or a type implementing IPersistentSet."
  (or (rontolisp::%clojure-is-set x) (rontolisp::%clojure-iset-p x)))

(defun rontolisp::%clojure-is-associative-type (x)
  "associative?: a map, a record or a vector, or a type implementing
   Associative."
  (or (rontolisp::%clojure-is-associative x)
      (rontolisp::%clojure-iassociative-p x)))

(defun rontolisp::%clojure-is-reversible-type (x)
  "reversible?: what rseq takes, or a type implementing Reversible."
  (or (rontolisp::%clojure-is-reversible x)
      (rontolisp::%clojure-ireversible-p x)))

(defun rontolisp::%clojure-is-indexed (x)
  "indexed?: a vector, or a type implementing Indexed. A program storing no
   Indexed row calls %clojure-is-vector in its place (the family's alias)."
  (or (rontolisp::%clojure-is-vector x) (rontolisp::%clojure-indexed-p x)))

(defun rontolisp::%clojure-is-associative (x)
  "associative?: a map, a record or a vector."
  (or (rontolisp::%clojure-is-map x) (rontolisp::%clojure-is-vector x)))

(defun rontolisp::%clojure-is-counted (x)
  "counted?: a list, vector, map, set or record; a lazy seq is not."
  (or (rontolisp::%clojure-is-list x) (rontolisp::%clojure-is-vector x)
      (rontolisp::%clojure-is-map x) (rontolisp::%clojure-set-p x)
      (rontolisp::%clojure-sorted-set-p x) (rontolisp::%clojure-counted-p x)
      (rontolisp::%clojure-transient-p x)))

(defun rontolisp::%clojure-is-ifn (x)
  "ifn?: a function, keyword, symbol, map, set, vector, var or an unbound var's
   root (the oracle's Var$Unbound is an AFn). A record is no IFn, like the
   oracle's, unless its body implements it."
  (or (functionp x) (rontolisp::%clojure-keyword-p x)
      (rontolisp::%clojure-real-symbol-p x) (hash-table-p x)
      (rontolisp::%clojure-set-p x) (rontolisp::%clojure-is-vector x)
      (rontolisp::%clojure-var-p x) (rontolisp::%clojure-sorted-p x)
      (rontolisp::%clojure-invokable-p x) (rontolisp::%clojure-transient-p x)
      (rontolisp::%clojure-unbound-p x) (rontolisp::%clojure-meta-symbol-p x)))

(defun rontolisp::%clojure-is-int (x)
  "int?: an integer a long holds (the oracle's Long, Integer, Short, Byte)."
  (and (integerp x) (<= -9223372036854775808 x 9223372036854775807)))

(defun rontolisp::%clojure-is-bigint (x)
  "instance? clojure.lang.BigInt: an integer past a long (the integer 1N
   reads as is a Long here)."
  (and (integerp x) (not (rontolisp::%clojure-is-int x))))

(defun rontolisp::%clojure-number-class (x)
  "class of the number X: the keyword of the oracle's class -- a Long, a
   BigInt past a long, a Double, else a Ratio."
  (cond ((integerp x)
         (if (rontolisp::%clojure-is-int x)
             '(:c%keyword "java.lang.Long")
             '(:c%keyword "clojure.lang.BigInt")))
        ((floatp x) '(:c%keyword "java.lang.Double"))
        (t '(:c%keyword "clojure.lang.Ratio"))))

(defun rontolisp::%clojure-is-nat-int (x)
  "nat-int?: an int? that is not negative."
  (and (rontolisp::%clojure-is-int x) (>= x 0)))

(defun rontolisp::%clojure-is-pos-int (x)
  "pos-int?: an int? above zero."
  (and (rontolisp::%clojure-is-int x) (> x 0)))

(defun rontolisp::%clojure-is-neg-int (x)
  "neg-int?: an int? below zero."
  (and (rontolisp::%clojure-is-int x) (< x 0)))

(defun rontolisp::%clojure-is-ratio (x)
  "ratio?: a rational that is no integer."
  (and (rationalp x) (not (integerp x))))

(defun rontolisp::%clojure-is-infinite (x)
  "infinite?: a double past either end of the range; any other number is
   finite, anything else signals, like the oracle's cast."
  (if (numberp x)
      (and (floatp x)
       (or (> x most-positive-double-float) (< x most-negative-double-float)))
      (rontolisp::%clojure-class-cast-exception-of "infinite? needs a number"
                                                   x)))

(defun rontolisp::%clojure-is-nan (x)
  "NaN?: a double that is not = to itself; anything else that is no number
   signals, like the oracle's cast."
  (if (numberp x)
      (and (floatp x) (/= x x))
      (rontolisp::%clojure-class-cast-exception-of "NaN? needs a number" x)))

(defun rontolisp::%clojure-is-ident (x)
  "ident?: a keyword or a symbol, one carrying metadata too."
  (or (rontolisp::%clojure-keyword-p x) (rontolisp::%clojure-real-symbol-p x)
      (rontolisp::%clojure-meta-symbol-p x)))

(defun rontolisp::%clojure-is-qualified (x keywords symbols qualified)
  "Whether X is a keyword (KEYWORDS true) or a symbol (SYMBOLS true, one
   carrying metadata too) whose namespace is present (QUALIFIED true) or
   absent: the simple-/qualified- ident, keyword and symbol predicates."
  (if (or (and keywords (rontolisp::%clojure-keyword-p x))
          (and symbols
               (or (rontolisp::%clojure-real-symbol-p x)
                   (rontolisp::%clojure-meta-symbol-p x))))
      (if (rontolisp::%clojure-namespace x) qualified (not qualified))
      nil))

(defun rontolisp::%clojure-is-volatile (x)
  "volatile?: the atom cell volatile! builds, which carries a second slot."
  (and (rontolisp::%clojure-atom-p x) (= (length (car (cdr x))) 2)))

;; A type implementing IPending answers its isRealized: an arm of the
;; pending-interface family ("Collection interfaces").
(defun rontolisp::%clojure-is-realized (x)
  "realized?: whether the lazy seq, delay, future or promise X has run its
   body. A list (what
   the seq verbs answer over a strict input) is realized; anything else signals,
   like the oracle's cast."
  (cond ((rontolisp::%clojure-lazy-p x) (null (car (car (cdr x)))))
        ((rontolisp::%clojure-is-list x) t)
        ;; a delay whose body has run (or signalled): an arm a program making
        ;; none folds
        ((rontolisp::%clojure-delay-p x) (null (aref (car (cdr x)) 0)))
        ;; a Clojure future (future, future-call): done once its task is, like
        ;; the oracle's isRealized -- an arm a program making none folds
        ((rontolisp::%clojure-future-wrapper-p x)
         (rontolisp::%clojure-host-future-done-p
          (rontolisp::%clojure-future-task x)))
        ;; a Clojure promise (promise): whether it was delivered -- an arm a
        ;; program making none folds
        ((rontolisp::%clojure-promise-p x) (aref (car (cdr x)) 1))
        ((rontolisp::%clojure-ipending-p x)
         (rontolisp::%clojure-ipending-realized x))
        (t (rontolisp::%clojure-class-cast-exception-of
            "realized? needs a lazy seq" x))))

(defun rontolisp::%clojure-is-bound (vars)
  "bound?: every one of VARS is a var whose root is no unbound marker (a
   declared-never-defined name, a value-less def). A macro's var (:macro in its
   metadata, the oracle's own mark) is bound without taking its root, which
   signals. Anything that is no var signals, like the oracle's cast; stops at
   the first var that is not bound, like its every?."
  (let ((ok t))
    (dolist (v vars ok)
      (if ok
          (progn
            (if (not (rontolisp::%clojure-var-p v))
                (rontolisp::%clojure-class-cast-exception-of "bound? needs vars"
                                                             v))
            (let ((root
                   (if (rontolisp::%clojure-truthy
                        (rontolisp::%clojure-call-keyword
                         (list :C%KEYWORD "macro") (rontolisp::%clojure-meta v)
                         nil))
                       nil
                       (rontolisp::%clojure-var-get v))))
              (if (rontolisp::%clojure-unbound-p root) (setq ok nil))))))))

(defun rontolisp::%clojure-is-thread-bound (vars)
  "thread-bound?: every one of VARS is a dynamic var under a binding right now.
   A var site of a ^:dynamic var carries its binding-depth reader as a fourth
   element, so any other var is never thread-bound, like the oracle's; anything
   that is no var signals, like its cast. Stops at the first var that is not."
  (let ((ok t))
    (dolist (v vars ok)
      (if ok
          (progn
            (if (not (rontolisp::%clojure-var-p v))
                (rontolisp::%clojure-class-cast-exception-of
                 "thread-bound? needs vars" v))
            (let ((depth (cdr (cdr (cdr v)))))
              (if (or (null depth) (<= (funcall (car depth)) 0))
                  (setq ok nil))))))))

(defun rontolisp::%clojure-is-thread-bound-v (&rest args)
  "thread-bound? as a value."
  (if (rontolisp::%clojure-is-thread-bound args) t rontolisp::%clojure-false))

(defun rontolisp::%clojure-is-special-symbol (x)
  "special-symbol?: one of the oracle's special form names."
  (if (rontolisp::%clojure-meta-symbol-p x)
      (rontolisp::%clojure-is-special-symbol (car (cdr x)))
      (if (rontolisp::%clojure-real-symbol-p x)
          (let ((s (rontolisp::%clojure-symbol-full-name x)) (found nil))
            (dolist (f '("def" "loop*" "recur" "if" "case*" "let*" "letfn*" "do"
                         "fn*" "quote" "var" "clojure.core/import*" "." "set!"
                         "deftype*" "reify*" "try" "throw" "monitor-enter"
                         "monitor-exit" "catch" "finally" "new" "&") found)
              (if (equal s f) (setq found t))))
          nil)))

(defun rontolisp::%clojure-is-identical (a b)
  "identical?: eql, except that two keywords of one spelling are one object,
   like the oracle's interned keywords (here each is a fresh list). Numbers and
   characters compare by value."
  (if (and (rontolisp::%clojure-keyword-p a) (rontolisp::%clojure-keyword-p b))
      (equal (car (cdr a)) (car (cdr b)))
      (eql a b)))

(defun rontolisp::%clojure-is-distinct (xs)
  "distinct?: no two of XS are =, through the structural-key runtime like
   distinct."
  (let ((seen (make-hash-table :test 'equal)) (ok t))
    (dolist (x xs ok)
      (if (and ok (not (rontolisp::%clojure-distinct-new-p x seen)))
          (setq ok nil)))))

(defun rontolisp::%clojure-is-distinct-v (&rest args)
  "distinct? as a value."
  (rontolisp::%clojure-check-arity args 1 nil "distinct?")
  (if (rontolisp::%clojure-is-distinct args) t rontolisp::%clojure-false))

(defun rontolisp::%clojure-is-bound-v (&rest args)
  "bound? as a value."
  (if (rontolisp::%clojure-is-bound args) t rontolisp::%clojure-false))

;; A Date or a Timestamp (the instant family's arm, so a program making no
;; instant keeps the two host tests alone), else a host Date or Instant.
(defun rontolisp::%clojure-is-inst (x)
  "inst?: a host java.util.Date or java.time.Instant."
  (or (rontolisp::%clojure-inst-p x)
      (rontolisp::%clojure-host-instance-p x "java.util.Date")
      (rontolisp::%clojure-host-instance-p x "java.time.Instant")))

;;;; clojure.set: the relational set library over the set wrapper.
;;
;; The oracle's own algorithms (clojure/set.clj), so an answer's kind follows the
;; same input as there: union grows its largest input, intersection shrinks its
;; smallest, difference and select shrink the first. A set grows or shrinks in a
;; fresh copy, nil stays nil, and an input nothing changes is answered itself. A
;; relation is a set of maps; a member may be a record (read through its entry
;; table), and merge / rename-keys keep the record where the oracle keeps it.
;; Each var has a worker the call lowering (ClojureSetLowering) calls after its own
;; arity check -- the variadic ones over a list of their sets -- and a -v entry the
;; value lowering names, which checks the count at run time in the oracle's
;; wording.

(defun rontolisp::%clojure-set-arity (args min max name)
  "The count of ARGS, or the oracle's arity error for clojure.set/NAME when it
   falls outside MIN..MAX (a nil MAX has no upper bound)."
  (let ((n (length args)))
    (if (or (< n min) (and max (> n max)))
        (rontolisp::%clojure-arity-exception
         (format nil "Wrong number of args (~D) passed to: clojure.set/~A" n
                 name))
        n)))

(defun rontolisp::%clojure-set-count (coll)
  "count as the set algorithms read it: a set, map or record by its entries,
   nil none, a vector or string by length, a seq by its realized length."
  (cond ((null coll) 0)
   ((rontolisp::%clojure-set-p coll) (hash-table-count (car (cdr coll))))
   ((rontolisp::%clojure-record-p coll)
    (hash-table-count (car (cdr (cdr (cdr coll))))))
   ((hash-table-p coll) (hash-table-count coll))
   ((vectorp coll) (length coll))
   ((rontolisp::%clojure-sorted-p coll) (rontolisp::%clojure-sorted-count coll))
   (t (length (rontolisp::%clojure-seq-all coll)))))

;; contains? of KEY in COLL past every arm holding it (the lowering's last
;; clause): nil and a vector hold nothing else; a string under a non-integer
;; real is the oracle's index test over its truncation (the integer arm took
;; an integer), under anything else refused like a list, a seq, a number, a
;; keyword or any other value that is no collection.
(defun rontolisp::%clojure-contains-past (coll key)
  (if (or (null coll) (vectorp coll))
      rontolisp::%clojure-false
      (rontolisp::%clojure-illegal-argument-exception
       "contains? not supported on this collection")))

(defun rontolisp::%clojure-set-has (coll x)
  "contains? as the set algorithms read it: a set by member, a map or record by
   key (found by =), a vector or string by index; nil holds nothing, anything
   else signals."
  (let ((miss (list nil)))
    (cond ((null coll) nil)
          ((rontolisp::%clojure-set-p coll)
           (let ((table (car (cdr coll))))
             (not
              (eq (gethash (rontolisp::%clojure-table-key x table) table miss)
                  miss))))
          ((rontolisp::%clojure-record-p coll)
           (rontolisp::%clojure-set-has (car (cdr (cdr (cdr coll)))) x))
          ((hash-table-p coll)
           (not
            (eq (gethash (rontolisp::%clojure-table-key x coll) coll miss)
                miss)))
          ((vectorp coll) (and (integerp x) (<= 0 x) (< x (length coll))))
          ((rontolisp::%clojure-sorted-p coll)
           (rontolisp::%clojure-sorted-contains coll x))
          (t (rontolisp::%clojure-illegal-argument-exception
              "contains? not supported on this collection")))))

(defun rontolisp::%clojure-set-of (members)
  "A fresh set of the list MEMBERS."
  (let ((table (make-hash-table :test 'equal)))
    (dolist (x members) (rontolisp::%clojure-set-put table x))
    (list :C%SET table)))

(defun rontolisp::%clojure-set-copy (s)
  "A fresh set wrapper holding the members of the set S (already
   representatives, so stored as they are)."
  (let ((table (make-hash-table :test 'equal)))
    (maphash (lambda (k v)
               (declare (ignore v))
               (setf (gethash k table) k)) (car (cdr s)))
    (list :C%SET table)))

(defun rontolisp::%clojure-set-grow (base items)
  "(reduce conj BASE ITEMS) for the list ITEMS: BASE itself when ITEMS is
   empty; else a set gains each in a fresh copy, a vector each at its end, nil
   or a seq each at its front; anything else signals."
  (cond ((null items) base)
   ((rontolisp::%clojure-set-p base)
    (let ((out (rontolisp::%clojure-set-copy base)))
      (dolist (x items out) (rontolisp::%clojure-set-put (car (cdr out)) x))))
   ((and (vectorp base) (not (stringp base)))
    (coerce (append (coerce base 'list) items) 'vector))
   ((rontolisp::%clojure-sequential-p base)
    (let ((out (rontolisp::%clojure-seq-all base)))
      (dolist (x items out) (setq out (cons x out)))))
   ((rontolisp::%clojure-sorted-set-p base)
    (let ((out base))
      (dolist (x items out)
        (setq out (rontolisp::%clojure-sorted-conj out x)))))
   (t (rontolisp::%clojure-class-cast-exception "clojure.set needs sets"))))

(defun rontolisp::%clojure-set-shrink (base drops)
  "(reduce disj BASE DROPS) for the list DROPS: BASE itself when DROPS is empty
   or BASE is nil; else a set loses each in a fresh copy; anything else
   signals."
  (cond ((or (null drops) (null base)) base)
        ((rontolisp::%clojure-set-p base)
         (let ((out (rontolisp::%clojure-set-copy base)))
           (dolist (x drops out)
             (remhash (rontolisp::%clojure-table-key x (car (cdr out)))
                      (car (cdr out))))))
        ((rontolisp::%clojure-sorted-set-p base)
         (let ((table (car (cdr (rontolisp::%clojure-sorted-hashed base)))))
           (dolist (x drops)
             (remhash (rontolisp::%clojure-table-key
                       (rontolisp::%clojure-sorted-key x base) table) table))
           (rontolisp::%clojure-sorted-shrunk (list :C%SET table) base)))
        (t (rontolisp::%clojure-class-cast-exception "disj needs a set"))))

(defun rontolisp::%clojure-set-bubble (sets largest)
  "The oracle's bubble-max-key over the list SETS by count (LARGEST true) or by
   its negation: the last extreme set first, then the others without any copy
   identical to it."
  (let ((best (car sets))
        (best-n (rontolisp::%clojure-set-count (car sets)))
        (rest nil))
    (dolist (s (cdr sets))
      (let ((n (rontolisp::%clojure-set-count s)))
        (if (if largest (>= n best-n) (<= n best-n))
            (progn
              (setq best s)
              (setq best-n n)))))
    (dolist (s sets) (if (not (eq s best)) (setq rest (cons s rest))))
    (cons best (reverse rest))))

(defun rontolisp::%clojure-set-union (sets)
  "clojure.set/union over the list SETS: of none the empty set, of one itself,
   of two the smaller conjoined onto the larger, of more every other set into
   the largest."
  (cond ((null sets) (list :C%SET (make-hash-table :test 'equal)))
        ((null (cdr sets)) (car sets))
        ((null (cdr (cdr sets)))
         (let ((a (car sets)) (b (car (cdr sets))))
           (if (< (rontolisp::%clojure-set-count a)
                  (rontolisp::%clojure-set-count b))
               (rontolisp::%clojure-set-grow b (rontolisp::%clojure-seq-all a))
               (rontolisp::%clojure-set-grow a
                                             (rontolisp::%clojure-seq-all b)))))
        (t (let* ((bubbled (rontolisp::%clojure-set-bubble sets t))
                  (acc (car bubbled)))
             (dolist (s (cdr bubbled) acc)
               (setq acc
                     (rontolisp::%clojure-set-grow acc
                      (rontolisp::%clojure-seq-all s))))))))

(defun rontolisp::%clojure-set-union-v (&rest sets)
  "union as a value."
  (rontolisp::%clojure-set-union sets))

(defun rontolisp::%clojure-set-intersection-2 (a b)
  "The members of A that B holds, shrinking the smaller of the two."
  (if (< (rontolisp::%clojure-set-count b) (rontolisp::%clojure-set-count a))
      (rontolisp::%clojure-set-intersection-2 b a)
      (let ((drops nil))
        (dolist (x (rontolisp::%clojure-seq-all a))
          (if (not (rontolisp::%clojure-set-has b x))
              (setq drops (cons x drops))))
        (rontolisp::%clojure-set-shrink a drops))))

(defun rontolisp::%clojure-set-intersection (sets)
  "clojure.set/intersection over the non-empty list SETS: of more than two,
   from the smallest on."
  (cond ((null (cdr sets)) (car sets))
        ((null (cdr (cdr sets)))
         (rontolisp::%clojure-set-intersection-2 (car sets) (car (cdr sets))))
        (t (let* ((bubbled (rontolisp::%clojure-set-bubble sets nil))
                  (acc (car bubbled)))
             (dolist (s (cdr bubbled) acc)
               (setq acc (rontolisp::%clojure-set-intersection-2 acc s)))))))

(defun rontolisp::%clojure-set-intersection-v (&rest sets)
  "intersection as a value."
  (rontolisp::%clojure-set-arity sets 1 nil "intersection")
  (rontolisp::%clojure-set-intersection sets))

(defun rontolisp::%clojure-set-difference-2 (a b)
  "A without the members B holds: walking A when it is the smaller, else
   dropping every member of B."
  (if (< (rontolisp::%clojure-set-count a) (rontolisp::%clojure-set-count b))
      (let ((drops nil))
        (dolist (x (rontolisp::%clojure-seq-all a))
          (if (rontolisp::%clojure-set-has b x) (setq drops (cons x drops))))
        (rontolisp::%clojure-set-shrink a drops))
      (rontolisp::%clojure-set-shrink a (rontolisp::%clojure-seq-all b))))

(defun rontolisp::%clojure-set-difference (sets)
  "clojure.set/difference over the non-empty list SETS, left to right."
  (let ((acc (car sets)))
    (dolist (s (cdr sets) acc)
      (setq acc (rontolisp::%clojure-set-difference-2 acc s)))))

(defun rontolisp::%clojure-set-difference-v (&rest sets)
  "difference as a value."
  (rontolisp::%clojure-set-arity sets 1 nil "difference")
  (rontolisp::%clojure-set-difference sets))

(defun rontolisp::%clojure-set-select (pred xset)
  "The members of XSET that PRED passes (a set shrunk, nil itself)."
  (let ((drops nil))
    (dolist (x (rontolisp::%clojure-seq-all xset))
      (if (not (rontolisp::%clojure-filter-test pred x))
          (setq drops (cons x drops))))
    (rontolisp::%clojure-set-shrink xset drops)))

(defun rontolisp::%clojure-set-select-v (&rest args)
  "select as a value."
  (rontolisp::%clojure-set-arity args 2 2 "select")
  (rontolisp::%clojure-set-select (car args) (car (cdr args))))

(defun rontolisp::%clojure-set-entries (m name)
  "The entry table of the map M (a record's own), nil for nil; anything else
   signals in NAME's words."
  (cond ((null m) nil)
        ((rontolisp::%clojure-record-p m) (car (cdr (cdr (cdr m)))))
        ((hash-table-p m) m)
        ((rontolisp::%clojure-sorted-map-p m)
         (rontolisp::%clojure-sorted-table m name))
        (t (rontolisp::%clojure-class-cast-exception-of
            (format nil "~A needs a map" name) m))))

(defun rontolisp::%clojure-set-keys (m name)
  "The keys of the map M as a list (none of nil)."
  (let ((acc nil) (table (rontolisp::%clojure-set-entries m name)))
    (if table
        (maphash (lambda (k v)
                   (declare (ignore v))
                   (setq acc (cons k acc))) table))
    acc))

;; A sorted map M takes TABLE back as a sorted map under its comparator.
(defun rontolisp::%clojure-set-rewrap (m table)
  "TABLE in the record M's place when M is a record, else TABLE."
  (if (rontolisp::%clojure-record-p m)
      (list :C%RECORD (car (cdr m)) (car (cdr (cdr m))) table
            (car (cdr (cdr (cdr (cdr m))))))
      (rontolisp::%clojure-sorted-rewrap table m)))

(defun rontolisp::%clojure-set-select-keys (m ks)
  "(select-keys M KS) for the key list KS: a fresh map of M's entries under
   those keys, each kept under M's own key."
  (let ((out (make-hash-table :test 'equal))
        (miss (list nil))
        (src (rontolisp::%clojure-set-entries m "select-keys")))
    (if src
        (dolist (k ks)
          (let* ((held (rontolisp::%clojure-table-key k src))
                 (v (gethash held src miss)))
            (if (not (eq v miss)) (setf (gethash held out) v)))))
    out))

(defun rontolisp::%clojure-set-merge (a b)
  "(merge A B) for two relation members: A's entries plus B's, B winning, in a
   fresh map, kept in A's record when A is one."
  (let ((eb (rontolisp::%clojure-set-entries b "merge")))
    (rontolisp::%clojure-set-rewrap a
                                    (rontolisp::%clojure-plist-table
                                     (rontolisp::%clojure-set-entries a "merge")
                                     (if eb
                                         (rontolisp::%clojure-table-plist eb)
                                         nil)))))

(defun rontolisp::%clojure-set-project (xrel ks)
  "The set of every member of XREL narrowed to the keys KS."
  (let ((keys (rontolisp::%clojure-seq-all ks)))
    (rontolisp::%clojure-set-of
     (mapcar (lambda (x) (rontolisp::%clojure-set-select-keys x keys))
             (rontolisp::%clojure-seq-all xrel)))))

(defun rontolisp::%clojure-set-project-v (&rest args)
  "project as a value."
  (rontolisp::%clojure-set-arity args 2 2 "project")
  (rontolisp::%clojure-set-project (car args) (car (cdr args))))

(defun rontolisp::%clojure-set-rename-keys (m kmap)
  "M with each key of KMAP present in it renamed to KMAP's value for it, every
   KMAP key dropped first; nil is nil. A record stays one unless a declared
   field is dropped, like the oracle's dissoc."
  (if (null m)
      nil
      (let* ((src (rontolisp::%clojure-set-entries m "rename-keys"))
             (pairs (rontolisp::%clojure-kv-pairs kmap "rename-keys"))
             (out (rontolisp::%copy-equal-table src))
             (miss (list nil))
             (record (rontolisp::%clojure-record-p m)))
        (dolist (p pairs)
          (remhash (rontolisp::%clojure-table-key (car p) out) out))
        (if record
            (dolist (f (car (cdr (cdr m))))
              (if (eq (gethash f out miss) miss) (setq record nil))))
        (dolist (p pairs)
          (let ((v
                 (gethash (rontolisp::%clojure-table-key (car p) src) src
                          miss)))
            (if (not (eq v miss))
                (setf (gethash (rontolisp::%clojure-store-key (cdr p) out) out)
                      v))))
        (if record
            (rontolisp::%clojure-set-rewrap m out)
            (rontolisp::%clojure-sorted-rewrap out m)))))

(defun rontolisp::%clojure-set-rename-keys-v (&rest args)
  "rename-keys as a value."
  (rontolisp::%clojure-set-arity args 2 2 "rename-keys")
  (rontolisp::%clojure-set-rename-keys (car args) (car (cdr args))))

(defun rontolisp::%clojure-set-rename (xrel kmap)
  "The set of every member of XREL with its keys renamed by KMAP."
  (rontolisp::%clojure-set-of
   (mapcar (lambda (x) (rontolisp::%clojure-set-rename-keys x kmap))
           (rontolisp::%clojure-seq-all xrel))))

(defun rontolisp::%clojure-set-rename-v (&rest args)
  "rename as a value."
  (rontolisp::%clojure-set-arity args 2 2 "rename")
  (rontolisp::%clojure-set-rename (car args) (car (cdr args))))

(defun rontolisp::%clojure-set-index (xrel ks)
  "A map from each distinct narrowing of XREL's members to the keys KS to the
   set of the members narrowing to it."
  (let ((keys (rontolisp::%clojure-seq-all ks))
        (out (make-hash-table :test 'equal))
        (miss (list nil)))
    (dolist (x (rontolisp::%clojure-seq-all xrel) out)
      (let* ((k
              (rontolisp::%clojure-store-key
               (rontolisp::%clojure-set-select-keys x keys) out))
             (s (gethash k out miss)))
        (if (eq s miss)
            (progn
              (setq s (list :C%SET (make-hash-table :test 'equal)))
              (setf (gethash k out) s)))
        (rontolisp::%clojure-set-put (car (cdr s)) x)))))

(defun rontolisp::%clojure-set-index-v (&rest args)
  "index as a value."
  (rontolisp::%clojure-set-arity args 2 2 "index")
  (rontolisp::%clojure-set-index (car args) (car (cdr args))))

(defun rontolisp::%clojure-set-map-invert (m)
  "A fresh map from each value of M to its key."
  (let ((out (make-hash-table :test 'equal)))
    (dolist (kv (rontolisp::%clojure-kv-pairs m "map-invert") out)
      (setf (gethash (rontolisp::%clojure-store-key (cdr kv) out) out)
            (car kv)))))

(defun rontolisp::%clojure-set-map-invert-v (&rest args)
  "map-invert as a value."
  (rontolisp::%clojure-set-arity args 1 1 "map-invert")
  (rontolisp::%clojure-set-map-invert (car args)))

(defun rontolisp::%clojure-set-join-index (r s ks rekey)
  "The join walk: every member x of S merged onto each member of R that the
   index of R by KS files under x's narrowing to (REKEY x)'s keys."
  (let ((idx (rontolisp::%clojure-set-index r ks))
        (out (make-hash-table :test 'equal))
        (miss (list nil)))
    (dolist (x (rontolisp::%clojure-seq-all s))
      (let* ((k (funcall rekey x))
             (found (gethash (rontolisp::%clojure-table-key k idx) idx miss)))
        (if (not (eq found miss))
            (dolist (m (rontolisp::%clojure-seq-all found))
              (rontolisp::%clojure-set-put out
               (rontolisp::%clojure-set-merge m x))))))
    (list :C%SET out)))

(defun rontolisp::%clojure-set-join (xrel yrel)
  "The natural join of two relations on the keys their first members share,
   indexing the smaller; the empty set when either is empty."
  (if (and (rontolisp::%clojure-seq xrel) (rontolisp::%clojure-seq yrel))
      (let* ((yfirst
              (rontolisp::%clojure-set-entries
               (car (rontolisp::%clojure-seq yrel)) "join"))
             (ks nil)
             (small
              (<= (rontolisp::%clojure-set-count xrel)
                  (rontolisp::%clojure-set-count yrel))))
        (dolist (k
                 (rontolisp::%clojure-set-keys
                  (car (rontolisp::%clojure-seq xrel)) "join"))
          (if (rontolisp::%clojure-set-has yfirst k) (setq ks (cons k ks))))
        (rontolisp::%clojure-set-join-index (if small xrel yrel)
         (if small yrel xrel) ks
         (lambda (x) (rontolisp::%clojure-set-select-keys x ks))))
      (list :C%SET (make-hash-table :test 'equal))))

(defun rontolisp::%clojure-set-join-km (xrel yrel km)
  "The join of two relations where KM maps XREL's keys to YREL's, indexing the
   smaller."
  (let* ((small
          (<= (rontolisp::%clojure-set-count xrel)
              (rontolisp::%clojure-set-count yrel)))
         (k (if small (rontolisp::%clojure-set-map-invert km) km))
         (pairs (rontolisp::%clojure-kv-pairs k "join"))
         (from (mapcar (lambda (p) (car p)) pairs)))
    (rontolisp::%clojure-set-join-index (if small xrel yrel)
                                        (if small yrel xrel)
                                        (mapcar (lambda (p) (cdr p)) pairs)
                                        (lambda (x)
                                          (rontolisp::%clojure-set-rename-keys
                                           (rontolisp::%clojure-set-select-keys
                                            x from) k)))))

(defun rontolisp::%clojure-set-join-v (&rest args)
  "join as a value: two relations, or two and a key map."
  (if (= (rontolisp::%clojure-set-arity args 2 3 "join") 2)
      (rontolisp::%clojure-set-join (car args) (car (cdr args)))
      (rontolisp::%clojure-set-join-km (car args) (car (cdr args))
                                       (car (cdr (cdr args))))))

(defun rontolisp::%clojure-set-subset-p (a b)
  "Whether every member of A is in B, the false object otherwise."
  (let ((ok
         (<= (rontolisp::%clojure-set-count a)
             (rontolisp::%clojure-set-count b))))
    (if ok
        (dolist (x (rontolisp::%clojure-seq-all a))
          (if (not (rontolisp::%clojure-set-has b x)) (setq ok nil))))
    (if ok t rontolisp::%clojure-false)))

(defun rontolisp::%clojure-set-subset-p-v (&rest args)
  "subset? as a value."
  (rontolisp::%clojure-set-arity args 2 2 "subset?")
  (rontolisp::%clojure-set-subset-p (car args) (car (cdr args))))

(defun rontolisp::%clojure-set-superset-p (a b)
  "Whether every member of B is in A, the false object otherwise."
  (rontolisp::%clojure-set-subset-p b a))

(defun rontolisp::%clojure-set-superset-p-v (&rest args)
  "superset? as a value."
  (rontolisp::%clojure-set-arity args 2 2 "superset?")
  (rontolisp::%clojure-set-subset-p (car (cdr args)) (car args)))

;;;; Sorted collections: sorted-map, sorted-set, their -by forms, subseq and
;;;; rsubseq, and compare, their default order; vector-of beside them.
;;
;; A sorted collection is (:C%SORTED setp cmp items): SETP true for a set, NIL for
;; a map; CMP the comparator function a -by form took, or NIL for compare, which
;; then also refuses a key that is neither nil, a number nor Comparable, like the
;; oracle's default comparator; ITEMS a simple vector in comparator order, a set's
;; members or a map's [k v] entries (seq answers the entries themselves). Like a
;; hash map it is never mutated: each verb answers a fresh one, copying ITEMS (an
;; association costs O(n), as a hash map's copy does). A lookup is a binary search
;; under the comparator, so a key comparing equal to a stored one finds it --
;; (get (sorted-map 1 :a) 1.0) is :a -- and an association keeps the stored key,
;; like the oracle's tree.
;;
;; Every other verb reaches this through an arm testing %clojure-sorted-p,
;; %clojure-sorted-map-p or %clojure-sorted-set-p, or through a pass-through view
;; answering its first argument for anything that is no sorted collection
;; (%clojure-sorted-key, %clojure-sorted-items, %clojure-sorted-hashed,
;; %clojure-sorted-shrunk, %clojure-sorted-rewrap): the lowering's inline map and
;; set verbs, and this file's printer, =, hash, seq, IFn, assoc, find, reduce-kv,
;; replace and clojure.set. A program that builds no sorted collection has every
;; arm and view stripped before the splice (clojure/ClojureArms: a test
;; folds to false, a view to its first argument), so it compiles to the bytes it
;; did before sorted collections existed. Hence the shape each arm keeps: its test
;; names a variable (or a car/cdr of one) and is a cond clause's test, an if's
;; test or a disjunct of an or; a view's other arguments are variables too. An arm
;; added to an existing defun leaves its docstring as it was: the JVM backend keeps
;; every docstring in the class it writes, so a changed one changes that class.

(defun rontolisp::%clojure-sorted-p (x)
  "Whether X is a sorted map or set: the (:C%SORTED setp cmp items) wrapper."
  (and (consp x) (eq (car x) :C%SORTED)))

(defun rontolisp::%clojure-sorted-map-p (x)
  "Whether X is a sorted map."
  (and (consp x) (eq (car x) :C%SORTED) (null (car (cdr x)))))

(defun rontolisp::%clojure-sorted-set-p (x)
  "Whether X is a sorted set."
  (and (consp x) (eq (car x) :C%SORTED) (not (null (car (cdr x))))))

;; A type implementing Sorted is sorted too: an arm of the sorted-interface
;; family ("Collection interfaces").
(defun rontolisp::%clojure-is-sorted (x)
  "sorted?: a sorted map or set."
  (declare (ignorable x))
  (if (or (rontolisp::%clojure-sorted-p x) (rontolisp::%clojure-isorted-p x))
      t
      nil))

(defun rontolisp::%clojure-is-set (x)
  "set?: a set or a sorted set. A program that builds no sorted collection
   calls %clojure-set-p in its place (the strip's alias)."
  (or (rontolisp::%clojure-set-p x) (rontolisp::%clojure-sorted-set-p x)))

(defun rontolisp::%clojure-is-reversible (x)
  "reversible?: what rseq takes -- a vector, a sorted map or a sorted set. A
   program that builds no sorted collection calls %clojure-is-vector in its
   place (the strip's alias)."
  (or (rontolisp::%clojure-is-vector x) (rontolisp::%clojure-sorted-p x)))

(defun rontolisp::%clojure-compare-strings (a b)
  "The oracle's String.compareTo: the difference of the first character codes
   that differ, else of the lengths."
  (let ((n (min (length a) (length b))) (i 0) (d 0))
    (do ()
        ((or (/= d 0) (>= i n)) (if (/= d 0) d (- (length a) (length b))))
      (setq d (- (char-code (char a i)) (char-code (char b i))))
      (setq i (+ i 1)))))

(defun rontolisp::%clojure-compare-names (a b)
  "The oracle's Symbol.compareTo over two spellings: one without a namespace
   before one with, then the namespaces, then the names, each as compareTo."
  (let ((na (rontolisp::%clojure-split-namespace a))
        (nb (rontolisp::%clojure-split-namespace b)))
    (cond ((equal a b) 0)
          ((and (null na) nb) -1)
          ((and na (null nb)) 1)
          (t (let ((c (if na (rontolisp::%clojure-compare-strings na nb) 0)))
               (if (/= c 0)
                   c
                   (rontolisp::%clojure-compare-strings
                    (rontolisp::%clojure-split-name a)
                    (rontolisp::%clojure-split-name b))))))))

(defun rontolisp::%clojure-compare-vectors (a b)
  "The oracle's vector compareTo: the shorter first, else the first member pair
   compare tells apart."
  (cond ((< (length a) (length b)) -1)
        ((> (length a) (length b)) 1)
        (t (let ((c 0) (i 0) (n (length a)))
             (do ()
                 ((or (/= c 0) (>= i n)) c)
               (setq c (rontolisp::%clojure-compare (aref a i) (aref b i)))
               (setq i (+ i 1)))))))

(defun rontolisp::%clojure-compare (a b)
  "compare, the oracle's Util.compare over the values here: nil before anything,
   numbers by value across their kinds (1 and 1.0 are 0, NaN against anything
   0), strings, keywords and symbols as compareTo (the difference of the first
   characters that differ; a name without a namespace first), characters by
   their difference, false before true, vectors by length and then member by
   member. Two values of different kinds, or of a kind with no order (a list, a
   map, a set, a function ...), signal."
  (cond ((eq a b) 0)
   ((null a) -1)
   ((null b) 1)
   ((and (numberp a) (numberp b)) (cond ((< a b) -1) ((< b a) 1) (t 0)))
   ((and (stringp a) (stringp b)) (rontolisp::%clojure-compare-strings a b))
   ((and (characterp a) (characterp b)) (- (char-code a) (char-code b)))
   ((and (or (eq a t) (eq a rontolisp::%clojure-false))
         (or (eq b t) (eq b rontolisp::%clojure-false)))
    (if (eq a t) 1 -1))
   ((and (rontolisp::%clojure-keyword-p a) (rontolisp::%clojure-keyword-p b))
    (rontolisp::%clojure-compare-names (car (cdr a)) (car (cdr b))))
   ((and (rontolisp::%clojure-real-symbol-p a)
         (rontolisp::%clojure-real-symbol-p b))
    (rontolisp::%clojure-compare-names (rontolisp::%clojure-symbol-full-name a)
     (rontolisp::%clojure-symbol-full-name b)))
   ;; a symbol carrying metadata orders as its bare symbol: an arm of the
   ;; symbol-meta family
   ((or (rontolisp::%clojure-meta-symbol-p a)
        (rontolisp::%clojure-meta-symbol-p b))
    (rontolisp::%clojure-compare (rontolisp::%clojure-symbol-bare a)
                                 (rontolisp::%clojure-symbol-bare b)))
   ((and (vectorp a) (not (stringp a)) (vectorp b) (not (stringp b)))
    (rontolisp::%clojure-compare-vectors a b))
   ;; an instant or a UUID orders against its own kind, like the oracle's
   ;; compareTo
   ((rontolisp::%clojure-instant-p a) (rontolisp::%clojure-instant-compare a b))
   ((rontolisp::%clojure-uuid-p a) (rontolisp::%clojure-uuid-compare a b))
   ;; a type implementing Comparable answers its compareTo: an arm of the
   ;; comparable-interface family ("Collection interfaces")
   ((rontolisp::%clojure-icomparable-p a)
    (rontolisp::%clojure-icomparable-compare a b))
   ;; a host Comparable answers its compareTo, a Date, Timestamp or UUID made
   ;; here as the host object it stands for: an arm of the host-object family
   ((rontolisp::%clojure-host-object-p a "java.lang.Comparable")
    (java:call (the (java:object "java.lang.Comparable") a) "compareTo"
               (if (or (rontolisp::%clojure-date-p b)
                       (rontolisp::%clojure-timestamp-p b)
                       (rontolisp::%clojure-uuid-p b))
                   (rontolisp::%clojure-time-value-host b)
                   b)))
   (t (rontolisp::%clojure-class-cast-exception
       "compare needs two values of one comparable kind"))))

(defun rontolisp::%clojure-compare-v (&rest args)
  "compare as a value."
  (rontolisp::%clojure-check-arity args 2 2 "compare")
  (rontolisp::%clojure-compare (car args) (car (cdr args))))

(defun rontolisp::%clojure-comparable-p (x)
  "Whether X is a value compare orders: nil, a number, a string, a character, a
   boolean, a keyword, a symbol or a vector -- the oracle's nil, Number or
   Comparable."
  (or (symbolp x) (numberp x) (stringp x) (characterp x)
      (rontolisp::%clojure-keyword-p x) (and (vectorp x) (not (stringp x)))
      (rontolisp::%clojure-instant-p x) (rontolisp::%clojure-uuid-p x)
      (rontolisp::%clojure-icomparable-p x)
      (rontolisp::%clojure-host-object-p x "java.lang.Comparable")))

(defun rontolisp::%clojure-comparator-p (x)
  "Whether X is a comparator sort and the sorted collections order through: a
   function, a record, deftype or reify implementing java.util.Comparator, or
   a host Comparator."
  (or (functionp x)
      ;; a type implementing Comparator: an arm of the comparable-interface
      ;; family ("Collection interfaces")
      (rontolisp::%clojure-icomparator-p x)
      ;; a host Comparator: an arm of the host-object family
      (rontolisp::%clojure-host-object-p x "java.util.Comparator")))

(defun rontolisp::%clojure-comparator-compare (cmp a b)
  "The int order the comparator CMP puts A and B in: a host Comparator's
   compare, a record, deftype or reify implementing Comparator's compare row,
   else the AFunction.compare reading of the function CMP (true -1, false asks
   the reversed call, a number its integer part)."
  (cond ;; a host Comparator answers its compareTo-like compare, an arm of the
        ;; host-object family
        ((rontolisp::%clojure-host-object-p cmp "java.util.Comparator")
         (java:call (the (java:object "java.util.Comparator") cmp) "compare" a
                    b))
        ;; a Comparator type answers its compare row, an arm of the
        ;; comparable-interface family ("Collection interfaces")
        ((rontolisp::%clojure-icomparator-p cmp)
         (let ((c
                (funcall (rontolisp::%clojure-call-method cmp "compare") cmp a
                         b)))
           (if (integerp c)
               c
               (rontolisp::%clojure-class-cast-exception-of
                "the answer of compare cannot be cast to class java.lang.Number"
                c))))
        (t (rontolisp::%clojure-cmp-call cmp a b))))

(defun rontolisp::%clojure-cmp-call (cmp a b)
  "The order the comparator function CMP puts A and B in, the oracle's
   AFunction.compare: true is -1; false asks (CMP B A), 1 when that is truthy,
   else 0; a number is its integer part (0.5 is 0, NaN 0); anything else, nil
   included, signals."
  (let ((r (funcall cmp a b)))
    (cond ((eq r t) -1)
          ((eq r rontolisp::%clojure-false)
           (if (rontolisp::%clojure-truthy (funcall cmp b a)) 1 0))
          ((integerp r) r)
          ((floatp r)
           (cond ((/= r r) 0)
                 ((> r 2147483647) 2147483647)
                 ((< r -2147483648) -2147483648)
                 (t (truncate r))))
          ((numberp r) (truncate r))
          (t (rontolisp::%clojure-class-cast-exception-of
              "a comparator answers a number or a boolean" r)))))

(defun rontolisp::%clojure-sorted-order (cmp a b)
  "The order of A and B under a sorted collection's comparator CMP: its
   function, or compare when CMP is NIL."
  (if cmp
      (rontolisp::%clojure-comparator-compare cmp a b)
      (rontolisp::%clojure-compare a b)))

(defun rontolisp::%clojure-sorted-check (cmp k)
  "K, or the oracle's refusal when CMP is NIL (compare orders) and K is no
   value compare orders."
  (if (or cmp (rontolisp::%clojure-comparable-p k))
      k
      (rontolisp::%clojure-class-cast-exception
       (concatenate 'string
                    "Default comparator requires nil, Number, or Comparable: "
                    (rontolisp::%clojure-str-of k "null" nil)))))

(defun rontolisp::%clojure-sorted-item-key (s item)
  "The key of ITEM in the sorted collection S: the member itself in a set, the
   entry's key in a map."
  (if (car (cdr s)) item (aref item 0)))

(defun rontolisp::%clojure-sorted-search (s k)
  "Where the key K sits in the sorted collection S: the index of the member or
   entry whose key compares equal to it, else (- -1 i) for the index i it sorts
   in at. The comparator is asked (cmp K stored), like the oracle's tree."
  (let* ((cmp (car (cdr (cdr s))))
         (items (car (cdr (cdr (cdr s)))))
         (lo 0)
         (hi (- (length items) 1))
         (found nil))
    (do ()
        ((or found (> lo hi)) (if found found (- -1 lo)))
      (let* ((mid (truncate (+ lo hi) 2))
             (c
              (rontolisp::%clojure-sorted-order cmp k
               (rontolisp::%clojure-sorted-item-key s (aref items mid)))))
        (cond ((< c 0) (setq hi (- mid 1)))
              ((> c 0) (setq lo (+ mid 1)))
              (t (setq found mid)))))))

(defun rontolisp::%clojure-sorted-with (s items)
  "A sorted collection of S's kind and comparator holding the vector ITEMS."
  (list :C%SORTED (car (cdr s)) (car (cdr (cdr s))) items))

(defun rontolisp::%clojure-sorted-insert (s i item)
  "A copy of the sorted collection S with ITEM inserted at index I."
  (let* ((items (car (cdr (cdr (cdr s)))))
         (n (length items))
         (out (make-array (+ n 1))))
    (dotimes (j i) (setf (aref out j) (aref items j)))
    (setf (aref out i) item)
    (do ((j i (+ j 1)))
        ((>= j n))
      (setf (aref out (+ j 1)) (aref items j)))
    (rontolisp::%clojure-sorted-with s out)))

(defun rontolisp::%clojure-sorted-replace (s i item)
  "A copy of the sorted collection S with its item at index I replaced by ITEM."
  (let* ((items (car (cdr (cdr (cdr s))))) (out (make-array (length items))))
    (dotimes (j (length items)) (setf (aref out j) (aref items j)))
    (setf (aref out i) item)
    (rontolisp::%clojure-sorted-with s out)))

(defun rontolisp::%clojure-sorted-make (setp cmp items)
  "A sorted set (SETP true) of the member list ITEMS, or a sorted map of the
   plist ITEMS, under the comparator function CMP (NIL for compare). One stable
   sort orders them, so of keys comparing equal the first stays and, in a map,
   the last value wins: the oracle's conj after conj, assoc after assoc. A key
   without a value, a CMP that is no function and, under compare, a key it does
   not order signal like the oracle."
  (if (and cmp (not (rontolisp::%clojure-comparator-p cmp)))
      (rontolisp::%clojure-class-cast-exception
       "a sorted collection needs a comparator function"))
  (let ((entries nil))
    (if setp
        (dolist (x items)
          (setq entries
                (cons (rontolisp::%clojure-sorted-check cmp x) entries)))
        (do ((p items (cdr (cdr p))))
            ((null p))
          (if (null (cdr p))
              (rontolisp::%clojure-illegal-argument-exception
               (concatenate 'string "No value supplied for key: "
                            (rontolisp::%clojure-str-of (car p) "null" nil))))
          (setq entries
                (cons (vector (rontolisp::%clojure-sorted-check cmp (car p))
                              (car (cdr p))) entries))))
    (let ((sorted
           (stable-sort (nreverse entries)
                        (lambda (a b)
                          (< (rontolisp::%clojure-sorted-order cmp
                              (if setp a (aref a 0)) (if setp b (aref b 0)))
                             0))))
          (out nil))
      (dolist (x sorted)
        (if (and out
                 (= 0
                    (rontolisp::%clojure-sorted-order cmp
                     (if setp (car out) (aref (car out) 0))
                     (if setp x (aref x 0)))))
            (if (not setp) (setf (aref (car out) 1) (aref x 1)))
            (setq out (cons x out))))
      (list :C%SORTED setp cmp (coerce (nreverse out) 'vector)))))

(defun rontolisp::%clojure-sorted-map-v (&rest kvs)
  "sorted-map as a value."
  (rontolisp::%clojure-sorted-make nil nil kvs))

(defun rontolisp::%clojure-sorted-map-by-v (&rest args)
  "sorted-map-by as a value."
  (rontolisp::%clojure-check-arity args 1 nil "sorted-map-by")
  (rontolisp::%clojure-sorted-make nil (car args) (cdr args)))

(defun rontolisp::%clojure-sorted-set-v (&rest xs)
  "sorted-set as a value."
  (rontolisp::%clojure-sorted-make t nil xs))

(defun rontolisp::%clojure-sorted-set-by-v (&rest args)
  "sorted-set-by as a value."
  (rontolisp::%clojure-check-arity args 1 nil "sorted-set-by")
  (rontolisp::%clojure-sorted-make t (car args) (cdr args)))

(defun rontolisp::%clojure-sorted-put (s k v)
  "The sorted map S with V under K: the entry whose key compares equal to K
   keeps that key and takes V, else a fresh entry sorts in."
  (let ((i (rontolisp::%clojure-sorted-search s k)))
    (if (>= i 0)
        (rontolisp::%clojure-sorted-replace s i
         (vector (aref (aref (car (cdr (cdr (cdr s)))) i) 0) v))
        (rontolisp::%clojure-sorted-insert s (- -1 i)
         (vector (rontolisp::%clojure-sorted-check (car (cdr (cdr s))) k) v)))))

(defun rontolisp::%clojure-sorted-assoc (s plist)
  "(assoc S k v ...) for the sorted collection S: each pair in turn through
   %clojure-sorted-put; a sorted set signals, like the oracle."
  (if (car (cdr s))
      (rontolisp::%clojure-class-cast-exception
       "assoc needs a map or a vector, not a set"))
  (let ((out s))
    (do ((p plist (cdr (cdr p))))
        ((null p) out)
      (setq out (rontolisp::%clojure-sorted-put out (car p) (car (cdr p)))))))

(defun rontolisp::%clojure-sorted-entry-plist (item one)
  "The entries conj adds to a map from ITEM, as a plist: none of nil, the pair
   of a [k v] vector, a map's or record's entries, and -- ONE false -- a set's
   members each a [k v] vector (the oracle casts them to map entries); anything
   else, a list included, signals."
  (cond (one (if (and (vectorp item) (not (stringp item)) (= (length item) 2))
                 (list (aref item 0) (aref item 1))
                 (rontolisp::%clojure-class-cast-exception-of
                  "conj needs a map entry: a map, a [k v] vector or nil" item)))
        ((null item) nil)
        ((and (vectorp item) (not (stringp item)) (= (length item) 2))
         (list (aref item 0) (aref item 1)))
        ((hash-table-p item) (rontolisp::%clojure-table-plist item))
        ((rontolisp::%clojure-sorted-map-p item)
         (rontolisp::%clojure-sorted-plist item))
        ((rontolisp::%clojure-record-p item)
         (rontolisp::%clojure-table-plist (car (cdr (cdr (cdr item))))))
        ((or (rontolisp::%clojure-set-p item)
             (rontolisp::%clojure-sorted-set-p item))
         (let ((acc nil))
           (dolist (m (rontolisp::%clojure-strict-seq item) acc)
             (setq acc
                   (append acc (rontolisp::%clojure-sorted-entry-plist m t))))))
        ((consp item) (rontolisp::%clojure-seq-entry-plist item))
        ((rontolisp::%clojure-host-seqable-p item)
         (rontolisp::%clojure-host-entry-plist item))
        (t (rontolisp::%clojure-map-entry-refusal
            "conj needs a map entry: a map, a [k v] vector or nil" item))))

(defun rontolisp::%clojure-seq-entry-plist (item)
  "The entries a sorted map or a seq (strict or lazy) ITEM adds to a map, as a
   plist: a sorted map's pairs in order, a seq's members each a [k v] vector
   (a map entry is a plain two-vector here, so a seq of vectors is accepted
   where the oracle casts to Map.Entry); any other member signals."
  (if (rontolisp::%clojure-sorted-map-p item)
      (rontolisp::%clojure-sorted-plist item)
      (let ((acc nil) (s (rontolisp::%clojure-seq item)))
        (do ()
            ((null s) (reverse acc))
          (let ((m (car s)))
            (if (and (vectorp m) (not (stringp m)) (= (length m) 2))
                (setq acc (cons (aref m 1) (cons (aref m 0) acc)))
                (rontolisp::%clojure-class-cast-exception-of
                 "conj needs a map entry: a map, a [k v] vector or nil" m)))
          (setq s (rontolisp::%clojure-seq-rest s))))))

(defun rontolisp::%clojure-merge-entry-plist (item)
  "The entries a later merge ITEM adds, as a plist (merge is conj folded over the
   maps): none of nil, a map's or record's pairs, a [k v] vector's pair, a sorted
   map's pairs, or the members of a set or seq each a [k v] vector; anything else,
   a list of non-entries included, signals."
  (cond ((null item) nil)
        ((hash-table-p item) (rontolisp::%clojure-table-plist item))
        ((and (vectorp item) (not (stringp item)) (= (length item) 2))
         (list (aref item 0) (aref item 1)))
        ((rontolisp::%clojure-record-p item)
         (rontolisp::%clojure-table-plist (car (cdr (cdr (cdr item))))))
        ((consp item) (rontolisp::%clojure-seq-entry-plist item))
        ((rontolisp::%clojure-host-seqable-p item)
         (rontolisp::%clojure-host-entry-plist item))
        (t (rontolisp::%clojure-map-entry-refusal
            "conj needs a map entry: a map, a [k v] vector or nil" item))))

(defun rontolisp::%clojure-hash-map-put-all (target source)
  "(.putAll TARGET SOURCE) where the host is not: the entries of the map SOURCE
   stored into TARGET's table, answering nil, like the oracle's mutation of its
   java.util.HashMap -- malli's fast-registry fills its (HashMap. 1024 0.25)
   this way at load, then reads it back with .get. A map or record source reads
   through the same entries merge takes, each key stored through
   %clojure-store-key like %clojure-plist-table stores it; nil is the oracle's
   NullPointerException, anything but a map its ClassCastException to
   java.util.Map (without the module tail). The target is always a table: the
   lowering answers a record or a sorted map the oracle's message-less
   UnsupportedOperationException, and anything else its no-such-method refusal."
  (if (or (hash-table-p source) (rontolisp::%clojure-record-p source)
          (rontolisp::%clojure-sorted-map-p source))
      (let ((entries (rontolisp::%clojure-merge-entry-plist source)))
        (do ((p entries (cdr (cdr p))))
            ((null p) nil)
          (setf (gethash (rontolisp::%clojure-store-key (car p) target) target)
                (car (cdr p)))))
      (if (null source)
          (rontolisp::%clojure-null-pointer-exception
           "Cannot invoke \"java.util.Map.size()\" because \"m\" is null")
          (rontolisp::%clojure-class-cast-exception
           (concatenate 'string "class "
                        (rontolisp::%clojure-class-name-of source)
                        " cannot be cast to class java.util.Map")))))

(defun rontolisp::%clojure-sorted-conj (s item)
  "(conj S ITEM) for the sorted collection S: a set gains ITEM unless a member
   compares equal to it (that member stays); a map gains ITEM's entries
   (%clojure-sorted-entry-plist), nil adding nothing, like the oracle."
  (if (car (cdr s))
      (let ((i (rontolisp::%clojure-sorted-search s item)))
        (if (>= i 0)
            s
            (rontolisp::%clojure-sorted-insert s (- -1 i)
             (rontolisp::%clojure-sorted-check (car (cdr (cdr s))) item))))
      (rontolisp::%clojure-sorted-assoc s
       (rontolisp::%clojure-sorted-entry-plist item nil))))

(defun rontolisp::%clojure-sorted-get (s k dflt)
  "K looked up in the sorted collection S: a set answers the member comparing
   equal to K, a map that key's value, else DFLT."
  (let ((i (rontolisp::%clojure-sorted-search s k)))
    (if (>= i 0)
        (let ((item (aref (car (cdr (cdr (cdr s)))) i)))
          (if (car (cdr s)) item (aref item 1)))
        dflt)))

(defun rontolisp::%clojure-sorted-contains (s k)
  "Whether the sorted collection S holds a key comparing equal to K."
  (>= (rontolisp::%clojure-sorted-search s k) 0))

(defun rontolisp::%clojure-sorted-find (s k)
  "(find S K): the stored [k v] entry of the sorted map S whose key compares
   equal to K, nil when none; a sorted set signals, like the oracle."
  (if (car (cdr s))
      (rontolisp::%clojure-illegal-argument-exception
       "find not supported on this type"))
  (let ((i (rontolisp::%clojure-sorted-search s k)))
    (if (>= i 0) (aref (car (cdr (cdr (cdr s)))) i) nil)))

(defun rontolisp::%clojure-sorted-count (s)
  "The member or entry count of the sorted collection S."
  (length (car (cdr (cdr (cdr s))))))

(defun rontolisp::%clojure-sorted-seq (s)
  "The seq of the sorted collection S in order: its members or [k v] entries,
   nil when it is empty."
  (coerce (car (cdr (cdr (cdr s)))) 'list))

(defun rontolisp::%clojure-sorted-items (x)
  "The ITEMS vector of X in order when it is a sorted collection, else X: the
   view rseq reads, so its vector arm walks a sorted collection backwards."
  (if (rontolisp::%clojure-sorted-p x) (car (cdr (cdr (cdr x)))) x))

(defun rontolisp::%clojure-sorted-keys (s which)
  "The keys (WHICH 0) or values (WHICH 1) of the sorted map S in order, nil
   when it is empty; a sorted set signals, like the oracle."
  (if (car (cdr s))
      (rontolisp::%clojure-class-cast-exception
       (if (= which 0) "keys needs a map" "vals needs a map")))
  (let ((acc nil) (items (car (cdr (cdr (cdr s))))))
    (do ((i (- (length items) 1) (- i 1)))
        ((< i 0) acc)
      (setq acc (cons (aref (aref items i) which) acc)))))

(defun rontolisp::%clojure-sorted-plist (s)
  "The entries of the sorted map S as a plist, in order."
  (let ((acc nil) (items (car (cdr (cdr (cdr s))))))
    (do ((i (- (length items) 1) (- i 1)))
        ((< i 0) acc)
      (setq acc
       (cons (aref (aref items i) 0) (cons (aref (aref items i) 1) acc))))))

(defun rontolisp::%clojure-sorted-kv-pairs (s)
  "The (key . value) pairs of the sorted map S, in order."
  (let ((acc nil) (items (car (cdr (cdr (cdr s))))))
    (do ((i (- (length items) 1) (- i 1)))
        ((< i 0) acc)
      (setq acc
       (cons (cons (aref (aref items i) 0) (aref (aref items i) 1)) acc)))))

(defun rontolisp::%clojure-sorted-table (s name)
  "A fresh map of the sorted map S's entries, each key stored through the
   structural-key runtime: what a verb written over hash tables walks
   (dissoc's copy, select-keys, the later maps of merge-with), whose lookups
   pass through %clojure-sorted-key first, so a key comparing equal finds its
   entry. A sorted set signals in NAME's words."
  (if (car (cdr s))
      (rontolisp::%clojure-class-cast-exception
       (format nil "~A needs a map" name)))
  (rontolisp::%clojure-plist-table nil (rontolisp::%clojure-sorted-plist s)))

(defun rontolisp::%clojure-sorted-hashed (x)
  "X as a hash set of its members when it is a sorted set, else X: the view
   disj's copy reads (its drops pass through %clojure-sorted-key, its answer
   through %clojure-sorted-shrunk)."
  (if (rontolisp::%clojure-sorted-set-p x)
      (let ((table (make-hash-table :test 'equal))
            (items (car (cdr (cdr (cdr x))))))
        (dotimes (i (length items))
          (rontolisp::%clojure-set-put table (aref items i)))
        (list :C%SET table))
      x))

(defun rontolisp::%clojure-sorted-key (k coll)
  "The key the sorted collection COLL stores for K, the one comparing equal to
   it, else K (COLL no sorted collection, or holding none): the view a lookup
   takes, ahead of %clojure-table-key, into a table of COLL's entries or
   members (dissoc, disj, select-keys)."
  (if (rontolisp::%clojure-sorted-p coll)
      (let ((i (rontolisp::%clojure-sorted-search coll k)))
        (if (>= i 0)
            (rontolisp::%clojure-sorted-item-key coll
             (aref (car (cdr (cdr (cdr coll)))) i))
            k))
      k))

(defun rontolisp::%clojure-sorted-shrunk (x orig)
  "X -- the hash map or hash set dissoc or disj built over a table of ORIG's
   entries or members, the dropped ones removed -- back as ORIG's kind when
   ORIG is sorted: ORIG's items X still holds, in order. Else X."
  (if (rontolisp::%clojure-sorted-p orig)
      (let* ((setp (car (cdr orig)))
             (table (if setp (car (cdr x)) x))
             (items (car (cdr (cdr (cdr orig)))))
             (miss (list nil))
             (kept nil))
        (dotimes (i (length items))
          (let ((item (aref items i)))
            (if (not
                 (eq (gethash (rontolisp::%clojure-table-key
                               (if setp item (aref item 0)) table) table miss)
                     miss))
                (setq kept (cons item kept)))))
        (rontolisp::%clojure-sorted-with orig (coerce (nreverse kept) 'vector)))
      x))

(defun rontolisp::%clojure-sorted-rewrap (x orig)
  "X -- a hash map a clojure.set verb built from ORIG's entries -- as a sorted
   map under ORIG's comparator when ORIG is a sorted map and X a hash map, else
   X."
  (if (rontolisp::%clojure-sorted-map-p orig)
      (if (hash-table-p x)
          (rontolisp::%clojure-sorted-make nil (car (cdr (cdr orig)))
                                           (rontolisp::%clojure-table-plist x))
          x)
      x))

(defun rontolisp::%clojure-sorted-merge-with (f maps)
  "(merge-with F maps...) whose first map is sorted, the oracle's reduce of
   merge-entry: every later map's entries join it in turn, F (a real function)
   over the old and the new value where a key comparing equal arrives again,
   so the answer stays sorted under its comparator."
  (let ((acc (car maps)))
    (dolist (m (cdr maps) acc)
      (if m
          (dolist (kv (rontolisp::%clojure-kv-pairs m "merge-with"))
            (let ((i (rontolisp::%clojure-sorted-search acc (car kv))))
              (setq acc
                    (rontolisp::%clojure-sorted-put acc (car kv)
                                                    (if (>= i 0)
                                                        (funcall f
                                                                 (aref
                                                                  (aref
                                                                   (car
                                                                    (cdr
                                                                     (cdr
                                                                      (cdr
                                                                       acc))))
                                                                   i) 1)
                                                                 (cdr kv))
                                                        (cdr kv))))))))))

(defun rontolisp::%clojure-sorted-lookup (coll k miss)
  "K's value in the map COLL (its member in a set), MISS when COLL holds none:
   a sorted collection by its comparator, a hash map or set by =."
  (if (rontolisp::%clojure-sorted-p coll)
      (rontolisp::%clojure-sorted-get coll k miss)
      (let ((table (if (hash-table-p coll) coll (car (cdr coll)))))
        (gethash (rontolisp::%clojure-table-key k table) table miss))))

(defun rontolisp::%clojure-sorted-equal (a b)
  "= when A or B is a sorted collection, the oracle's equiv on A's side: two
   sets (hash or sorted) of one count are = when A holds every member of B, two
   maps when B holds every key of A under an = value -- each lookup by its own
   collection's comparator, or by = in a hash one, as there. Anything else is
   unequal."
  (let ((miss (list nil)) (ok t))
    (cond ((and (or (rontolisp::%clojure-set-p a)
                    (rontolisp::%clojure-sorted-set-p a))
                (or (rontolisp::%clojure-set-p b)
                    (rontolisp::%clojure-sorted-set-p b)))
           (if (= (rontolisp::%clojure-set-count a)
                  (rontolisp::%clojure-set-count b))
               (dolist (m (rontolisp::%clojure-strict-seq b) ok)
                 (if (and ok
                      (eq (rontolisp::%clojure-sorted-lookup a m miss) miss))
                     (setq ok nil)))
               nil))
          ((and (or (hash-table-p a) (rontolisp::%clojure-sorted-map-p a))
                (or (hash-table-p b) (rontolisp::%clojure-sorted-map-p b)))
           (if (= (rontolisp::%clojure-set-count a)
                  (rontolisp::%clojure-set-count b))
               (dolist (kv (rontolisp::%clojure-kv-pairs a "=") ok)
                 (if ok
                     (let ((w
                            (rontolisp::%clojure-sorted-lookup b (car kv)
                                                               miss)))
                       (if (or (eq w miss)
                               (not (rontolisp::%clojure-equal (cdr kv) w)))
                           (setq ok nil)))))
               nil))
          ((rontolisp::%clojure-host-equal-p a b) t)
          (t nil))))

(defun rontolisp::%clojure-sorted-hash (s)
  "%clojure-hash of the sorted collection S: what a hash set or map of the same
   members or entries answers (%clojure-hash-entries), since = holds between
   them."
  (let* ((setp (car (cdr s)))
         (items (car (cdr (cdr (cdr s)))))
         (h (if setp 3 5)))
    (dotimes (i (length items) h)
      (setq h
            (logand (+ h
                       (if setp
                           (rontolisp::%clojure-hash (aref items i))
                           (logand (+ (* 1021
                                         (rontolisp::%clojure-hash
                                          (aref (aref items i) 0)))
                                      (rontolisp::%clojure-hash
                                       (aref (aref items i) 1))) 1048575)))
                    1048575)))))

(defun rontolisp::%clojure-write-sorted
    (x nil-replacement readable stream labels)
  "Write the sorted collection X in order, like the oracle: #{a b} for a set,
   {k v, k v} for a map."
  (let ((items (car (cdr (cdr (cdr x))))))
    (if (car (cdr x))
        (progn
          (write-string "#{" stream)
          (dotimes (i (length items))
            (if (> i 0) (write-char #\Space stream))
            (rontolisp::%clojure-write-nested (aref items i) nil-replacement
                                              readable stream labels))
          (write-char #\} stream))
        (progn
          (write-char #\{ stream)
          (dotimes (i (length items))
            (if (> i 0) (write-string ", " stream))
            (rontolisp::%clojure-write-nested (aref (aref items i) 0)
                                              nil-replacement readable stream
                                              labels)
            (write-char #\Space stream)
            (rontolisp::%clojure-write-nested (aref (aref items i) 1)
                                              nil-replacement readable stream
                                              labels))
          (write-char #\} stream)))))

(defun rontolisp::%clojure-sorted-need (s name)
  "S, or NAME's refusal when it is no sorted collection."
  (if (rontolisp::%clojure-sorted-p s)
      s
      (rontolisp::%clojure-class-cast-exception-of
       (format nil "~A needs a sorted collection" name) s)))

(defun rontolisp::%clojure-sorted-test (test)
  "The test of subseq or rsubseq as one of the core tests (:< :<= :> :>=):
   itself when the lowering passed one for a literal <, <=, > or >=, else the
   core test a function answers like on (1 0), (0 0) and (-1 0) -- the core
   functions as values, which the oracle tells apart by identity -- else the
   function itself."
  (if (keywordp test)
      test
      (let ((p (rontolisp::%clojure-truthy (funcall test 1 0)))
            (z (rontolisp::%clojure-truthy (funcall test 0 0)))
            (n (rontolisp::%clojure-truthy (funcall test -1 0))))
        (cond ((and (not p) (not z) n) :<)
              ((and (not p) z n) :<=)
              ((and p (not z) (not n)) :>)
              ((and p z (not n)) :>=)
              (t test)))))

(defun rontolisp::%clojure-sorted-passes (s test bound item)
  "Whether ITEM's key passes TEST against the key BOUND under the sorted
   collection S's comparator, the oracle's mk-bound-fn: a core test reads the
   order's sign, a function is called on the order and 0."
  (let ((c
         (rontolisp::%clojure-sorted-order (car (cdr (cdr s)))
          (rontolisp::%clojure-sorted-item-key s item) bound)))
    (cond ((eq test :<) (< c 0))
          ((eq test :<=) (<= c 0))
          ((eq test :>) (> c 0))
          ((eq test :>=) (>= c 0))
          (t (rontolisp::%clojure-truthy (funcall test c 0))))))

(defun rontolisp::%clojure-sorted-walk (s from ascending test bound)
  "The items of the sorted collection S from index FROM on, ASCENDING or not,
   while each passes TEST against BOUND (every one when TEST is NIL), as a
   strict list (nil when none)."
  (let ((items (car (cdr (cdr (cdr s))))) (acc nil) (i from) (done nil))
    (do ()
        ((or done (< i 0) (>= i (length items))) (nreverse acc))
      (if (or (null test)
              (rontolisp::%clojure-sorted-passes s test bound (aref items i)))
          (progn
            (setq acc (cons (aref items i) acc))
            (setq i (if ascending (+ i 1) (- i 1))))
          (setq done t)))))

(defun rontolisp::%clojure-sorted-from (s test bound ascending)
  "The walk the oracle's seqFrom BOUND starts, ASCENDING or not: from the first
   item whose key is not before BOUND (not after it, descending), that item
   dropped when it fails TEST against BOUND; -1 past either end."
  (let* ((i (rontolisp::%clojure-sorted-search s bound))
         (n (length (car (cdr (cdr (cdr s))))))
         (at (cond ((>= i 0) i) (ascending (- -1 i)) (t (- (- -1 i) 1)))))
    (cond ((or (< at 0) (>= at n)) -1)
          ((rontolisp::%clojure-sorted-passes s test bound
            (aref (car (cdr (cdr (cdr s)))) at))
           at)
          (ascending (+ at 1))
          (t (- at 1)))))

;; A type implementing Sorted walks through its seqFrom, seq, comparator and
;; entryKey: arms of the sorted-interface family ("Collection interfaces").
(defun rontolisp::%clojure-subseq (s test key ascending)
  "(subseq S TEST KEY) when ASCENDING, else (rsubseq S TEST KEY), the oracle's
   two paths: a test leading away from the walk's start (> or >= ascending, <
   or <= descending) starts at KEY; any other walks from the start while it
   holds. A strict list, nil when nothing passes."
  (if (rontolisp::%clojure-isorted-p s)
      (rontolisp::%clojure-isorted-subseq s
                                          (rontolisp::%clojure-sorted-test test)
                                          key ascending)
      (progn
        (rontolisp::%clojure-sorted-need s (if ascending "subseq" "rsubseq"))
        (let ((test (rontolisp::%clojure-sorted-test test)))
          (if (if ascending
                  (or (eq test :>) (eq test :>=))
                  (or (eq test :<) (eq test :<=)))
              (rontolisp::%clojure-sorted-walk s
               (rontolisp::%clojure-sorted-from s test key ascending) ascending
               nil nil)
              (rontolisp::%clojure-sorted-walk s
               (if ascending 0 (- (rontolisp::%clojure-sorted-count s) 1))
               ascending test key))))))

(defun rontolisp::%clojure-subseq-5
    (s start-test start-key end-test end-key ascending)
  "(subseq S start-test start-key end-test end-key) when ASCENDING, else the
   rsubseq of the same five: the walk from the leading bound's key (the start
   ascending, the end descending), its first item dropped when it fails that
   bound, while the other bound holds."
  (if (rontolisp::%clojure-isorted-p s)
      (rontolisp::%clojure-isorted-subseq-5 s
       (rontolisp::%clojure-sorted-test (if ascending start-test end-test))
       (if ascending start-key end-key)
       (rontolisp::%clojure-sorted-test (if ascending end-test start-test))
       (if ascending end-key start-key) ascending)
      (progn
        (rontolisp::%clojure-sorted-need s (if ascending "subseq" "rsubseq"))
        (rontolisp::%clojure-sorted-walk s
                                         (rontolisp::%clojure-sorted-from s
                                          (if ascending start-test end-test)
                                          (if ascending start-key end-key)
                                          ascending) ascending
                                         (if ascending end-test start-test)
                                         (if ascending end-key start-key)))))

;; A sorted collection as the oracle's clojure.lang.Sorted, which a body of the
;; interface reads through instance calls: (.comparator s), (.entryKey s e),
;; (.seqFrom s k ascending) and (.seq s ascending).
(defun rontolisp::%clojure-sorted-comparator (s)
  "The comparator of the sorted collection S as a function: the one a -by form
   took, else compare."
  (or (car (cdr (cdr s))) #'rontolisp::%clojure-compare-v))

(defun rontolisp::%clojure-sorted-entry-key (s e)
  "The key of the item E of the sorted collection S: a set's member itself, a
   map entry's key."
  (if (car (cdr s)) e (aref e 0)))

(defun rontolisp::%clojure-sorted-seq-from (s key ascending)
  "The oracle's seqFrom: the items of the sorted collection S from the first
   whose key is not before KEY (not after it, ASCENDING false), nil when none."
  (let* ((asc (rontolisp::%clojure-truthy ascending))
         (i (rontolisp::%clojure-sorted-search s key))
         (at (cond ((>= i 0) i) (asc (- -1 i)) (t (- (- -1 i) 1)))))
    (rontolisp::%clojure-sorted-walk s at asc nil nil)))

(defun rontolisp::%clojure-sorted-seq-dir (s ascending)
  "The oracle's seq of the sorted collection S in order, or reversed when
   ASCENDING is false; nil when it is empty."
  (if (rontolisp::%clojure-truthy ascending)
      (rontolisp::%clojure-sorted-seq s)
      (reverse (rontolisp::%clojure-sorted-seq s))))

(defun rontolisp::%clojure-subseq-of (args ascending)
  "subseq (ASCENDING) or rsubseq as a value: the collection and one bound or
   two."
  (let ((n
         (rontolisp::%clojure-check-arity args 3 5
                                          (if ascending "subseq" "rsubseq"))))
    (cond ((= n 3)
           (rontolisp::%clojure-subseq (car args) (car (cdr args))
                                       (car (cdr (cdr args))) ascending))
          ((= n 5)
           (rontolisp::%clojure-subseq-5 (car args) (car (cdr args))
                                         (car (cdr (cdr args)))
                                         (car (cdr (cdr (cdr args))))
                                         (car (cdr (cdr (cdr (cdr args)))))
                                         ascending))
          (t (rontolisp::%clojure-arity-error n
              (if ascending "subseq" "rsubseq"))))))

(defun rontolisp::%clojure-subseq-v (&rest args)
  "subseq as a value."
  (rontolisp::%clojure-subseq-of args t))

(defun rontolisp::%clojure-rsubseq-v (&rest args)
  "rsubseq as a value."
  (rontolisp::%clojure-subseq-of args nil))

(defun rontolisp::%clojure-cast-bounded (x lo hi kind)
  "The oracle's byteCast/shortCast of X: a character's code, an integer, a ratio
   truncated, or a double truncated toward zero, answered when it lies in LO..HI;
   a double is compared BEFORE truncating (127.9 is out of range for a byte) and
   NaN is out of range. Anything else signals. The refusal spells the value with
   princ-to-string, so a program casting a byte or short splices no str path."
  (let ((n
         (cond ((characterp x) (char-code x))
          ((integerp x) x)
          ((floatp x) (if (or (/= x x) (< x lo) (> x hi)) nil (truncate x)))
          ((numberp x) (truncate x))
          (t (rontolisp::%clojure-class-cast-exception-of
              (concatenate 'string kind " needs a number or a character") x)))))
    (if (or (null n) (< n lo) (> n hi))
        (rontolisp::%clojure-illegal-argument-exception
         (concatenate 'string "Value out of range for " kind ": "
                      (princ-to-string (if (null n) x n))))
        n)))

(defun rontolisp::%clojure-byte (x)
  "(byte x): X cast as a signed 8-bit integer."
  (rontolisp::%clojure-cast-bounded x -128 127 "byte"))

(defun rontolisp::%clojure-short (x)
  "(short x): X cast as a signed 16-bit integer."
  (rontolisp::%clojure-cast-bounded x -32768 32767 "short"))

(defun rontolisp::%clojure-double (x)
  "(double x): a number widened to a double; anything else signals."
  (if (numberp x)
      (float x)
      (rontolisp::%clojure-class-cast-exception-of "double needs a number" x)))

(defun rontolisp::%clojure-float (x)
  "(float x): a number widened to a double (doubles only here) that must lie in
   the float range, like the oracle's floatCast; NaN passes."
  (let ((d (rontolisp::%clojure-double x)))
    (if (and (= d d)
             (or (> d 3.4028234663852886e38) (< d -3.4028234663852886e38)))
        (rontolisp::%clojure-illegal-argument-exception
         (concatenate 'string "Value out of range for float: "
                      (rontolisp::%clojure-host-number-text d)))
        d)))

(defun rontolisp::%clojure-num (x)
  "(num x): a number itself, nil as nil; anything else signals."
  (if (or (numberp x) (null x))
      x
      (rontolisp::%clojure-class-cast-exception "num needs a number")))

(defun rontolisp::%clojure-wrap-bits (n bits)
  "The integer N as a signed two's-complement value of BITS bits (a mask, not a
   division: `mod` over a bignum linked about 20 KB of wasm)."
  (let* ((m (ash 1 bits)) (r (logand n (- m 1))))
    (if (>= r (ash m -1)) (- r m) r)))

(defun rontolisp::%clojure-unchecked-cast (x bits wide charp kind)
  "The oracle's unchecked KIND cast of X: an integer or a ratio (truncated)
   wraps to BITS bits, a double truncates after saturating to the int range
   (the long range when WIDE; NaN is 0) and then wraps, a character is its
   code when CHARP; anything else signals."
  (cond ((characterp x)
         (if charp
             (char-code x)
             (rontolisp::%clojure-class-cast-exception
              (concatenate 'string "unchecked-" kind " needs a number"))))
        ((floatp x)
         (rontolisp::%clojure-wrap-bits (cond ((/= x x) 0)
                                              (wide
                                               (cond ((>= x
                                                       9.223372036854775807e18)
                                                      9223372036854775807)
                                                     ((<= x
                                                       -9.223372036854775808e18)
                                                      -9223372036854775808)
                                                     (t (truncate x))))
                                              (t (cond ((>= x 2147483647.0)
                                                        2147483647)
                                                       ((<= x -2147483648.0)
                                                        -2147483648)
                                                       (t (truncate x)))))
                                        bits))
        ((rationalp x) (rontolisp::%clojure-wrap-bits (truncate x) bits))
        (t (rontolisp::%clojure-class-cast-exception-of
            (concatenate 'string "unchecked-" kind " needs a number") x))))

(defun rontolisp::%clojure-unchecked-int (x)
  "(unchecked-int x): X wrapped to a signed 32-bit integer."
  (rontolisp::%clojure-unchecked-cast x 32 nil t "int"))

(defun rontolisp::%clojure-unchecked-long (x)
  "(unchecked-long x): X wrapped to a signed 64-bit integer."
  (rontolisp::%clojure-unchecked-cast x 64 t nil "long"))

(defun rontolisp::%clojure-unchecked-short (x)
  "(unchecked-short x): X wrapped to a signed 16-bit integer."
  (rontolisp::%clojure-unchecked-cast x 16 nil nil "short"))

(defun rontolisp::%clojure-unchecked-byte (x)
  "(unchecked-byte x): X wrapped to a signed 8-bit integer."
  (rontolisp::%clojure-unchecked-cast x 8 nil nil "byte"))

(defun rontolisp::%clojure-unchecked-char (x)
  "(unchecked-char x): a character itself, a number's low 16 bits as a
   character."
  (cond ((characterp x) x)
        ((realp x)
         (code-char
          (logand (rontolisp::%clojure-unchecked-cast x 64 t nil "char")
                  65535)))
        (t (rontolisp::%clojure-class-cast-exception-of
            "unchecked-char needs a number or a character" x))))

(defun rontolisp::%clojure-unchecked-double (x)
  "(unchecked-double x): a number widened to a double."
  (if (numberp x)
      (float x)
      (rontolisp::%clojure-class-cast-exception-of
       "unchecked-double needs a number" x)))

(defun rontolisp::%clojure-unchecked-float (x)
  "(unchecked-float x): a number widened to a double (doubles only here); past
   the float range it is the infinity of its sign, like the oracle's cast."
  (let ((d
         (if (numberp x)
             (float x)
             (rontolisp::%clojure-class-cast-exception-of
              "unchecked-float needs a number" x))))
    (cond ((> d 3.4028234663852886e38) (* most-positive-double-float 2.0d0))
          ((< d -3.4028234663852886e38) (* most-negative-double-float 2.0d0))
          (t d))))

(defun rontolisp::%clojure-parse-decimal (s)
  "The exact rational a decimal string spells: an optional sign, digits with an
   optional fraction, an optional exponent (e, E, d or D). Anything else
   signals."
  (let ((n (length s)) (i 0) (neg nil) (mant 0) (scale 0) (digits 0) (ex 0))
    (when (and (< i n) (or (char= (char s i) #\-) (char= (char s i) #\+)))
      (setq neg (char= (char s i) #\-))
      (setq i (+ i 1)))
    (do ((go t))
        ((not go))
      (if (and (< i n) (digit-char-p (char s i)))
          (progn
            (setq mant (+ (* mant 10) (digit-char-p (char s i))))
            (setq digits (+ digits 1))
            (setq i (+ i 1)))
          (setq go nil)))
    (when (and (< i n) (char= (char s i) #\.))
      (setq i (+ i 1))
      (do ((go t))
          ((not go))
        (if (and (< i n) (digit-char-p (char s i)))
            (progn
              (setq mant (+ (* mant 10) (digit-char-p (char s i))))
              (setq digits (+ digits 1))
              (setq scale (+ scale 1))
              (setq i (+ i 1)))
            (setq go nil))))
    (when (and (> digits 0) (< i n) (find (char s i) "eEdD"))
      (let ((eneg nil) (edigits 0))
        (setq i (+ i 1))
        (when (and (< i n) (or (char= (char s i) #\-) (char= (char s i) #\+)))
          (setq eneg (char= (char s i) #\-))
          (setq i (+ i 1)))
        (do ((go t))
            ((not go))
          (if (and (< i n) (digit-char-p (char s i)))
              (progn
                (setq ex (+ (* ex 10) (digit-char-p (char s i))))
                (setq edigits (+ edigits 1))
                (setq i (+ i 1)))
              (setq go nil)))
        (when (= edigits 0) (setq digits 0))
        (when eneg (setq ex (- ex)))))
    (if (or (= digits 0) (< i n))
        (rontolisp::%clojure-number-format-exception
         (concatenate 'string "Invalid decimal number: " s))
        (let ((r (* mant (expt 10 (- ex scale))))) (if neg (- r) r)))))

(defun rontolisp::%clojure-decimal-of-float (x)
  "The exact rational of the shortest decimal a double prints as, which is
   what the oracle's BigDecimal.valueOf reads; NaN and the infinities signal."
  (if (rontolisp::%clojure-symbolic-float-p x)
      (rontolisp::%clojure-number-format-exception "Infinite or NaN")
      (rontolisp::%clojure-parse-decimal (princ-to-string x))))

;; format: java.util.Formatter's conversions of one argument, behind the
;; lowering's parse of the literal format string (ClojureStringLowering
;; formatOf), which also makes every refusal of the parse. FLAGS is the
;; specifier's flags in Formatter's own order ("-#+ 0,("), WIDTH and PRECISION
;; an integer or nil, CONV the conversion as written: an uppercase one
;; upcases. nil spells null, like the oracle's.
(defun rontolisp::%clojure-format-justify (s flags width)
  "S padded with spaces to WIDTH, on the right under the - flag."
  (let ((pad (if width (- width (length s)) 0)))
    (cond ((<= pad 0) s)
     ((find #\- flags)
      (concatenate 'string s (make-string pad :initial-element #\Space)))
     (t (concatenate 'string (make-string pad :initial-element #\Space) s)))))

(defun rontolisp::%clojure-format-null (conv flags width)
  "A nil argument of a non-text conversion: null, justified."
  (rontolisp::%clojure-format-justify
   (if (char= conv (char-downcase conv)) "null" "NULL") flags width))

(defun rontolisp::%clojure-format-mismatch (conv x)
  "The oracle's IllegalFormatConversionException for an argument X of the
   wrong class for CONV."
  (rontolisp::%clojure-illegal-format-conversion-exception
   (concatenate 'string (string (char-downcase conv)) " != "
                (rontolisp::%clojure-class-name-of x))))

(defun rontolisp::%clojure-format-text (s conv flags width precision)
  "The text S of a general conversion: cut to PRECISION, upcased under an
   uppercase CONV, justified."
  (let ((cut
         (if (and precision (< precision (length s)))
             (subseq s 0 precision)
             s)))
    (rontolisp::%clojure-format-justify (if (char= conv (char-downcase conv))
                                            cut
                                            (rontolisp::%clojure-upper-case
                                             cut)) flags width)))

(defun rontolisp::%clojure-format-char (x conv flags width)
  "%c: the character X as text; nil spells null, anything else is refused."
  (cond ((null x) (rontolisp::%clojure-format-text "null" conv flags width nil))
        ((characterp x)
         (rontolisp::%clojure-format-text (string x) conv flags width nil))
        (t (rontolisp::%clojure-format-mismatch conv x))))

(defun rontolisp::%clojure-format-sign (neg flags)
  "The leading sign of a number: ( or - when NEG, else + or a space by the flags."
  (cond (neg (if (find #\( flags) "(" "-"))
        ((find #\+ flags) "+")
        ((find #\Space flags) " ")
        (t "")))

(defun rontolisp::%clojure-format-number (prefix magnitude suffix flags width)
  "A converted number: zeros between PREFIX (sign, radix indicator) and
   MAGNITUDE up to WIDTH under the 0 flag, SUFFIX (exponent, closing
   parenthesis) last, justified."
  (let ((zeros
         (if (and width (find #\0 flags))
             (- width (length prefix) (length magnitude) (length suffix))
             0)))
    (rontolisp::%clojure-format-justify (if (> zeros 0)
                                            (concatenate 'string prefix
                                                         (make-string zeros
                                                          :initial-element #\0)
                                                         magnitude suffix)
                                            (concatenate 'string prefix
                                                         magnitude suffix))
                                        flags width)))

(defun rontolisp::%clojure-format-group (digits)
  "DIGITS with a comma before each group of three counted from the right."
  (let ((n (length digits)) (out (make-string-output-stream)))
    (dotimes (i n)
      (when (and (> i 0) (= (mod (- n i) 3) 0)) (write-char #\, out))
      (write-char (char digits i) out))
    (get-output-stream-string out)))

(defun rontolisp::%clojure-format-integer (x conv flags width)
  "%d, %o, %x: an integer in the long range as the oracle's Long (octal and
   hexadecimal in two's complement, refusing the sign flags), past it as a
   BigInteger (signed)."
  (cond ((null x) (rontolisp::%clojure-format-null conv flags width))
        ((not (integerp x)) (rontolisp::%clojure-format-mismatch conv x))
        (t (let* ((neg (< x 0))
                  (close (if (and neg (find #\( flags)) ")" ""))
                  (radix (char-downcase conv)))
             (if (char= radix #\d)
                 (let ((digits (format nil "~D" (abs x))))
                   (rontolisp::%clojure-format-number
                    (rontolisp::%clojure-format-sign neg flags)
                    (if (find #\, flags)
                        (rontolisp::%clojure-format-group digits)
                        digits) close flags width))
                 (let ((long (typep x '(signed-byte 64))))
                   (when long
                     (let ((bad
                            (remove-if-not (lambda (c) (find c "+ (")) flags)))
                       (when (> (length bad) 0)
                         (rontolisp::%clojure-format-flags-conversion-mismatch-exception
                          (concatenate 'string "Conversion = " (string radix)
                                       ", Flags = " bad)))))
                   (let* ((v
                           (cond ((not long) (abs x))
                                 (neg (+ x 18446744073709551616))
                                 (t x)))
                          (digits
                           (if (char= radix #\o)
                               (format nil "~O" v)
                               (format nil "~X" v)))
                          (alternate (find #\# flags)))
                     (rontolisp::%clojure-format-number
                      (concatenate 'string
                       (if long "" (rontolisp::%clojure-format-sign neg flags))
                       (cond ((not alternate) "")
                             ((char= radix #\o) "0")
                             ((char= conv #\x) "0x")
                             (t "0X")))
                      (if (char= conv #\x) (string-downcase digits) digits)
                      (if long "" close) flags width))))))))

(defun rontolisp::%clojure-format-decimal (text)
  "The shortest decimal TEXT spells (a double's printed text, its sign aside)
   as (m . k): the double is m times 10 to the k."
  (let ((m 0) (k 0) (i 0) (n (length text)) (fraction nil))
    (do ()
        ((or (>= i n) (find (char text i) "eEdD")))
      (let ((c (char text i)))
        (cond ((char= c #\.) (setq fraction t))
              ((digit-char-p c)
               (setq m (+ (* m 10) (digit-char-p c)))
               (when fraction (setq k (- k 1))))))
      (setq i (+ i 1)))
    (when (< i n) (setq k (+ k (parse-integer text :start (+ i 1)))))
    (cons m k)))

(defun rontolisp::%clojure-format-round (m k places)
  "m times 10 to the k, rounded half up to PLACES decimals, times 10 to the
   PLACES: Formatter's rounding of the shortest decimal."
  (let ((shift (+ k places)))
    (if (>= shift 0)
        (* m (expt 10 shift))
        (let ((d (expt 10 (- shift)))) (floor (+ m (floor d 2)) d)))))

(defun rontolisp::%clojure-format-digits (n count)
  "The decimal digits of N, zeros in front to COUNT."
  (let ((digits (format nil "~D" n)))
    (if (< (length digits) count)
        (concatenate 'string
         (make-string (- count (length digits)) :initial-element #\0) digits)
        digits)))

(defun rontolisp::%clojure-format-point (whole fraction flags)
  "WHOLE and FRACTION joined by the decimal point, which an empty FRACTION
   keeps only under the # flag."
  (if (or (> (length fraction) 0) (find #\# flags))
      (concatenate 'string whole "." fraction)
      whole))

(defun rontolisp::%clojure-format-fixed (m k places flags)
  "%f's magnitude of m times 10 to the k: PLACES decimals, the whole part
   grouped under the , flag."
  (let* ((digits
          (rontolisp::%clojure-format-digits
           (rontolisp::%clojure-format-round m k places) (+ places 1)))
         (cut (- (length digits) places))
         (whole (subseq digits 0 cut)))
    (rontolisp::%clojure-format-point
     (if (find #\, flags) (rontolisp::%clojure-format-group whole) whole)
     (subseq digits cut) flags)))

(defun rontolisp::%clojure-format-exponent (m k places)
  "The decimal exponent of m times 10 to the k once rounded half up to PLACES
   + 1 significant digits, and those digits: (exponent . digits)."
  (if (= m 0)
      (cons 0 0)
      (let* ((e (+ (- (length (format nil "~D" m)) 1) k))
             (n (rontolisp::%clojure-format-round m (- k e) places)))
        (if (> (length (format nil "~D" n)) (+ places 1))
            (cons (+ e 1) (floor n 10))
            (cons e n)))))

(defun rontolisp::%clojure-format-scientific (m k places flags)
  "%e's magnitude of m times 10 to the k: (mantissa . exponent)."
  (let* ((rounded (rontolisp::%clojure-format-exponent m k places))
         (digits
          (rontolisp::%clojure-format-digits (cdr rounded) (+ places 1))))
    (cons (rontolisp::%clojure-format-point (subseq digits 0 1)
                                            (subseq digits 1) flags)
          (car rounded))))

(defun rontolisp::%clojure-format-scientific-text (m k places flags conv close)
  "%e's text of m times 10 to the k: (mantissa . exponent-and-CLOSE), the
   exponent signed and at least two digits."
  (let* ((scientific (rontolisp::%clojure-format-scientific m k places flags))
         (power (abs (cdr scientific))))
    (cons (car scientific)
          (concatenate 'string (if (char= conv #\E) "E" "e")
                       (if (< (cdr scientific) 0) "-" "+")
                       (if (< power 10) "0" "") (format nil "~D" power)
                       close))))

(defun rontolisp::%clojure-format-magnitude (m k conv flags precision close)
  "The magnitude of m times 10 to the k under %e, %f or %g:
   (digits . suffix). %g takes PRECISION significant digits, fixed from
   10 to the -4 up to 10 to the PRECISION once rounded, scientific elsewhere."
  (let ((form (char-downcase conv)))
    (cond ((char= form #\f)
           (cons (rontolisp::%clojure-format-fixed m k (or precision 6) flags)
                 close))
          ((char= form #\e)
           (rontolisp::%clojure-format-scientific-text m k (or precision 6)
                                                       flags conv close))
          (t
           (let* ((significant
                   (cond ((null precision) 6)
                         ((= precision 0) 1)
                         (t precision)))
                  (e
                   (car
                    (rontolisp::%clojure-format-exponent m k
                                                         (- significant 1)))))
             (if (and (>= e -4) (< e significant))
                 (cons (rontolisp::%clojure-format-fixed m k (- significant 1 e)
                                                         flags) close)
                 (rontolisp::%clojure-format-scientific-text m k
                  (- significant 1) flags (if (char= conv #\G) #\E #\e)
                  close)))))))

(defun rontolisp::%clojure-format-float (x conv flags width precision)
  "%e, %f, %g: a double as Formatter renders it, from the shortest decimal it
   prints as, rounded half up."
  (let ((upper (char/= conv (char-downcase conv))))
    (cond ((null x) (rontolisp::%clojure-format-null conv flags width))
          ((not (floatp x)) (rontolisp::%clojure-format-mismatch conv x))
          ((/= x x)
           (rontolisp::%clojure-format-justify (if upper "NAN" "NaN") flags
                                               width))
          (t
           (let* ((text (princ-to-string x))
                  (neg (char= (char text 0) #\-))
                  (sign (rontolisp::%clojure-format-sign neg flags))
                  (close (if (and neg (find #\( flags)) ")" "")))
             (if (or (> x most-positive-double-float)
                     (< x most-negative-double-float))
                 (rontolisp::%clojure-format-justify (concatenate 'string sign
                                                                  (if upper
                                                                      "INFINITY"
                                                                      "Infinity")
                                                                  close) flags
                                                     width)
                 (let* ((decimal (rontolisp::%clojure-format-decimal text))
                        (magnitude
                         (rontolisp::%clojure-format-magnitude (car decimal)
                                                               (cdr decimal)
                                                               conv flags
                                                               precision
                                                               close)))
                   (rontolisp::%clojure-format-number sign (car magnitude)
                                                      (cdr magnitude) flags
                                                      width))))))))

;; format of a format string computed at run time, and format as a value
;; (tools.cli's (apply format fmt cols)): Formatter's parse when the call runs,
;; every refusal the lowering's parse of a literal makes (ClojureFormatLowering)
;; in the same class and words, then each specifier's argument converted left
;; to right through the helpers above. A parsed specifier is the list (index
;; flags width precision conv): INDEX 0 the next ordinary argument, n the n$
;; one, -1 the previous one (<), -2 none (%% and %n); FLAGS in Formatter's
;; order, < included; WIDTH and PRECISION an integer or nil.
(defun rontolisp::%clojure-format-v (fmt &rest args)
  "format as a value, and a call whose format string is computed: FMT parsed
   as Formatter parses it, ARGS converted like a literal's."
  (cond ((null fmt)
         (rontolisp::%clojure-null-pointer-exception
          "Cannot invoke \"String.length()\" because \"s\" is null"))
        ((not (stringp fmt))
         (rontolisp::%clojure-class-cast-exception
          (concatenate 'string "class " (rontolisp::%clojure-class-name-of fmt)
                       " cannot be cast to class java.lang.String")))
        (t (rontolisp::%clojure-format-print
            (rontolisp::%clojure-format-parse fmt) args))))

(defun rontolisp::%clojure-format-parse (s)
  "Formatter's parse of the format string S: its literal runs (strings) and
   specifiers in order, the first refusal of the parse signalled."
  (let ((parts nil) (i 0) (n (length s)) (done nil))
    (do ()
        (done (reverse parts))
      (let ((pct (position #\% s :start i)))
        (cond ((null pct)
               (if (< i n) (setq parts (cons (subseq s i) parts)))
               (setq done t))
              (t
               (if (> pct i) (setq parts (cons (subseq s i pct) parts)))
               (if (= (+ pct 1) n)
                   (rontolisp::%clojure-unknown-format-conversion-exception
                    "Conversion = '%'"))
               (let ((spec (rontolisp::%clojure-format-specifier s pct)))
                 (setq parts (cons (car spec) parts))
                 (setq i (cdr spec))
                 (if (>= i n) (setq done t)))))))))

(defun rontolisp::%clojure-format-digits-end (s j)
  "The index past the run of decimal digits of S starting at J."
  (let ((k j) (n (length s)))
    (do ()
        ((or (>= k n) (not (digit-char-p (char s k)))) k)
      (setq k (+ k 1)))))

(defun rontolisp::%clojure-format-specifier (s pct)
  "The specifier of S at the % at PCT, Formatter's
   %[index$][flags][width][.precision][t]conversion with its checks, consed
   onto the index past it."
  (let* ((n (length s))
         (j (+ pct 1))
         (index 0)
         (d (rontolisp::%clojure-format-digits-end s j)))
    (if (and (> d j) (< d n) (char= (char s d) #\$))
        (progn
          (setq index (parse-integer s :start j :end d))
          (if (= index 0)
              (rontolisp::%clojure-illegal-format-argument-index-exception
               "Illegal format argument index = 0"))
          (setq j (+ d 1))))
    (let ((from j))
      (do ()
          ((or (>= j n) (not (find (char s j) "-#+ 0,(<"))))
        (setq j (+ j 1)))
      (let ((written (subseq s from j))
            (width nil)
            (precision nil)
            (wend (rontolisp::%clojure-format-digits-end s j)))
        (if (> wend j)
            (progn
              (setq width (parse-integer s :start j :end wend))
              (setq j wend)))
        (if (and (< (+ j 1) n) (char= (char s j) #\.)
                 (digit-char-p (char s (+ j 1))))
            (let ((pend (rontolisp::%clojure-format-digits-end s (+ j 1))))
              (setq precision (parse-integer s :start (+ j 1) :end pend))
              (setq j pend)))
        (cond ((and (< (+ j 1) n) (find (char s j) "tT")
                    (or (alpha-char-p (char s (+ j 1)))
                        (char= (char s (+ j 1)) #\%)))
               (error
                (concatenate 'string "format directive %" (string (char s j))
                             " is not supported yet")))
              ((or (>= j n)
                   (not (or (alpha-char-p (char s j)) (char= (char s j) #\%))))
               (rontolisp::%clojure-unknown-format-conversion-exception
                (concatenate 'string "Conversion = '"
                             (string (char s (+ pct 1))) "'"))))
        (let ((conv (char s j)) (flags ""))
          (dotimes (k (length written))
            (if (< (position (char written k) written) k)
                (rontolisp::%clojure-duplicate-format-flags-exception
                 (concatenate 'string "Flags = '" (string (char written k))
                              "'"))))
          (dolist (flag '(#\- #\# #\+ #\Space #\0 #\, #\( #\<))
            (if (find flag written)
                (setq flags (concatenate 'string flags (string flag)))))
          (if (find #\< flags) (setq index -1))
          (if (not (find conv "bBhHsScCdoxXeEfgGaAtT%n"))
              (rontolisp::%clojure-unknown-format-conversion-exception
               (concatenate 'string "Conversion = '" (string conv) "'")))
          (let* ((kind (char-downcase conv))
                 (spec
                  (list (if (find kind "%n") -2 index) flags width precision
                        conv)))
            (rontolisp::%clojure-format-check spec)
            (if (find kind "ha")
                (error
                 (concatenate 'string "format directive %" (string conv)
                              " is not supported yet")))
            (cons spec (+ j 1))))))))

(defun rontolisp::%clojure-format-spec-text (spec)
  "Formatter's FormatSpecifier.toString of SPEC, the words of its refusals."
  (concatenate 'string "%" (nth 1 spec)
   (if (> (nth 0 spec) 0)
       (concatenate 'string (princ-to-string (nth 0 spec)) "$")
       "") (if (nth 2 spec) (princ-to-string (nth 2 spec)) "")
   (if (nth 3 spec) (concatenate 'string "." (princ-to-string (nth 3 spec))) "")
   (string (nth 4 spec))))

(defun rontolisp::%clojure-format-check (spec)
  "Formatter's checks of the parsed SPEC by its conversion, refused in its
   class and words."
  (let ((flags (nth 1 spec))
        (width (nth 2 spec))
        (precision (nth 3 spec))
        (kind (char-downcase (nth 4 spec))))
    (cond ((find kind "bhs")
           (if (and (find kind "bh") (find #\# flags))
               (rontolisp::%clojure-format-flags-mismatch kind "#"))
           (rontolisp::%clojure-format-require-width spec "-")
           (rontolisp::%clojure-format-bad-flags spec "+ 0,("))
          ((char= kind #\c)
           (if precision
               (rontolisp::%clojure-illegal-format-precision-exception
                (princ-to-string precision)))
           (rontolisp::%clojure-format-bad-flags spec "#+ 0,(")
           (rontolisp::%clojure-format-require-width spec "-"))
          ((find kind "dox")
           (rontolisp::%clojure-format-check-numeric spec)
           (if precision
               (rontolisp::%clojure-illegal-format-precision-exception
                (princ-to-string precision)))
           (rontolisp::%clojure-format-bad-flags spec
                                                 (if (char= kind #\d) "#" ",")))
          ((find kind "efga")
           (rontolisp::%clojure-format-check-numeric spec)
           (cond
            ((char= kind #\e) (rontolisp::%clojure-format-bad-flags spec ","))
            ((char= kind #\g) (rontolisp::%clojure-format-bad-flags spec "#"))
            ((char= kind #\a)
             (rontolisp::%clojure-format-bad-flags spec ",("))))
          (t
           (if precision
               (rontolisp::%clojure-illegal-format-precision-exception
                (princ-to-string precision)))
           (if (char= kind #\%)
               (progn
                 (if (and (> (length flags) 0) (string/= flags "-"))
                     (rontolisp::%clojure-format-illegal-flags spec))
                 (rontolisp::%clojure-format-require-width spec "-"))
               (progn
                 (if width
                     (rontolisp::%clojure-illegal-format-width-exception
                      (princ-to-string width)))
                 (if (> (length flags) 0)
                     (rontolisp::%clojure-format-illegal-flags spec))))))))

(defun rontolisp::%clojure-format-check-numeric (spec)
  "The checks every numeric conversion makes of SPEC's flags."
  (let ((flags (nth 1 spec)))
    (rontolisp::%clojure-format-require-width spec "-0")
    (if (or (and (find #\+ flags) (find #\Space flags))
            (and (find #\- flags) (find #\0 flags)))
        (rontolisp::%clojure-format-illegal-flags spec))))

(defun rontolisp::%clojure-format-require-width (spec flags)
  "MissingFormatWidthException when SPEC has one of FLAGS but no width."
  (if (null (nth 2 spec))
      (dotimes (k (length flags))
        (if (find (char flags k) (nth 1 spec))
            (rontolisp::%clojure-missing-format-width-exception
             (rontolisp::%clojure-format-spec-text spec))))))

(defun rontolisp::%clojure-format-bad-flags (spec bad)
  "The conversion's refusal of the flags of SPEC among BAD, all of them named."
  (let ((given ""))
    (dotimes (k (length (nth 1 spec)))
      (if (find (char (nth 1 spec) k) bad)
          (setq given
                (concatenate 'string given (string (char (nth 1 spec) k))))))
    (if (> (length given) 0)
        (rontolisp::%clojure-format-flags-mismatch (char-downcase (nth 4 spec))
                                                   given))))

(defun rontolisp::%clojure-format-flags-mismatch (kind flags)
  "FormatFlagsConversionMismatchException of the conversion KIND and FLAGS."
  (rontolisp::%clojure-format-flags-conversion-mismatch-exception
   (concatenate 'string "Conversion = " (string kind) ", Flags = " flags)))

(defun rontolisp::%clojure-format-illegal-flags (spec)
  "IllegalFormatFlagsException naming SPEC's flags."
  (rontolisp::%clojure-illegal-format-flags-exception
   (concatenate 'string "Flags = '" (nth 1 spec) "'")))

(defun rontolisp::%clojure-format-print (parts args)
  "The text of the parsed PARTS over the ARGS list: each specifier's argument
   resolved as Formatter resolves it and converted, left to right."
  (let ((out "") (last -1) (ordinary -1) (count (length args)))
    (dolist (part parts out)
      (if (stringp part)
          (setq out (concatenate 'string out part))
          (let* ((index (nth 0 part))
                 (flags (remove #\< (nth 1 part)))
                 (width (nth 2 part))
                 (precision (nth 3 part))
                 (conv (nth 4 part))
                 (kind (char-downcase conv)))
            (cond ((char= kind #\%)
                   (setq out
                         (concatenate 'string out
                                      (rontolisp::%clojure-format-justify "%"
                                       flags width))))
                  ((char= kind #\n)
                   (setq out (concatenate 'string out (string #\Newline))))
                  (t
                   (let ((at
                          (cond ((= index -1) last)
                           ((= index 0)
                            (setq ordinary (+ ordinary 1))
                            ordinary)
                           (t (- index 1)))))
                     (setq last at)
                     (if (or (< at 0) (>= at count))
                         (rontolisp::%clojure-missing-format-argument-exception
                          (concatenate 'string "Format specifier '"
                           (rontolisp::%clojure-format-spec-text part) "'")))
                     (if (and (char= kind #\s) (find #\# flags))
                         (rontolisp::%clojure-format-flags-mismatch #\s "#"))
                     (let ((x (nth at args)))
                       (setq out
                             (concatenate 'string out
                                          (cond
                                           ((char= kind #\s)
                                            (rontolisp::%clojure-format-text
                                             (rontolisp::%clojure-str-of x
                                                                         "null"
                                                                         nil)
                                             conv flags width precision))
                                           ((char= kind #\b)
                                            (rontolisp::%clojure-format-text
                                             (if (rontolisp::%clojure-truthy x)
                                                 "true"
                                                 "false") conv flags width
                                             precision))
                                           ((char= kind #\c)
                                            (rontolisp::%clojure-format-char x
                                             conv flags width))
                                           ((find kind "dox")
                                            (rontolisp::%clojure-format-integer
                                             x conv flags width))
                                           (t (rontolisp::%clojure-format-float
                                               x conv flags width
                                               precision))))))))))))))

(defun rontolisp::%clojure-rationalize (x)
  "(rationalize x): nil as nil, a rational itself, a double as the rational of
   its shortest decimal (0.1 is 1/10); anything else signals."
  (cond ((null x) nil)
        ((rationalp x) x)
        ((floatp x) (rontolisp::%clojure-decimal-of-float x))
        (t (rontolisp::%clojure-class-cast-exception-of
            "rationalize needs a number" x))))

(defun rontolisp::%clojure-bigint (x)
  "(bigint x): a number truncated to an integer, a decimal string parsed;
   NaN, an infinity or anything else signals."
  (cond ((integerp x) x)
        ((rationalp x) (truncate x))
        ((floatp x)
         (if (rontolisp::%clojure-symbolic-float-p x)
             (rontolisp::%clojure-number-format-exception "Infinite or NaN")
             (truncate x)))
        ((stringp x)
         ;; parse-integer skips surrounding whitespace, BigInteger refuses it: the
         ;; string must start on a sign or a digit and end on a digit
         (let ((n (length x)))
           (when (or (= n 0)
                     (not
                      (or (digit-char-p (char x 0)) (char= (char x 0) #\+)
                          (char= (char x 0) #\-)))
                     (not (digit-char-p (char x (- n 1)))))
             (rontolisp::%clojure-number-format-exception
              (concatenate 'string "Invalid integer: " x)))
           (parse-integer x)))
        (t (rontolisp::%clojure-illegal-argument-exception-of
            "bigint needs a number or a string" x))))

(defun rontolisp::%clojure-biginteger (x)
  "(biginteger x): the same integer as bigint."
  (rontolisp::%clojure-bigint x))

(defun rontolisp::%clojure-bigdec (x)
  "(bigdec x): an integer itself, a double as the rational of its shortest
   decimal, a ratio only when it has a finite decimal expansion, a decimal
   string parsed; anything else signals."
  (cond ((integerp x) x)
        ((rationalp x)
         (let ((d (denominator x)))
           (do ((go t))
               ((not go))
             (cond ((= (mod d 2) 0) (setq d (/ d 2)))
                   ((= (mod d 5) 0) (setq d (/ d 5)))
                   (t (setq go nil))))
           (if (= d 1)
               x
               (rontolisp::%clojure-arithmetic-exception
                "Non-terminating decimal expansion; no exact representable decimal result."))))
        ((floatp x) (rontolisp::%clojure-decimal-of-float x))
        ((stringp x) (rontolisp::%clojure-parse-decimal x))
        (t (rontolisp::%clojure-illegal-argument-exception-of
            "bigdec needs a number or a string" x))))

(defun rontolisp::%clojure-numerator (x)
  "(numerator x): the numerator of a ratio; anything else signals."
  (if (and (rationalp x) (not (integerp x)))
      (numerator x)
      (rontolisp::%clojure-class-cast-exception-of "numerator needs a ratio"
                                                   x)))

