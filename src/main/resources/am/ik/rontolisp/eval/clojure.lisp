(defun rontolisp::%clojure-vector-of-range (x n lo hi kind)
  "N (X's integer value) when it lies in LO..HI, else the oracle's refusal for
   the primitive KIND, spelling X."
  (if (or (< n lo) (> n hi))
      (rontolisp::%clojure-illegal-argument-exception
       (concatenate 'string "Value out of range for " kind ": "
                    (rontolisp::%clojure-str-of x "null" nil)))
      n))

(defun rontolisp::%clojure-vector-of-1 (kind x)
  "X as the primitive slot KIND (\"int\", \"long\", ...) of a vector-of stores
   it, the oracle's cast: the integer kinds truncate a number (a character to
   its code) and refuse one out of range (through longCast, unlike byte and
   short, which compare a double first), :double and :float widen to a double
   (:float refusing one past the float range), :char takes a character or a code, :boolean is the truthiness."
  (cond ((equal kind "long") (rontolisp::%clojure-long-cast x))
        ((equal kind "int") (rontolisp::%clojure-int-cast x))
        ((equal kind "short")
         (rontolisp::%clojure-vector-of-range x
                                              (rontolisp::%clojure-long-cast x)
                                              -32768 32767 "short"))
        ((equal kind "byte")
         (rontolisp::%clojure-vector-of-range x
                                              (rontolisp::%clojure-long-cast x)
                                              -128 127 "byte"))
        ((equal kind "double") (rontolisp::%clojure-double x))
        ((equal kind "float") (rontolisp::%clojure-float x))
        ((equal kind "char")
         (cond ((characterp x) x)
               ((numberp x)
                (code-char
                 (rontolisp::%clojure-vector-of-range x
                                                      (cond ((not (floatp x))
                                                             (truncate x))
                                                            ((/= x x) 0)
                                                            ((> x 65535) 65536)
                                                            ((< x 0) -1)
                                                            (t (truncate x))) 0
                                                      65535 "char")))
               (t (rontolisp::%clojure-class-cast-exception-of
                   "vector-of needs a number or a character" x))))
        (t (if (rontolisp::%clojure-truthy x) t rontolisp::%clojure-false))))

(defun rontolisp::%clojure-vector-of (type items)
  "(vector-of TYPE items...): an ordinary vector of ITEMS each stored as the
   primitive TYPE (:int :long :float :double :byte :short :char :boolean)
   would hold it (%clojure-vector-of-1); any other TYPE signals, like the
   oracle. Later conj and assoc store their values as given (the oracle keeps
   casting), and :float holds doubles."
  (let ((kind (if (rontolisp::%clojure-keyword-p type) (car (cdr type)) "")))
    (if (not
         (or (equal kind "int") (equal kind "long") (equal kind "float")
             (equal kind "double") (equal kind "byte") (equal kind "short")
             (equal kind "char") (equal kind "boolean")))
        (rontolisp::%clojure-illegal-argument-exception
         (concatenate 'string "Unrecognized type "
                      (rontolisp::%clojure-str-of type "" nil))))
    (let ((out (make-array (length items))) (i 0))
      (dolist (x items out)
        (setf (aref out i) (rontolisp::%clojure-vector-of-1 kind x))
        (setq i (+ i 1))))))

(defun rontolisp::%clojure-vector-of-v (&rest args)
  "vector-of as a value."
  (rontolisp::%clojure-check-arity args 1 nil "vector-of")
  (rontolisp::%clojure-vector-of (car args) (cdr args)))

;;;; The oracle's long and int casts, and clojure.math's round and long arithmetic.
;;
;; The two casts are the oracle's RT.longCast and RT.intCast of an object: what
;; (long x), (int x), a ^long parameter apply, and what vector-of stores an integer
;; kind through. The double functions of clojure.math are one (%strict-math :name ...)
;; each, over arguments cast by %clojure-double, lowered in place by the
;; rontolisp.internal.math kernels (ClojureKernelLowering); the functions below are
;; the kernels that are workers.

(defun rontolisp::%clojure-long-cast (x)
  "X as the oracle's longCast takes an object: an integer in the long range, a
   ratio truncated toward zero, a double truncated (NaN is 0, 2^63 itself the
   largest long, as Java's (long) saturates, one past it refused), a
   character's code; anything else signals, so does a value out of range. The
   refusal spells the value as the oracle's toString through princ, not the str
   runtime."
  (let ((n
         (cond ((integerp x) x)
               ((characterp x) (char-code x))
               ((floatp x)
                ;; one float comparison on the common path: a generic one costs
                ;; more than the truncation on wasm
                (cond ((< (abs x) 9.223372036854775807e18) (truncate x))
                      ((/= x x) 0)
                      ((= x 9.223372036854775807e18) 9223372036854775807)
                      ((= x -9.223372036854775808e18) -9223372036854775808)
                      (t nil)))
               ((numberp x) (truncate x))
               (t (rontolisp::%clojure-class-cast-exception-of
                   "long needs a number or a character" x)))))
    (if (or (null n) (> n 9223372036854775807) (< n -9223372036854775808))
        (rontolisp::%clojure-illegal-argument-exception
         (concatenate 'string "Value out of range for long: "
                      (cond (n (princ-to-string n))
                            ;; Double.toString: Infinity, 1.0E19
                            ((rontolisp::%clojure-symbolic-float-p x)
                             (princ-to-string x))
                            (t (string-upcase (princ-to-string x))))))
        n)))

(defun rontolisp::%clojure-int-cast (x)
  "X as the oracle's intCast takes an object: its longCast, refused past the
   int range as the oracle's integer overflow. An integer in the int range
   answers itself without the longCast call."
  (if (and (integerp x) (>= x -2147483648) (<= x 2147483647))
      x
      (let ((n (rontolisp::%clojure-long-cast x)))
        (if (or (< n -2147483648) (> n 2147483647))
            (rontolisp::%clojure-arithmetic-exception "integer overflow")
            n))))

(defun rontolisp::%clojure-long-v (&rest args)
  "long as a value."
  (rontolisp::%clojure-check-arity args 1 1 "long")
  (rontolisp::%clojure-long-cast (car args)))

(defun rontolisp::%clojure-int-v (&rest args)
  "int as a value."
  (rontolisp::%clojure-check-arity args 1 1 "int")
  (rontolisp::%clojure-int-cast (car args)))

(defun rontolisp::%clojure-math-round (a)
  "(clojure.math/round a): the long nearest the double of A, a tie rounding up
   -- the floor of a + 1/2, exactly; NaN is 0, and a double past either end of
   the long range is that end, like Java's Math.round."
  (let ((x (rontolisp::%clojure-double a)))
    (cond ((/= x x) 0)
          ((>= x 9.223372036854775807e18) 9223372036854775807)
          ((<= x -9.223372036854775808e18) -9223372036854775808)
          ((>= (abs x) 4.503599627370496e15) (truncate x))
          (t (floor (+ (rational x) 1/2))))))

(defun rontolisp::%clojure-math-floor-div (x y)
  "(clojure.math/floor-div x y): the largest long not above x / y, both longs;
   the one quotient past the long range (Long/MIN_VALUE by -1) wraps, and a
   zero divisor is the oracle's ArithmeticException."
  (let ((a (rontolisp::%clojure-long-cast x))
        (b (rontolisp::%clojure-long-cast y)))
    (if (= b 0)
        (rontolisp::%clojure-arithmetic-exception "/ by zero")
        (rontolisp::%clojure-wrap-long (floor a b)))))

(defun rontolisp::%clojure-math-floor-mod (x y)
  "(clojure.math/floor-mod x y): x minus (floor-div x y) times y, both longs,
   which takes y's sign; a zero divisor is the oracle's ArithmeticException."
  (let ((a (rontolisp::%clojure-long-cast x))
        (b (rontolisp::%clojure-long-cast y)))
    (if (= b 0)
        (rontolisp::%clojure-arithmetic-exception "/ by zero")
        (mod a b))))

(defun rontolisp::%clojure-math-exact (n)
  "N when it is a long, else the oracle's ArithmeticException, long overflow."
  (if (or (< n -9223372036854775808) (> n 9223372036854775807))
      (rontolisp::%clojure-arithmetic-exception "long overflow")
      n))

(defun rontolisp::%clojure-math-add-exact (x y)
  "(clojure.math/add-exact x y): the sum of two longs, refused past the long
   range."
  (rontolisp::%clojure-math-exact
   (+ (rontolisp::%clojure-long-cast x) (rontolisp::%clojure-long-cast y))))

(defun rontolisp::%clojure-math-subtract-exact (x y)
  "(clojure.math/subtract-exact x y): the difference of two longs, refused past
   the long range."
  (rontolisp::%clojure-math-exact
   (- (rontolisp::%clojure-long-cast x) (rontolisp::%clojure-long-cast y))))

(defun rontolisp::%clojure-math-multiply-exact (x y)
  "(clojure.math/multiply-exact x y): the product of two longs, refused past
   the long range."
  (rontolisp::%clojure-math-exact
   (* (rontolisp::%clojure-long-cast x) (rontolisp::%clojure-long-cast y))))

(defun rontolisp::%clojure-math-increment-exact (a)
  "(clojure.math/increment-exact a): the long A plus one, refused past the long
   range."
  (rontolisp::%clojure-math-exact (+ (rontolisp::%clojure-long-cast a) 1)))

(defun rontolisp::%clojure-math-decrement-exact (a)
  "(clojure.math/decrement-exact a): the long A minus one, refused past the long
   range."
  (rontolisp::%clojure-math-exact (- (rontolisp::%clojure-long-cast a) 1)))

(defun rontolisp::%clojure-math-negate-exact (a)
  "(clojure.math/negate-exact a): minus the long A, refused past the long range
   (Long/MIN_VALUE has no long negation)."
  (rontolisp::%clojure-math-exact (- (rontolisp::%clojure-long-cast a))))

;;;; Metadata: with-meta and meta over an identity side table.
;;
;; A value's metadata lives in rontolisp::%clojure-meta-table, an eq table from the
;; object with-meta answered to its map, read and written under
;; %clojure-meta-guard (a Ring handler runs one thread per request on the
;; interpreter and the JVM). with-meta answers a fresh shallow copy,
;; like the oracle's new object: the original keeps its own metadata and = still
;; compares contents (a reify copy keeps its tag, so it dispatches the same and is
;; a different object, like the oracle's); the table keeps every object it was
;; handed for the program's lifetime. The kinds that carry metadata are the
;; oracle's IObj kinds the lowering has: symbols, maps, vectors, lists, sets,
;; records, reify values, lazy seqs and functions (a wrapping closure).
;;
;; A symbol is interned, one object per name, so no metadata can sit on it: a
;; symbol carrying metadata is the wrapper (:C%SYMBOL sym meta) over the bare
;; symbol, made only with metadata -- by with-meta of a symbol, a quote or a read
;; of ^m sym, and a macro argument or template carrying reader metadata. Every
;; verb taking a symbol reads a wrapper as its bare symbol (= and the hashes
;; too, so it is = to the bare symbol and to every other wrapper of it, while
;; identical? tells them apart, like the oracle's), and a map key or set member
;; is stored as the bare symbol. Each such reading is an arm of the symbol-meta
;; family (clojure/ClojureArms), whose producers are what makes a wrapper, so a
;; program making none compiles as before it existed.
;;
;; Deliberate non-goals, each a documented deviation (.kb/clojure-frontend.md): a
;; derived value (conj, dissoc, ...) starts without metadata where the oracle
;; carries it over; a symbol keys a map or set without its metadata; the table
;; keeps every object it was handed for the program's lifetime.

(defvar rontolisp::%clojure-meta-guard (rontolisp:make-mutex))

(defvar rontolisp::%clojure-meta-table
  (make-hash-table :test 'eq)
  "The metadata side table: an eq table from an object to its metadata map.")

(defun rontolisp::%clojure-check-meta (m)
  "M, or the oracle's refusal when it is neither nil nor a map."
  (if (or (null m) (hash-table-p m) (rontolisp::%clojure-record-p m)
          (rontolisp::%clojure-sorted-map-p m))
      m
      (rontolisp::%clojure-class-cast-exception
       "with-meta takes a map as metadata")))

(defun rontolisp::%clojure-put-meta (x m)
  "X with the metadata map M recorded for it (none for a nil M); answers X."
  (when (rontolisp::%clojure-check-meta m)
    (rontolisp:with-mutex (rontolisp::%clojure-meta-guard)
      (setf (gethash x rontolisp::%clojure-meta-table) m)))
  x)

(defun rontolisp::%clojure-meta-symbol-p (x)
  "Whether X is a symbol carrying metadata: the (:C%SYMBOL sym meta) wrapper."
  (and (consp x) (eq (car x) :C%SYMBOL)))

(defun rontolisp::%clojure-symbol-with-meta (sym m)
  "The bare symbol SYM carrying the metadata map M: a fresh wrapper, or SYM
   itself for a nil M."
  (if (null m) sym (list :C%SYMBOL sym m)))

(defun rontolisp::%clojure-symbol-bare (x)
  "X's bare symbol when X is a symbol carrying metadata, else X: what a case
   dispatches on (the family's view, X itself in a program making none)."
  (if (rontolisp::%clojure-meta-symbol-p x) (car (cdr x)) x))

;; A deftype implementing IObj answers its own withMeta, and one implementing
;; IMeta its own meta: arms of the meta-interface family ("Host interfaces").
;; A symbol answers a fresh wrapper carrying the metadata, like the oracle's new
;; object: = reads it as its bare symbol, while identical? tells it apart, like
;; the oracle's; a macro expansion decodes it as the symbol with its metadata as
;; reader metadata -- test.check's defspec varies its name's metadata this way,
;; and the defn it emits registers its :test below.
(defun rontolisp::%clojure-with-meta (x m)
  "A copy of X carrying the metadata map M, like the oracle's withMeta; a
   symbol answers a fresh wrapper over its bare symbol (the symbol itself for
   a nil M). Anything else that is no IObj in the oracle signals, like its
   cast."
  (cond ((rontolisp::%clojure-iobj-p x)
         (funcall (rontolisp::%clojure-interface-entry x "withMeta") x m))
        ;; ahead of the list arm: the wrapper is a cons
        ((rontolisp::%clojure-meta-symbol-p x)
         (rontolisp::%clojure-symbol-with-meta (car (cdr x))
          (rontolisp::%clojure-check-meta m)))
        ((hash-table-p x)
         (let ((copy (make-hash-table :test 'equal)))
           (maphash (lambda (k v) (setf (gethash k copy) v)) x)
           (rontolisp::%clojure-put-meta copy m)))
        ((and (vectorp x) (not (stringp x)))
         (rontolisp::%clojure-put-meta (copy-seq x) m))
        ((functionp x)
         (rontolisp::%clojure-put-meta (lambda (&rest args) (apply x args)) m))
        ((and (consp x) (not (rontolisp::%clojure-keyword-p x))
              (not (rontolisp::%clojure-atom-p x))
              (not
               (member (car x)
                       '(:C%TYPE :C%PATTERN :C%MATCHER
                                 :C%REDUCED :C%NIL
                                 :C%VAR :C%UNBOUND))))
         (rontolisp::%clojure-put-meta (copy-list x) m))
        ((and x (symbolp x) (not (eq x t))
              (not (eq x rontolisp::%clojure-false)))
         (rontolisp::%clojure-symbol-with-meta x
          (rontolisp::%clojure-check-meta m)))
        (t (rontolisp::%clojure-class-cast-exception-of
            "with-meta takes a collection, a record or a function" x))))

(defun rontolisp::%clojure-with-meta-v (&rest args)
  "with-meta as a value."
  (rontolisp::%clojure-check-arity args 2 2 "with-meta")
  (rontolisp::%clojure-with-meta (car args) (car (cdr args))))

(defun rontolisp::%clojure-meta (x)
  "X's metadata map, nil when it carries none."
  (if (rontolisp::%clojure-meta-symbol-p x)
      (car (cdr (cdr x)))
      (if (rontolisp::%clojure-imeta-p x)
          (funcall (rontolisp::%clojure-interface-entry x "meta") x)
          (rontolisp:with-mutex (rontolisp::%clojure-meta-guard)
            (values (gethash x rontolisp::%clojure-meta-table))))))

(defun rontolisp::%clojure-meta-v (&rest args)
  "meta as a value."
  (rontolisp::%clojure-check-arity args 1 1 "meta")
  (rontolisp::%clojure-meta (car args)))

(defun rontolisp::%clojure-vary-meta (x f args)
  "A copy of X carrying (apply f (meta x) args)."
  (rontolisp::%clojure-with-meta x (apply f (rontolisp::%clojure-meta x) args)))

(defun rontolisp::%clojure-vary-meta-v (&rest args)
  "vary-meta as a value."
  (rontolisp::%clojure-check-arity args 2 nil "vary-meta")
  (rontolisp::%clojure-vary-meta (car args)
                                 (rontolisp::%clojure-as-fn (car (cdr args)))
                                 (cdr (cdr args))))

(defun rontolisp::%clojure-meta-method (x method)
  "The implementation X's metadata holds under the qualified METHOD symbol, or
   NIL when it holds none or a falsey one: the oracle's extend-via-metadata
   lookup, which then invokes it like any IFn."
  (let ((m (rontolisp::%clojure-meta x)))
    (if m
        (let ((f
               (gethash method
                        (if (hash-table-p m)
                            m
                            (if (rontolisp::%clojure-sorted-map-p m)
                                (rontolisp::%clojure-sorted-table m "meta")
                                (car (cdr (cdr (cdr m)))))))))
          (if (rontolisp::%clojure-truthy f) f nil))
        nil)))

(defun rontolisp::%clojure-type-tag (x)
  "type's read of X's metadata: its logically true :type entry, else NIL, under
   which type answers X's class, like the oracle's (or (get (meta x) :type)
   (class x))."
  (rontolisp::%clojure-meta-method x (list :C%KEYWORD "type")))

;;;; Type designators: what type answers where the oracle answers a host class.
;;
;; A schema registry lookup falls through to (type x) on a miss, and the oracle
;; answers a host class there: every entry but Pattern's misses, so an
;; unregistered value refuses with :malli.core/invalid-schema. A kind keyword
;; here hits the :function/:keyword/:string/:symbol/:boolean/:nil/:map/:set
;; entry instead: a function or set loops until the stack overflows, anything
;; else mistypes (child-error, invalid-entry). So type answers the host class
;; designator (:C%CLASS name) for exactly those kinds -- the names
;; %clojure-class-name-of answers, so a value reads as its class -- and nil for
;; nil, like the oracle. A pattern answers the host Pattern class object where
;; a host is, its (:C%CLASS name) designator where none is (typeForm splits the
;; way a bare class literal does): only the oracle's answer hits the registry's
;; class-schemas entry, so (m/schema #"a") builds the regex schema. class keeps
;; the kind keyword; the multimethod dispatcher and instance? read a designator
;; back as its kind, so dispatch answers what the keyword did. A kind no entry
;; collides with (numbers, vectors, records, ...) keeps its keyword: its miss
;; already refuses right.

(defvar rontolisp::%clojure-type-class-names
  '(("clojure.lang.AFunction" . "function") ("clojure.lang.Keyword" . "keyword")
    ("java.lang.String" . "string") ("clojure.lang.Symbol" . "symbol")
    ("java.lang.Boolean" . "boolean")
    ("clojure.lang.PersistentArrayMap" . "map")
    ("clojure.lang.PersistentHashMap" . "map")
    ("clojure.lang.PersistentTreeMap" . "map")
    ("clojure.lang.PersistentHashSet" . "set")
    ("clojure.lang.PersistentTreeSet" . "set"))
  "Host class names type answers by designator, each to the spelling of the
   kind keyword class answers for its values.")

(defun rontolisp::%clojure-type-designator (k x)
  "type's answer for the kind keyword K class answers for X: the (:C%CLASS
   name) designator of X's host class when K collides with a schema registry
   entry, nil for nil, else K itself. A map names its size's class, like the
   oracle (an empty map PersistentArrayMap, nine entries up PersistentHashMap);
   a sorted map or set its tree class (the (:C%SORTED setp cmp items) wrapper
   %clojure-sorted-p names). K is never a designator here: type is the only
   caller, over class's answer."
  (if (rontolisp::%clojure-keyword-p k)
      (let ((spelling (car (cdr k))))
        (cond
         ((equal spelling "function") (list :c%class "clojure.lang.AFunction"))
         ((equal spelling "keyword") (list :c%class "clojure.lang.Keyword"))
         ((equal spelling "string") (list :c%class "java.lang.String"))
         ((equal spelling "symbol") (list :c%class "clojure.lang.Symbol"))
         ((equal spelling "boolean") (list :c%class "java.lang.Boolean"))
         ((equal spelling "nil") nil)
         ((equal spelling "map")
          (list :c%class (if (and (consp x) (eq (car x) :C%SORTED))
                             "clojure.lang.PersistentTreeMap"
                             (if (> (hash-table-count x) 8)
                                 "clojure.lang.PersistentHashMap"
                                 "clojure.lang.PersistentArrayMap"))))
         ((equal spelling "set")
          (list :c%class (if (and (consp x) (eq (car x) :C%SORTED))
                             "clojure.lang.PersistentTreeSet"
                             "clojure.lang.PersistentHashSet")))
         (t k)))
      k))

(defun rontolisp::%clojure-designator-kind (v)
  "The kind keyword class answers for the values of V's host class, when V is
   a (:C%CLASS name) designator of one of %clojure-type-class-names, else NIL.
   The multimethod dispatcher and instance? read a type answer through this,
   so a designator finds the kind method a defmethod stores, like the keyword
   did; a designator of any other class stays one, as before."
  (if (and (consp v) (eq (car v) :C%CLASS) (consp (cdr v))
           (stringp (car (cdr v))))
      (let ((spelling
             (cdr
              (assoc (car (cdr v)) rontolisp::%clojure-type-class-names
                     :test #'equal))))
        (if spelling (list :c%keyword spelling) nil))
      nil))

;;;; Monitors: the lock locking holds on the interpreter and the JVM, and the
;;;; one alter-var-root, alter-meta! and reset-meta! hold.
;;
;; The oracle's locking enters the object's own monitor. Here a value has none, so
;; rontolisp::%clojure-monitors maps it, by identity (eql: a number by value), to a
;; reentrant rontolisp:make-mutex, made on first use under one guard mutex (a Ring
;; handler runs one thread per request, so two may ask at once). A keyword is a
;; fresh list per site, so it is keyed by its spelling instead, one monitor per
;; keyword like the oracle's interned one. Like the metadata table it keeps every
;; object it was handed. The wasm lowering of locking never calls it: a module
;; is single-threaded, so the body runs as is (the alter functions call it on
;; every target, where wasm's mutex is a no-op).

(defvar rontolisp::%clojure-monitor-guard (rontolisp:make-mutex))

(defvar rontolisp::%clojure-monitors (make-hash-table :test 'eql))

(defvar rontolisp::%clojure-keyword-monitors (make-hash-table :test 'equal))

(defun rontolisp::%clojure-monitor (x)
  "The reentrant mutex standing for X's monitor."
  (rontolisp:with-mutex (rontolisp::%clojure-monitor-guard)
    (let ((table
           (if (rontolisp::%clojure-keyword-p x)
               rontolisp::%clojure-keyword-monitors
               rontolisp::%clojure-monitors))
          (key (if (rontolisp::%clojure-keyword-p x) (car (cdr x)) x)))
      (or (gethash key table)
          (setf (gethash key table) (rontolisp:make-mutex))))))

;;;; Shared core values: one object per site-independent core function value.
;;
;; A predicate (or not, or boolean) as a value must be one object program-wide --
;; = and identical? like the oracle's var roots, and usable as a map key
;; (malli's registry keys its schemas by predicate values). A fresh lambda per
;; reference site used to make them distinct objects, which identity equality
;; then told apart. rontolisp::%clojure-shared-values maps the core name to its
;; object, made on first use; later references answer the stored one. The table
;; lives per environment, so macro-time evaluation shares macro-time-wide and
;; the program shares run-wide. Only rows whose body closes over nothing but
;; its parameters come here. A core value closing over lower-time state that
;; still evolves while the program lowers (the namespaces known, the libraries
;; loaded, the namespace and its aliases) shares one cell per snapshot instead
;; of one program-wide: the lowering keys the cell by the snapshot's digest, so
;; two references under one snapshot are one object while references under
;; different snapshots keep distinct objects, and no call through a value moves.

(defvar rontolisp::%clojure-shared-values (make-hash-table :test 'equal))

(defun rontolisp::%clojure-shared-value (name make)
  "The program-wide value of the site-independent core function NAME: (funcall
   MAKE) on first use, the stored object after."
  (or (gethash name rontolisp::%clojure-shared-values)
      (setf (gethash name rontolisp::%clojure-shared-values) (funcall make))))

;;;; Atoms across request threads.
;;
;; A Ring handler runs one thread per request on the interpreter and the JVM, and an
;; atom is how a program shares state between them. swap! is the oracle's retry
;; loop: the function runs on the value read, outside any lock, and the
;; compare-and-set stores its answer only if the cell still holds that value, else
;; it runs again on the newer one (also what a function swapping the same atom
;; itself sees, on every backend). The compare and the store are one step under
;; %clojure-atom-guard, which holds nothing but an eql and a store, so it never
;; waits on the program's code; reset! stores under it too, so no store lands
;; between a compare and its store. ATOM is the (:C%ATOM cell) wrapper, CELL its
;; vector. deref reads without the guard: a stale read fails the compare and is
;; read again. On wasm, a single-threaded module, the guard is a no-op.
;;
;; These are the plain helpers: a program that can give no reference a validator
;; or a watch calls them. One that can (it names add-watch, set-validator! or an
;; atom option) calls the %clojure-ref-* helpers of "Validators and watches"
;; instead, which the strip renames to these elsewhere (clojure/ClojureArms, the
;; WATCH family).

(defvar rontolisp::%clojure-atom-guard (rontolisp:make-mutex))

(defun rontolisp::%clojure-atom-cas (atom old new)
  "T when ATOM held OLD (eql) and now holds NEW, as one step; else NIL."
  (let ((cell (car (cdr atom))))
    (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
      (when (eql (aref cell 0) old)
        (setf (aref cell 0) new)
        t))))

(defun rontolisp::%clojure-atom-reset (atom new)
  "ATOM rewritten to NEW under the guard; answers NEW."
  (let ((cell (car (cdr atom))))
    (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
      (setf (aref cell 0) new)))
  new)

(defun rontolisp::%clojure-atom-swap (atom f args)
  "F applied to ATOM's value and ARGS until the compare-and-set stores its
   answer; answers the value stored."
  (let ((cell (car (cdr atom))))
    (loop
      (let* ((old (aref cell 0)) (new (apply f old args)))
        (when (rontolisp::%clojure-atom-cas atom old new) (return new))))))

(defun rontolisp::%clojure-atom-swap-vals (atom f args)
  "swap-vals!: as %clojure-atom-swap, answering [old new]."
  (let ((cell (car (cdr atom))))
    (loop
      (let* ((old (aref cell 0)) (new (apply f old args)))
        (when (rontolisp::%clojure-atom-cas atom old new)
          (return (vector old new)))))))

(defun rontolisp::%clojure-atom-reset-vals (atom new)
  "reset-vals!: ATOM rewritten to NEW, answering [old new]."
  (let ((cell (car (cdr atom))))
    (loop
      (let ((old (aref cell 0)))
        (when (rontolisp::%clojure-atom-cas atom old new)
          (return (vector old new)))))))

;;;; Refs and agents across request threads.
;;
;; A transaction (dosync) runs its body without holding any lock, tracking the
;; refs it reads with the commit count each held when read; at the commit point
;; it waits for the ensures of refs it wrote, then under %clojure-stm-guard it
;; retries the body when another committed transaction wrote a read ref and
;; otherwise installs the pending writes: the body re-runs, so its side effects
;; may run more than once, like the oracle's. alter and ref-set stage their
;; writes in the transaction, logging the before-value; commute logs its function
;; and arguments and applies them at commit to the latest value (running twice
;; uncontended, like the oracle's); ensure answers the value and pins the read
;; until commit, which blocks writers of the ref. A nested dosync joins the
;; running transaction. Validators run on the final values, and a body that
;; signals (a refusing validator included) drops its pending writes.
;;
;; An agent runs its actions one at a time in the order they were sent. A send
;; queues the action under %clojure-atom-guard and, when no thread is running the
;; agent, elects its thread the runner: on a host target the runner hands the
;; agent to the shared pool ("The shared agent pool" below), so a slow action
;; never blocks its sender; on wasm, single-threaded by construction, the runner
;; runs the queue itself. Actions run outside every
;; lock, so a send never waits for another request's action. A send made while a
;; transaction or an action runs is held until it completes, and dropped when it
;; fails, like the oracle's. A failing action (a throw, a refusing validator)
;; never signals: the agent's error handler is called with the agent and the
;; error, then in the :fail mode the agent keeps the error and stops, its queue
;; kept, refusing every send and await until restart-agent; in the :continue
;; mode the queue goes on.
;;
;; A ref with a validator and every agent carry it in the cell: #(value nil
;; validator state watches), slot 1 nil because a volatile is the cell of length
;; 2; an agent's STATE is #(running queue error handler mode), nil for a ref, and
;; WATCHES the reference's watches ("Validators and watches"). A ref without a
;; validator is the atom's cell. On wasm, a single-threaded module, the guards
;; are no-ops.

(defvar rontolisp::%clojure-stm-guard (rontolisp:make-mutex))

;; The running transaction's log, a box holding (ref . value before the
;; transaction) entries; nil outside a transaction.
(defvar rontolisp::%clojure-stm-log nil)

;; The running transaction's read set, a box holding (ref . commit count)
;; entries, newest first; nil outside a transaction.
(defvar rontolisp::%clojure-stm-reads nil)

;; The running transaction's commutes, a box holding (ref fun args eager)
;; entries, newest first; nil outside a transaction.
(defvar rontolisp::%clojure-stm-commutes nil)

;; The running transaction's pending writes, a box holding (ref . value)
;; entries, newest first; installed at commit, discarded otherwise.
(defvar rontolisp::%clojure-stm-pending nil)

;; Every ref a transaction read or wrote, to its commit count, bumped on every
;; commit that wrote it; a ref read before any write reads 0. An eql table: the
;; wrapper is one object per ref, so identity is equality.
(defvar rontolisp::%clojure-stm-versions (make-hash-table :test 'eql))

;; Refs an ensure pins, to the log of the transaction holding them; a writer of
;; one waits until its holder commits, aborts or fails, like the oracle's.
(defvar rontolisp::%clojure-stm-pins (make-hash-table :test 'eql))

;; The guard of the two tables above: taken briefly, never while user code runs
;; and never while waiting on a pin, so no lock order exists.
(defvar rontolisp::%clojure-stm-table-guard (rontolisp:make-mutex))

;; Where a send waits while a transaction or an action runs on this thread: a
;; box holding (agent . action) entries, newest first; nil where it runs at once.
(defvar rontolisp::%clojure-agent-held nil)

(defun rontolisp::%clojure-stm-validate (value validator)
  "VALUE, once VALIDATOR (nil for none, else any IFn) accepts it; else the
   oracle's refusal."
  (if (and validator
           (not
            (rontolisp::%clojure-truthy
             (rontolisp::%clojure-call validator (list value)))))
      (rontolisp::%clojure-illegal-state-exception "Invalid reference state")
      value))

(defun rontolisp::%clojure-cell-validator (cell)
  "The validator CELL carries, or nil."
  (if (> (length cell) 2) (aref cell 2) nil))

(defun rontolisp::%clojure-ref-make (init validator)
  "(ref init :validator f): the cell carrying VALIDATOR, which INIT must pass."
  (list :C%ATOM (vector (rontolisp::%clojure-stm-validate init validator) nil
                        validator nil nil)))

(defun rontolisp::%clojure-agent-make (init validator handler mode)
  "(agent init): an idle agent with no queued action over INIT, which
   VALIDATOR (nil for none) must pass, its error HANDLER (nil for none) and
   MODE; a MODE nil is the oracle's default, :continue with a handler and :fail
   without."
  (list :C%ATOM (vector (rontolisp::%clojure-stm-validate init validator) nil
                        validator
                        (vector nil nil nil handler
                                (or mode
                                    (if handler
                                        '(:c%keyword "continue")
                                        '(:c%keyword "fail")))) nil)))

(defun rontolisp::%clojure-agent-option (options name)
  "What the key/value list OPTIONS gives the keyword NAME, read like the
   oracle's (apply hash-map options): the last value when repeated, nil for
   none or a false one; a key without a value is its refusal."
  (let ((found nil))
    (do ((p options (cdr (cdr p))))
        ((null p) (if (rontolisp::%clojure-truthy found) found nil))
      (if (null (cdr p))
          (rontolisp::%clojure-illegal-argument-exception
           (concatenate 'string "No value supplied for key: "
                        (rontolisp::%clojure-str-of (car p) "null" nil))))
      (if (and (consp (car p)) (eq (car (car p)) :c%keyword)
               (equal (car (cdr (car p))) name))
          (setq found (car (cdr p)))))))

(defun rontolisp::%clojure-agent-v (&rest args)
  "agent with options, called and as a value: (agent init :validator f
   :error-handler h :error-mode m); :meta and any other key are ignored, like
   the oracle's."
  (rontolisp::%clojure-check-arity args 1 nil "agent")
  (let ((options (cdr args)))
    (rontolisp::%clojure-agent-make (car args)
     (rontolisp::%clojure-agent-option options "validator")
     (rontolisp::%clojure-agent-option options "error-handler")
     (rontolisp::%clojure-agent-option options "error-mode"))))

(defun rontolisp::%clojure-stm-require ()
  "Nil inside a transaction; the oracle's refusal outside one."
  (if rontolisp::%clojure-stm-log
      nil
      (rontolisp::%clojure-illegal-state-exception "No transaction running")))

(defun rontolisp::%clojure-stm-write (ref value)
  "alter, commute and ref-set inside the running transaction: VALUE logged as
   REF's pending write (installed at commit), with its value from before the
   transaction on its first write; answers VALUE. A write past a commute of REF
   in this transaction is the oracle's refusal."
  (let ((log rontolisp::%clojure-stm-log)
        (pending rontolisp::%clojure-stm-pending))
    (if (assoc ref (car rontolisp::%clojure-stm-commutes))
        (rontolisp::%clojure-illegal-state-exception "Can't set after commute"))
    (if (assoc ref (car log))
        nil
        (setf (car log) (cons (cons ref (aref (car (cdr ref)) 0)) (car log))))
    (rontolisp::%clojure-stm-read ref)
    (setf (car pending) (cons (cons ref value) (car pending)))
    value))

(defun rontolisp::%clojure-stm-version-of (ref)
  "REF's commit count, 0 where no transaction ever wrote it."
  (rontolisp:with-mutex (rontolisp::%clojure-stm-table-guard)
    (or (gethash ref rontolisp::%clojure-stm-versions) 0)))

(defun rontolisp::%clojure-stm-bump (refs)
  "Bump every ref of REFS past its commit: a transaction that read an older
   count retries."
  (rontolisp:with-mutex (rontolisp::%clojure-stm-table-guard)
    (dolist (ref refs)
      (setf (gethash ref rontolisp::%clojure-stm-versions)
            (1+ (or (gethash ref rontolisp::%clojure-stm-versions) 0))))))

(defun rontolisp::%clojure-stm-read (ref)
  "Record REF and its commit count in the running transaction's read set, unless
   recorded; nil outside one. Answers nil."
  (let ((reads rontolisp::%clojure-stm-reads))
    (if (and reads (not (assoc ref (car reads))))
        (setf (car reads)
              (cons (cons ref (rontolisp::%clojure-stm-version-of ref))
                    (car reads)))))
  nil)

(defun rontolisp::%clojure-stm-peek (ref)
  "REF's in-transaction value: the latest commute's application, else the
   latest pending write, else the cell's. Reads see no uncommitted write but
   the transaction's own, so no commit builds on a value no commit made."
  (let ((commuted (assoc ref (car rontolisp::%clojure-stm-commutes))))
    (if commuted
        (car (cdr (cdr (cdr commuted))))
        (let ((wrote (assoc ref (car rontolisp::%clojure-stm-pending))))
          (if wrote (cdr wrote) (aref (car (cdr ref)) 0))))))

(defun rontolisp::%clojure-stm-deref (ref)
  "deref's read inside a transaction: recorded in the read set, answering the
   in-transaction value; outside one the cell's value."
  (if rontolisp::%clojure-stm-log
      (progn
        (rontolisp::%clojure-stm-read ref)
        (rontolisp::%clojure-stm-peek ref))
      (aref (car (cdr ref)) 0)))

(defun rontolisp::%clojure-stm-ensure (ref)
  "ensure's read: the ref recorded and pinned to this transaction, answering
   its in-transaction value."
  (rontolisp::%clojure-stm-read ref)
  (rontolisp:with-mutex (rontolisp::%clojure-stm-table-guard)
    (setf (gethash ref rontolisp::%clojure-stm-pins)
          rontolisp::%clojure-stm-log))
  (rontolisp::%clojure-stm-peek ref))

(defun rontolisp::%clojure-stm-commute (ref fun args)
  "commute's application: FUN of the in-transaction value and ARGS, logged for
   the commit's re-application onto the latest value, answering it. Later reads
   in this transaction see it. The eager application writes nothing in place,
   so a conflicting commit retries before it could build on it."
  (let* ((commutes rontolisp::%clojure-stm-commutes)
         (base (rontolisp::%clojure-stm-peek ref))
         (eager (apply fun (cons base args))))
    (setf (car commutes) (cons (list ref fun args eager) (car commutes)))
    eager))

(defun rontolisp::%clojure-stm-valid-p (reads)
  "Whether the running transaction may commit: every (ref . version) of READS
   still holds its count. A committed writer of one since retries the
   transaction; nothing uncommitted is ever visible, so nothing else can."
  (dolist (entry (car reads) t)
    (if (not (eql (cdr entry) (rontolisp::%clojure-stm-version-of (car entry))))
        (return nil))))

(defun rontolisp::%clojure-stm-pinned (log commutes)
  "Whether a writer of the running transaction must wait: a written ref pinned
   to another transaction's log."
  (rontolisp:with-mutex (rontolisp::%clojure-stm-table-guard)
    (dolist (ref (append (mapcar #'car (car log)) (mapcar #'car (car commutes)))
                 nil)
      (let ((owner (gethash ref rontolisp::%clojure-stm-pins nil)))
        (if (and owner (not (eq owner log))) (return t))))))

(defun rontolisp::%clojure-stm-release-pins (log)
  "Forget the ensures the transaction LOG holds."
  (rontolisp:with-mutex (rontolisp::%clojure-stm-table-guard)
    (let ((out nil))
      (maphash
       (lambda (ref owner) (if (eq owner log) (setq out (cons ref out))))
       rontolisp::%clojure-stm-pins)
      (dolist (ref out) (remhash ref rontolisp::%clojure-stm-pins)))))

(defun rontolisp::%clojure-stm-commit-check (log commutes)
  "Whether the running transaction may commit: writers of ensured refs wait
   for their holder first, like the oracle's. The wait re-checks without
   sleeping -- a sleep needs the component wait shim, and there is nothing to
   wait for where no other thread exists."
  (loop (if (rontolisp::%clojure-stm-pinned log commutes) nil (return nil)))
  t)

(defun rontolisp::%clojure-stm-abort (log reads commutes pending held)
  "Drop the running transaction: its pending writes never reach a cell, its
   ensures are forgotten and its held sends dropped. Answered nil; nothing was
   ever visible, so no versions bump and no values move."
  (rontolisp::%clojure-stm-release-pins log)
  (setf (car log) nil)
  (setf (car reads) nil)
  (setf (car commutes) nil)
  (setf (car pending) nil)
  (setf (car held) nil)
  nil)

(defun rontolisp::%clojure-stm-run (body)
  "dosync: the thunk BODY run as one transaction, answering its value. The body
   runs without holding any lock; at the commit point writers of ensured refs
   wait for their holder, then under one lock a read conflict retries the body
   and otherwise the commute entries apply onto the latest values, the
   validators run on the final values and the versions bump. The watches of the
   refs it wrote are called once it committed, then the sends it made are
   dispatched. A nested dosync joins the running transaction."
  (if rontolisp::%clojure-stm-log
      (funcall body)
      (let ((log (list nil))
            (held (list nil))
            (reads (list nil))
            (commutes (list nil))
            (pending (list nil)))
        (loop
          (let ((answer nil) (committed nil))
            (unwind-protect (progn
                              (setq answer
                                    (let ((rontolisp::%clojure-stm-log log)
                                          (rontolisp::%clojure-agent-held held)
                                          (rontolisp::%clojure-stm-reads reads)
                                          (rontolisp::%clojure-stm-commutes
                                           commutes)
                                          (rontolisp::%clojure-stm-pending
                                           pending))
                                      (funcall body)))
                              ;; writers of ensured refs wait for their holder
                              ;; outside the commit lock: the holder needs it
                              ;; to finish
                              (rontolisp::%clojure-stm-commit-check log
                                                                    commutes)
                              (setq committed
                                    (rontolisp:with-mutex (rontolisp::%clojure-stm-guard)
                                      (if (not
                                           (rontolisp::%clojure-stm-valid-p
                                            reads))
                                          nil
                                          (let ((clean nil))
                                            (unwind-protect (progn
                                                              ;; install the pending writes, oldest first
                                                              (dolist (entry
                                                                       (reverse
                                                                        (car
                                                                         pending)))
                                                                (setf
                                                                 (aref
                                                                  (car
                                                                   (cdr
                                                                    (car
                                                                     entry))) 0)
                                                                 (cdr entry)))
                                                              ;; commute entries apply to the latest
                                                              ;; value, in order
                                                              (dolist (entry
                                                                       (reverse
                                                                        (car
                                                                         commutes)))
                                                                (let* ((ref
                                                                        (car
                                                                         entry))
                                                                       (fun
                                                                        (car
                                                                         (cdr
                                                                          entry)))
                                                                       (args
                                                                        (car
                                                                         (cdr
                                                                          (cdr
                                                                           entry))))
                                                                       (cell
                                                                        (car
                                                                         (cdr
                                                                          ref))))
                                                                  (if (not
                                                                       (assoc
                                                                        ref
                                                                        (car
                                                                         log)))
                                                                      (setf
                                                                       (car log)
                                                                       (cons
                                                                        (cons
                                                                         ref
                                                                         (aref
                                                                          cell
                                                                          0))
                                                                        (car
                                                                         log))))
                                                                  (setf
                                                                   (aref cell 0)
                                                                   (rontolisp::%clojure-stm-validate
                                                                    (apply fun
                                                                     (cons
                                                                      (aref cell
                                                                            0)
                                                                      args))
                                                                    (rontolisp::%clojure-cell-validator
                                                                     cell)))))
                                                              ;; validators run on the final values,
                                                              ;; as before
                                                              (dolist (entry
                                                                       (car
                                                                        log))
                                                                (let ((cell
                                                                       (car
                                                                        (cdr
                                                                         (car
                                                                          entry)))))
                                                                  (rontolisp::%clojure-stm-validate
                                                                   (aref cell 0)
                                                                   (rontolisp::%clojure-cell-validator
                                                                    cell))))
                                                              (rontolisp::%clojure-stm-bump
                                                               (mapcar #'car
                                                                (car log)))
                                                              (rontolisp::%clojure-stm-noted
                                                               (rontolisp::%clojure-ref-history-noted
                                                                answer log) log)
                                                              (rontolisp::%clojure-stm-notified
                                                               answer log)
                                                              (rontolisp::%clojure-stm-release-pins
                                                               log)
                                                              (setq clean t)
                                                              t)
                                              (if clean
                                                  nil
                                                  ;; a failure mid-commit puts back and
                                                  ;; bumps, still under the guard
                                                  (progn
                                                    (dolist (entry (car log))
                                                      (setf (aref (car
                                                                   (cdr
                                                                    (car
                                                                     entry))) 0)
                                                            (cdr entry)))
                                                    (rontolisp::%clojure-stm-bump
                                                     (mapcar #'car
                                                             (car log)))))))))))
              (if committed
                  nil
                  (rontolisp::%clojure-stm-abort log reads commutes pending
                                                 held)))
            (if committed
                (progn
                  (rontolisp::%clojure-agent-release held)
                  (return answer))))))))

(defun rontolisp::%clojure-agent-release (held)
  "The sends the box HELD kept, queued in the order they were made: enqueued
   like the oracle's releasePendingSends, so a send held for an agent that has
   failed since joins its queue."
  (dolist (entry (reverse (car held)))
    (rontolisp::%clojure-agent-drain (car entry) (cdr entry))))

(defun rontolisp::%clojure-agent-cell (agent op)
  "AGENT's cell; the oracle's cast failure of OP for anything but an agent."
  (if (and (rontolisp::%clojure-atom-p agent) (= (length (car (cdr agent))) 5)
           (aref (car (cdr agent)) 3))
      (car (cdr agent))
      (rontolisp::%clojure-class-cast-exception-of
       (concatenate 'string op " needs an agent") agent)))

(defun rontolisp::%clojure-agent-check (cell)
  "Nil while the agent CELL has no error; else the oracle's refusal of a send
   to a failed agent, a RuntimeException whose cause is the error."
  (let ((failure (aref (aref cell 3) 2)))
    (if failure
        (error
         (c%e-new '("java.lang.RuntimeException" "java.lang.Exception"
                    "java.lang.Throwable") "Agent is failed, needs restart" nil
                  failure)))))

(defun rontolisp::%clojure-agent-send (agent action)
  "send and send-off: ACTION, a function of AGENT's value answering its next,
   queued on AGENT, or held while a transaction or an action runs on this
   thread; answers AGENT. A failed agent refuses it."
  (let ((cell (rontolisp::%clojure-agent-cell agent "send"))
        (held rontolisp::%clojure-agent-held))
    (rontolisp::%clojure-agent-check cell)
    (if held
        (setf (car held) (cons (cons agent action) (car held)))
        (rontolisp::%clojure-agent-drain agent action))
    agent))

(defun rontolisp::%clojure-agent-drain (agent action)
  "ACTION (when not nil) queued on AGENT; then, unless another thread is
   running the agent or it has failed, its queue is handed to the shared pool,
   which runs it until it is empty or an action fails. Where no thread exists
   (wasm) this definition is replaced by the sender-thread one
   (eval/ClojureLibrary, the host-arms stand-ins), so no pool reference -- and
   no thread primitive -- reaches a module."
  (let* ((cell (car (cdr agent))) (state (aref cell 3)) (mine nil))
    (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
      (if action (setf (aref state 1) (append (aref state 1) (list action))))
      (if (and (aref state 1) (not (aref state 0)) (not (aref state 2)))
          (progn
            (setf (aref state 0) t)
            (setq mine t))))
    (if mine (rontolisp::%clojure-agent-pool-submit agent))))

;;;; The shared agent pool.
;;
;; On a host target (the interpreter and the JVM, where threads exist), an
;; elected runner hands its agent to the shared pool instead of running the
;; queue itself: four worker threads, started on the first send that needs one,
;; each pumping queued agents between sleeps of a millisecond. The pool is one
;; for sends
;; and send-offs alike (the oracle gives send-off its own unbounded pool; here
;; a blocking action holds a worker like any other). A CPU-bound action
;; therefore no longer blocks its sender -- or a request thread -- while await
;; still blocks the caller until the queued actions complete. Where no thread
;; exists (wasm, single-threaded by construction), this whole section is
;; pruned: the drain the module splices instead runs the queue on the elected
;; runner's own thread (eval/ClojureLibrary, the host-arms stand-ins).

(defvar rontolisp::%clojure-agent-pool
  nil
  "The shared pool: #(queue workers) once started, nil before. The queue holds
   the agents whose queue wants pumping, oldest first; the workers pump one
   each. Stays nil where no thread exists, where the sender runs each queue
   itself.")

(defvar rontolisp::%clojure-agent-pool-guard (rontolisp:make-mutex))

(defun rontolisp::%clojure-agent-pool-submit (agent)
  "Queue AGENT for a pump on the shared pool, starting its crew on the first
   call: one pump queued per election, like one inline run per election."
  (rontolisp:with-mutex (rontolisp::%clojure-agent-pool-guard)
    (if (null rontolisp::%clojure-agent-pool)
        (setf rontolisp::%clojure-agent-pool (vector nil nil)))
    (let ((pool rontolisp::%clojure-agent-pool))
      (if (null (aref pool 1))
          (setf (aref pool 1) (rontolisp::%clojure-agent-pool-start pool)))
      (setf (aref pool 0) (append (aref pool 0) (list agent))))))

(defun rontolisp::%clojure-agent-pool-start (pool)
  "Start the shared pool's crew over POOL, answering its worker handles: each
   loops taking the oldest queued agent and pumping it, sleeping between takes
   of an empty queue, so a worker never holds a lock while an action runs.
   Four workers, like the oracle's small fixed send pool."
  (let ((crew nil))
    (dotimes (i 4)
      (setq crew
            (cons (rontolisp:make-thread
                   (lambda () (rontolisp::%clojure-agent-pool-work pool)))
                  crew)))
    crew))

(defun rontolisp::%clojure-agent-pool-work (pool)
  "One pool thread's loop over POOL: pump the oldest queued agent, else sleep
   a millisecond. A pump that signals anyway (an action's own failure stays in
   the agent, so only a bug can) is dropped and the loop goes on, so the crew
   never shrinks."
  (loop
    (let ((agent
           (rontolisp:with-mutex (rontolisp::%clojure-agent-pool-guard)
             (if (aref pool 0)
                 (let ((next (car (aref pool 0))))
                   (setf (aref pool 0) (cdr (aref pool 0)))
                   next)
                 nil))))
      (if agent
          (handler-case (rontolisp::%clojure-agent-pump agent) (error () nil))
          (sleep 0.001)))))

(defun rontolisp::%clojure-agent-pump (agent)
  "Run AGENT's queue until it is empty or an action fails, one action after
   the other outside every lock: the elected runner's run, on its own thread
   or a pool worker's. Each take elects under %clojure-atom-guard; the last
   one clears the running flag, the unwind an abnormal exit."
  (let* ((cell (car (cdr agent))) (state (aref cell 3)) (done nil))
    (unwind-protect (loop
                      (let ((next
                             (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
                               (if (and (aref state 1) (not (aref state 2)))
                                   (let ((first (car (aref state 1))))
                                     (setf (aref state 1) (cdr (aref state 1)))
                                     first)
                                   (progn
                                     (setf (aref state 0) nil)
                                     nil)))))
                        (if next
                            (rontolisp::%clojure-agent-act agent cell next)
                            (progn
                              (setq done t)
                              (return nil)))))
      (if done
          nil
          (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
            (setf (aref state 0) nil))))))

(defun rontolisp::%clojure-agent-act (agent cell action)
  "One action of AGENT, whose cell is CELL: its answer validated and stored,
   the agent's watches called, then the sends it made sent. When it fails, the sends are dropped, the error
   handler is called (its own failure ignored, its sends dispatched at once)
   and, unless the mode is :continue, the agent keeps the error."
  (let ((held (list nil)) (failure nil))
    (handler-case (let* ((old (aref cell 0))
                         (next
                          (let ((rontolisp::%clojure-agent-held held)
                                (rontolisp::%clojure-stm-log nil))
                            (funcall action old))))
                    (rontolisp::%clojure-ref-notified
                     (setf (aref cell 0)
                      (rontolisp::%clojure-stm-validate next (aref cell 2)))
                     agent old))
      (error (c) (setq failure c)))
    (if failure
        (let* ((state (aref cell 3)) (handler (aref state 3)))
          (if handler
              (handler-case (let ((rontolisp::%clojure-agent-held nil)
                                  (rontolisp::%clojure-stm-log nil))
                              (funcall handler agent failure))
                (error () nil)))
          (if (equal (aref state 4) '(:c%keyword "continue"))
              nil
              (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
                (setf (aref state 2) failure))))
        (rontolisp::%clojure-agent-release held))))

(defun rontolisp::%clojure-agent-await-here (agents)
  "await's dispatch: a marker action queued behind each of AGENTS' queued
   actions, and each queue run on this thread unless another thread runs it;
   answers the markers' boxes, each true once its marker ran. A failed agent
   refuses its marker, like the oracle's send of it."
  (let ((marks nil))
    (dolist (agent agents)
      (let ((cell (rontolisp::%clojure-agent-cell agent "await"))
            (seen (list nil)))
        (rontolisp::%clojure-agent-check cell)
        (rontolisp::%clojure-agent-drain agent
                                         (lambda (value)
                                           (setf (car seen) t)
                                           value))
        (setq marks (cons (cons agent seen) marks))))
    marks))

(defun rontolisp::%clojure-agent-await (agents)
  "await on a host target: %clojure-agent-await-here, then a wait between
   sleeps of a millisecond for each marker another thread is running, taking
   the queue over when that thread stopped. Like the oracle's, it waits on
   through a failure until restart-agent runs the marker."
  (dolist (mark (rontolisp::%clojure-agent-await-here agents))
    (loop
      (if (car (cdr mark)) (return nil))
      (sleep 0.001)
      (rontolisp::%clojure-agent-drain (car mark) nil))))

(defun rontolisp::%clojure-await-timeout (timeout)
  "TIMEOUT, await-for's milliseconds; the oracle's cast refusal for anything
   but a number."
  (if (realp timeout)
      timeout
      (rontolisp::%clojure-class-cast-exception-of
       "await-for needs a number of milliseconds" timeout)))

(defun rontolisp::%clojure-agent-await-for (timeout agents)
  "await-for on a host target: %clojure-agent-await-here, then a wait between
   sleeps of a millisecond for each marker another thread is running, until
   TIMEOUT milliseconds from the call passed; T when every marker ran, NIL
   when the time ran out."
  (let ((deadline
         (+ (get-internal-real-time)
            (* (rontolisp::%clojure-await-timeout timeout)
               (/ internal-time-units-per-second 1000)))))
    (dolist (mark (rontolisp::%clojure-agent-await-here agents) t)
      (loop
        (if (car (cdr mark)) (return nil))
        (if (>= (get-internal-real-time) deadline)
            (return-from rontolisp::%clojure-agent-await-for nil))
        (sleep 0.001)
        (rontolisp::%clojure-agent-drain (car mark) nil)))))

(defun rontolisp::%clojure-agent-await-for-here (timeout agents)
  "await-for on wasm, where this thread runs every queue: T when every marker
   ran, NIL when one waits behind a failed action."
  (rontolisp::%clojure-await-timeout timeout)
  (dolist (mark (rontolisp::%clojure-agent-await-here agents) t)
    (if (car (cdr mark)) nil (return nil))))

(defun rontolisp::%clojure-agent-state (agent op)
  "The state vector #(running queue error handler mode) of AGENT, the oracle's
   cast failure of OP for anything but an agent."
  (aref (rontolisp::%clojure-agent-cell agent op) 3))

(defun rontolisp::%clojure-agent-error (agent)
  "agent-error: the error AGENT failed on, nil while it has not failed."
  (aref (rontolisp::%clojure-agent-state agent "agent-error") 2))

(defun rontolisp::%clojure-agent-errors (agent)
  "agent-errors (deprecated): a list of AGENT's error, nil when it has none."
  (let ((failure
         (aref (rontolisp::%clojure-agent-state agent "agent-errors") 2)))
    (if failure (list failure))))

(defun rontolisp::%clojure-agent-restart (agent value options)
  "restart-agent: the failed AGENT's value set to VALUE, which its validator
   must pass, its error cleared and its queue released to run (handed to the
   shared pool where threads exist, run on this thread where they do not)
   -- or dropped when OPTIONS, a key/value list, gives :clear-actions a true
   value; answers VALUE. An agent that has not failed is the oracle's refusal."
  (let* ((clear (rontolisp::%clojure-agent-option options "clear-actions"))
         (cell (rontolisp::%clojure-agent-cell agent "restart-agent"))
         (state (aref cell 3))
         (restarted nil))
    (if (aref state 2)
        (progn
          (rontolisp::%clojure-stm-validate value (aref cell 2))
          (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
            (if (aref state 2)
                (progn
                  (setf (aref cell 0) value)
                  (if clear (setf (aref state 1) nil))
                  (setf (aref state 2) nil)
                  (setq restarted t))))))
    (if restarted
        (progn
          (rontolisp::%clojure-agent-drain agent nil)
          value)
        (rontolisp::%clojure-runtime-exception
         "Agent does not need a restart"))))

(defun rontolisp::%clojure-agent-clear-errors (agent)
  "clear-agent-errors (deprecated): restart-agent of AGENT over its own value."
  (rontolisp::%clojure-agent-restart agent
   (aref (rontolisp::%clojure-agent-cell agent "clear-agent-errors") 0) nil))

(defun rontolisp::%clojure-agent-set-error-handler (agent handler)
  "set-error-handler!: HANDLER, a function of the agent and the error, called
   when an action of AGENT fails; answers nil."
  (setf (aref (rontolisp::%clojure-agent-state agent "set-error-handler!") 3)
        (if (rontolisp::%clojure-truthy handler) handler nil))
  nil)

(defun rontolisp::%clojure-agent-set-error-mode (agent mode)
  "set-error-mode!: AGENT's mode, :continue going on past a failing action and
   anything else keeping its error; answers nil."
  (setf (aref (rontolisp::%clojure-agent-state agent "set-error-mode!") 4) mode)
  nil)

(defun rontolisp::%clojure-agent-error-handler (agent)
  "error-handler: AGENT's error handler, nil for none."
  (aref (rontolisp::%clojure-agent-state agent "error-handler") 3))

(defun rontolisp::%clojure-agent-error-mode (agent)
  "error-mode: AGENT's mode keyword."
  (aref (rontolisp::%clojure-agent-state agent "error-mode") 4))

;;;; Ref histories: ref-history-count, ref-min-history and ref-max-history.
;;
;; A ref's history is the count of committed transactions that wrote it, capped
;; by its min history (the oracle's retained chain: minHistory bounds what a
;; commit keeps, maxHistory only the faults), beside the min and max it was
;; made or set with (both the oracle's intCast, so 1.5 is 1). The counts live in the eq table below, keyed
;; by the ref wrapper: an atom wrapper is never entered, so the readers refuse
;; it as the oracle's cast to a ref does. A committed transaction bumps every
;; tracked ref its log wrote through %clojure-ref-history-noted, which answers
;; its first argument; a rolled-back one never reaches it.
;;
;; Only a program naming a history verb tracks a ref (clojure/ClojureArms, the
;; REF_HISTORY family): every other program has the noted call folded to its
;; answer and no ref registered.

(defvar rontolisp::%clojure-ref-histories
  (make-hash-table :test 'eql)
  "Each tracked ref's history: an eql table from the ref wrapper to
   #(count min max).")

(defun rontolisp::%clojure-ref-history-track (ref min max)
  "REF registered with MIN and MAX history, answering REF. A view of the
   ref-history family: a program naming no history verb folds it to REF."
  (setf (gethash ref rontolisp::%clojure-ref-histories)
        (vector 0 (rontolisp::%clojure-int-cast min)
                (rontolisp::%clojure-int-cast max)))
  ref)

(defun rontolisp::%clojure-ref-history-noted (answer log)
  "ANSWER, after bumping the history count of every tracked ref the committed
   transaction LOG wrote: one more commit, capped by the ref's min history
   (the oracle's retained chain), never below zero. A view of the
   ref-history family: a program naming no history verb folds it to ANSWER."
  (dolist (entry (car log) answer)
    (let ((hist (gethash (car entry) rontolisp::%clojure-ref-histories)))
      (if hist
          (setf (aref hist 0)
                (max 0 (min (+ (aref hist 0) 1) (aref hist 1))))))))

(defun rontolisp::%clojure-ref-history-of (ref)
  "The history vector REF is tracked under; the oracle's cast failure of
   anything but a ref (its NullPointerException for nil)."
  (let ((hist (gethash ref rontolisp::%clojure-ref-histories)))
    (if hist
        hist
        (rontolisp::%clojure-class-cast-exception-of
         (concatenate 'string "Cannot cast "
                      (rontolisp::%clojure-class-name-of ref)
                      " to clojure.lang.Ref") ref))))

(defun rontolisp::%clojure-ref-history-count (ref)
  "(ref-history-count ref): the committed transactions that wrote REF, capped
   by its max history."
  (aref (rontolisp::%clojure-ref-history-of ref) 0))

(defun rontolisp::%clojure-ref-history-count-v (&rest args)
  "ref-history-count as a value."
  (rontolisp::%clojure-check-arity args 1 1 "ref-history-count")
  (rontolisp::%clojure-ref-history-count (car args)))

(defun rontolisp::%clojure-ref-min-history (ref)
  "(ref-min-history ref): REF's min history."
  (aref (rontolisp::%clojure-ref-history-of ref) 1))

(defun rontolisp::%clojure-ref-min-history-set (ref n)
  "(ref-min-history ref n): N (the oracle's intCast) stored as REF's min
   history; answers REF."
  (let ((hist (rontolisp::%clojure-ref-history-of ref)))
    (setf (aref hist 1) (rontolisp::%clojure-int-cast n))
    ref))

(defun rontolisp::%clojure-ref-min-history-v (&rest args)
  "ref-min-history as a value."
  (rontolisp::%clojure-check-arity args 1 2 "ref-min-history")
  (if (cdr args)
      (rontolisp::%clojure-ref-min-history-set (car args) (car (cdr args)))
      (rontolisp::%clojure-ref-min-history (car args))))

(defun rontolisp::%clojure-ref-max-history (ref)
  "(ref-max-history ref): REF's max history."
  (aref (rontolisp::%clojure-ref-history-of ref) 2))

(defun rontolisp::%clojure-ref-max-history-set (ref n)
  "(ref-max-history ref n): N (the oracle's intCast) stored as REF's max
   history; answers REF."
  (let ((hist (rontolisp::%clojure-ref-history-of ref)))
    (setf (aref hist 2) (rontolisp::%clojure-int-cast n))
    ref))

(defun rontolisp::%clojure-ref-max-history-v (&rest args)
  "ref-max-history as a value."
  (rontolisp::%clojure-check-arity args 1 2 "ref-max-history")
  (if (cdr args)
      (rontolisp::%clojure-ref-max-history-set (car args) (car (cdr args)))
      (rontolisp::%clojure-ref-max-history (car args))))

;;;; Validators and watches.
;;
;; set-validator!, get-validator, add-watch, remove-watch, an atom's options and
;; the verbs that store into a reference with them. An atom, a ref and an agent
;; keep both in the cell, #(value nil validator state watches); a var, interned
;; per name, in the eq tables below. WATCHES is a list of (key . fn) entries in
;; the order the oracle's watch map, a PersistentHashMap, walks its keys (by
;; their hashes, %clojure-hash-map-before-p), each list fresh, so a notification
;; walks it without a lock. A
;; watch is called with the key, the reference, the old and the new value after
;; the store, on the thread that stored: an atom's after a swap!, reset!,
;; successful compare-and-set!, swap-vals! or reset-vals!; a ref's once its
;; transaction committed (once per ref written, with its value from before the
;; transaction); an agent's after each action, await's marker included; a var's
;; after an alter-var-root. A watch's failure passes to the storing verb, the
;; value already stored. A validator runs ahead of the store.
;;
;; Only a program naming set-validator!, add-watch or an atom option can give a
;; reference either (clojure/ClojureArms, the WATCH family): every other program
;; has its atoms' and refs' cells one long (%clojure-ref-cell folds to vector),
;; calls the plain atom helpers of "Atoms across request threads" in place of the
;; %clojure-ref-* ones here, and has the views below folded to their first
;; argument.

(defvar rontolisp::%clojure-var-watches
  (make-hash-table :test 'eq)
  "Each watched var's watch list: an eq table from the var.")

(defvar rontolisp::%clojure-var-validators
  (make-hash-table :test 'eq)
  "Each validated var's validator: an eq table from the var.")

(defun rontolisp::%clojure-ref-cell (value)
  "The cell of an atom or a ref over VALUE, with room for a validator and
   watches."
  (vector value nil nil nil nil))

(defun rontolisp::%clojure-watchable-ref (ref op)
  "REF when it is an atom, a ref, an agent or a var; the oracle's cast refusal
   naming OP otherwise (a volatile included), its NullPointerException for nil."
  (if (or (rontolisp::%clojure-var-p ref)
          (and (rontolisp::%clojure-atom-p ref)
               (not (= (length (car (cdr ref))) 2))))
      ref
      (rontolisp::%clojure-class-cast-exception-of
       (concatenate 'string op " needs an atom, a ref, an agent or a var")
       ref)))

(defun rontolisp::%clojure-watchable-cell (ref op)
  "The cell of REF, an atom, a ref or an agent; nil for a var; the refusal of
   %clojure-watchable-ref naming OP for anything else."
  (rontolisp::%clojure-watchable-ref ref op)
  (if (rontolisp::%clojure-var-p ref) nil (car (cdr ref))))

(defun rontolisp::%clojure-ref-validator (ref)
  "The validator of REF, nil for none."
  (if (rontolisp::%clojure-var-p ref)
      (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
        (values (gethash ref rontolisp::%clojure-var-validators)))
      (rontolisp::%clojure-cell-validator (car (cdr ref)))))

(defun rontolisp::%clojure-ref-watches (ref)
  "The watch list of REF."
  (if (rontolisp::%clojure-var-p ref)
      (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
        (values (gethash ref rontolisp::%clojure-var-watches)))
      (let ((cell (car (cdr ref))))
        (if (= (length cell) 5) (aref cell 4) nil))))

(defun rontolisp::%clojure-ref-notify (ref old new)
  "REF's watches called with their key, REF, OLD and NEW."
  (dolist (watch (rontolisp::%clojure-ref-watches ref))
    (rontolisp::%clojure-call (cdr watch) (list (car watch) ref old new))))

(defun rontolisp::%clojure-ref-notified (new ref old)
  "A view: NEW, once REF's watches were called with OLD and NEW."
  (rontolisp::%clojure-ref-notify ref old new)
  new)

(defun rontolisp::%clojure-ref-validated (value ref)
  "A view: VALUE, once REF's validator accepts it."
  (rontolisp::%clojure-stm-validate value
                                    (rontolisp::%clojure-ref-validator ref)))

(defun rontolisp::%clojure-stm-noted (answer log)
  "A view: ANSWER, once each entry (ref . old) of the committing transaction's
   LOG holds the ref's committed value too, (ref old . new)."
  (dolist (entry (car log))
    (setf (cdr entry) (cons (cdr entry) (aref (car (cdr (car entry))) 0))))
  answer)

(defun rontolisp::%clojure-stm-notified (value log)
  "A view: VALUE, once the watches of each ref the committed transaction's LOG
   wrote were called, in the order of the first writes."
  (dolist (entry (reverse (car log)))
    (rontolisp::%clojure-ref-notify (car entry) (car (cdr entry))
                                    (cdr (cdr entry))))
  value)

(defun rontolisp::%clojure-ref-swap (atom f args)
  "swap! of a program that may validate or watch: F applied to ATOM's value
   and ARGS, validated, until the compare-and-set stores it; the watches
   called; answers the value stored."
  (let ((cell (car (cdr atom))))
    (loop
      (let* ((old (aref cell 0))
             (new (rontolisp::%clojure-ref-validated (apply f old args) atom)))
        (when (rontolisp::%clojure-atom-cas atom old new)
          (rontolisp::%clojure-ref-notify atom old new)
          (return new))))))

(defun rontolisp::%clojure-ref-swap-vals (atom f args)
  "swap-vals! of a program that may validate or watch: as %clojure-ref-swap,
   answering [old new]."
  (let ((cell (car (cdr atom))))
    (loop
      (let* ((old (aref cell 0))
             (new (rontolisp::%clojure-ref-validated (apply f old args) atom)))
        (when (rontolisp::%clojure-atom-cas atom old new)
          (rontolisp::%clojure-ref-notify atom old new)
          (return (vector old new)))))))

(defun rontolisp::%clojure-ref-reset (atom new)
  "reset! of a program that may validate or watch: NEW validated and stored,
   the watches called with the value it replaced; answers NEW."
  (let ((cell (car (cdr atom))) (old nil))
    (rontolisp::%clojure-ref-validated new atom)
    (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
      (setq old (aref cell 0))
      (setf (aref cell 0) new))
    (rontolisp::%clojure-ref-notify atom old new)
    new))

(defun rontolisp::%clojure-ref-reset-vals (atom new)
  "reset-vals! of a program that may validate or watch: NEW validated and
   stored, the watches called; answers [old new]."
  (let ((cell (car (cdr atom))))
    (loop
      (let ((old (aref cell 0)))
        (rontolisp::%clojure-ref-validated new atom)
        (when (rontolisp::%clojure-atom-cas atom old new)
          (rontolisp::%clojure-ref-notify atom old new)
          (return (vector old new)))))))

(defun rontolisp::%clojure-ref-cas (atom old new)
  "compare-and-set! of a program that may validate or watch: NEW validated,
   then stored when ATOM holds OLD, the watches called with OLD and NEW; T when
   it stored."
  (rontolisp::%clojure-ref-validated new atom)
  (if (rontolisp::%clojure-atom-cas atom old new)
      (progn
        (rontolisp::%clojure-ref-notify atom old new)
        t)
      nil))

(defvar rontolisp::%clojure-macro-expanders
  (make-hash-table :test 'equal)
  "The present expander of each program macro: an equal table from
   \"ns/name\" to it, written by the note a defmacro site carries (a
   WATCH-family statement a program naming no watch verb sheds), read by
   %clojure-set-validator.")

(defun rontolisp::%clojure-note-macro-expander (name expander)
  "Register EXPANDER as the present expander of the macro NAME (\"ns/name\"):
   what a computed set-validator! of its var checks, since the var's site
   reads no value. Answers nil."
  (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
    (setf (gethash name rontolisp::%clojure-macro-expanders) expander))
  nil)

(defun rontolisp::%clojure-macro-expander-of (ref)
  "The present expander of the macro whose var is REF, nil for any other
   reference: what a computed set-validator! checks without touching the
   var's signaling site."
  (if (rontolisp::%clojure-var-p ref)
      (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
        (values
         (gethash (car (cdr ref)) rontolisp::%clojure-macro-expanders)))))

(defun rontolisp::%clojure-set-validator (ref f)
  "set-validator!: F (nil to remove) as REF's validator, once REF's value
   passes it; answers nil. A macro's var reads no value, so one the program
   defined checks its present expander, like the literal macro path."
  (let ((cell (rontolisp::%clojure-watchable-cell ref "set-validator!"))
        (f (if (rontolisp::%clojure-truthy f) f nil)))
    (if cell
        (progn
          (rontolisp::%clojure-stm-validate (aref cell 0) f)
          (setf (aref cell 2) f))
        (let ((macro (rontolisp::%clojure-macro-expander-of ref)))
          (if macro
              (rontolisp::%clojure-set-validator-macro ref f macro)
              (rontolisp:with-mutex ((rontolisp::%clojure-monitor ref))
                (rontolisp::%clojure-stm-validate
                 (rontolisp::%clojure-var-get ref) f)
                (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
                  (if f
                      (setf (gethash ref rontolisp::%clojure-var-validators) f)
                      (remhash ref rontolisp::%clojure-var-validators)))))))
    nil))

(defun rontolisp::%clojure-set-validator-v (&rest args)
  "set-validator! as a value."
  (rontolisp::%clojure-check-arity args 2 2 "set-validator!")
  (rontolisp::%clojure-set-validator (car args) (car (cdr args))))

(defun rontolisp::%clojure-set-validator-macro (ref f current)
  "set-validator! of a macro's var: F (nil to remove) as REF's validator, once
   CURRENT, the macro's present expander, passes it; answers nil. A macro has
   no value for its var site to read, so the expander travels with the call."
  (let ((f (if (rontolisp::%clojure-truthy f) f nil)))
    (rontolisp::%clojure-stm-validate current f)
    (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
      (if f
          (setf (gethash ref rontolisp::%clojure-var-validators) f)
          (remhash ref rontolisp::%clojure-var-validators))))
  nil)

(defun rontolisp::%clojure-get-validator (ref)
  "get-validator: REF's validator, nil for none."
  (rontolisp::%clojure-watchable-ref ref "get-validator")
  (rontolisp::%clojure-ref-validator ref))

(defun rontolisp::%clojure-get-validator-v (&rest args)
  "get-validator as a value."
  (rontolisp::%clojure-check-arity args 1 1 "get-validator")
  (rontolisp::%clojure-get-validator (car args)))

(defun rontolisp::%clojure-hash-map-before-p (a b)
  "Whether a key of hash A comes before one of hash B in the walk of the
   oracle's PersistentHashMap: the 32-bit hashes compared five bits at a time
   from the low end, the trie's index at each level."
  (let ((x (logand a 4294967295)) (y (logand b 4294967295)) (before nil))
    (do ((shift 0 (+ shift 5)))
        ((> shift 30) before)
      (let ((i (logand (ash x (- shift)) 31)) (j (logand (ash y (- shift)) 31)))
        (if (/= i j)
            (progn
              (setq before (< i j))
              (setq shift 35)))))))

(defun rontolisp::%clojure-watch-insert (watches key fn hash)
  "The watch list WATCHES, in the walk order of the oracle's watch map, with
   the watch FN of KEY, whose hash is HASH: ahead of the first watch whose key
   it comes before, after those of an equal hash."
  (if (or (null watches)
          (rontolisp::%clojure-hash-map-before-p hash
           (rontolisp::%clojure-hasheq (car (car watches)))))
      (cons (cons key fn) watches)
      (cons (car watches)
            (rontolisp::%clojure-watch-insert (cdr watches) key fn hash))))

(defun rontolisp::%clojure-watch-put (watches key fn)
  "The watch list WATCHES with KEY's watch FN: in the place of an earlier
   watch of a key = to KEY, else where the oracle's watch map walks it."
  (if (find-if (lambda (watch) (rontolisp::%clojure-equal (car watch) key))
               watches)
      (mapcar (lambda (watch)
                (if (rontolisp::%clojure-equal (car watch) key)
                    (cons key fn)
                    watch)) watches)
      (rontolisp::%clojure-watch-insert watches key fn
                                        (rontolisp::%clojure-hasheq key))))

(defun rontolisp::%clojure-watch-drop (watches key)
  "The watch list WATCHES without the watch of a key = to KEY."
  (remove-if (lambda (watch) (rontolisp::%clojure-equal (car watch) key))
             watches))

(defun rontolisp::%clojure-add-watch (ref key fn)
  "add-watch: FN called with KEY, REF, the old and the new value after each
   change of REF, replacing an earlier watch of KEY; answers REF."
  (let ((cell (rontolisp::%clojure-watchable-cell ref "add-watch")))
    (if cell
        (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
          (setf (aref cell 4)
                (rontolisp::%clojure-watch-put (aref cell 4) key fn)))
        (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
          (setf (gethash ref rontolisp::%clojure-var-watches)
                (rontolisp::%clojure-watch-put
                 (gethash ref rontolisp::%clojure-var-watches) key fn))))
    ref))

(defun rontolisp::%clojure-add-watch-v (&rest args)
  "add-watch as a value."
  (rontolisp::%clojure-check-arity args 3 3 "add-watch")
  (rontolisp::%clojure-add-watch (car args) (car (cdr args))
                                 (car (cdr (cdr args)))))

(defun rontolisp::%clojure-remove-watch (ref key)
  "remove-watch: REF without its watch of KEY; answers REF."
  (let ((cell (rontolisp::%clojure-watchable-cell ref "remove-watch")))
    (if cell
        (if (= (length cell) 5)
            (rontolisp:with-mutex (rontolisp::%clojure-atom-guard)
              (setf (aref cell 4)
                    (rontolisp::%clojure-watch-drop (aref cell 4) key))))
        (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
          (let ((left
                 (rontolisp::%clojure-watch-drop
                  (gethash ref rontolisp::%clojure-var-watches) key)))
            (if left
                (setf (gethash ref rontolisp::%clojure-var-watches) left)
                (remhash ref rontolisp::%clojure-var-watches)))))
    ref))

(defun rontolisp::%clojure-remove-watch-v (&rest args)
  "remove-watch as a value."
  (rontolisp::%clojure-check-arity args 2 2 "remove-watch")
  (rontolisp::%clojure-remove-watch (car args) (car (cdr args))))

(defun rontolisp::%clojure-atom-options (atom options)
  "(atom x & options): ATOM given the :meta and the :validator the key/value
   list OPTIONS gives, read like the oracle's (apply hash-map options), the
   metadata first; the validator must accept the value. Answers ATOM."
  (let ((m (rontolisp::%clojure-agent-option options "meta"))
        (validator (rontolisp::%clojure-agent-option options "validator")))
    (if m (rontolisp::%clojure-reset-meta atom m))
    (if validator (rontolisp::%clojure-set-validator atom validator))
    atom))

;;;; Delays: delay, force, deref and realized? over a memo cell.
;;
;; A delay is (:C%DELAY cell), CELL the vector #(thunk value failure mutex): THUNK
;; the body's closure until it has run, VALUE its answer, FAILURE the condition it
;; signalled, MUTEX the delay's own lock. The body runs at most once, under that
;; lock like the oracle's synchronized deref (a Ring handler runs one thread per
;; request on the interpreter and the JVM; on wasm the lock is a no-op), and a
;; body that signalled signals the same condition again on every later force, the
;; oracle's cached exception. A force reads the cell under the lock, so it never
;; sees the thunk gone before the value is stored; realized? and the printer read
;; the thunk slot alone, without waiting on a body another thread runs, like the
;; oracle's isRealized. A force from inside the body runs the body again, the
;; oracle's recursion. Every verb's test of one is an arm of the delay family
;; (clojure/ClojureArms): a program making no delay compiles as before delays.

(defun rontolisp::%clojure-delay (thunk)
  "delay: an unrealized delay over the zero-argument closure THUNK."
  (list :C%DELAY (vector thunk nil nil (rontolisp:make-mutex))))

(defun rontolisp::%clojure-delay-p (x)
  "Whether X is the (:C%DELAY cell) wrapper delay builds."
  (and (consp x) (eq (car x) :C%DELAY)))

(defun rontolisp::%clojure-delay-force (d)
  "The value of the delay D: its body's answer, the body run the first time
   under D's lock; a body that signalled signals its condition again."
  (let ((cell (car (cdr d))) (value nil) (failure nil))
    (rontolisp:with-mutex ((aref cell 3))
      (let ((thunk (aref cell 0)))
        (if thunk
            (progn
              (handler-case (setf (aref cell 1) (funcall thunk))
                (error (c) (setf (aref cell 2) c)))
              (setf (aref cell 0) nil))))
      (setq value (aref cell 1))
      (setq failure (aref cell 2)))
    (if failure (error failure) value)))

(defun rontolisp::%clojure-force (x)
  "force: the value of the delay X, anything else itself. A program making no
   delay calls progn in its place (the delay family's alias)."
  (if (rontolisp::%clojure-delay-p x) (rontolisp::%clojure-delay-force x) x))

(defun rontolisp::%clojure-force-v (&rest args)
  "force as a value."
  (rontolisp::%clojure-check-arity args 1 1 "force")
  (rontolisp::%clojure-force (car args)))

(defun rontolisp::%clojure-is-delay (x no)
  "delay?: T for a delay, NO (the false object) for anything else. A program
   making no delay calls progn in its place (the delay family's alias)."
  (if (rontolisp::%clojure-delay-p x) t no))

(defun rontolisp::%clojure-delay-write
    (x nil-replacement readable stream labels)
  "Write the delay X as the oracle's print-method of an IDeref does, its
   #object[clojure.lang.Delay {:status s, :val v}] without the identity hash:
   :pending with a nil value until the body has run, then :ready with its answer
   or :failed with its condition."
  (let ((cell (car (cdr x))))
    (write-string "#object[clojure.lang.Delay {:status " stream)
    (write-string
     (cond ((aref cell 0) ":pending") ((aref cell 2) ":failed") (t ":ready"))
     stream)
    (write-string ", :val " stream)
    (rontolisp::%clojure-write-nested
     (cond ((aref cell 0) nil) ((aref cell 2) (aref cell 2)) (t (aref cell 1)))
     "nil" readable stream labels)
    (write-string "}]" stream)))

;;;; Vars: #'x as a value.
;;
;; A var is (:C%VAR "ns/name" getter), interned per name in
;; rontolisp::%clojure-var-table (read and written under %clojure-var-guard: a
;; Ring handler runs one thread per request), so #'x answers the same object at
;; every site, like the oracle's one Var per name. GETTER is a
;; closure over the lowered value of the name, so deref and an invocation read
;; the root through it; its metadata lives in %clojure-meta-table like any other
;; value's. Each site hands both in: the lowering records a definition's
;; metadata at lower time (docstring, arglists, position, name metadata), and a
;; site lowered after a redefinition sees the newest one. An unbound var's root
;; is the (:C%UNBOUND "ns/name") marker its value cell holds from the start of
;; the program (a declared-never-defined name, a value-less def), like the
;; oracle's Var$Unbound: truthy, str "Unbound: #'ns/name", calling it signals.
;; Each test of one (%clojure-unbound-p over a variable, in a foldable place) is
;; an arm a program that makes none sheds, like a sorted-collection arm
;; (clojure/ClojureArms, the UNBOUND family).

(defvar rontolisp::%clojure-var-guard (rontolisp:make-mutex))

(defvar rontolisp::%clojure-var-table
  (make-hash-table :test 'equal)
  "The interned vars: an equal table from \"ns/name\" to its var.")

(defun rontolisp::%clojure-var-p (x)
  "Whether X is the (:C%VAR name getter) var #'x lowers to."
  (and (consp x) (eq (car x) :C%VAR)))

(defvar rontolisp::%clojure-var-generations
  (make-hash-table :test 'equal)
  "The definition each interned var's metadata came from: an equal table from
   \"ns/name\" to the generation its last metadata store carried.")

(defun rontolisp::%clojure-var (name getter meta &optional (generation 1))
  "The var NAME (\"ns/name\"), interned on first use, reading its root through
   GETTER. META is the metadata of the definition GENERATION (the how-manyth
   definition of the name the site saw, 0 before any): the var takes it on
   first use and from a site of a later definition, so a site never undoes an
   alter-meta! or reset-meta! of the definition it saw, and a redefinition
   replaces the metadata, like the oracle's def. The store happens under the
   guard, so no request thread's alter-meta! lands between the decision and it."
  (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
    (let ((v (gethash name rontolisp::%clojure-var-table))
          (seen (gethash name rontolisp::%clojure-var-generations)))
      (if v
          (rplaca (cdr (cdr v)) getter)
          (progn
            (setq v (list :C%VAR name getter))
            (setf (gethash name rontolisp::%clojure-var-table) v)))
      (if (or (null seen) (< seen generation))
          (progn
            (setf (gethash name rontolisp::%clojure-var-generations) generation)
            (rontolisp::%clojure-replace-meta v meta))
          v))))

(defun rontolisp::%clojure-var-dynamic
    (name getter meta depth &optional (generation 1) binder)
  "The var NAME of a ^:dynamic var: as the plain var, and DEPTH, a closure over
   its binding-depth counter, recorded as the fourth element for thread-bound?;
   BINDER, the closure binding the var around a call, as the fifth in a program
   binding vars through var objects (%clojure-with-bindings)."
  (let ((v (rontolisp::%clojure-var name getter meta generation)))
    (rplacd (cdr (cdr v)) (if binder (list depth binder) (list depth)))
    v))

;; with-bindings, with-bindings* and a push-thread-bindings followed by a try
;; whose finally pops (the shape binding expands to, hiccup's and honeysql's):
;; each var of the map bound to its value around THUNK, through the binder its
;; site carries -- the binding binding lowers to, so thread-scoped like it.
(defun rontolisp::%clojure-with-bindings (bindings thunk)
  "The zero-argument function THUNK called with each var of the map BINDINGS
   bound to its value, like the oracle's push-thread-bindings around a try
   whose finally pops; a var that is no dynamic one is refused in its words."
  (rontolisp::%clojure-bind-entries (rontolisp::%clojure-seq bindings) thunk))

(defun rontolisp::%clojure-bind-entries (entries thunk)
  "THUNK called under the bindings of the map ENTRIES, a seq of [var value]."
  (if (null entries)
      (funcall thunk)
      (let ((var (aref (car entries) 0)) (value (aref (car entries) 1)))
        (if (not (rontolisp::%clojure-var-p var))
            (rontolisp::%clojure-class-cast-exception
             (concatenate 'string "class "
                          (rontolisp::%clojure-class-name-of var)
                          " cannot be cast to class clojure.lang.Var")))
        (let ((binder (car (cdr (cdr (cdr (cdr var)))))))
          (if (null binder)
              (rontolisp::%clojure-illegal-state-exception
               (concatenate 'string "Can't dynamically bind non-dynamic var: "
                            (car (cdr var)))))
          (funcall binder value
                   (lambda ()
                     (rontolisp::%clojure-bind-entries
                      (rontolisp::%clojure-seq (cdr entries)) thunk)))))))

(defun rontolisp::%clojure-with-bindings-v (&rest args)
  "with-bindings* as a value: a map, a function and its arguments."
  (rontolisp::%clojure-check-arity args 2 nil "with-bindings*")
  (rontolisp::%clojure-with-bindings (car args)
   (lambda () (rontolisp::%clojure-call (car (cdr args)) (cdr (cdr args))))))

(defun rontolisp::%clojure-bound-fn* (f bindings)
  "bound-fn* of the function F: a function calling F with the captured BINDINGS
   pushed, like the oracle's get-thread-bindings frame around the call -- each
   captured var rebound to its creation-time value over the caller's own
   bindings, through the binder its site carries, so a call on another thread
   sees the captured values. BINDINGS is the map the call site built of every
   thread-bound dynamic var and core special plus the enclosing
   with-local-vars cells."
  (lambda (&rest args)
    (rontolisp::%clojure-with-bindings bindings
     (lambda () (rontolisp::%clojure-call f args)))))

(defun rontolisp::%clojure-local-var (name box)
  "A with-local-vars var cell: the var NAME (\"ns/name\") holding BOX, a cons
   of the current value and the binding depth. Deref and var-get read the
   current value -- the unbound root outside the extent, like the oracle's --
   thread-bound? the depth, the binder save/restores both around a call, and
   var-set stores through it when bound. Fresh per evaluation, never interned."
  (let ((v
         (list :C%VAR name (lambda () (car box)) (lambda () (cdr box))
               (lambda (value thunk)
                 (let ((old-value (car box)) (old-depth (cdr box)))
                   (rplaca box value)
                   (rplacd box (+ old-depth 1))
                   (unwind-protect (funcall thunk)
                     (rplaca box old-value)
                     (rplacd box old-depth))))
               (lambda (value)
                 (if (<= (cdr box) 0)
                     (rontolisp::%clojure-illegal-state-exception
                      (concatenate 'string
                       "Can't change/establish root binding of: "
                       (rontolisp::%clojure-var-short-name (list :C%VAR name))
                       " with set")))
                 (rplaca box value)
                 value))))
    (rontolisp::%clojure-put-meta v
                                  (rontolisp::%clojure-map-literal
                                   (list (list :C%KEYWORD "ns") nil
                                         (list :C%KEYWORD "name") nil)))
    v))

(defun rontolisp::%clojure-replace-meta (x m)
  "X with the metadata map M replacing its own, none for a nil M; answers X."
  (if (rontolisp::%clojure-check-meta m)
      (rontolisp::%clojure-put-meta x m)
      (progn
        (rontolisp:with-mutex (rontolisp::%clojure-meta-guard)
          (remhash x rontolisp::%clojure-meta-table))
        x)))

(defun rontolisp::%clojure-var-get (v)
  "The root of the var V."
  (funcall (car (cdr (cdr v)))))

(defun rontolisp::%clojure-var-root (v)
  "var-get: the root of V, which must be a var (deref also reads an atom or a
   reduced value, var-get does not)."
  (if (rontolisp::%clojure-var-p v)
      (rontolisp::%clojure-var-get v)
      (rontolisp::%clojure-class-cast-exception-of "var-get needs a var" v)))

(defun rontolisp::%clojure-var-root-v (&rest args)
  "var-get as a value."
  (rontolisp::%clojure-check-arity args 1 1 "var-get")
  (rontolisp::%clojure-var-root (car args)))

(defun rontolisp::%clojure-unbound (name)
  "The unbound root of the var NAME (\"ns/name\")."
  (list :C%UNBOUND name))

(defun rontolisp::%clojure-unbound-p (x)
  "Whether X is an unbound var's root."
  (and (consp x) (eq (car x) :C%UNBOUND)))

(defun rontolisp::%clojure-var-test (v)
  "clojure.core/test: call the fn at :test in V's metadata, answering :ok, or
   :no-test when there is none; whatever the fn throws passes through."
  (let ((f
         (rontolisp::%clojure-call-keyword (list :C%KEYWORD "test")
                                           (rontolisp::%clojure-meta v) nil)))
    (if (rontolisp::%clojure-truthy f)
        (progn
          (rontolisp::%clojure-call f nil)
          (list :C%KEYWORD "ok"))
        (list :C%KEYWORD "no-test"))))

(defun rontolisp::%clojure-var-test-v (&rest args)
  "test as a value."
  (rontolisp::%clojure-check-arity args 1 1 "test")
  (rontolisp::%clojure-var-test (car args)))

;;;; alter-var-root, alter-meta! and reset-meta!.
;;
;; A var's root is the value cell of its name, which only the lowering can name:
;; an alter-var-root of a literal #'x hands its own setter (a closure storing the
;; cell) to %clojure-alter-root. A var reached any other way finds the setter a
;; site of it registered in %clojure-var-setters, which every value-cell var site
;; of a program holding such an alter-var-root does (clojure/ClojureVarLowering);
;; a var with none -- a defn called directly, a clojure.core var -- is refused by
;; name. Each alteration holds the reference's monitor (%clojure-monitor, a
;; reentrant mutex per value), so two request threads altering one reference take
;; turns while others run, like the oracle's methods synchronized on the
;; reference; the function runs under it, like the oracle's.

(defvar rontolisp::%clojure-var-setters
  (make-hash-table :test 'eq)
  "The root setter of each var a settable site handed one: an eq table from the
   var to a one-argument closure storing its value cell.")

(defun rontolisp::%clojure-var-setter (v setter)
  "The var V, its root setter SETTER recorded for a computed alter-var-root."
  (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
    (setf (gethash v rontolisp::%clojure-var-setters) setter))
  v)

(defun rontolisp::%clojure-alter-root (v setter f args)
  "alter-var-root of the var V whose root SETTER stores: the root becomes
   (apply f root args), which the var's validator must accept and it answers,
   and the var's watches are called."
  (rontolisp:with-mutex ((rontolisp::%clojure-monitor v))
    (let ((old (rontolisp::%clojure-var-get v)))
      (rontolisp::%clojure-ref-notified (funcall setter
                                         (rontolisp::%clojure-ref-validated
                                          (rontolisp::%clojure-call f
                                           (cons old args)) v)) v old))))

(defun rontolisp::%clojure-alter-var-root (v f args)
  "alter-var-root of a var computed at run time: through the setter a site of
   it registered. Anything that is no var signals like the oracle's cast."
  (if (rontolisp::%clojure-var-p v)
      (let ((setter
             (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
               (values (gethash v rontolisp::%clojure-var-setters)))))
        (if setter
            (rontolisp::%clojure-alter-root v setter f args)
            (rontolisp::%clojure-unsupported-operation-exception
             (concatenate 'string "alter-var-root of #'" (car (cdr v))
                          " is not supported: "
                          (if (eql (search "clojure.core/" (car (cdr v))) 0)
                              "a clojure.core verb lowers inline at every call"
                              (concatenate 'string
                               "its calls do not go through the var (a defn an"
                               " earlier input defined without ^:redef, a"
                               " multimethod, protocol method, record"
                               " constructor or test)"))))))
      (rontolisp::%clojure-class-cast-exception-of "alter-var-root needs a var"
                                                   v)))

(defun rontolisp::%clojure-alter-var-root-v (&rest args)
  "alter-var-root as a value."
  (rontolisp::%clojure-check-arity args 2 nil "alter-var-root")
  (rontolisp::%clojure-alter-var-root (car args) (car (cdr args))
                                      (cdr (cdr args))))

;;;; A def, defn or with-redefs replacing a var's root.
;;
;; The oracle's bindRoot validates the new root and notifies the var's
;; watches on every replacement -- a def's, a redefined defn's and a
;; with-redefs' entry and restore as much as an alter-var-root's. The
;; lowering wraps those stores in the WATCH-family arms below
;; (clojure/ClojureArms): a store over a getter and a setter closure, a
;; guarded rebind, a validated init with its notify statement, which a
;; program naming no watch verb folds back to the plain store. A session
;; keeps them, so a later input's add-watch or set-validator! sees every
;; earlier root.

(defun rontolisp::%clojure-var-guarded-p (name)
  "Whether the interned var NAME (\"ns/name\") has watches or a validator.
   Nil where no var site ever interned one, which can hold neither."
  (let ((v (gethash name rontolisp::%clojure-var-table)))
    (and v
         (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
           (or (gethash v rontolisp::%clojure-var-watches)
               (gethash v rontolisp::%clojure-var-validators))))))

(defun rontolisp::%clojure-var-store (getter setter new name)
  "The store replacing the root of the var NAME (\"ns/name\"): NEW validated
   against its validator, stored through SETTER and its watches called with
   the root GETTER read and NEW; answers NEW, like the oracle's bindRoot. A
   var no site ever interned holds neither, so the store is plain."
  (let ((old (funcall getter)) (v (gethash name rontolisp::%clojure-var-table)))
    (setq new
          (rontolisp::%clojure-stm-validate new
           (if v (rontolisp::%clojure-ref-validator v) nil)))
    (funcall setter new)
    (if v (rontolisp::%clojure-ref-notify v old new))
    new))

(defvar rontolisp::%clojure-var-def-old
  (make-hash-table :test 'equal)
  "The root a dynamic definition is replacing: an equal table from
   \"ns/name\" to it, stashed while its init runs and taken by the notify
   statement behind it.")

(defun rontolisp::%clojure-var-validated (new name)
  "A view: NEW, once the validator of the var NAME (\"ns/name\") accepts it.
   The root it replaces is stashed for the notify statement behind the
   definition; a var no site ever interned is fresh, so its unbound root is
   stashed."
  (let ((v (gethash name rontolisp::%clojure-var-table)))
    (setf (gethash name rontolisp::%clojure-var-def-old)
     (if v (rontolisp::%clojure-var-get v) (rontolisp::%clojure-unbound name)))
    (rontolisp::%clojure-stm-validate new
     (if v (rontolisp::%clojure-ref-validator v) nil))))

(defun rontolisp::%clojure-var-notify-stored (name new)
  "A statement: the watches of the var NAME (\"ns/name\") called with the
   root its definition replaced, stashed while its init ran, and NEW;
   answers NEW."
  (let ((v (gethash name rontolisp::%clojure-var-table)))
    (let ((old (gethash name rontolisp::%clojure-var-def-old)))
      (remhash name rontolisp::%clojure-var-def-old)
      (if v (rontolisp::%clojure-ref-notify v old new)))
    new))

(defun rontolisp::%clojure-var-defn-notify (name new old)
  "A statement: NEW validated against the validator of the var NAME
   (\"ns/name\") and its watches called with OLD and NEW; answers NEW.
   Behind a defn, whose function cells the definition already bound; a var
   no site ever interned holds neither."
  (let ((v (gethash name rontolisp::%clojure-var-table)))
    (setq new
          (rontolisp::%clojure-stm-validate new
           (if v (rontolisp::%clojure-ref-validator v) nil)))
    (if v (rontolisp::%clojure-ref-notify v old new))
    new))

(defun rontolisp::%clojure-reference-p (x)
  "Whether X is one of the oracle's IReference kinds: a var, an atom, a ref,
   an agent or a namespace (a volatile is none)."
  (or (rontolisp::%clojure-var-p x) (rontolisp::%clojure-ns-object-p x)
      (and (rontolisp::%clojure-atom-p x)
           (let ((cell (car (cdr x))))
             (not (and (= (length cell) 2) (eq (aref cell 1) :C%VOLATILE)))))))

(defun rontolisp::%clojure-check-reference (x op)
  "X when it is a reference; else the oracle's cast refusal naming OP."
  (if (rontolisp::%clojure-reference-p x)
      x
      (rontolisp::%clojure-class-cast-exception-of
       (concatenate 'string op
                    " needs a var, an atom, a ref, an agent or a namespace")
       x)))

(defun rontolisp::%clojure-alter-meta (r f args)
  "alter-meta!: the reference R's metadata becomes (apply f meta args), which
   it answers."
  (rontolisp::%clojure-check-reference r "alter-meta!")
  (rontolisp:with-mutex ((rontolisp::%clojure-monitor r))
    (let ((m
           (rontolisp::%clojure-call f
                                     (cons (rontolisp::%clojure-meta r) args))))
      (rontolisp::%clojure-replace-meta r m)
      m)))

(defun rontolisp::%clojure-alter-meta-v (&rest args)
  "alter-meta! as a value."
  (rontolisp::%clojure-check-arity args 2 nil "alter-meta!")
  (rontolisp::%clojure-alter-meta (car args) (car (cdr args)) (cdr (cdr args))))

(defun rontolisp::%clojure-reset-meta (r m)
  "reset-meta!: the reference R's metadata becomes M, which it answers."
  (rontolisp::%clojure-check-reference r "reset-meta!")
  (rontolisp:with-mutex ((rontolisp::%clojure-monitor r))
    (rontolisp::%clojure-replace-meta r m)
    m))

(defun rontolisp::%clojure-reset-meta-v (&rest args)
  "reset-meta! as a value."
  (rontolisp::%clojure-check-arity args 2 2 "reset-meta!")
  (rontolisp::%clojure-reset-meta (car args) (car (cdr args))))

;;;; eval, and resolve of a computed symbol: the lowering's own work, so they run
;;;; only while the program lowers. The macro-time evaluator (eval/ClojureMacroTime)
;;;; replaces both with calls back into the lowering, so a macro body (and every
;;;; helper it calls) evaluates a form and resolves a name at expansion time; a
;;;; compiled program carries no lowering, so here both refuse. resolve of a
;;;; quoted symbol never comes here: it resolves while the program lowers.

;; A macro body's &env and &form: the call's locals (a map of each local's symbol
;; to itself, nil without one) and the call itself, which an expansion while the
;; program lowers binds (clojure/ClojureMacroLowering), and a run-time expansion
;; binds &form for. Nil elsewhere, so a run-time macroexpand's &env is nil, like
;; the oracle's.
(defvar rontolisp::%clojure-macro-env nil)

(defvar rontolisp::%clojure-macro-form nil)

(defun rontolisp::%clojure-eval (form)
  "eval at run time: refused."
  (declare (ignore form))
  (rontolisp::%clojure-unsupported-operation-exception
   "eval is not supported at run time: only a macro body's eval runs, while the program lowers"))

(defun rontolisp::%clojure-resolve (symbol)
  "resolve of a computed symbol at run time: refused."
  (declare (ignore symbol))
  (rontolisp::%clojure-unsupported-operation-exception
   "resolve of a computed symbol is not supported at run time: vars exist only while the program lowers"))

(defun rontolisp::%clojure-find-var (symbol)
  "find-var of a computed symbol: an unqualified one is the oracle's refusal, a
   qualified one is resolved -- refused at run time, answered through the
   lowering while a macro expands (hiccup's compile-multi)."
  (cond ((not (rontolisp::%clojure-real-symbol-p symbol))
         (rontolisp::%clojure-class-cast-exception-of
          (concatenate 'string "class "
                       (rontolisp::%clojure-class-name-of symbol)
                       " cannot be cast to class clojure.lang.Symbol") symbol))
        ((null (rontolisp::%clojure-namespace symbol))
         (rontolisp::%clojure-illegal-argument-exception
          "Symbol must be namespace-qualified"))
        (t (rontolisp::%clojure-find-var-resolve symbol))))

(defun rontolisp::%clojure-find-var-resolve (symbol)
  "find-var of a computed qualified symbol at run time: refused."
  (declare (ignore symbol))
  (rontolisp::%clojure-unsupported-operation-exception
   "find-var of a computed symbol is not supported at run time: vars exist only while the program lowers"))

(defun rontolisp::%clojure-find-var-v (&rest args)
  "find-var as a value."
  (rontolisp::%clojure-check-arity args 1 1 "find-var")
  (rontolisp::%clojure-find-var (car args)))

(defun rontolisp::%clojure-ns-resolve-in (pair)
  "ns-resolve of the symbol (second PAIR) in the namespace (first PAIR) at run
   time: refused, like resolve. The macro-time evaluator resolves it through the
   lowering instead."
  (declare (ignore pair))
  (rontolisp::%clojure-unsupported-operation-exception
   "ns-resolve of a computed namespace or symbol is not supported at run time: vars exist only while the program lowers"))

(defun rontolisp::%clojure-ns-resolve (ns symbol)
  "ns-resolve of a namespace or symbol computed at run time: a nil namespace is
   the oracle's NullPointerException (the-ns of nil reaching the namespace
   table), any other resolves through %clojure-ns-resolve-in."
  (if (null ns)
      (rontolisp::%clojure-null-pointer-exception
       "Cannot invoke \"Object.hashCode()\" because \"key\" is null")
      (rontolisp::%clojure-ns-resolve-in (list ns symbol))))

(defun rontolisp::%clojure-ns-resolve-v (&rest args)
  "ns-resolve as a value: of a namespace and a symbol, or of a namespace, an
   environment (a map, as &env is) and a symbol, which answers nil when the
   environment holds the symbol."
  (rontolisp::%clojure-check-arity args 2 3 "ns-resolve")
  (if (cdr (cdr args))
      (let ((env (car (cdr args)))
            (symbol (car (cdr (cdr args))))
            (miss (list nil)))
        (if (and (hash-table-p env) (not (eq (gethash symbol env miss) miss)))
            nil
            (rontolisp::%clojure-ns-resolve (car args) symbol)))
      (rontolisp::%clojure-ns-resolve (car args) (car (cdr args)))))

;;;; Namespaces: *ns* as a value, and the REPL's history.
;;
;; A namespace is (:C%NS-OBJECT "name"), interned per name in
;; rontolisp::%clojure-ns-table, so every read of one
;; answers the same object, like the oracle's one Namespace per name. It exists
;; at run time only as a value: what a namespace defines is decided where the
;; program lowers, so the-ns and find-ns take the names the program created
;; before the call (KNOWN, from the lowering). *ns* holds one: ns and in-ns
;; switch it, a require rebinds it around the namespace's load. Every test of
;; one (%clojure-ns-object-p) is an arm a program that makes none sheds
;; (clojure/ClojureArms, the NAMESPACE family).

(defvar rontolisp::%clojure-ns-guard (rontolisp:make-mutex))

(defvar rontolisp::%clojure-ns-table
  (make-hash-table :test 'equal)
  "The interned namespaces: an equal table from the name to its namespace, read
   and written under %clojure-ns-guard (a Ring handler runs one thread per
   request).")

(defun rontolisp::%clojure-ns-object (name)
  "The namespace NAME, interned on first use."
  (rontolisp:with-mutex (rontolisp::%clojure-ns-guard)
    (let ((ns (gethash name rontolisp::%clojure-ns-table)))
      (if ns
          ns
          (setf (gethash name rontolisp::%clojure-ns-table)
                (list :C%NS-OBJECT name))))))

(defun rontolisp::%clojure-ns-object-p (x)
  "Whether X is a namespace."
  (and (consp x) (eq (car x) :C%NS-OBJECT)))

(defun rontolisp::%clojure-write-ns-object (x readable stream)
  "Write namespace X as the oracle's #object, its name quoted under pr, the
   identity hash left out."
  (write-string "#object[clojure.lang.Namespace " stream)
  (if readable
      (rontolisp::%clojure-write-readable-string (car (cdr x)) stream)
      (write-string (car (cdr x)) stream))
  (write-char #\] stream))

(defun rontolisp::%clojure-the-ns (x known)
  "the-ns: X itself for a namespace, else the namespace the symbol X names,
   signalling like the oracle when the program created none."
  (if (rontolisp::%clojure-ns-object-p x)
      x
      (let ((ns (rontolisp::%clojure-find-ns x known)))
        (if ns
            ns
            (rontolisp::%clojure-exception
             (format nil "No namespace: ~A found"
                     (rontolisp::%clojure-symbol-full-name x)))))))

(defun rontolisp::%clojure-ns-name (x known)
  "ns-name: the name of the namespace X (or the symbol naming one) as a
   symbol."
  (rontolisp::%clojure-symbol-1
   (car (cdr (rontolisp::%clojure-the-ns x known)))))

;;;; Namespaces as the program answers them: all-ns, create-ns, remove-ns,
;; loaded-libs, intern, var-set and with-redefs-fn. The lowering answers the
;; mappings (ns-publics, ns-interns, ns-map, ns-refers, ns-aliases,
;; ns-imports) and the wirings (alias, refer, ns-unmap, ns-unalias,
;; requiring-resolve, load-string, load-file) for what it knows while the
;; program lowers; anything computed it cannot know refuses at run time.
;;
;; find-ns and the-ns read the run-time namespace table beside the names the
;; program created before the call (KNOWN): a namespace create-ns made is
;; found, one remove-ns took is gone (so all-ns skips it too). Namespaces
;; exist at run time only as values -- what one defines is decided where the
;; program lowers.

(defvar rontolisp::%clojure-ns-removed
  (make-hash-table :test 'equal)
  "The namespaces remove-ns took: an equal table from the name to T, read by
   find-ns, the-ns and all-ns.")

(defun rontolisp::%clojure-find-ns (x known)
  "find-ns: the namespace the symbol X names when the program created it
   (KNOWN, the names it created before the call) or created it at run time,
   else nil; a removed one is gone."
  (if (not (rontolisp::%clojure-real-symbol-p x))
      (rontolisp::%clojure-class-cast-exception-of "find-ns needs a symbol" x))
  (let ((name (rontolisp::%clojure-symbol-full-name x)))
    (if (gethash name rontolisp::%clojure-ns-removed)
        nil
        (if (or (member name known :test #'equal)
                (gethash name rontolisp::%clojure-ns-table))
            (rontolisp::%clojure-ns-object name)
            nil))))

(defun rontolisp::%clojure-all-ns (known)
  "(all-ns): the namespaces the program created before the call, minus
   removed ones, as namespace objects."
  (let ((acc nil))
    (dolist (name known (reverse acc))
      (if (not (gethash name rontolisp::%clojure-ns-removed))
          (setq acc (cons (rontolisp::%clojure-ns-object name) acc))))))

(defun rontolisp::%clojure-create-ns (x)
  "(create-ns x): the namespace the symbol X names, made when missing; a
   removed one is made again. Anything but a symbol is the oracle's cast
   refusal."
  (if (not (rontolisp::%clojure-real-symbol-p x))
      (rontolisp::%clojure-class-cast-exception-of
       (concatenate 'string "class " (rontolisp::%clojure-class-name-of x)
                    " cannot be cast to class clojure.lang.Symbol") x))
  (let ((name (rontolisp::%clojure-symbol-full-name x)))
    (remhash name rontolisp::%clojure-ns-removed)
    (rontolisp::%clojure-ns-object name)))

(defun rontolisp::%clojure-create-ns-v (&rest args)
  "create-ns as a value."
  (rontolisp::%clojure-check-arity args 1 1 "create-ns")
  (rontolisp::%clojure-create-ns (car args)))

(defun rontolisp::%clojure-remove-ns (x)
  "(remove-ns x): the namespace the symbol X names taken out of the table,
   nil for one never made; anything but a symbol is the oracle's cast
   refusal."
  (if (not (rontolisp::%clojure-real-symbol-p x))
      (rontolisp::%clojure-class-cast-exception-of
       (concatenate 'string "class " (rontolisp::%clojure-class-name-of x)
                    " cannot be cast to class clojure.lang.Symbol") x))
  (let ((name (rontolisp::%clojure-symbol-full-name x)))
    (rontolisp:with-mutex (rontolisp::%clojure-ns-guard)
      (let ((ns (gethash name rontolisp::%clojure-ns-table)))
        (if (null ns)
            nil
            (progn
              (remhash name rontolisp::%clojure-ns-table)
              (setf (gethash name rontolisp::%clojure-ns-removed) t)
              ns))))))

(defun rontolisp::%clojure-remove-ns-v (&rest args)
  "remove-ns as a value."
  (rontolisp::%clojure-check-arity args 1 1 "remove-ns")
  (rontolisp::%clojure-remove-ns (car args)))

(defun rontolisp::%clojure-loaded-libs (libs)
  "(loaded-libs): the LIBS names (what the program loaded before the call)
   as a set of symbols."
  (rontolisp::%clojure-set-of
   (let ((acc nil))
     (dolist (name libs (reverse acc))
       (setq acc (cons (rontolisp::%clojure-symbol-1 name) acc))))))

(defun rontolisp::%clojure-intern (ns name &optional (val nil) (val-p nil))
  "(intern ns name [val]): the var NAME (a symbol) in NS (a symbol or a
   namespace) -- an existing one kept (given VAL, rebound like bindRoot),
   else made with VAL (unbound without one) over a cell of its own. The cell
   answers var-get, deref, alter-var-root and with-redefs-fn; a def or defn
   of the name keeps its own cell, so a direct call never sees the interned
   root, like the oracle's static link."
  (if (rontolisp::%clojure-ns-object-p ns)
      (setq ns (rontolisp::%clojure-symbol-1 (car (cdr ns)))))
  (if (not (rontolisp::%clojure-real-symbol-p ns))
      (rontolisp::%clojure-class-cast-exception-of
       (concatenate 'string "class " (rontolisp::%clojure-class-name-of ns)
                    " cannot be cast to class clojure.lang.Symbol") ns))
  (if (not (rontolisp::%clojure-real-symbol-p name))
      (rontolisp::%clojure-class-cast-exception-of
       (concatenate 'string "class " (rontolisp::%clojure-class-name-of name)
                    " cannot be cast to class clojure.lang.Symbol") name))
  (let ((key
         (concatenate 'string (rontolisp::%clojure-symbol-full-name ns) "/"
                      (rontolisp::%clojure-symbol-full-name name))))
    (let ((v
           (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
             (values (gethash key rontolisp::%clojure-var-table)))))
      (if (null v)
          (let* ((cell (list (if val-p val (rontolisp::%clojure-unbound key))))
                 (getter (lambda () (car cell)))
                 (setter (lambda (n) (setf (car cell) n))))
            (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
              (setq v (list :C%VAR key getter))
              (setf (gethash key rontolisp::%clojure-var-table) v))
            (rontolisp::%clojure-var-setter v setter)
            v)
          (if (not val-p)
              v
              (let ((old (rontolisp::%clojure-var-get v))
                    (new
                     (rontolisp::%clojure-stm-validate val
                      (rontolisp::%clojure-ref-validator v)))
                    (setter
                     (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
                       (values (gethash v rontolisp::%clojure-var-setters)))))
                (if setter
                    (funcall setter new)
                    (rplaca (cdr (cdr v)) (let ((n new)) (lambda () n))))
                (rontolisp::%clojure-ref-notify v old new)
                v))))))

(defun rontolisp::%clojure-intern-v (&rest args)
  "intern as a value: [ns name] or [ns name val]."
  (let ((n (rontolisp::%clojure-check-arity args 2 3 "intern")))
    (if (= n 2)
        (rontolisp::%clojure-intern (car args) (car (cdr args)) nil nil)
        (rontolisp::%clojure-intern (car args) (car (cdr args))
                                    (car (cdr (cdr args))) t))))

(defun rontolisp::%clojure-var-short-name (v)
  "The short name of the var V (\"ns/name\" past its slash)."
  (let ((name (car (cdr v))) (at nil))
    (dotimes (i (length name)) (if (char= (char name i) #\/) (setq at i)))
    (if at (subseq name (+ at 1)) name)))

(defun rontolisp::%clojure-var-set (v val)
  "(var-set v val): the thread-local value of a with-local-vars cell under its
   extent, else refused -- a var that is not thread-locally bound takes no
   root through set, like the oracle's."
  (if (not (rontolisp::%clojure-var-p v))
      (rontolisp::%clojure-class-cast-exception-of "var-set needs a var" v))
  (let ((setter (car (cdr (cdr (cdr (cdr (cdr v))))))))
    (if (not (null setter))
        (funcall setter val)
        (rontolisp::%clojure-illegal-state-exception
         (concatenate 'string "Can't change/establish root binding of: "
                      (rontolisp::%clojure-var-short-name v) " with set")))))

(defun rontolisp::%clojure-var-set-v (&rest args)
  "var-set as a value."
  (rontolisp::%clojure-check-arity args 2 2 "var-set")
  (rontolisp::%clojure-var-set (car args) (car (cdr args))))

(defun rontolisp::%clojure-with-redefs-fn (binding-map f)
  "(with-redefs-fn binding-map f): F called with each var of the map bound to
   its value, restored after -- the validations and notifications of bindRoot.
   A var with a registered root setter stores through its value cell, so a
   direct call sees the rebound root; any other var swaps its getter, so only
   var-mediated reads see it, like the oracle's static link. A binding
   failure leaves the earlier ones bound, like the oracle's."
  (let ((restores nil))
    (dolist (entry (rontolisp::%clojure-seq binding-map))
      (let ((v (aref entry 0)) (n (aref entry 1)))
        (if (not (rontolisp::%clojure-var-p v))
            (rontolisp::%clojure-class-cast-exception-of
             (concatenate 'string "class " (rontolisp::%clojure-class-name-of v)
                          " cannot be cast to class clojure.lang.Var") v))
        (let* ((old (rontolisp::%clojure-var-get v))
               (new
                (rontolisp::%clojure-stm-validate n
                 (rontolisp::%clojure-ref-validator v)))
               (setter
                (rontolisp:with-mutex (rontolisp::%clojure-var-guard)
                  (values (gethash v rontolisp::%clojure-var-setters))))
               (getter (car (cdr (cdr v)))))
          (if setter
              (funcall setter new)
              (rplaca (cdr (cdr v)) (let ((n new)) (lambda () n))))
          (setq restores
                (cons (let ((var v) (was old) (had getter) (through setter))
                        (lambda ()
                          (let ((now (rontolisp::%clojure-var-get var))
                                (back
                                 (rontolisp::%clojure-stm-validate was
                                  (rontolisp::%clojure-ref-validator var))))
                            (if through
                                (funcall through back)
                                (rplaca (cdr (cdr var)) had))
                            (rontolisp::%clojure-ref-notify var now back))))
                      restores))
          (rontolisp::%clojure-ref-notify v old new))))
    (unwind-protect (rontolisp::%clojure-call f nil)
      (dolist (restore (reverse restores)) (funcall restore)))))

(defun rontolisp::%clojure-with-redefs-fn-v (&rest args)
  "with-redefs-fn as a value."
  (rontolisp::%clojure-check-arity args 2 2 "with-redefs-fn")
  (rontolisp::%clojure-with-redefs-fn (car args) (car (cdr args))))

(defun rontolisp::%clojure-ns-map-merge (&rest maps)
  "MAPS merged into a fresh table, later ones winning: how a namespace
   mapping too large for one method answers."
  (let ((m (make-hash-table :test 'equal)))
    (dolist (src maps m) (maphash (lambda (k v) (setf (gethash k m) v)) src))))

(defun rontolisp::%clojure-ns-computed-here (what x)
  "(ns-publics ns-interns ns-map ns-refers ns-aliases ns-imports of a
   computed namespace at run time: refused -- only what the lowering knows
   maps."
