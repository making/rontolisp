;; The ASDF component metaobject family at run time: the classes rove's
;; system-driven `run` dispatches over (typecase, defmethod specializers), the
;; readers it walks the component model with, and `asdf:find-system` answering
;; a memoized `asdf:system` instance per name -- `eq` across calls, like real
;; ASDF. One Lisp source for every backend: the interpreter evaluates these
;; forms lazily (eval.AsdfRuntimeLibrary / LispEvaluator), the compile paths
;; splice them when the program references any of the names.
;;
;; The class hierarchy is real ASDF's, and so are the slot names, in asdf's own
;; package, so (slot-value (asdf:find-system :x) 'asdf::relative-pathname) reads
;; here what it reads there (cxml). A parent's children are real instances in
;; definition order, a :module and a :static-file among them; a package-inferred
;; sub-system has one child, named "lisp". The fixed plan is a table of its own
;; on the system: the source files, in load order.
;;
;; The one per-backend seam is the record source: `%asdf-system-record` /
;; `%asdf-system-names` read the interpreter's live registry (Java built-ins)
;; or the compile-time-baked `%asdf-registry%` table (defuns generated by
;; AsdfRuntimeLibrary). A record is
;; (CLASS DIR COMPONENTS DEPS LOADED-P VERSION META ROOT)
;; with DIR the .asd's directory, ROOT the system's :pathname below it, META a plist
;; of what the .asd declared (`%asdf-set-metadata`): a compile path bakes it only
;; for a program that can read it, and COMPONENTS a list of
;; (KIND NAME RELATIVE RESOLVED PLAN-INDEX . OPTIONS), `%asdf-build-component`. KIND
;; is a string for a class loaded code defines. An instance of such a class, or of a
;; system's when CLASS is a string, comes from `%asdf-make-component` /
;; `%asdf-make-system`, a seam because a compile path dispatches over the classes
;; it spliced rather than making a class named at run time. A system of such a class
;; is then reinitialized (`%asdf-reinitialize-system`), registered by then as in real
;; ASDF, whose parse-defsystem reinitializes the system it registered.
;;
;; The operation protocol below is the second half: `asdf:perform` is the
;; generic every component load goes through, so an extension's method runs
;; around it. Its per-backend seams load one component
;; (`%asdf-load-component`), answer a system's recorded test-op wiring
;; (`%asdf-test-op-edges`, `%asdf-run-recorded-test-op`) and move the registry
;; (`%asdf-locate-system`, `%asdf-clear-system`, `%asdf-load-asd`): Java built-ins
;; on the interpreter, generated defuns on the compile paths.
;;
;; A name real ASDF exports and nothing here defines is a signalling stub
;; AsdfRuntimeLibrary synthesizes from the inventory (asdf-exports.txt).

(defclass asdf:component ()
  ((asdf::name :initarg :name :reader asdf:component-name)
   ;; What the definition said: the directory on a system, the :pathname if any on
   ;; anything below it. What the reader computes in real ASDF is the path below the
   ;; parent's, which the record carries.
   (asdf::relative-pathname :initarg :pathname :initform nil)
   (%relative :initform nil :reader asdf:component-relative-pathname)
   (asdf::absolute-pathname :initarg :absolute-pathname
                            :initform nil
                            :reader %asdf-component-pathname-slot)
   (asdf::if-feature :initarg :if-feature
                     :initform nil
                     :accessor asdf::component-if-feature)
   ;; The parse found the :if-feature false: it is no source of the plan.
   (%disabled :initform nil)
   ;; Where it stands in the system's fixed plan, nil when it has no action there.
   (%plan-index :initform nil)
   ;; The declared :version string, on the component like real ASDF (only a
   ;; system ever carries one here -- a component file has none).
   (asdf:version :initarg :version :initform nil :reader asdf:component-version)
   (asdf::description :initarg :description
                      :initform nil
                      :reader asdf::component-description)
   (asdf::long-description :initarg :long-description
                           :initform nil
                           :reader asdf::component-long-description)
   (asdf::properties :initform nil :accessor asdf::component-properties)
   (asdf::sideway-dependencies :initarg :sideway
                               :initform nil
                               :reader asdf:component-sideway-dependencies)
   (asdf::parent :initarg :parent :initform nil :reader asdf:component-parent)
   ;; Unbound: the parent's (asdf::around-compile-hook). A class's default-initarg
   ;; is read by the plan (the hook runs where the loader reads the file).
   (asdf::around-compile :initarg :around-compile)))

(defclass asdf:child-component (asdf:component) ())

(defclass asdf:parent-component (asdf:component)
  ((asdf::children :initarg :children
                   :initform nil
                   :accessor asdf:component-children)
   ;; Unbound until a find-component (compute-children-by-name).
   (asdf::children-by-name :accessor asdf:component-children-by-name)
   ;; The class of a (:file ...) below an instance, read by the plan: a system
   ;; class says it in this slot's initform (hu.dwim.system).
   (asdf::default-component-class :initarg
     :default-component-class :initform
     nil
     :accessor asdf::module-default-component-class)))

(defclass asdf:module (asdf:child-component asdf:parent-component) ())

(defclass asdf::proto-system (asdf:component) ())

(defclass asdf:system (asdf:module asdf::proto-system)
  ((asdf::author :initarg :author :initform nil)
   (asdf::maintainer :initarg :maintainer :initform nil)
   (asdf::licence :initarg :license :initarg :licence :initform nil)
   (asdf::homepage :initarg :homepage :initform nil)
   (asdf::bug-tracker :initarg :bug-tracker :initform nil)
   (asdf::mailto :initarg :mailto :initform nil)
   (asdf::long-name :initarg :long-name :initform nil)
   (asdf::source-control :initarg :source-control :initform nil)
   (asdf:source-file :initform nil) (asdf::depends-on :initform nil)
   (asdf::weakly-depends-on :initform nil)
   (asdf::defsystem-depends-on :initform nil) (asdf::entry-point :initform nil)
   (asdf::build-operation :initform nil) (asdf::build-pathname :initform nil)
   ;; The .asd's directory, which the :pathname of absolute-pathname is below.
   (%source-directory :initform nil)
   ;; Plan index -> component.
   (%plan :initform nil)))

(defclass asdf:package-inferred-system (asdf:system) ())

;; The file's extension, which `asdf:source-file-type` answers by default. The
;; plan names a file by it, a class saying it in this slot's initform
;; (coalton-file) or a default-initarg (lass-file).
(defclass asdf:file-component (asdf:child-component)
  ((type :initarg :type :initform nil :accessor asdf:file-type)))

(defclass asdf:source-file (asdf:file-component) ())

(defclass asdf:cl-source-file (asdf:source-file) ((type :initform "lisp")))

(defclass asdf:cl-source-file.cl (asdf:cl-source-file) ((type :initform "cl")))

(defclass asdf:cl-source-file.lsp (asdf:cl-source-file)
  ((type :initform "lsp")))

(defclass asdf:static-file (asdf:source-file) ())

(defclass asdf:doc-file (asdf:static-file) ())

(defclass asdf:html-file (asdf:doc-file) ((type :initform "html")))

;; The conditions a load signals: what real ASDF signals, under its names.
(define-condition asdf:system-definition-error (error) ())

(define-condition asdf:missing-component (asdf:system-definition-error)
  ((asdf::requires :initarg :requires :reader asdf::missing-requires)
   (asdf::parent :initarg :parent :initform nil :reader asdf::missing-parent)
   ;; Where a load looked, which real ASDF does not say.
   (%detail :initarg :detail :initform nil :reader %asdf-missing-detail))
  (:report
   (lambda (condition stream)
     (format stream "Component ~s not found" (asdf::missing-requires condition))
     (when (%asdf-missing-detail condition)
       (format stream " ~a" (%asdf-missing-detail condition))))))

(define-condition asdf:missing-dependency (asdf:missing-component)
  ((asdf::required-by :initarg :required-by :reader asdf::missing-required-by))
  (:report
   (lambda (condition stream)
     (format stream "Component ~s not found, required by ~a"
             (asdf::missing-requires condition)
             (asdf:component-name (asdf::missing-required-by condition)))
     (when (%asdf-missing-detail condition)
       (format stream " ~a" (%asdf-missing-detail condition))))))

(define-condition asdf:load-system-definition-error
    (asdf:system-definition-error)
  ((asdf::name :initarg :name :reader asdf:error-name)
   (asdf::pathname :initarg :pathname :reader asdf:error-pathname)
   (asdf::condition :initarg :condition :reader asdf::error-condition))
  (:report
   (lambda (condition stream)
     (format stream
      "Error while trying to load definition for system ~a from pathname ~a: ~a"
      (asdf:error-name condition) (asdf:error-pathname condition)
      (asdf::error-condition condition)))))

;; Loading a .asd on the interpreter, under real ASDF's handler: an error while
;; the file loads is a load-system-definition-error whose condition is the error.
(defun %asdf-call-loading-definition (name pathname thunk)
  (handler-bind ((error
                  (lambda (condition)
                    (error 'asdf:load-system-definition-error
                           :name name
                           :pathname pathname
                           :condition condition))))
    (funcall thunk)))

;; A load that found no .asd, from the interpreter's loader: REQUIRED-BY is the
;; system whose dependency it is, or nil for a system asked for by name.
(defun %asdf-signal-missing (name required-by detail)
  (if required-by
      (error 'asdf:missing-dependency
             :requires name
             :required-by (asdf:find-system required-by)
             :detail detail)
      (error 'asdf:missing-component :requires name :detail detail)))

;; The directories asdf:*central-registry* names. A push is the program's, so a
;; search reads this first, as real ASDF does (asdf-search.lisp); each entry is
;; evaluated there, its value a pathname designator.
(defvar asdf:*central-registry* nil)

;; The contract version, uiop's (uiop-version.lisp): a version gate gets the
;; answer matching the API it finds. lisp-binary.asd loads its bundled ASDF on
;; anything older than 3.1.5.
(defvar asdf::*asdf-version* "3.3.7")

(defvar asdf:*verbose-out* nil)

(defun asdf:asdf-version () asdf::*asdf-version*)

(defun asdf:asdf-message (format-string &rest format-args)
  (when asdf:*verbose-out*
    (apply #'format asdf:*verbose-out* format-string format-args)))

;; This ASDF is part of the implementation: there is nothing to upgrade to.
(defun asdf:upgrade-asdf () t)

;; name -> system instance; one object per system, which is what makes
;; find-system `eq` across calls (and what (setf (gethash system ...)) shapes
;; in callers assume).
(defvar %asdf-instances% nil)

;; ASDF's coerce-name: a string stays verbatim, a symbol designator downcases,
;; a component answers its own (already canonical) name.
(defun asdf:coerce-name (designator)
  (cond ((stringp designator) designator)
        ((typep designator 'asdf:component) (asdf:component-name designator))
        (t (string-downcase (string designator)))))

;; The .asd file a system is defined in: the name before the first slash.
(defun asdf:primary-system-name (system)
  (let* ((name (asdf:coerce-name system)) (slash (position #\/ name)))
    (if slash (subseq name 0 slash) name)))

;; An instance of one of ASDF's own classes, each named literally so a compile
;; path's make-instance stays out of the computed-class gate.
(defun %asdf-new-component (kind name written resolved parent)
  (let ((component
         (case kind
           (:module (make-instance 'asdf:module))
           (:static-file (make-instance 'asdf:static-file))
           (:doc-file (make-instance 'asdf:doc-file))
           (:html-file (make-instance 'asdf:html-file))
           (:cl-source-file.cl (make-instance 'asdf:cl-source-file.cl))
           (:cl-source-file.lsp (make-instance 'asdf:cl-source-file.lsp))
           (t (make-instance 'asdf:cl-source-file)))))
    (setf (slot-value component 'asdf::name) name)
    (setf (slot-value component 'asdf::relative-pathname) written)
    (setf (slot-value component 'asdf::absolute-pathname) resolved)
    (setf (slot-value component 'asdf::parent) parent)
    component))

;; NODE is (KIND NAME RELATIVE RESOLVED PLAN-INDEX . OPTIONS). PLAN is the system's
;; table, where a source file of the fixed plan goes.
(defun %asdf-build-component (node parent plan)
  (let* ((kind (first node))
         (name (second node))
         (resolved (fourth node))
         (index (nth 4 node))
         (options (nthcdr 5 node))
         (written (getf options :pathname))
         (component
          (if (stringp kind)
              (%asdf-make-component kind (getf options :initargs) name written
                                    resolved parent)
              (%asdf-new-component kind name written resolved parent))))
    (setf (slot-value component '%relative) (third node))
    (setf (slot-value component 'asdf::sideway-dependencies)
          (getf options :sideway))
    (setf (slot-value component 'asdf::if-feature) (getf options :if-feature))
    (setf (slot-value component '%disabled) (getf options :disabled))
    (when (getf options :type)
      (setf (asdf:file-type component) (getf options :type)))
    (when index
      (setf (slot-value component '%plan-index) index)
      (setf (gethash index plan) component))
    (when (typep component 'asdf:parent-component)
      (setf (asdf:component-children component)
            (mapcar
             (lambda (child) (%asdf-build-component child component plan))
             (getf options :children))))
    component))

(defun %asdf-build-system (key rec)
  (let* ((class (first rec))
         (dir (second rec))
         (root (or (nth 7 rec) dir))
         (deps (fourth rec))
         (version (nth 5 rec))
         (sys
          (cond
           ((eq class :package-inferred-system)
            (make-instance 'asdf:package-inferred-system
                           :name key
                           :pathname root
                           :absolute-pathname root
                           :version version
                           :sideway deps))
           ((stringp class) (%asdf-make-system class key root version deps))
           (t (make-instance 'asdf:system
                             :name key
                             :pathname root
                             :absolute-pathname root
                             :version version
                             :sideway deps))))
         (plan (make-hash-table)))
    (setf (slot-value sys '%relative) root)
    (setf (slot-value sys '%source-directory) dir)
    (setf (slot-value sys '%plan) plan)
    (%asdf-set-metadata sys deps (nth 6 rec))
    (setf (gethash key %asdf-instances%) sys)
    (when (stringp class) (%asdf-reinitialize-system sys))
    (setf (asdf:component-children sys)
     (mapcar (lambda (node) (%asdf-build-component node sys plan)) (third rec)))
    sys))

;; The source file of system SYSTEM-NAME at INDEX of the fixed plan.
(defun %asdf-planned-component (system-name index)
  (gethash index (slot-value (asdf:find-system system-name) '%plan)))

;; What the definition says of these wins over what the class said of them (a
;; system's class may fill them from its initargs: hu.dwim.system's license).
(defun %asdf-set-metadata (sys deps meta)
  (setf (slot-value sys 'asdf::depends-on) deps)
  (when (getf meta :description)
    (setf (slot-value sys 'asdf::description) (getf meta :description)))
  (setf (slot-value sys 'asdf::long-description) (getf meta :long-description))
  (setf (slot-value sys 'asdf::properties) (getf meta :properties))
  (when (getf meta :author)
    (setf (slot-value sys 'asdf::author) (getf meta :author)))
  (setf (slot-value sys 'asdf::maintainer) (getf meta :maintainer))
  (when (or (getf meta :license) (getf meta :licence))
    (setf (slot-value sys 'asdf::licence)
          (or (getf meta :license) (getf meta :licence))))
  (setf (slot-value sys 'asdf::homepage) (getf meta :homepage))
  (setf (slot-value sys 'asdf::bug-tracker) (getf meta :bug-tracker))
  (setf (slot-value sys 'asdf::mailto) (getf meta :mailto))
  (setf (slot-value sys 'asdf::long-name) (getf meta :long-name))
  (setf (slot-value sys 'asdf::source-control) (getf meta :source-control))
  (setf (slot-value sys 'asdf:source-file) (getf meta :source-file))
  (setf (slot-value sys 'asdf::weakly-depends-on)
        (getf meta :weakly-depends-on))
  (setf (slot-value sys 'asdf::defsystem-depends-on)
        (getf meta :defsystem-depends-on))
  (setf (slot-value sys 'asdf::entry-point) (getf meta :entry-point))
  (setf (slot-value sys 'asdf::build-operation) (getf meta :build-operation))
  (setf (slot-value sys 'asdf::build-pathname) (getf meta :build-pathname)))

;; The system KEY already registered, as its one instance; nil otherwise.
(defun %asdf-registered-instance (key)
  (unless %asdf-instances%
    (setq %asdf-instances% (make-hash-table :test 'equal)))
  (or (gethash key %asdf-instances%)
      (let ((rec (%asdf-system-record key)))
        (and rec (%asdf-build-system key rec)))))

(defun asdf:registered-system (name)
  (%asdf-registered-instance (asdf:coerce-name name)))

(defun asdf:find-system (name &optional (error-p t))
  (if (typep name 'asdf:component)
      name
      (let ((key (asdf:coerce-name name)))
        (or (%asdf-registered-instance key)
            (progn
              (%asdf-locate-system key)
              (%asdf-registered-instance key))
            (when error-p (error 'asdf:missing-component :requires key))))))

;; A system a search function answered, already built: a load of it has no files.
(defun %asdf-adopt-system (key system)
  (%asdf-note-found-system key)
  (unless %asdf-instances%
    (setq %asdf-instances% (make-hash-table :test 'equal)))
  (setf (gethash key %asdf-instances%) system))

(defun asdf:registered-systems () (%asdf-system-names))

;; Forget a system: the next find-system searches for it again and answers a new
;; instance. On a compile path the program keeps what it spliced.
(defun asdf:clear-system (system)
  (let ((key (asdf:coerce-name system)))
    (when %asdf-instances% (remhash key %asdf-instances%))
    (%asdf-clear-system key)
    t))

(defun asdf:map-systems (fn)
  (dolist (name (%asdf-system-names)) (funcall fn (asdf:find-system name))))

(defun asdf:component-system (component)
  (let ((parent (asdf:component-parent component)))
    (if parent (asdf:component-system parent) component)))

(defun asdf:component-loaded-p (component)
  (let ((rec
         (%asdf-system-record
          (if (typep component 'asdf:component)
              (asdf:component-name (asdf:component-system component))
              (asdf:coerce-name component)))))
    (and rec (nth 4 rec) t)))

(defun asdf:already-loaded-systems ()
  (remove-if-not #'asdf:component-loaded-p (%asdf-system-names)))

;; Real ASDF's answer is the time it registered the system and the system.
(defun asdf:system-registered-p (name)
  (let ((system (asdf:registered-system name))) (and system (cons 0 system))))

(defun asdf::compute-children-by-name (parent &key only-if-needed-p)
  (unless (and only-if-needed-p (slot-boundp parent 'asdf::children-by-name))
    (let ((hash (make-hash-table :test 'equal)))
      (setf (asdf:component-children-by-name parent) hash)
      (dolist (child (asdf:component-children parent))
        (setf (gethash (asdf:component-name child) hash) child))
      hash)))

;; Real ASDF's methods: a base that is no parent and a name below it fail as there.
(defgeneric asdf:find-component (base path &key registered))

(defmethod asdf:find-component ((base string) path &key registered)
  (let ((system
         (if registered
             (asdf:registered-system base)
             (asdf:find-system base nil))))
    (and system (asdf:find-component system path :registered registered))))

(defmethod asdf:find-component ((base symbol) path &key registered)
  (cond (base (asdf:find-component (asdf:coerce-name base) path
                                   :registered registered))
        (path (asdf:find-component path nil :registered registered))
        (t nil)))

(defmethod asdf:find-component ((base cons) path &key registered)
  (asdf:find-component (car base) (cons (cdr base) path)
                       :registered registered))

(defmethod asdf:find-component
    ((parent asdf:parent-component) (name string) &key registered)
  (declare (ignore registered))
  (asdf::compute-children-by-name parent :only-if-needed-p t)
  (values (gethash name (asdf:component-children-by-name parent))))

(defmethod asdf:find-component (base (name symbol) &key registered)
  (if name
      (asdf:find-component base (asdf:coerce-name name) :registered registered)
      base))

(defmethod asdf:find-component ((c asdf:component) (name cons) &key registered)
  (asdf:find-component (asdf:find-component c (car name) :registered registered)
                       (cdr name)
                       :registered registered))

(defmethod asdf:find-component (base (actual asdf:component) &key registered)
  (declare (ignore base registered))
  actual)

;; The transitive sub-components of TYPE, COMPONENT first, leaving out what the
;; parse disabled.
(defun asdf::sub-components (component &key (type t))
  (let ((found nil))
    (labels ((recurse (x)
               (unless (slot-value x '%disabled)
                 (when (typep x type) (push x found))
                 (when (typep x 'asdf:parent-component)
                   (dolist (child (asdf:component-children x))
                     (recurse child))))))
      (recurse component))
    (reverse found)))

(defun asdf:component-find-path (component)
  (let ((path nil))
    (do ((c component (asdf:component-parent c)))
        ((null c) path)
      (push (asdf:component-name c) path))))

(defun asdf:module-components (module) (asdf:component-children module))

;; Source is read as UTF-8 and nothing else (.kb/asdf.md, :encoding).
(defun asdf:component-encoding (component)
  (declare (ignore component))
  :utf-8)

(defun asdf:component-external-format (component)
  (declare (ignore component))
  :utf-8)

(defun asdf:component-load-dependencies (component)
  (asdf:component-sideway-dependencies component))

(defun asdf:component-property (component property)
  (cdr (assoc property (asdf::component-properties component) :test #'equal)))

(defun asdf:version-satisfies (component version)
  (let ((current
         (if (stringp component) component (asdf:component-version component))))
    (or (not (and version current)) (uiop/version:version<= version current))))

;; What the .asd declared, as written when it is a literal (nil otherwise: a #.
;; marker in these options is never evaluated, .kb/asdf.md).
(defun asdf:system-source-file (system)
  (slot-value (asdf:find-system system) 'asdf:source-file))

(defun asdf:system-definition-pathname (system)
  (asdf:system-source-file system))

(defun asdf:system-description (system) (asdf::component-description system))

(defun asdf:system-long-description (system)
  (asdf::component-long-description system))

(defun asdf:system-author (system) (slot-value system 'asdf::author))

(defun asdf:system-maintainer (system) (slot-value system 'asdf::maintainer))

(defun asdf:system-license (system) (slot-value system 'asdf::licence))

(defun asdf:system-licence (system) (slot-value system 'asdf::licence))

(defun asdf:system-homepage (system) (slot-value system 'asdf::homepage))

(defun asdf:system-bug-tracker (system) (slot-value system 'asdf::bug-tracker))

(defun asdf:system-mailto (system) (slot-value system 'asdf::mailto))

(defun asdf:system-long-name (system) (slot-value system 'asdf::long-name))

(defun asdf:system-source-control (system)
  (slot-value system 'asdf::source-control))

(defun asdf:system-depends-on (system) (slot-value system 'asdf::depends-on))

(defun asdf:system-weakly-depends-on (system)
  (slot-value system 'asdf::weakly-depends-on))

(defun asdf:system-defsystem-depends-on (system)
  (slot-value system 'asdf::defsystem-depends-on))

(defun asdf::component-entry-point (system)
  (slot-value system 'asdf::entry-point))

(defun asdf::component-build-operation (system)
  (slot-value system 'asdf::build-operation))

(defun asdf::component-build-pathname (system)
  (slot-value system 'asdf::build-pathname))

;; There are no fasls and no output translations: a path is where it is.
(defun asdf:apply-output-translations (path) path)

(defun asdf:disable-output-translations () t)

(defun asdf:clear-output-translations () nil)

(defun asdf:initialize-output-translations (&rest parameter)
  (declare (ignore parameter))
  t)

(defun asdf:ensure-output-translations () t)

;; component-pathname / system-source-directory / system-relative-pathname
;; accept a designator as well as the component object (they key on the name),
;; and keep answering NAMESTRINGS like the other asdf/uiop producers
;; (.kb/pathnames.md).
(defgeneric asdf:component-pathname (component))

(defmethod asdf:component-pathname ((component asdf:component))
  (%asdf-component-pathname-slot component))

(defmethod asdf:component-pathname (component)
  (%asdf-component-pathname-slot (asdf:find-system component)))

(defgeneric asdf::component-parent-pathname (component))

(defmethod asdf::component-parent-pathname ((component asdf:component))
  (let ((parent (asdf:component-parent component)))
    (if parent
        (asdf:component-pathname parent)
        (asdf:system-source-directory component))))

(defun asdf:system-source-directory (system)
  (slot-value (asdf:component-system (asdf:find-system system))
              '%source-directory))

(defun asdf:system-relative-pathname (system relative)
  (namestring
   (uiop/pathname:merge-pathnames* relative
                                   (asdf:system-source-directory system))))

;; ---------------------------------------------------------------------------
;; The operation protocol: real ASDF's operation classes and generics over a
;; plan that is fixed rather than computed. load-system performs prepare-op on
;; the system, then prepare-op, compile-op and load-op on each component file
;; in load order, then compile-op and load-op on the system -- the action order
;; real ASDF's plan has for a source tree. A source file is compiled BY loading
;; it here (there are no fasls), so load-op on a cl-source-file loads the
;; source and compile-op has nothing to produce; a method an extension adds
;; runs around each load all the same (asdf-flv's perform :around binds its
;; file-local variables around every component).

(defclass asdf:operation () ())

(defclass asdf:downward-operation (asdf:operation) ())

(defclass asdf:upward-operation (asdf:operation) ())

(defclass asdf:sideway-operation (asdf:operation) ())

(defclass asdf:selfward-operation (asdf:operation) ())

(defclass asdf:non-propagating-operation (asdf:operation) ())

(defclass asdf::basic-load-op (asdf:operation) ())

(defclass asdf::basic-compile-op (asdf:operation) ())

(defclass asdf:prepare-op (asdf:upward-operation asdf:sideway-operation) ())

(defclass asdf:prepare-source-op (asdf:upward-operation asdf:sideway-operation)
  ())

(defclass asdf:compile-op
    (asdf::basic-compile-op asdf:downward-operation asdf:selfward-operation)
  ())

(defclass asdf:load-op
    (asdf::basic-load-op asdf:downward-operation asdf:selfward-operation)
  ())

;; load-op already loads source here, so the two load a component alike.
(defclass asdf:load-source-op
    (asdf::basic-load-op asdf:downward-operation asdf:selfward-operation)
  ())

(defclass asdf:test-op (asdf:selfward-operation) ())

;; What cffi-toolchain reaches of the bundle operations, which this ASDF
;; performs none of: the abstract bundle-op and its internal link-op
;; (cffi-toolchain imports it from asdf/bundle and specializes perform on it),
;; and the pathname type of a bundle output, which names a groveller's object
;; file and executable. Real ASDF's types, per OS.
(defclass asdf:bundle-op (asdf:operation) ())

(defclass asdf/bundle::link-op (asdf:bundle-op) ())

(defun asdf::bundle-pathname-type (bundle-type)
  (etypecase bundle-type
    ((or null string) bundle-type)
    ((eql :no-output-file) (error "No output file, therefore no pathname type"))
    ((eql :fasl) (uiop/lisp-build:compile-file-type))
    ((eql :image) "image")
    ((eql :object) "o")
    ((member :lib :static-library) "a")
    ((member :dll :shared-library) (if (uiop/os:os-macosx-p) "dylib" "so"))
    ((eql :program) nil)))

(defclass asdf:define-op (asdf:non-propagating-operation) ())

(defclass asdf:build-op (asdf:non-propagating-operation) ())

;; class name -> its one instance: an operation is a singleton per class, as
;; real ASDF's make-operation answers it.
(defvar %asdf-operations% nil)

(defun asdf:make-operation (operation-class)
  (let ((entry (assoc operation-class %asdf-operations%)))
    (if entry
        (cdr entry)
        (let ((operation (make-instance operation-class)))
          (setq %asdf-operations%
                (cons (cons operation-class operation) %asdf-operations%))
          operation))))

(defun %asdf-operation (designator)
  (if (typep designator 'asdf:operation)
      designator
      (asdf:make-operation designator)))

(defun asdf:find-operation (context spec)
  (declare (ignore context))
  (%asdf-operation spec))

(defgeneric asdf:perform (operation component))

;; An operation designated by its class name means the class's instance.
(defmethod asdf:perform ((operation symbol) component)
  (asdf:perform (asdf:make-operation operation) component))

(defmethod asdf:perform
    ((operation asdf:operation) (component asdf:parent-component))
  nil)

(defmethod asdf:perform
    ((operation asdf:operation) (component asdf:source-file))
  (error "ASDF:PERFORM: no method for ~a on component ~a"
         (class-name (class-of operation)) (asdf:component-name component)))

(defmethod asdf:perform ((operation asdf:prepare-op) (component asdf:component))
  nil)

(defmethod asdf:perform
    ((operation asdf:prepare-source-op) (component asdf:component))
  nil)

(defmethod asdf:perform
    ((operation asdf:compile-op) (component asdf:source-file))
  nil)

(defmethod asdf:perform ((operation asdf:load-op) (component asdf:static-file))
  nil)

;; Loading a component is the per-backend seam: the interpreter reads the file,
;; a compiled program runs the forms it spliced for it.
(defun %asdf-load-source (component)
  (let ((index (slot-value component '%plan-index)))
    (unless index
      (error "ASDF:PERFORM: ~a is no source file the plan of its system holds"
             (asdf:component-name component)))
    (%asdf-load-component
     (asdf:component-name (asdf:component-system component)) index)))

(defmethod asdf:perform
    ((operation asdf:load-op) (component asdf:cl-source-file))
  (%asdf-load-source component))

(defmethod asdf:perform
    ((operation asdf:load-source-op) (component asdf:cl-source-file))
  (%asdf-load-source component))

(defmethod asdf:perform
    ((operation asdf:load-source-op) (component asdf:static-file))
  nil)

(defmethod asdf:perform ((operation asdf:test-op) (component asdf:component))
  nil)

;; The body the system's .asd recorded as :perform (test-op (o c) ...).
(defmethod asdf:perform ((operation asdf:test-op) (component asdf:system))
  (%asdf-run-recorded-test-op (asdf:component-name component) operation
                              component))

(defgeneric asdf:input-files (operation component))

(defmethod asdf:input-files ((operation symbol) component)
  (asdf:input-files (asdf:make-operation operation) component))

(defmethod asdf:input-files
    ((operation asdf:operation) (component asdf:component))
  nil)

(defmethod asdf:input-files
    ((operation asdf:compile-op) (component asdf:cl-source-file))
  (list (asdf:component-pathname component)))

(defmethod asdf:input-files
    ((operation asdf:load-op) (component asdf:cl-source-file))
  (list (asdf:component-pathname component)))

(defmethod asdf:input-files
    ((operation asdf:load-source-op) (component asdf:cl-source-file))
  (list (asdf:component-pathname component)))

(defmethod asdf:input-files
    ((operation asdf:load-op) (component asdf:static-file))
  (list (asdf:component-pathname component)))

;; No operation writes a file here: there are no fasls.
(defgeneric asdf:output-files (operation component))

(defmethod asdf:output-files ((operation symbol) component)
  (asdf:output-files (asdf:make-operation operation) component))

(defmethod asdf:output-files
    ((operation asdf:operation) (component asdf:component))
  (values nil t))

;; Every action is done as far as the plan is concerned (load-system performs
;; a fixed plan); the generic is here for the methods a library defines on it
;; (arnesi's clean-op).
(defgeneric asdf:operation-done-p (operation component))

(defmethod asdf:operation-done-p ((operation symbol) component)
  (asdf:operation-done-p (asdf:make-operation operation) component))

(defmethod asdf:operation-done-p
    ((operation asdf:operation) (component asdf:component))
  t)

;; The plan asks a prototype of a class loaded code defines (AsdfSystems); ASDF's
;; own classes and the ones a .asd declares it reads off their shape.
(defgeneric asdf:source-file-type (component system))

(defmethod asdf:source-file-type
    ((component asdf:component) (system asdf:parent-component))
  nil)

(defmethod asdf:source-file-type
    ((component asdf:file-component) (system asdf:parent-component))
  (asdf:file-type component))

(defmethod asdf:source-file-type
    ((component asdf:parent-component) (system asdf:parent-component))
  :directory)

;; The nearest :around-compile, up the parents.
(defgeneric asdf::around-compile-hook (component))

(defmethod asdf::around-compile-hook ((component asdf:component))
  (cond ((slot-boundp component 'asdf::around-compile)
         (slot-value component 'asdf::around-compile))
        ((asdf:component-parent component)
         (asdf::around-compile-hook (asdf:component-parent component)))))

;; What a method compiling a file itself calls (coalton-file); a loader runs the
;; hook around a source file it reads.
(defgeneric asdf::call-with-around-compile-hook (component thunk))

(defmethod asdf::call-with-around-compile-hook
    ((component asdf:component) thunk)
  (let ((hook (asdf::around-compile-hook component)))
    (if hook (funcall hook thunk) (funcall thunk))))

;; The action's direct dependencies, real ASDF's shapes: (OPERATION . COMPONENTS),
;; each component a name or an instance. The plan here is fixed, so nothing here
;; reads the answer; a method a library adds extends what the library itself
;; asks (swank-asdf reads a system's dependencies this way).
(defgeneric asdf:component-depends-on (operation component))

(defmethod asdf:component-depends-on ((operation symbol) component)
  (asdf:component-depends-on (asdf:make-operation operation) component))

(defmethod asdf:component-depends-on
    ((operation asdf:operation) (component asdf:component))
  nil)

(defun %asdf-define-dependency (system)
  (list 'asdf:define-op (asdf:component-name system)))

(defmethod asdf:component-depends-on
    ((operation asdf:operation) (component asdf:system))
  (list (%asdf-define-dependency component)))

(defmethod asdf:component-depends-on
    ((operation asdf:prepare-op) (component asdf:system))
  (list (cons 'asdf:load-op (asdf:component-sideway-dependencies component))
        (%asdf-define-dependency component)))

(defmethod asdf:component-depends-on
    ((operation asdf:prepare-source-op) (component asdf:system))
  (list
   (cons 'asdf:load-source-op (asdf:component-sideway-dependencies component))
   (%asdf-define-dependency component)))

(defmethod asdf:component-depends-on
    ((operation asdf:prepare-op) (component asdf:child-component))
  (list (list operation (asdf:component-parent component))
        (cons 'asdf:load-op (asdf:component-sideway-dependencies component))))

(defmethod asdf:component-depends-on
    ((operation asdf:prepare-source-op) (component asdf:child-component))
  (list (list operation (asdf:component-parent component))
   (cons 'asdf:load-source-op (asdf:component-sideway-dependencies component))))

(defmethod asdf:component-depends-on
    ((operation asdf:load-op) (component asdf:module))
  (list (cons operation (asdf:component-children component))
        (list 'asdf:prepare-op component) (list 'asdf:compile-op component)))

(defmethod asdf:component-depends-on
    ((operation asdf:compile-op) (component asdf:module))
  (list (cons operation (asdf:component-children component))
        (list 'asdf:prepare-op component)))

(defmethod asdf:component-depends-on
    ((operation asdf:load-source-op) (component asdf:module))
  (list (cons operation (asdf:component-children component))
        (list 'asdf:prepare-source-op component)))

(defmethod asdf:component-depends-on
    ((operation asdf:load-op) (component asdf:system))
  (list (cons operation (asdf:component-children component))
        (list 'asdf:prepare-op component) (list 'asdf:compile-op component)
        (%asdf-define-dependency component)))

(defmethod asdf:component-depends-on
    ((operation asdf:compile-op) (component asdf:system))
  (list (cons operation (asdf:component-children component))
        (list 'asdf:prepare-op component) (%asdf-define-dependency component)))

(defmethod asdf:component-depends-on
    ((operation asdf:load-source-op) (component asdf:system))
  (list (cons operation (asdf:component-children component))
        (list 'asdf:prepare-source-op component)
        (%asdf-define-dependency component)))

(defmethod asdf:component-depends-on
    ((operation asdf:test-op) (component asdf:system))
  (list (list 'asdf:load-op component) (%asdf-define-dependency component)))

(defmethod asdf:component-depends-on
    ((operation asdf:load-op) (component asdf:source-file))
  (list (list 'asdf:prepare-op component) (list 'asdf:compile-op component)))

(defmethod asdf:component-depends-on
    ((operation asdf:compile-op) (component asdf:source-file))
  (list (list 'asdf:prepare-op component)))

(defmethod asdf:component-depends-on
    ((operation asdf:load-source-op) (component asdf:source-file))
  (list (list 'asdf:prepare-source-op component)))

(defgeneric asdf:additional-input-files (operation component))

(defmethod asdf:additional-input-files (operation component)
  (declare (ignore operation component))
  nil)

(defgeneric asdf:needed-in-image-p (operation component))

(defmethod asdf:needed-in-image-p (operation component)
  (declare (ignore operation component))
  t)

(defgeneric asdf:perform-with-restarts (operation component))

(defmethod asdf:perform-with-restarts (operation component)
  (asdf:perform operation component))

(defgeneric asdf:action-description (operation component))

(defmethod asdf:action-description (operation component)
  (format nil "~a on ~a" (class-name (class-of (%asdf-operation operation)))
          (asdf:component-name component)))

;; One component's actions, in plan order. Between prepare-op and compile-op
;; come the actions an extension's class adds on the component itself (the
;; %asdf-perform-build-actions seam: cffi-grovel's process-op, which writes the file
;; the component's compile-op reads). An image performs them; a compiled program
;; performs none, its build having done them.
(defun %asdf-perform-component (system-name index)
  (let ((component (%asdf-planned-component system-name index)))
    (asdf:perform (asdf:make-operation 'asdf:prepare-op) component)
    (%asdf-perform-build-actions component)
    (asdf:perform (asdf:make-operation 'asdf:compile-op) component)
    (asdf:perform (asdf:make-operation 'asdf:load-op) component)
    nil))

;; The system's own actions: prepare-op before its components (:before),
;; compile-op and load-op after them (:after).
(defun %asdf-perform-system (system-name phase)
  (let ((system (asdf:find-system system-name)))
    (if (eq phase :before)
        (asdf:perform (asdf:make-operation 'asdf:prepare-op) system)
        (progn
          (asdf:perform (asdf:make-operation 'asdf:compile-op) system)
          (asdf:perform (asdf:make-operation 'asdf:load-op) system)))
    nil))

(defun asdf:operate (operation component &rest keys)
  (let ((op (%asdf-operation operation)))
    (cond ((or (typep op 'asdf:load-op) (typep op 'asdf:load-source-op))
           (apply #'asdf:load-system component keys))
          ((typep op 'asdf:test-op) (%asdf-test component))
          ((typep op 'asdf:build-op) (apply #'asdf:make component keys))
          (t (error "ASDF:OPERATE: ~a is not supported: a system is loaded from source with LOAD-OP and tested with TEST-OP"
                    (class-name (class-of op)))))
    op))

(defun asdf:oos (operation component &rest keys)
  (apply #'asdf:operate operation component keys))

;; compile-op has nothing to produce here, so operate refuses it by name.
(defun asdf:compile-system (system &rest keys)
  (apply #'asdf:operate 'asdf:compile-op system keys)
  t)

(defun asdf:load-systems* (systems &rest keys)
  (dolist (system systems) (apply #'asdf:load-system system keys))
  nil)

(defun asdf:load-systems (&rest systems) (asdf:load-systems* systems))

(defun asdf:require-system (system &rest keys)
  (apply #'asdf:load-system system keys)
  nil)

;; Whether a :build-operation names what this ASDF does: load the system.
(defun %asdf-load-op-name-p (operation)
  (let* ((name (string-upcase (string operation)))
         (colon (position #\: name :from-end t))
         (member (if colon (subseq name (+ colon 1)) name)))
    (or (string= member "LOAD-OP") (string= member "LOAD-SOURCE-OP"))))

;; build-op is the system's :build-operation, by default load-op. Any other one
;; builds something: an image is not dumped here, so it is refused by name.
(defun asdf:make (system &rest keys)
  (let ((build (asdf::component-build-operation (asdf:find-system system))))
    (if (and build (not (%asdf-load-op-name-p build)))
        (error "ASDF:MAKE: ~a is not supported: a system is loaded from source with LOAD-OP and tested with TEST-OP"
               build)
        (apply #'asdf:load-system system keys))
    t))

;; Load the definitions in a .asd; a file that is not there defines nothing, as
;; in real ASDF. On a compile path a literal top-level call was consumed while
;; splicing and any other one is the run-time load the seam refuses.
(defun asdf:load-asd (pathname &key name)
  (declare (ignore name))
  (dolist (defined (%asdf-load-asd (namestring pathname)))
    (when %asdf-instances% (remhash defined %asdf-instances%)))
  (asdf:make-operation 'asdf:define-op))

;; test-op on a system: load it, test every system its :in-order-to test-op
;; wiring names first, then perform test-op on it. Each system once per
;; test-system call, so a cyclic chain terminates.
(defvar %asdf-tested% nil)

(defun %asdf-test (system)
  (let ((%asdf-tested% nil)) (%asdf-test-closure (asdf:coerce-name system))))

(defun %asdf-test-closure (key)
  (unless (member key %asdf-tested% :test #'equal)
    (setq %asdf-tested% (cons key %asdf-tested%))
    (asdf:load-system key)
    (dolist (edge (%asdf-test-op-edges key)) (%asdf-test-closure edge))
    (asdf:perform (asdf:make-operation 'asdf:test-op) (asdf:find-system key))))

(defun asdf:test-system (system &rest keys)
  (declare (ignore keys))
  (asdf:operate 'asdf:test-op system)
  t)
