package local:uni;

// The unified WASI 0.3 (Preview 3) import surface for rontolisp's component output.
// Imports only: the wasi:cli/run@0.3.0 export is wired by WasmComponentBuilder (its async
// signature is not expressible through `wasm-tools component new`). The interface order
// fixes the component instance indices WasmComponentBuilder.build assumes, so it must not
// change; new interfaces are appended LAST.
world uni {
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stdin@0.3.0;
  import wasi:cli/environment@0.3.0;
  import wasi:clocks/system-clock@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:filesystem/types@0.3.0;
  import wasi:filesystem/preopens@0.3.0;
  import wasi:random/random@0.3.0;
}
