package local:uni;

// The import surface for rontolisp's component output WHEN THE PROGRAM USES rontolisp:fetch.
//
// It is the base WASI 0.3 surface (uni.wit) PLUS the WASI 0.2 HTTP machinery. fetch stays
// on wasi:http@0.2 because an async (stream<u8>/future<T>) wasi:http@0.3 does not exist
// upstream yet (the wasi-http repo's v0.3.0-rc tags and main are still wasi:http@0.2.x).
// See ../../TODO.md. The base I/O is unchanged WASI 0.3; only the http body streaming and
// the outgoing-request machinery are WASI 0.2 (driven synchronously by pollable.block in
// adapter-http.wat).
//
// The interface order here, together with wasm-tools' dependency ordering, fixes the
// component import-instance indices that WasmComponentBuilder.buildHttp assumes. Appending
// the 0.2 http interfaces pulls in wasi:io@0.2 / wasi:cli@0.2 / wasi:clocks@0.2 /
// wasi:random@0.2 instances, so the buildHttp indices are independent of build() and must
// be re-derived from a fresh `wasm-tools dump`.
world uni-http {
  // --- base I/O: WASI 0.3 (same set as uni.wit) ---
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stdin@0.3.0;
  import wasi:cli/environment@0.3.0;
  import wasi:clocks/system-clock@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:filesystem/types@0.3.0;
  import wasi:filesystem/preopens@0.3.0;
  import wasi:random/random@0.3.0;
  // --- outgoing HTTP (rontolisp:fetch): WASI 0.2 ---
  import wasi:io/poll@0.2.0;
  import wasi:io/streams@0.2.0;
  import wasi:http/types@0.2.0;
  import wasi:http/outgoing-handler@0.2.0;
}
