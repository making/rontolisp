package local:uni;

// The import surface for rontolisp's component output WHEN THE PROGRAM USES a
// rontolisp:tcp-* built-in.
//
// It is the base WASI 0.3 surface (uni.wit) PLUS wasi:sockets/types@0.3.0 -- unlike
// fetch (which is a 0.2 hybrid, see uni-http.wit), sockets exist natively in WASI 0.3
// and wasmtime 46 hosts them (-S tcp=y -S inherit-network=y), so the sockets variant
// stays pure 0.3: the tcp-socket send/receive plumbing flows through the same built-in
// stream<u8> machinery as the base I/O.
//
// The interface order here fixes the component import-instance indices that
// WasmComponentBuilder.buildSock assumes: the base instances 0-8 keep the uni.wit
// order, wasi:sockets/types is appended LAST (instance 9). After editing, run regen.sh
// and re-derive the buildSock constants from a fresh `wasm-tools dump`.
world uni-sock {
  // --- base I/O: WASI 0.3 (same set as uni.wit) ---
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stdin@0.3.0;
  import wasi:cli/environment@0.3.0;
  import wasi:clocks/system-clock@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:filesystem/types@0.3.0;
  import wasi:filesystem/preopens@0.3.0;
  import wasi:random/random@0.3.0;
  // --- TCP sockets (rontolisp:tcp-*): WASI 0.3 ---
  import wasi:sockets/types@0.3.0;
  // --- stderr for warn (fd 2), appended last ---
  import wasi:cli/stderr@0.3.0;
}
