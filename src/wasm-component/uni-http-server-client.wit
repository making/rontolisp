package local:uni;

// The import surface for rontolisp's component output WHEN THE PROGRAM USES BOTH
// rontolisp:http-handler AND rontolisp:fetch (a proxy-style serve component that makes
// outgoing requests from inside a served handler).
//
// It is the uni-http-server surface (see uni-http-server.wit) PLUS the outgoing-request machinery of
// wasi:http@0.2: wasi:io/poll (fetch-await blocks on the response pollable) and
// wasi:http/outgoing-handler. wasi:http/types and wasi:io/streams are already imported by
// the serve surface; only the members used additionally by fetch (outgoing-request
// setters, future-incoming-response, incoming-response) enlarge their trimmed instance
// types (core-http-server-client.wat determines the trimming). The whole surface stays inside the
// wasi:http proxy world, so any host that serves the plain serve variant can also run
// this one (outbound permission flags aside, e.g. `wasmtime serve -S http=y`).
//
// The interface order fixes the component import-instance indices buildServeHttp assumes;
// append new interfaces LAST. Re-derive the buildServeHttp constants from a fresh
// `wasm-tools dump` after changing this file or core-http-server-client.wat.
world uni-http-server-client {
  import wasi:http/types@0.2.0;
  import wasi:io/streams@0.2.0;
  import wasi:random/random@0.2.0;
  import wasi:clocks/wall-clock@0.2.0;
  import wasi:clocks/monotonic-clock@0.2.0;
  import wasi:cli/stdout@0.2.0;
  import wasi:cli/stderr@0.2.0;
  import wasi:io/poll@0.2.0;
  import wasi:http/outgoing-handler@0.2.0;
}
