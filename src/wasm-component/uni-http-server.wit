package local:uni;

// The import surface for rontolisp's component output WHEN THE PROGRAM USES
// rontolisp:http-handler (compile to a wasi:http@0.3.0 handler component runnable under
// `wasmtime serve`). ONE world serves plain serve AND serve+fetch: in 0.3 the `service`
// world always imports `client`, so the 0.2-era narrow/wide split is gone -- a handler
// that never fetches simply never calls `send`.
//
// Alongside the wasi:http machinery http.lisp drives, it imports the entropy / clock /
// stdio interfaces of the service world, which the preview1 bridge
// (adapter-http-server-p1.wat) maps to the rontolisp core's wasi_snapshot_preview1
// imports so random / time / print work inside a served handler. The
// wasi:http/handler@0.3.0 EXPORT is emitted programmatically by
// WasmServeComponentBuilder (like the `run` export of the other variants), so it is not
// declared here; this world is imports-only.
//
// The interface order fixes the component import-instance indices the builder assumes;
// append new interfaces LAST. Re-derive the builder constants from a fresh
// `wasm-tools dump` after changing this file or core-http-server.wat.
world uni-http-server {
  import wasi:http/types@0.3.0;
  import wasi:http/client@0.3.0;
  import wasi:random/random@0.3.0;
  import wasi:clocks/system-clock@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stderr@0.3.0;
}
