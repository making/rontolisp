<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.example</groupId>
	<artifactId>spin-postgres</artifactId>
	<version>1.0.0-SNAPSHOT</version>

	<!--
		target/spin-postgres.wasm, a component for `spin up` (spin.toml): a servlet keeping
		notes in PostgreSQL through plain JDBC. jdbc-spin-postgres is the driver the
		component is compiled with: its connections are Spin's spin:postgres/postgres.
		jdbc-postgresql is a runtime dependency, which the wasm goal leaves out: `mvn
		exec:exec` runs the same classes on a JDK, where no host implements the interface
		and DriverManager goes on to the socket driver.
	-->

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<rontolisp.version>0.1.0-SNAPSHOT</rontolisp.version>
		<rontolisp.mainClass>com.example.notes.App</rontolisp.mainClass>
		<servlet-httpserver.version>0.1.0-SNAPSHOT</servlet-httpserver.version>
		<jdbc-spin-postgres.version>0.1.0-SNAPSHOT</jdbc-spin-postgres.version>
		<jdbc-postgresql.version>0.1.0-SNAPSHOT</jdbc-postgresql.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>am.ik.servlet</groupId>
			<artifactId>servlet-httpserver</artifactId>
			<version>${servlet-httpserver.version}</version>
		</dependency>
		<dependency>
			<groupId>am.ik.jdbc</groupId>
			<artifactId>jdbc-spin-postgres</artifactId>
			<version>${jdbc-spin-postgres.version}</version>
		</dependency>
		<dependency>
			<groupId>am.ik.jdbc</groupId>
			<artifactId>jdbc-postgresql</artifactId>
			<version>${jdbc-postgresql.version}</version>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<!-- The SNAPSHOTs: the plugin, the rontolisp it embeds and this repository's modules. -->
	<repositories>
		<repository>
			<id>central-snapshots</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
	<pluginRepositories>
		<pluginRepository>
			<id>central-snapshots</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.4.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.5.0</version>
			</plugin>
			<plugin>
				<groupId>am.ik.rontolisp</groupId>
				<artifactId>rontolisp-maven-plugin</artifactId>
				<version>${rontolisp.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>wasm</goal>
						</goals>
						<configuration>
							<component>true</component>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
				`mvn exec:exec`: the main class on the JDK running Maven, with the runtime class
				path (the socket driver included) and the environment Maven has.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.3</version>
				<configuration>
					<executable>${java.home}/bin/java</executable>
					<classpathScope>runtime</classpathScope>
					<arguments>
						<argument>-classpath</argument>
						<classpath/>
						<argument>${rontolisp.mainClass}</argument>
					</arguments>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
