<section class="form-page">
  <p class="crumbs"><a href="/books">本棚</a> ＞ {{heading}}</p>
  <form class="book-form" method="post" action="{{action}}" data-spine="{{spine-json}}" novalidate>
    <div class="stand preview" aria-hidden="true">
      {{#form}}<span class="spine" style="{{spine}}"><span class="spine-title">{{title}}</span><span class="spine-author">{{author}}</span></span>{{/form}}
    </div>

    <div class="card">
      <h1 class="card-title">{{heading}}</h1>
      {{#errors}}
      <div class="error-summary" role="alert">
        <p>入力を確かめてください。</p>
        <ul>{{#error-list}}<li>{{message}}</li>{{/error-list}}</ul>
      </div>
      {{/errors}}

      <div class="card-rows">
        {{#form}}
        <div class="row{{#errors.title}} invalid{{/errors.title}}">
          <label for="f-title">書名</label>
          <div><input id="f-title" name="title" value="{{title}}" maxlength="200" required autofocus>
          {{#errors.title}}<p class="field-error">{{errors.title}}</p>{{/errors.title}}</div>
        </div>
        <div class="row{{#errors.author}} invalid{{/errors.author}}">
          <label for="f-author">著者</label>
          <div><input id="f-author" name="author" value="{{author}}" maxlength="200" required>
          {{#errors.author}}<p class="field-error">{{errors.author}}</p>{{/errors.author}}</div>
        </div>
        <div class="row{{#errors.pages}} invalid{{/errors.pages}}">
          <label for="f-pages">頁数</label>
          <div><input id="f-pages" name="pages" type="number" min="1" value="{{pages}}" inputmode="numeric">
          {{#errors.pages}}<p class="field-error">{{errors.pages}}</p>{{/errors.pages}}</div>
        </div>
        <div class="row{{#errors.current-page}} invalid{{/errors.current-page}}">
          <label for="f-current">読んだ頁</label>
          <div><input id="f-current" name="current_page" type="number" min="0" value="{{current-page}}" inputmode="numeric">
          {{#errors.current-page}}<p class="field-error">{{errors.current-page}}</p>{{/errors.current-page}}</div>
        </div>
        {{/form}}
        <div class="row" role="radiogroup" aria-labelledby="l-status">
          <span class="label" id="l-status">状態</span>
          <div class="choices">
            {{#status-options}}<label><input type="radio" name="status" value="{{value}}" {{#checked}}checked{{/checked}}><span>{{label}}</span></label>{{/status-options}}
            {{#errors.status}}<p class="field-error">{{errors.status}}</p>{{/errors.status}}
          </div>
        </div>
        <div class="row" role="radiogroup" aria-labelledby="l-rating">
          <span class="label" id="l-rating">評価</span>
          <div class="rating-input">
            {{#rating-options}}<input type="radio" id="r{{n}}" name="rating" value="{{n}}" {{#checked}}checked{{/checked}}><label for="r{{n}}" aria-label="{{n}}つ星">★</label>{{/rating-options}}
            <input type="radio" id="r0" name="rating" value="" class="rating-none"><label for="r0" class="rating-none-label">つけない</label>
            {{#errors.rating}}<p class="field-error">{{errors.rating}}</p>{{/errors.rating}}
          </div>
        </div>
        {{#form}}
        <div class="row{{#errors.started-on}} invalid{{/errors.started-on}}">
          <label for="f-started">読み始め</label>
          <div><input id="f-started" name="started_on" type="date" value="{{started-on}}">
          {{#errors.started-on}}<p class="field-error">{{errors.started-on}}</p>{{/errors.started-on}}</div>
        </div>
        <div class="row{{#errors.finished-on}} invalid{{/errors.finished-on}}">
          <label for="f-finished">読み終わり</label>
          <div><input id="f-finished" name="finished_on" type="date" value="{{finished-on}}">
          {{#errors.finished-on}}<p class="field-error">{{errors.finished-on}}</p>{{/errors.finished-on}}</div>
        </div>
        <div class="row">
          <label for="f-tags">索引</label>
          <div><input id="f-tags" name="tags" value="{{tags}}" placeholder="小説, 日本文学">
          <p class="field-hint">読点ではなくカンマで区切ります。</p></div>
        </div>
        <div class="row">
          <label for="f-summary">感想</label>
          <div><textarea id="f-summary" name="summary" rows="4">{{summary}}</textarea></div>
        </div>
        {{/form}}
      </div>

      <div class="card-actions">
        <button class="button primary" type="submit">{{#editing}}変更を保存{{/editing}}{{^editing}}本棚に加える{{/editing}}</button>
        <a class="button quiet" href="{{cancel}}">やめる</a>
      </div>
    </div>
  </form>
</section>
