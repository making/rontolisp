(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (type $ft (func))
  (type $ct (cont $ft))
  (type $box (struct (field (mut i32))))
  (type $arr (array (mut i32)))
  (tag $yield)
  (tag $err (param i32))
  (global $n (mut i32) (i32.const 0))
  (memory (export "memory") 1)
  (func $deep (param $d i32) (param $mine (ref $box))
    (if (i32.eqz (local.get $d))
      (then (suspend $yield))
      (else (call $deep (i32.sub (local.get $d) (i32.const 1)) (local.get $mine))))
    (global.set $n (i32.add (global.get $n) (struct.get $box 0 (local.get $mine)))))
  (func $worker (type $ft)
    (local $i i32)
    (loop $l
      (call $deep (i32.const 20) (struct.new $box (i32.const 1)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (i32.const 1000000))))
    ;; an exception out of a continuation reaches the resume's stack
    (throw $err (i32.const 5)))
  (elem declare func $worker)
  (func (export "_start")
    (local $k (ref null $ct)) (local $j i32) (local $junk (ref null $arr))
    (local.set $k (cont.new $ct (ref.func $worker)))
    (block $caught (result i32)
      (try_table (catch $err $caught)
        (block $done
          (loop $again
            (block $on (result (ref $ct))
              (resume $ct (on $yield $on) (local.get $k))
              (br $done))
            (local.set $k)
            ;; garbage between the switches: the suspended stack's box has to survive
            (local.set $junk (array.new $arr (i32.const 0) (i32.const 64)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $again))))
      (i32.const 0))
    (i32.add (i32.rem_u (global.get $n) (i32.const 100)))
    (call $exit)))
