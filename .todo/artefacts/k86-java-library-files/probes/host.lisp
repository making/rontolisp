;; What the host layer answers for the file operations a Java program needs, on each
;; backend. Run where locked.txt (mode 000) and ro/ (mode 555) were made beforehand.
(defun try-open (label thunk)
  (let ((s (handler-case (funcall thunk) (file-error (c) (list :file-error)) (error (c) (list :error (princ-to-string c))))))
    (if (streamp s)
        (progn (close s) (format t "~a: opened~%" label))
        (format t "~a: ~s~%" label s))))

(format t "probe missing ~s~%" (%probe-file "nothing.txt"))
(%make-directories "t/")
(format t "probe dir ~s ~s~%" (%probe-file "t") (%probe-file "t/"))
(with-open-file (s "t/f.bin" :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
  (write-sequence (make-array 5 :element-type '(unsigned-byte 8) :initial-contents '(1 2 200 255 0)) s))
(format t "probe file ~s ~s~%" (%probe-file "t/f.bin") (%probe-file "t/f.bin/"))
(format t "probe under file ~s~%" (%probe-file "t/f.bin/x"))
(try-open "in missing" (lambda () (open "t/missing" :element-type '(unsigned-byte 8))))
(try-open "in dir" (lambda () (open "t" :element-type '(unsigned-byte 8))))
(try-open "in under file" (lambda () (open "t/f.bin/x" :element-type '(unsigned-byte 8))))
(try-open "in locked" (lambda () (open "locked.txt" :element-type '(unsigned-byte 8))))
(try-open "in empty" (lambda () (open "" :element-type '(unsigned-byte 8))))
(try-open "out dir" (lambda () (open "t" :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)))
(try-open "out missing dir" (lambda () (open "t/nope/x" :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)))
(try-open "out locked" (lambda () (open "locked.txt" :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)))
(try-open "out ro" (lambda () (open "ro/x" :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)))
(try-open "append locked" (lambda () (open "locked.txt" :direction :output :element-type '(unsigned-byte 8) :if-exists :append)))
(try-open "io missing" (lambda () (open "t/io.bin" :direction :io :element-type '(unsigned-byte 8) :if-exists :overwrite :if-does-not-exist :create)))
(with-open-file (s "t/f.bin" :element-type '(unsigned-byte 8))
  (let ((buf (make-array 8 :element-type '(unsigned-byte 8) :initial-element 7)))
    (format t "read-sequence ~s ~s~%" (read-sequence buf s :start 1 :end 4) buf)
    (format t "position ~s length ~s~%" (file-position s) (file-length s))
    (file-position s 4)
    (format t "after seek ~s ~s~%" (read-byte s nil -1) (read-byte s nil -1))
    (file-position s 1)
    (format t "after seek back ~s ~s~%" (read-byte s nil -1) (file-position s))
    (format t "read-sequence at end ~s~%" (progn (file-position s 5) (read-sequence buf s)))))
(with-open-file (s "t/f.bin" :direction :io :element-type '(unsigned-byte 8) :if-exists :overwrite)
  (file-position s 2)
  (write-byte 9 s)
  (format t "io position ~s length ~s~%" (file-position s) (file-length s))
  (file-position s 0)
  (format t "io read ~s ~s ~s~%" (read-byte s nil -1) (read-byte s nil -1) (read-byte s nil -1))
  (file-position s 10)
  (write-byte 4 s)
  (format t "io past end length ~s~%" (file-length s)))
(with-open-file (s "t/f.bin" :element-type '(unsigned-byte 8))
  (let ((buf (make-array 20 :element-type '(unsigned-byte 8) :initial-element 7)))
    (format t "contents ~s ~s~%" (read-sequence buf s) buf)))
(with-open-file (s "t/f.bin" :direction :output :element-type '(unsigned-byte 8) :if-exists :append)
  (format t "append position ~s~%" (file-position s))
  (write-byte 1 s))
(with-open-file (s "t/f.bin" :element-type '(unsigned-byte 8))
  (format t "after append length ~s~%" (file-length s)))
(format t "write date ~s~%" (> (file-write-date "t/f.bin") 3900000000))
(%make-directories "t/l/")
(dolist (n '("b" "a" "c" "10" "9" "B" ".dot"))
  (with-open-file (s (concatenate 'string "t/l/" n) :direction :output :if-exists :supersede :if-does-not-exist :create)
    nil))
(format t "make l ~s~%" (%probe-file "t/l"))
(%make-directories "t/l/dir/")
(format t "list ~s~%" (%list-directory "t/l/"))
(format t "list file ~s missing ~s~%" (%list-directory "t/f.bin/") (%list-directory "t/none/"))
(format t "make dirs again ~s~%" (%make-directories "t/l/dir/"))
(format t "make dirs under file ~s~%" (%make-directories "t/f.bin/x/"))
(format t "make dirs ro ~s~%" (%make-directories "ro/x/"))
(format t "delete missing ~s~%" (%delete-file "t/l/none"))
(format t "delete non-empty ~s~%" (%delete-file "t/l"))
(format t "delete empty dir ~s~%" (%delete-file "t/l/dir"))
(format t "delete file ~s~%" (%delete-file "t/l/a"))
(format t "rename ~s~%" (%rename-file "t/l/b" "t/l/b2"))
(format t "rename onto existing ~s~%" (%rename-file "t/l/b2" "t/l/c"))
(format t "rename missing ~s~%" (%rename-file "t/l/none" "t/l/x"))
(format t "rename into missing ~s~%" (%rename-file "t/l/c" "t/nope/c"))
(format t "list after ~s~%" (%list-directory "t/l/"))
(format t "cwd ~s~%" (%host-getcwd))
(format t "real ~s~%" (%real-path "t/./l/../f.bin"))
(format t "truename ~s~%" (ignore-errors (truename "t/./l/../f.bin")))
