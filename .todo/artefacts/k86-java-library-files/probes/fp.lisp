(with-open-file (out "fp.bin" :direction :output :if-exists :supersede
                      :element-type '(unsigned-byte 8))
  (dotimes (i 10) (write-byte i out))
  (print (file-position out)))
(with-open-file (in "fp.bin" :element-type '(unsigned-byte 8))
  (print (file-position in))
  (print (read-byte in))
  (print (file-position in))
  (print (file-position in 5))
  (print (file-position in))
  (print (read-byte in))
  (print (file-position in))
  (file-position in 9)
  (print (list (read-byte in) (read-byte in nil -1) (read-byte in nil -1)))
  (print (file-position in)))
(with-open-file (in "fp.bin")
  (print (file-position in)))
