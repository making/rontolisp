;; Seeking past the end of an input and of an :io stream, then reading and writing there.
(with-open-file (s "s.bin" :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
  (write-byte 1 s) (write-byte 2 s))
(with-open-file (s "s.bin" :element-type '(unsigned-byte 8))
  (format t "seek ~s~%" (file-position s 10))
  (format t "at ~s read ~s length ~s~%" (file-position s) (read-byte s nil -1) (file-length s))
  (file-position s 1)
  (format t "back ~s~%" (read-byte s nil -1)))
(with-open-file (s "s.bin" :direction :io :element-type '(unsigned-byte 8) :if-exists :overwrite)
  (format t "io seek ~s~%" (file-position s 5))
  (write-byte 9 s)
  (format t "io length ~s~%" (file-length s))
  (file-position s 0)
  (let ((buf (make-array 8 :element-type '(unsigned-byte 8) :initial-element 7)))
    (format t "io read ~s ~s~%" (read-sequence buf s) buf)))
