;; Reading again at the end, with and without a seek between, and a file that grew.
(with-open-file (s "e.bin" :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
  (write-byte 1 s))
(with-open-file (s "e.bin" :element-type '(unsigned-byte 8))
  (format t "~s ~s~%" (read-byte s nil -1) (read-byte s nil -1))
  (format t "again ~s~%" (read-byte s nil -1))
  (let ((buf (make-array 4 :element-type '(unsigned-byte 8))))
    (format t "sequence ~s ~s~%" (read-sequence buf s) (read-sequence buf s))
    (with-open-file (o "e.bin" :direction :output :element-type '(unsigned-byte 8) :if-exists :append)
      (write-byte 2 o))
    (format t "length now ~s at ~s~%" (file-length s) (file-position s))
    (format t "grown ~s~%" (read-byte s nil -1))
    (file-position s 0)
    (format t "after seek ~s ~s ~s~%" (read-byte s nil -1) (read-byte s nil -1) (read-byte s nil -1))))
