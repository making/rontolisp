;; bottom-up merge sort over two (unsigned-byte 32) vectors
(defun merge-pass (src dst n width)
  (declare (type (simple-array (unsigned-byte 32) (*)) src dst))
  (let ((lo 0))
    (loop while (< lo n)
          do (let* ((mid (min n (+ lo width)))
                    (hi (min n (+ mid width)))
                    (i lo) (j mid) (k lo))
               (loop while (and (< i mid) (< j hi))
                     do (let ((x (aref src i)) (y (aref src j)))
                          (if (< y x)
                              (progn (setf (aref dst k) y) (setq j (+ j 1)))
                              (progn (setf (aref dst k) x) (setq i (+ i 1))))
                          (setq k (+ k 1))))
               (loop while (< i mid)
                     do (setf (aref dst k) (aref src i)) (setq i (+ i 1)) (setq k (+ k 1)))
               (loop while (< j hi)
                     do (setf (aref dst k) (aref src j)) (setq j (+ j 1)) (setq k (+ k 1)))
               (setq lo hi)))))

(defun sort-u32 (a n)
  (declare (type (simple-array (unsigned-byte 32) (*)) a))
  (let ((b (make-array n :element-type '(unsigned-byte 32)))
        (width 1) (src a) (dst nil))
    (declare (type (simple-array (unsigned-byte 32) (*)) b))
    (setq dst b)
    (loop while (< width n)
          do (merge-pass src dst n width)
             (let ((tmp src)) (setq src dst) (setq dst tmp))
             (setq width (* width 2)))
    src))

(defun run (n rounds)
  (let ((xs (make-array n :element-type '(unsigned-byte 32)))
        (x 12345) (total 0))
    (dotimes (i n)
      (setq x (mod (+ (* x 1103515245) 12345) 2147483648))
      (setf (aref xs i) (mod x 100000)))
    (dotimes (r rounds)
      (let ((a (make-array n :element-type '(unsigned-byte 32))))
        (dotimes (i n) (setf (aref a i) (aref xs i)))
        (let ((s (sort-u32 a n)))
          (setq total (+ total (aref s r) (aref s (- n 1 r)))))))
    total))
(print (run 50000 96))
