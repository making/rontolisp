;; bottom-up merge sort over two (unsigned-byte 32) vectors, every index masked so its range is known
(defun merge-pass (src dst n0 width0)
  (declare (type (simple-array (unsigned-byte 32) (*)) src dst))
  (let ((n (logand n0 1073741823)) (width (logand width0 1073741823)) (lo 0))
    (loop while (< lo n)
          do (let* ((mid (logand (min n (+ lo width)) 1073741823))
                    (hi (logand (min n (+ mid width)) 1073741823))
                    (i lo) (j mid) (k lo))
               (loop while (and (< i mid) (< j hi))
                     do (if (< (aref src j) (aref src i))
                            (progn (setf (aref dst k) (aref src j)) (setq j (logand (+ j 1) 1073741823)))
                            (progn (setf (aref dst k) (aref src i)) (setq i (logand (+ i 1) 1073741823))))
                        (setq k (logand (+ k 1) 1073741823)))
               (loop while (< i mid)
                     do (setf (aref dst k) (aref src i)) (setq i (logand (+ i 1) 1073741823)) (setq k (logand (+ k 1) 1073741823)))
               (loop while (< j hi)
                     do (setf (aref dst k) (aref src j)) (setq j (logand (+ j 1) 1073741823)) (setq k (logand (+ k 1) 1073741823)))
               (setq lo hi)))))

(defun sort-u32 (a n)
  (declare (type (simple-array (unsigned-byte 32) (*)) a))
  (let ((b (make-array n :element-type '(unsigned-byte 32)))
        (width 1) (src a) (dst nil))
    (declare (type (simple-array (unsigned-byte 32) (*)) b))
    (setq dst b)
    (loop while (< width n)
          do (merge-pass src dst n width)
             (let ((tmp src)) (setq src dst) (setq dst tmp))
             (setq width (* width 2)))
    src))

(defun run (n rounds)
  (let ((xs (make-array n :element-type '(unsigned-byte 32)))
        (x 12345) (total 0))
    (dotimes (i n)
      (setq x (mod (+ (* x 1103515245) 12345) 2147483648))
      (setf (aref xs i) (mod x 100000)))
    (dotimes (r rounds)
      (let ((a (make-array n :element-type '(unsigned-byte 32))))
        (dotimes (i n) (setf (aref a i) (aref xs i)))
        (let ((s (sort-u32 a n)))
          (setq total (+ total (aref s r) (aref s (- n 1 r)))))))
    total))
(print (run 50000 96))
