(defvar *items* nil)
(defvar *count* 0)
(defvar *held* 0)
(rontolisp:async-defun put (n)
  (setq *held* (+ *held* 1))
  (unwind-protect
      (progn
        (while (= *count* 2) (rontolisp:await (rontolisp:wait-for 1)))
        (setq *items* (append *items* (list n)))
        (setq *count* (+ *count* 1)))
    (setq *held* (- *held* 1))))
(rontolisp:async-defun take ()
  (setq *held* (+ *held* 1))
  (unwind-protect
      (progn
        (while (= *count* 0) (rontolisp:await (rontolisp:wait-for 1)))
        (let ((n (car *items*)))
          (setq *items* (cdr *items*))
          (setq *count* (- *count* 1))
          n))
    (setq *held* (- *held* 1))))
(rontolisp:async-defun producer (rounds)
  (handler-case
      (let ((i 0))
        (while (< i rounds)
          (rontolisp:await (put (* i i)))
          (setq i (+ i 1)))
        (error "done producing"))
    (error (c) (format t "producer: ~a~%" c))))
(rontolisp:async-defun consume (rounds)
  (let ((p (producer rounds)) (sum 0) (i 0))
    (while (< i rounds)
      (setq sum (+ sum (rontolisp:await (take))))
      (setq i (+ i 1)))
    (rontolisp:await p)
    sum))
(print (rontolisp:await (consume 10)))
(print *held*)
