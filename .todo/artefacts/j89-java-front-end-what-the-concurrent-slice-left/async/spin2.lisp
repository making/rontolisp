(defvar *count* 0)
(defvar *polls* 0)
(rontolisp:async-defun put ()
  (while (= *count* 1) (rontolisp:await (rontolisp:wait-for 0)))
  (setq *count* (+ *count* 1)))
(rontolisp:async-defun producer ()
  (rontolisp:await (put))
  (rontolisp:await (put))
  (print :produced))
(rontolisp:async-defun take ()
  (while (= *count* 0)
    (setq *polls* (+ *polls* 1))
    (if (= *polls* 5) (progn (print :starved) (finish-output) (error "starved")))
    (rontolisp:await (rontolisp:wait-for 0)))
  (setq *count* (- *count* 1)))
(rontolisp:async-defun consume ()
  (let ((p (producer)))
    (rontolisp:await (take))
    (rontolisp:await (take))
    (rontolisp:await p)
    :done))
(print (rontolisp:await (consume)))
