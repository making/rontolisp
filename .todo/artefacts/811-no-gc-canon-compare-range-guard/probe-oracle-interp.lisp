;;;; Interpreter-vs-wasmtime oracle: the probe-exp bodies driven from inside the
;;;; program on in-range values (the export wrappers themselves are host-only).
(defun id-s8 (x) x)
(defun id-s16 (x) x)
(defun id-s32 (x) x)
(defun id-u8 (x) x)
(defun id-u16 (x) x)
(defun id-u32 (x) x)
(defun id-u64 (x) x)
(defun run ()
  (princ (id-s8 -128)) (princ " ") (princ (id-s8 127)) (princ " ") (princ (id-s8 0)) (princ " ")
  (princ (id-s8 1)) (princ " ") (princ (id-s8 -1)) (terpri)
  (princ (id-s16 -32768)) (princ " ") (princ (id-s16 32767)) (princ " ") (princ (id-s16 -1)) (terpri)
  (princ (id-s32 -2147483648)) (princ " ") (princ (id-s32 2147483647)) (princ " ") (princ (id-s32 -1)) (terpri)
  (princ (id-u8 0)) (princ " ") (princ (id-u8 255)) (terpri)
  (princ (id-u16 0)) (princ " ") (princ (id-u16 65535)) (terpri)
  (princ (id-u32 0)) (princ " ") (princ (id-u32 4294967295)) (terpri)
  (princ (id-u64 0)) (princ " ") (princ (id-u64 9223372036854775807)) (terpri))
(rontolisp:wasm-export 'id-s8 :as "id_s8" :params '(:s64) :returns :s8)
(rontolisp:wasm-export 'id-s16 :as "id_s16" :params '(:s64) :returns :s16)
(rontolisp:wasm-export 'id-s32 :as "id_s32" :params '(:s64) :returns :s32)
(rontolisp:wasm-export 'id-u8 :as "id_u8" :params '(:s64) :returns :u8)
(rontolisp:wasm-export 'id-u16 :as "id_u16" :params '(:s64) :returns :u16)
(rontolisp:wasm-export 'id-u32 :as "id_u32" :params '(:s64) :returns :u32)
(rontolisp:wasm-export 'id-u64 :as "id_u64" :params '(:s64) :returns :u64)
(rontolisp:wasm-export 'run :as "run" :params '() :returns nil)
(run)
