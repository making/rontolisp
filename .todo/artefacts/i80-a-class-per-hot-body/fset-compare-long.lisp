;; fset:compare on two symbols of one package (the image's inner step), timed per round;
;; prints the wall time the rounds start at, for a JFR window.
(defvar *t0* (get-internal-real-time))
(defun elapsed () (/ (- (get-internal-real-time) *t0*) (float internal-time-units-per-second)))
(ql:quickload "fset" :silent t)
(defpackage :compare-keys (:use))
(defvar *a* (intern "APPLY-SUBSTITUTION" :compare-keys))
(defvar *b* (intern "APPLY-KSUBSTITUTION" :compare-keys))
(defvar *c* (intern "TYPE-VARIABLES" :compare-keys))
(defvar *d* (intern "TYPE-PREDICATE" :compare-keys))
(defun compare-many (n)
  (let ((less 0))
    (dotimes (i n less)
      (when (eq (fset:compare *a* *b*) :less) (incf less))
      (when (eq (fset:compare *c* *d*) :less) (incf less)))))
(compare-many 20000)
(compare-many 20000)
(multiple-value-bind (s m h) (get-decoded-time)
  (format t "start ~2,'0D:~2,'0D:~2,'0D~%" h m s))
(dotimes (round 60)
  (let ((start (elapsed)))
    (let ((value (compare-many 20000)))
      (format t "compare ~,3F s ~A~%" (- (elapsed) start) value))))
