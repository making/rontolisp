;; Per-operation costs of the interpreter's compiled bodies: each probe loops N times in a
;; defun, timed over rounds; prints ns per iteration of the best round.
(defpackage :micro (:use :cl))
(in-package :micro)
(defun now () (/ (get-internal-real-time) (float internal-time-units-per-second)))
(defvar *sym-a* (intern "APPLY-SUBSTITUTION" :micro))
(defvar *sym-b* (intern "APPLY-KSUBSTITUTION" :micro))
(defun two (a b) (declare (ignore b)) a)
(defgeneric gf2 (a b))
(defmethod gf2 ((a symbol) (b symbol)) a)
(defmethod gf2 ((a string) (b string)) b)
(defmethod gf2 ((a integer) (b integer)) b)
(defun p-empty (n) (dotimes (i n) nil))
(defun p-add (n) (let ((x 0)) (dotimes (i n x) (setq x (+ x 1)))))
(defun p-call (n) (let ((x nil)) (dotimes (i n x) (setq x (two i n)))))
(defun p-eq (n) (let ((x 0)) (dotimes (i n x) (when (eq *sym-a* *sym-b*) (setq x 1)))))
(defun p-lexeq (n) (let ((x 0) (a *sym-a*) (b *sym-b*)) (dotimes (i n x) (when (eq a b) (setq x 1)))))
(defun p-pkg (n) (let ((x nil) (a *sym-a*)) (dotimes (i n x) (setq x (symbol-package a)))))
(defun p-name (n) (let ((x nil) (a *sym-a*)) (dotimes (i n x) (setq x (symbol-name a)))))
(defun p-gf (n) (let ((x nil) (a *sym-a*) (b *sym-b*)) (dotimes (i n x) (setq x (gf2 a b)))))
(defun early (k) (dotimes (i 10 :none) (when (= i k) (return :found))))
(defun p-return (n) (let ((x nil)) (dotimes (i n x) (setq x (early 0)))))
(defun p-noreturn (n) (let ((x nil)) (dotimes (i n x) (setq x (early 20)))))
(defun p-typecase (n)
  (let ((x nil) (s "abc"))
    (dotimes (i n x) (setq x (typecase s (simple-base-string 1) (string 2) (t 3))))))
(defun p-let (n) (let ((x 0)) (dotimes (i n x) (let ((y i)) (setq x y)))))
(defun p-schar (n) (let ((x nil) (s "APPLY-SUBSTITUTION")) (dotimes (i n x) (setq x (schar s 3)))))
(defun p-charlt (n) (let ((x nil) (a #\A) (b #\B)) (dotimes (i n x) (setq x (char< a b)))))
(defun p-fib (n) (if (< n 2) n (+ (p-fib (- n 1)) (p-fib (- n 2)))))
(defun probe (name fn n)
  (let ((best nil))
    (dotimes (round 8)
      (let ((start (now)))
        (funcall fn n)
        (let ((took (- (now) start)))
          (when (or (null best) (< took best)) (setq best took)))))
    (format t "~12A ~8,1F ns~%" name (/ (* best 1e9) n))))
(probe "empty" #'p-empty 1000000)
(probe "add" #'p-add 1000000)
(probe "call" #'p-call 1000000)
(probe "eq-free" #'p-eq 1000000)
(probe "eq-lex" #'p-lexeq 1000000)
(probe "symbol-pkg" #'p-pkg 1000000)
(probe "symbol-name" #'p-name 1000000)
(probe "gf2" #'p-gf 1000000)
(probe "return" #'p-return 200000)
(probe "noreturn" #'p-noreturn 200000)
(probe "typecase" #'p-typecase 200000)
(probe "let" #'p-let 1000000)
(probe "schar" #'p-schar 1000000)
(probe "char<" #'p-charlt 1000000)
(let ((best nil))
  (dotimes (round 5)
    (let ((start (now)))
      (p-fib 25)
      (let ((took (- (now) start)))
        (when (or (null best) (< took best)) (setq best took)))))
  (format t "~12A ~8,1F ns per call~%" "fib25" (/ (* best 1e9) 242785)))
