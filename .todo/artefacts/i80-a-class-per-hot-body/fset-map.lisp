;; fset map operations over symbol keys (coalton's environment updates), timed per round.
(defvar *t0* (get-internal-real-time))
(defun elapsed () (/ (- (get-internal-real-time) *t0*) (float internal-time-units-per-second)))
(ql:quickload "fset" :silent t)
(defpackage :map-keys (:use))
(defvar *keys* (loop for i below 500 collect (intern (format nil "KEY-~D" i) :map-keys)))
(defun build-map ()
  (let ((m (fset:empty-map)))
    (dolist (k *keys* m)
      (setq m (fset:with m k (symbol-name k))))))
(defun lookups (m)
  (let ((n 0))
    (dolist (k *keys* n)
      (when (fset:lookup m k) (incf n)))))
(defun image-map (m)
  (fset:image (lambda (k v) (values k (length v))) m))
(build-map)
(build-map)
(multiple-value-bind (s m h) (get-decoded-time)
  (format t "start ~2,'0D:~2,'0D:~2,'0D~%" h m s))
(dotimes (round 12)
  (let ((start (elapsed)))
    (let ((m nil) (n 0))
      (dotimes (i 10) (setq m (build-map)))
      (dotimes (i 10) (setq n (+ n (lookups m))))
      (dotimes (i 10) (image-map m))
      (format t "map ~,3F s ~A~%" (- (elapsed) start) n))))
