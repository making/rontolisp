(defvar *unused* (rontolisp::%future-new))
(defvar *held* 0)
(rontolisp:async-defun take (n)
  (setq *held* (+ *held* 1))
  (unwind-protect (+ n 1) (setq *held* (- *held* 1))))
(rontolisp:async-defun run (rounds)
  (let ((sum 0) (i 0))
    (while (< i rounds)
      (setq sum (logand (+ sum (rontolisp:await (take i))) 1073741823))
      (setq i (+ i 1)))
    sum))
(print (rontolisp:await (run 20000000)))
