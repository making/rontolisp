;; run queue of parked futures; a trampoline settles them one by one
(defvar *ready* nil)
(defvar *turn* 0)
(defvar *log* nil)
(defun park ()
  (let ((f (rontolisp::%future-new)))
    (setq *ready* (append *ready* (list f)))
    f))
(rontolisp:async-defun wait-turn (me)
  (while (not (= *turn* me))
    (rontolisp:await (park))))
(rontolisp:async-defun player (me rounds)
  (let ((i 0))
    (while (< i rounds)
      (unwind-protect
          (progn
            (rontolisp:await (wait-turn me))
            (format t "~a ~a~%" (if (= me 0) "ping" "pong") i)
            (setq *turn* (- 1 me)))
        (setq *log* (cons me *log*)))
      (setq i (+ i 1)))
    (* me 100)))
(defun run-all (futures)
  (while *ready*
    (let ((f (car *ready*)))
      (setq *ready* (cdr *ready*))
      (rontolisp::%future-settle f nil)))
  futures)
(let ((a (player 1 3)) (b (player 0 3)))
  (run-all nil)
  (print (rontolisp::%future-settled-p a))
  (print (rontolisp:await a))
  (print (rontolisp:await b))
  (print (length *log*)))
