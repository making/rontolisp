;; "secret" at P?
(defun secret-at (p)
  (and (= (%load8 p) 115) (= (%load8 (+ p 1)) 101) (= (%load8 (+ p 2)) 99)
       (= (%load8 (+ p 3)) 114) (= (%load8 (+ p 4)) 101) (= (%load8 (+ p 5)) 116)))

(defun has-secret (p n)
  (let ((i 0) (found 0))
    (loop while (and (= found 0) (<= (+ i 6) n))
          do (when (secret-at (+ p i)) (setq found 1))
             (setq i (+ i 1)))
    found))

(defun put-literal (out s)
  (dotimes (i (length s)) (%store8 (+ out i) (char-code (char s i))))
  (+ out (length s)))

(defun put-decimal (out n)
  (let ((digits 1) (m n))
    (loop while (>= m 10) do (setq m (floor m 10)) (setq digits (+ digits 1)))
    (let ((i (- digits 1)) (m2 n))
      (loop while (>= i 0)
            do (%store8 (+ out i) (+ 48 (mod m2 10)))
               (setq m2 (floor m2 10))
               (setq i (- i 1))))
    (+ out digits)))

(defun redact (size)
  (let* ((start (%alloc 64))
         (a (put-literal start "Original message body ("))
         (b (put-decimal a size))
         (end (put-literal b " bytes) redacted.
")))
    (%set-buffer 1 0 size start (- end start))))

(defun on-response-body (id size eos)
  (if (= eos 0)
      1
      (let* ((mark (%mark)) (cells (%alloc 8)))
        (when (= (%get-buffer 1 0 size cells (+ cells 4)) 0)
          (when (= (has-secret (%load32 cells) (%load32 (+ cells 4))) 1)
            (redact size)))
        (%reset mark)
        0)))
(rontolisp:wasm-export 'on-response-body :as "proxy_on_response_body" :params '(:u32 :s32 :s32) :returns :s32)
