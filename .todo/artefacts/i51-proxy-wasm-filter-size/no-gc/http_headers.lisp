;;;; http_headers on --no-gc: bytes in linear memory, no strings built, no objects.
(rontolisp:wasm-import '%log :from "env" :as "proxy_log" :params '(:s32 :u32 :u32) :returns :s32)
(rontolisp:wasm-import '%get-pairs :from "env" :as "proxy_get_header_map_pairs" :params '(:s32 :u32 :u32) :returns :s32)
(rontolisp:wasm-import '%get-header :from "env" :as "proxy_get_header_map_value" :params '(:s32 :string :u32 :u32) :returns :s32)
(rontolisp:wasm-import '%send :from "env" :as "proxy_send_local_response" :params '(:s32 :string :string :u32 :u32 :s32) :returns :s32)
(rontolisp:wasm-import '%alloc :from "rontolisp:memory" :as "alloc" :params '(:u32) :returns :u32)
(rontolisp:wasm-import '%mark :from "rontolisp:memory" :as "mark" :returns :u32)
(rontolisp:wasm-import '%reset :from "rontolisp:memory" :as "reset" :params '(:u32))
(rontolisp:wasm-import '%load8 :from "rontolisp:memory" :as "load8" :params '(:u32) :returns :u32)
(rontolisp:wasm-import '%load32 :from "rontolisp:memory" :as "load32" :params '(:u32) :returns :u32)
(rontolisp:wasm-import '%store8 :from "rontolisp:memory" :as "store8" :params '(:u32 :u32))
(rontolisp:wasm-import '%store32 :from "rontolisp:memory" :as "store32" :params '(:u32 :u32))

(defun on-memory-allocate (size) (%alloc size))
(rontolisp:wasm-export 'on-memory-allocate :as "proxy_on_memory_allocate" :params '(:u32) :returns :u32)
(defun abi-version () 0)
(rontolisp:wasm-export 'abi-version :as "proxy_abi_version_0_2_1")
(defun on-vm-start (id size) 1)
(rontolisp:wasm-export 'on-vm-start :as "proxy_on_vm_start" :params '(:u32 :s32) :returns :s32)
(defun on-configure (id size) 1)
(rontolisp:wasm-export 'on-configure :as "proxy_on_configure" :params '(:u32 :s32) :returns :s32)
(defun on-done (id) 1)
(rontolisp:wasm-export 'on-done :as "proxy_on_done" :params '(:u32) :returns :s32)
(defun on-delete (id) 0)
(rontolisp:wasm-export 'on-delete :as "proxy_on_delete" :params '(:u32))
(defun on-context-create (id parent) 0)
(rontolisp:wasm-export 'on-context-create :as "proxy_on_context_create" :params '(:u32 :u32))
(defun on-request-body (id n eos) 0)
(rontolisp:wasm-export 'on-request-body :as "proxy_on_request_body" :params '(:u32 :s32 :s32) :returns :s32)
(defun on-response-body (id n eos) 0)
(rontolisp:wasm-export 'on-response-body :as "proxy_on_response_body" :params '(:u32 :s32 :s32) :returns :s32)

(defun put-literal (out s)
  (dotimes (i (length s)) (%store8 (+ out i) (char-code (char s i))))
  (+ out (length s)))

(defun put-bytes (out p n)
  (dotimes (i n) (%store8 (+ out i) (%load8 (+ p i))))
  (+ out n))

(defun put-decimal (out n)
  (let ((digits 1) (m n))
    (loop while (>= m 10) do (setq m (floor m 10)) (setq digits (+ digits 1)))
    (let ((i (- digits 1)) (m2 n))
      (loop while (>= i 0)
            do (%store8 (+ out i) (+ 48 (mod m2 10)))
               (setq m2 (floor m2 10))
               (setq i (- i 1))))
    (+ out digits)))

;; The ABI's whole-map form: u32 count, (u32 name, u32 value) * count, (name NUL value NUL) * count.
(defun log-pairs (id map request)
  (let ((cells (%alloc 8)))
    (when (= (%get-pairs map cells (+ cells 4)) 0)
      (let* ((base (%load32 cells))
             (count (%load32 base))
             (sizes (+ base 4))
             (data (+ sizes (* 8 count)))
             (i 0))
        (loop while (< i count)
              do (let* ((name-size (%load32 (+ sizes (* 8 i))))
                        (value-size (%load32 (+ sizes (* 8 i) 4)))
                        (line (%alloc (+ name-size value-size 32)))
                        (a (put-literal line "#"))
                        (b (put-decimal a id))
                        (c (if (= request 1) (put-literal b " -> ") (put-literal b " <- ")))
                        (d (put-bytes c data name-size))
                        (e (put-literal d ": "))
                        (f (put-bytes e (+ data name-size 1) value-size)))
                   (%log 2 line (- f line))
                   (setq data (+ data name-size value-size 2))
                   (setq i (+ i 1))))))))

(defun path-is-hello ()
  (let ((cells (%alloc 8)))
    (and (= (%get-header 0 ":path" cells (+ cells 4)) 0)
         (= (%load32 (+ cells 4)) 6)
         (let ((p (%load32 cells)))
           (and (= (%load8 p) 47) (= (%load8 (+ p 1)) 104) (= (%load8 (+ p 2)) 101)
                (= (%load8 (+ p 3)) 108) (= (%load8 (+ p 4)) 108) (= (%load8 (+ p 5)) 111))))))

(defun put-u32 (out v) (%store32 out v) (+ out 4))

(defun put-pair-sizes (out a b) (put-u32 (put-u32 out a) b))

(defun put-pair (out name value)
  (+ 1 (put-literal (+ 1 (put-literal out name)) value)))

(defun answer-hello ()
  (let* ((pairs (%alloc 64))
         (a (put-pair-sizes (put-u32 pairs 2) 5 5))
         (b (put-pair-sizes a 10 10))
         (c (put-pair b "Hello" "World"))
         (d (put-pair c "Powered-By" "proxy-wasm")))
    (%send 200 "" "Hello, World!
" pairs (- d pairs) -1)))

(defun on-request-headers (id n eos)
  (let ((mark (%mark)) (action 0))
    (log-pairs id 0 1)
    (when (path-is-hello)
      (answer-hello)
      (setq action 1))
    (%reset mark)
    action))
(rontolisp:wasm-export 'on-request-headers :as "proxy_on_request_headers" :params '(:u32 :s32 :s32) :returns :s32)

(defun on-response-headers (id n eos)
  (let ((mark (%mark)))
    (log-pairs id 2 0)
    (%reset mark)
    0))
(rontolisp:wasm-export 'on-response-headers :as "proxy_on_response_headers" :params '(:u32 :s32 :s32) :returns :s32)

(defun on-log (id)
  (let* ((mark (%mark))
         (line (%alloc 32))
         (a (put-literal line "#"))
         (b (put-decimal a id))
         (c (put-literal b " completed.")))
    (%log 2 line (- c line))
    (%reset mark)))
(rontolisp:wasm-export 'on-log :as "proxy_on_log" :params '(:u32))
