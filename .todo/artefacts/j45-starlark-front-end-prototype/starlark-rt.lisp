;;; Prototype run-time library for a Starlark -> core forms lowering.
;;; Values: None = :none, True/False = T/NIL, int = integer, float = double,
;;; string = string, list/tuple/dict/range/function = structs below.

(defstruct (sl-list (:constructor %sl-mk-list (items))) items (frozen nil) (iter 0))
(defstruct (sl-tuple (:constructor %sl-mk-tuple (items))) items)
(defstruct (sl-dict (:constructor %sl-mk-dict (table))) table (frozen nil) (iter 0))
(defstruct (sl-range (:constructor %sl-mk-range (start stop step))) start stop step)
(defstruct (sl-fn (:constructor %sl-mk-fn (name params defaults npos varargs kwargs impl)))
  name params defaults npos varargs kwargs impl)

(defun %sl-new-vec () (make-array 0 :adjustable t :fill-pointer 0))
(defun %sl-list-from (xs)
  (let ((v (%sl-new-vec))) (dolist (x xs) (vector-push-extend x v)) (%sl-mk-list v)))
(defun %sl-list (&rest xs) (%sl-list-from xs))
(defun %sl-tuple-from (xs) (%sl-mk-tuple (apply #'vector xs)))
(defun %sl-tuple (&rest xs) (%sl-tuple-from xs))
(defun %sl-acc-push (acc x) (vector-push-extend x (sl-list-items acc)))

(defun %sl-type (x)
  (cond ((eq x :none) "NoneType")
        ((or (eq x t) (null x)) "bool")
        ((integerp x) "int")
        ((floatp x) "float")
        ((stringp x) "string")
        ((sl-list-p x) "list")
        ((sl-tuple-p x) "tuple")
        ((sl-dict-p x) "dict")
        ((sl-range-p x) "range")
        ((sl-fn-p x) "function")
        ((functionp x) "builtin_function_or_method")
        (t "unknown")))

(defun %sl-range-len (r)
  (let ((start (sl-range-start r)) (stop (sl-range-stop r)) (step (sl-range-step r)))
    (if (> step 0)
        (if (< start stop) (ceiling (- stop start) step) 0)
        (if (> start stop) (ceiling (- start stop) (- step)) 0))))

(defun %sl-truth (x)
  (cond ((eq x t) t)
        ((null x) nil)
        ((eq x :none) nil)
        ((numberp x) (/= x 0))
        ((stringp x) (> (length x) 0))
        ((sl-list-p x) (> (length (sl-list-items x)) 0))
        ((sl-tuple-p x) (> (length (sl-tuple-items x)) 0))
        ((sl-dict-p x) (> (hash-table-count (sl-dict-table x)) 0))
        ((sl-range-p x) (> (%sl-range-len x) 0))
        (t t)))

;;; ---- sequences as Lisp lists / vectors ----

(defun %sl-range-list (r)
  (let ((n (%sl-range-len r)) (v (sl-range-start r)) (step (sl-range-step r)) (acc nil))
    (dotimes (i n) (push v acc) (setq v (+ v step)))
    (nreverse acc)))

(defun %sl-dict-keys (d)
  (let ((acc nil))
    (maphash (lambda (k cell) (push (car cell) acc)) (sl-dict-table d))
    (nreverse acc)))

(defun %sl-elems (x)
  (cond ((sl-list-p x) (coerce (sl-list-items x) 'list))
        ((sl-tuple-p x) (coerce (sl-tuple-items x) 'list))
        ((sl-dict-p x) (%sl-dict-keys x))
        ((sl-range-p x) (%sl-range-list x))
        (t (error "type '~a' is not iterable" (%sl-type x)))))

(defun %sl-iter-begin (x)
  (cond ((sl-list-p x) (setf (sl-list-iter x) (+ (sl-list-iter x) 1)) (sl-list-items x))
        ((sl-tuple-p x) (sl-tuple-items x))
        ((sl-dict-p x) (setf (sl-dict-iter x) (+ (sl-dict-iter x) 1))
         (apply #'vector (%sl-dict-keys x)))
        ((sl-range-p x) (apply #'vector (%sl-range-list x)))
        (t (error "type '~a' is not iterable" (%sl-type x)))))

(defun %sl-iter-end (x)
  (cond ((sl-list-p x) (setf (sl-list-iter x) (- (sl-list-iter x) 1)))
        ((sl-dict-p x) (setf (sl-dict-iter x) (- (sl-dict-iter x) 1))))
  nil)

(defun %sl-unpack (x n)
  (let ((v (apply #'vector (%sl-elems x))))
    (cond ((< (length v) n) (error "too few values to unpack (got ~a, want ~a)" (length v) n))
          ((> (length v) n) (error "too many values to unpack (got ~a, want ~a)" (length v) n)))
    v))

(defun %sl-check-list (l)
  (cond ((not (sl-list-p l)) (error "~a has no such field or method" (%sl-type l)))
        ((sl-list-frozen l) (error "cannot mutate frozen list"))
        ((> (sl-list-iter l) 0) (error "cannot mutate list during iteration"))))
(defun %sl-check-dict (d)
  (cond ((not (sl-dict-p d)) (error "~a has no such field or method" (%sl-type d)))
        ((sl-dict-frozen d) (error "cannot mutate frozen dict"))
        ((> (sl-dict-iter d) 0) (error "cannot mutate dict during iteration"))))

;;; ---- equality and ordering ----

(defun %sl-list-eq (a b)
  (cond ((and (null a) (null b)) t)
        ((or (null a) (null b)) nil)
        ((%sl-eq (car a) (car b)) (%sl-list-eq (cdr a) (cdr b)))
        (t nil)))

(defun %sl-dict-eq (a b)
  (let ((ta (sl-dict-table a)) (tb (sl-dict-table b)) (same t))
    (if (/= (hash-table-count ta) (hash-table-count tb))
        nil
        (progn
          (maphash (lambda (k cell)
                     (let ((other (gethash k tb)))
                       (if (or (null other) (not (%sl-eq (cdr cell) (cdr other))))
                           (setq same nil))))
                   ta)
          same))))

(defun %sl-eq (a b)
  (cond ((and (numberp a) (numberp b)) (= a b))
        ((and (stringp a) (stringp b)) (string= a b))
        ((and (sl-list-p a) (sl-list-p b)) (%sl-list-eq (%sl-elems a) (%sl-elems b)))
        ((and (sl-tuple-p a) (sl-tuple-p b)) (%sl-list-eq (%sl-elems a) (%sl-elems b)))
        ((and (sl-dict-p a) (sl-dict-p b)) (%sl-dict-eq a b))
        ((and (sl-range-p a) (sl-range-p b)) (%sl-list-eq (%sl-elems a) (%sl-elems b)))
        (t (eq a b))))

(defun %sl-list-cmp (a b)
  (cond ((and (null a) (null b)) 0)
        ((null a) -1)
        ((null b) 1)
        ((%sl-eq (car a) (car b)) (%sl-list-cmp (cdr a) (cdr b)))
        (t (%sl-cmp (car a) (car b)))))

(defun %sl-boolp (x) (or (eq x t) (null x)))

(defun %sl-cmp (a b)
  (cond ((and (numberp a) (numberp b)) (cond ((< a b) -1) ((> a b) 1) (t 0)))
        ((and (stringp a) (stringp b)) (cond ((string< a b) -1) ((string> a b) 1) (t 0)))
        ((and (%sl-boolp a) (%sl-boolp b)) (cond ((eq a b) 0) ((null a) -1) (t 1)))
        ((and (sl-list-p a) (sl-list-p b)) (%sl-list-cmp (%sl-elems a) (%sl-elems b)))
        ((and (sl-tuple-p a) (sl-tuple-p b)) (%sl-list-cmp (%sl-elems a) (%sl-elems b)))
        (t (error "unsupported comparison: ~a <=> ~a" (%sl-type a) (%sl-type b)))))

(defun %sl-lt (a b) (< (%sl-cmp a b) 0))
(defun %sl-le (a b) (<= (%sl-cmp a b) 0))
(defun %sl-gt (a b) (> (%sl-cmp a b) 0))
(defun %sl-ge (a b) (>= (%sl-cmp a b) 0))

;;; ---- dict ----

(defun %sl-key (k)
  (cond ((stringp k) k)
        ((integerp k) k)
        ((floatp k) (if (= k (float (round k) 1d0)) (round k) k))
        ((eq k t) :true)
        ((null k) :false)
        ((eq k :none) :none)
        ((sl-tuple-p k) (cons :tuple (mapcar #'%sl-key (%sl-elems k))))
        (t (error "unhashable type: ~a" (%sl-type k)))))

(defun %sl-new-dict () (%sl-mk-dict (make-hash-table :test 'equal)))
(defun %sl-dict-put (d k v)
  (let* ((key (%sl-key k)) (cell (gethash key (sl-dict-table d))))
    (%sl-check-dict d)
    (if cell (rplacd cell v) (setf (gethash key (sl-dict-table d)) (cons k v)))
    v))
(defun %sl-dict (&rest kvs)
  (let ((d (%sl-new-dict)))
    (loop while kvs
          do (%sl-dict-put d (car kvs) (cadr kvs)) (setq kvs (cddr kvs)))
    d))
(defun %sl-dict-cell (d k) (gethash (%sl-key k) (sl-dict-table d)))
(defun %sl-dict-plist (d)
  (let ((acc nil))
    (maphash (lambda (k cell) (push (car cell) acc) (push (cdr cell) acc)) (sl-dict-table d))
    (nreverse acc)))

;;; ---- printing ----

(defun %sl-write-string-repr (x s)
  (write-char #\" s)
  (dotimes (i (length x))
    (let ((c (char x i)))
      (cond ((char= c #\") (write-string "\\\"" s))
            ((char= c #\\) (write-string "\\\\" s))
            ((char= c #\Newline) (write-string "\\n" s))
            ((char= c #\Tab) (write-string "\\t" s))
            ((char= c #\Return) (write-string "\\r" s))
            (t (write-char c s)))))
  (write-char #\" s))

(defun %sl-float-str (x)
  (if (and (= x (float (round x) 1d0)) (< (abs x) 1d17))
      (format nil "~a.0" (round x))
      (let* ((text (format nil "~a" x)) (d (position #\d text)))
        (if d (subseq text 0 d) text))))

(defun %sl-write-seq (xs s open close)
  (write-string open s)
  (let ((first t))
    (dolist (x xs)
      (if first (setq first nil) (write-string ", " s))
      (%sl-write x s)))
  (write-string close s))

(defun %sl-write (x s)
  (cond ((eq x :none) (write-string "None" s))
        ((eq x t) (write-string "True" s))
        ((null x) (write-string "False" s))
        ((integerp x) (format s "~d" x))
        ((floatp x) (write-string (%sl-float-str x) s))
        ((stringp x) (%sl-write-string-repr x s))
        ((sl-list-p x) (%sl-write-seq (%sl-elems x) s "[" "]"))
        ((sl-tuple-p x)
         (if (= (length (sl-tuple-items x)) 1)
             (progn (write-string "(" s) (%sl-write (aref (sl-tuple-items x) 0) s) (write-string ",)" s))
             (%sl-write-seq (%sl-elems x) s "(" ")")))
        ((sl-dict-p x)
         (write-string "{" s)
         (let ((first t))
           (maphash (lambda (k cell)
                      (if first (setq first nil) (write-string ", " s))
                      (%sl-write (car cell) s) (write-string ": " s) (%sl-write (cdr cell) s))
                    (sl-dict-table x)))
         (write-string "}" s))
        ((sl-range-p x)
         (if (= (sl-range-step x) 1)
             (format s "range(~d, ~d)" (sl-range-start x) (sl-range-stop x))
             (format s "range(~d, ~d, ~d)" (sl-range-start x) (sl-range-stop x) (sl-range-step x))))
        ((sl-fn-p x) (format s "<function ~a>" (sl-fn-name x)))
        (t (write-string "<built-in function>" s))))

(defun %sl-b-repr (x) (with-output-to-string (s) (%sl-write x s)))
(defun %sl-b-str (x) (if (stringp x) x (%sl-b-repr x)))

;;; ---- arithmetic ----

(defun %sl-num (x) (if (numberp x) x nil))
(defun %sl-binop-error (op a b)
  (error "unknown binary op: ~a ~a ~a" (%sl-type a) op (%sl-type b)))
(defun %sl-arith (x y) (if (or (floatp x) (floatp y)) t nil))

(defun %sl-add (a b)
  (cond ((and (numberp a) (numberp b))
         (if (%sl-arith a b) (+ (float a 1d0) (float b 1d0)) (+ a b)))
        ((and (stringp a) (stringp b)) (concatenate 'string a b))
        ((and (sl-list-p a) (sl-list-p b)) (%sl-list-from (append (%sl-elems a) (%sl-elems b))))
        ((and (sl-tuple-p a) (sl-tuple-p b)) (%sl-tuple-from (append (%sl-elems a) (%sl-elems b))))
        (t (%sl-binop-error "+" a b))))

(defun %sl-iadd (a b)
  (if (and (sl-list-p a) (sl-list-p b))
      (progn (%sl-check-list a)
             (dolist (x (%sl-elems b)) (vector-push-extend x (sl-list-items a)))
             a)
      (%sl-add a b)))

(defun %sl-sub (a b)
  (if (and (numberp a) (numberp b))
      (if (%sl-arith a b) (- (float a 1d0) (float b 1d0)) (- a b))
      (%sl-binop-error "-" a b)))

(defun %sl-repeat-list (xs n)
  (let ((acc nil)) (dotimes (i n) (setq acc (append xs acc))) acc))
(defun %sl-repeat-string (x n)
  (with-output-to-string (s) (dotimes (i n) (write-string x s))))

(defun %sl-mul (a b)
  (cond ((and (numberp a) (numberp b))
         (if (%sl-arith a b) (* (float a 1d0) (float b 1d0)) (* a b)))
        ((and (stringp a) (integerp b)) (%sl-repeat-string a b))
        ((and (integerp a) (stringp b)) (%sl-repeat-string b a))
        ((and (sl-list-p a) (integerp b)) (%sl-list-from (%sl-repeat-list (%sl-elems a) b)))
        ((and (integerp a) (sl-list-p b)) (%sl-list-from (%sl-repeat-list (%sl-elems b) a)))
        ((and (sl-tuple-p a) (integerp b)) (%sl-tuple-from (%sl-repeat-list (%sl-elems a) b)))
        ((and (integerp a) (sl-tuple-p b)) (%sl-tuple-from (%sl-repeat-list (%sl-elems b) a)))
        (t (%sl-binop-error "*" a b))))

(defun %sl-div (a b)
  (if (and (numberp a) (numberp b))
      (if (= b 0) (error "floating-point division by zero") (/ (float a 1d0) (float b 1d0)))
      (%sl-binop-error "/" a b)))

(defun %sl-floordiv (a b)
  (cond ((and (integerp a) (integerp b))
         (if (= b 0) (error "integer division by zero") (values (floor a b))))
        ((and (numberp a) (numberp b))
         (if (= b 0) (error "floored division by zero") (float (floor (float a 1d0) (float b 1d0)) 1d0)))
        (t (%sl-binop-error "//" a b))))

(defun %sl-mod (a b)
  (cond ((and (integerp a) (integerp b))
         (if (= b 0) (error "integer modulo by zero") (mod a b)))
        ((and (numberp a) (numberp b))
         (if (= b 0) (error "float modulo by zero") (mod (float a 1d0) (float b 1d0))))
        ((stringp a) (%sl-percent a (if (sl-tuple-p b) (%sl-elems b) (list b))))
        (t (%sl-binop-error "%" a b))))

(defun %sl-neg (a) (if (numberp a) (- a) (error "unknown unary op: -~a" (%sl-type a))))
(defun %sl-pos (a) (if (numberp a) a (error "unknown unary op: +~a" (%sl-type a))))
(defun %sl-invert (a) (if (integerp a) (lognot a) (error "unknown unary op: ~~~a" (%sl-type a))))
(defun %sl-and (a b) (if (and (integerp a) (integerp b)) (logand a b) (%sl-binop-error "&" a b)))
(defun %sl-xor (a b) (if (and (integerp a) (integerp b)) (logxor a b) (%sl-binop-error "^" a b)))
(defun %sl-or (a b)
  (cond ((and (integerp a) (integerp b)) (logior a b))
        ((and (sl-dict-p a) (sl-dict-p b))
         (let ((d (%sl-new-dict)))
           (maphash (lambda (k cell) (%sl-dict-put d (car cell) (cdr cell))) (sl-dict-table a))
           (maphash (lambda (k cell) (%sl-dict-put d (car cell) (cdr cell))) (sl-dict-table b))
           d))
        (t (%sl-binop-error "|" a b))))
(defun %sl-lshift (a b)
  (cond ((not (and (integerp a) (integerp b))) (%sl-binop-error "<<" a b))
        ((< b 0) (error "negative shift count: ~a" b))
        (t (ash a b))))
(defun %sl-rshift (a b)
  (cond ((not (and (integerp a) (integerp b))) (%sl-binop-error ">>" a b))
        ((< b 0) (error "negative shift count: ~a" b))
        (t (ash a (- b)))))

;;; ---- indexing ----

(defun %sl-norm-index (i n what)
  (if (not (integerp i)) (error "~a index: got ~a, want int" what (%sl-type i)))
  (let ((j (if (< i 0) (+ i n) i)))
    (if (or (< j 0) (>= j n)) (error "~a index ~a out of range" what i))
    j))

(defun %sl-index (x i)
  (cond ((sl-list-p x) (aref (sl-list-items x) (%sl-norm-index i (length (sl-list-items x)) "list")))
        ((sl-tuple-p x) (aref (sl-tuple-items x) (%sl-norm-index i (length (sl-tuple-items x)) "tuple")))
        ((stringp x) (let ((j (%sl-norm-index i (length x) "string"))) (subseq x j (+ j 1))))
        ((sl-dict-p x)
         (let ((cell (%sl-dict-cell x i)))
           (if cell (cdr cell) (error "key ~a not found in dictionary" (%sl-b-repr i)))))
        ((sl-range-p x)
         (+ (sl-range-start x) (* (sl-range-step x) (%sl-norm-index i (%sl-range-len x) "range"))))
        (t (error "unhandled index operation ~a[~a]" (%sl-type x) (%sl-type i)))))

(defun %sl-setindex (x i v)
  (cond ((sl-list-p x)
         (%sl-check-list x)
         (setf (aref (sl-list-items x) (%sl-norm-index i (length (sl-list-items x)) "list")) v))
        ((sl-dict-p x) (%sl-dict-put x i v))
        (t (error "~a value does not support item assignment" (%sl-type x)))))

(defun %sl-clamp (i n lo hi default)
  (cond ((eq i :none) default)
        ((not (integerp i)) (error "slice index: got ~a, want int" (%sl-type i)))
        (t (let ((j (if (< i 0) (+ i n) i))) (max lo (min hi j))))))

(defun %sl-slice-list (xs lo hi step)
  (let* ((v (apply #'vector xs)) (n (length v)) (acc nil))
    (if (not (or (eq step :none) (integerp step))) (error "slice step: got ~a, want int" (%sl-type step)))
    (let ((st (if (eq step :none) 1 step)))
      (cond ((= st 0) (error "slice step cannot be zero"))
            ((> st 0)
             (let ((i (%sl-clamp lo n 0 n 0)) (end (%sl-clamp hi n 0 n n)))
               (loop while (< i end) do (push (aref v i) acc) (setq i (+ i st)))))
            (t
             (let ((i (%sl-clamp lo n -1 (- n 1) (- n 1))) (end (%sl-clamp hi n -1 (- n 1) -1)))
               (loop while (> i end) do (push (aref v i) acc) (setq i (+ i st)))))))
    (nreverse acc)))

(defun %sl-slice (x lo hi step)
  (cond ((sl-list-p x) (%sl-list-from (%sl-slice-list (%sl-elems x) lo hi step)))
        ((sl-tuple-p x) (%sl-tuple-from (%sl-slice-list (%sl-elems x) lo hi step)))
        ((stringp x) (coerce (%sl-slice-list (coerce x 'list) lo hi step) 'string))
        ((sl-range-p x) (%sl-list-from (%sl-slice-list (%sl-elems x) lo hi step)))
        (t (error "invalid slice operand ~a" (%sl-type x)))))

(defun %sl-member (x xs)
  (cond ((null xs) nil) ((%sl-eq x (car xs)) t) (t (%sl-member x (cdr xs)))))

(defun %sl-in (x c)
  (cond ((stringp c)
         (if (stringp x) (if (search x c) t nil)
             (error "'in <string>' requires string as left operand, not ~a" (%sl-type x))))
        ((sl-dict-p c) (if (%sl-dict-cell c x) t nil))
        ((or (sl-list-p c) (sl-tuple-p c) (sl-range-p c)) (%sl-member x (%sl-elems c)))
        (t (error "unknown binary op: ~a in ~a" (%sl-type x) (%sl-type c)))))

(defun %sl-getattr (x name) (error "~a has no .~a field or method" (%sl-type x) name))

;;; ---- calls ----

(defun %sl-kw-keys (kw)
  (let ((acc nil))
    (loop while kw
          do (push (intern (string-upcase (car kw)) :keyword) acc) (push (cadr kw) acc)
             (setq kw (cddr kw)))
    (nreverse acc)))

(defun %sl-bind (f pos kw)
  (let* ((params (sl-fn-params f)) (n (length params)) (npos (sl-fn-npos f))
         (vals (make-array n :initial-element :%unset)) (extra nil)
         (kwd (if (sl-fn-kwargs f) (%sl-new-dict) nil)) (i 0))
    (dolist (a pos)
      (if (< i npos) (setf (aref vals i) a) (push a extra))
      (setq i (+ i 1)))
    (if (and extra (not (sl-fn-varargs f)))
        (error "function ~a accepts at most ~a positional arguments (~a given)" (sl-fn-name f) npos (length pos)))
    (loop while kw
          do (let ((idx (position (car kw) params :test #'string=)))
               (cond ((and idx (eq (aref vals idx) :%unset)) (setf (aref vals idx) (cadr kw)))
                     (idx (error "function ~a got multiple values for parameter ~a" (sl-fn-name f) (car kw)))
                     (kwd (%sl-dict-put kwd (car kw) (cadr kw)))
                     (t (error "function ~a got an unexpected keyword argument ~a" (sl-fn-name f) (car kw)))))
             (setq kw (cddr kw)))
    (let ((ds (sl-fn-defaults f)))
      (dotimes (j n)
        (if (eq (aref vals j) :%unset)
            (if (eq (car ds) :%required)
                (error "function ~a missing argument for ~a" (sl-fn-name f) (nth j params))
                (setf (aref vals j) (car ds))))
        (setq ds (cdr ds))))
    (append (coerce vals 'list)
            (if (sl-fn-varargs f) (list (%sl-tuple-from (nreverse extra))) nil)
            (if kwd (list kwd) nil))))

(defun %sl-call (f pos kw)
  (cond ((sl-fn-p f) (apply (sl-fn-impl f) (%sl-bind f pos kw)))
        ((functionp f) (apply f (append pos (%sl-kw-keys kw))))
        (t (error "invalid call of non-function (~a)" (%sl-type f)))))

;;; ---- built-in functions ----

(defun %sl-b-len (x)
  (cond ((stringp x) (length x))
        ((sl-list-p x) (length (sl-list-items x)))
        ((sl-tuple-p x) (length (sl-tuple-items x)))
        ((sl-dict-p x) (hash-table-count (sl-dict-table x)))
        ((sl-range-p x) (%sl-range-len x))
        (t (error "len: value of type ~a has no len" (%sl-type x)))))

(defun %sl-b-print (args &key (sep " "))
  (let ((first t))
    (dolist (a args)
      (if first (setq first nil) (write-string sep))
      (write-string (%sl-b-str a))))
  (terpri)
  :none)

(defun %sl-b-fail (args &key (sep " "))
  (error "fail: ~a"
         (with-output-to-string (s)
           (let ((first t))
             (dolist (a args)
               (if first (setq first nil) (write-string sep s))
               (write-string (%sl-b-str a) s))))))

(defun %sl-b-type (x) (%sl-type x))
(defun %sl-b-bool (&optional (x nil)) (%sl-truth x))
(defun %sl-b-list (&optional (x :%unset)) (if (eq x :%unset) (%sl-list) (%sl-list-from (%sl-elems x))))
(defun %sl-b-tuple (&optional (x :%unset))
  (cond ((eq x :%unset) (%sl-tuple)) ((sl-tuple-p x) x) (t (%sl-tuple-from (%sl-elems x)))))

(defun %sl-b-dict (pos kw)
  (let ((d (%sl-new-dict)))
    (if (cdr pos) (error "dict: got ~a arguments, want at most 1" (length pos)))
    (if pos (%sl-m-update d (car pos)))
    (loop while kw do (%sl-dict-put d (car kw) (cadr kw)) (setq kw (cddr kw)))
    d))

(defun %sl-b-range (a &optional (b :%unset) (c 1))
  (if (not (and (integerp a) (or (eq b :%unset) (integerp b)) (integerp c)))
      (error "range: got ~a, want int" (%sl-type (if (integerp a) (if (integerp b) c b) a))))
  (if (= c 0) (error "range: step argument must not be zero"))
  (if (eq b :%unset) (%sl-mk-range 0 a 1) (%sl-mk-range a b c)))

(defun %sl-digit (c)
  (let ((code (char-code c)))
    (cond ((and (>= code 48) (<= code 57)) (- code 48))
          ((and (>= code 97) (<= code 122)) (+ 10 (- code 97)))
          ((and (>= code 65) (<= code 90)) (+ 10 (- code 65)))
          (t 99))))

(defun %sl-parse-int (text base)
  (let* ((s (string-trim " " text)) (n (length s)) (i 0) (neg nil) (acc 0) (b base))
    (if (and (< i n) (or (char= (char s i) #\-) (char= (char s i) #\+)))
        (progn (setq neg (char= (char s i) #\-)) (setq i (+ i 1))))
    (if (and (< (+ i 1) n) (char= (char s i) #\0))
        (let ((p (char-downcase (char s (+ i 1)))))
          (cond ((and (char= p #\x) (or (= b 0) (= b 16))) (setq b 16) (setq i (+ i 2)))
                ((and (char= p #\o) (or (= b 0) (= b 8))) (setq b 8) (setq i (+ i 2)))
                ((and (char= p #\b) (or (= b 0) (= b 2))) (setq b 2) (setq i (+ i 2))))))
    (if (= b 0) (setq b 10))
    (if (>= i n) (error "int: invalid literal with base ~a: ~a" base text))
    (loop while (< i n)
          do (let ((d (%sl-digit (char s i))))
               (if (>= d b) (error "int: invalid literal with base ~a: ~a" base text))
               (setq acc (+ (* acc b) d))
               (setq i (+ i 1))))
    (if neg (- acc) acc)))

(defun %sl-b-int (x &optional (base :%unset))
  (cond ((stringp x)
         (if (and (not (eq base :%unset)) (not (integerp base))) (error "int: base must be int"))
         (%sl-parse-int x (if (eq base :%unset) 10 base)))
        ((not (eq base :%unset)) (error "int: can't convert non-string with explicit base"))
        ((integerp x) x)
        ((floatp x) (values (truncate x)))
        ((eq x t) 1)
        ((null x) 0)
        (t (error "int: cannot convert ~a to int" (%sl-type x)))))

(defun %sl-b-float (&optional (x 0))
  (cond ((numberp x) (float x 1d0))
        ((eq x t) 1d0)
        ((null x) 0d0)
        (t (error "float: cannot convert ~a to float" (%sl-type x)))))

(defun %sl-b-abs (x) (if (numberp x) (abs x) (error "abs: got ~a, want int or float" (%sl-type x))))
(defun %sl-b-hash (x) (if (stringp x) (sxhash x) (error "hash: got ~a, want string" (%sl-type x))))
(defun %sl-b-any (x) (if (member t (mapcar #'%sl-truth (%sl-elems x))) t nil))
(defun %sl-b-all (x) (if (member nil (mapcar #'%sl-truth (%sl-elems x))) nil t))
(defun %sl-b-reversed (x) (%sl-list-from (reverse (%sl-elems x))))
(defun %sl-b-enumerate (x &optional (start 0))
  (let ((acc nil) (i start))
    (dolist (e (%sl-elems x)) (push (%sl-tuple i e) acc) (setq i (+ i 1)))
    (%sl-list-from (nreverse acc))))

(defun %sl-b-zip (args)
  (let ((lists (mapcar #'%sl-elems args)) (acc nil))
    (if lists
        (loop while (not (member nil lists))
              do (push (%sl-tuple-from (mapcar #'car lists)) acc)
                 (setq lists (mapcar #'cdr lists))))
    (%sl-list-from (nreverse acc))))

(defun %sl-keyfn (key)
  (if (eq key :none) (lambda (x) x) (lambda (x) (%sl-call key (list x) nil))))

(defun %sl-b-sorted (x &key (key :none) (reverse nil))
  (let* ((kf (%sl-keyfn key))
         (pairs (mapcar (lambda (e) (cons (funcall kf e) e)) (%sl-elems x)))
         (sorted (stable-sort pairs
                              (if (%sl-truth reverse)
                                  (lambda (a b) (%sl-lt (car b) (car a)))
                                  (lambda (a b) (%sl-lt (car a) (car b)))))))
    (%sl-list-from (mapcar #'cdr sorted))))

(defun %sl-extreme (name args key want)
  (let* ((xs (if (and args (null (cdr args))) (%sl-elems (car args)) args))
         (kf (%sl-keyfn key)))
    (if (null xs) (error "~a: empty sequence" name))
    (let* ((best (car xs)) (bk (funcall kf best)))
      (dolist (x (cdr xs))
        (let ((k (funcall kf x)))
          (if (= (%sl-cmp k bk) want) (progn (setq best x) (setq bk k)))))
      best)))
(defun %sl-b-min (args &key (key :none)) (%sl-extreme "min" args key -1))
(defun %sl-b-max (args &key (key :none)) (%sl-extreme "max" args key 1))

;;; test-suite assertions
(defun %sl-b-assert_eq (x y)
  (if (not (%sl-eq x y)) (format t "ASSERT ~a != ~a~%" (%sl-b-repr x) (%sl-b-repr y)))
  :none)
(defun %sl-b-assert_ne (x y)
  (if (%sl-eq x y) (format t "ASSERT ~a == ~a~%" (%sl-b-repr x) (%sl-b-repr y)))
  :none)
(defun %sl-b-assert_ (c &optional (msg "assertion failed"))
  (if (not (%sl-truth c)) (format t "ASSERT ~a~%" msg))
  :none)

;;; ---- methods ----

(defun %sl-m-append (l x) (%sl-check-list l) (vector-push-extend x (sl-list-items l)) :none)
(defun %sl-m-extend (l xs)
  (%sl-check-list l)
  (dolist (x (%sl-elems xs)) (vector-push-extend x (sl-list-items l)))
  :none)
(defun %sl-list-replace (l xs)
  (let ((v (%sl-new-vec))) (dolist (x xs) (vector-push-extend x v)) (setf (sl-list-items l) v)))
(defun %sl-m-insert (l i x)
  (%sl-check-list l)
  (let* ((xs (%sl-elems l)) (n (length xs)) (j (max 0 (min n (if (< i 0) (+ i n) i)))))
    (%sl-list-replace l (append (subseq xs 0 j) (list x) (nthcdr j xs))))
  :none)
(defun %sl-m-remove (l x)
  (%sl-check-list l)
  (let ((xs (%sl-elems l)) (acc nil) (found nil))
    (dolist (e xs) (if (and (not found) (%sl-eq e x)) (setq found t) (push e acc)))
    (if (not found) (error "remove: element not found"))
    (%sl-list-replace l (nreverse acc)))
  :none)
(defun %sl-m-clear (x)
  (cond ((sl-list-p x) (%sl-check-list x) (%sl-list-replace x nil))
        (t (%sl-check-dict x) (clrhash (sl-dict-table x))))
  :none)

(defun %sl-m-pop (x &optional (a :%unset) (b :%unset))
  (cond ((sl-list-p x)
         (%sl-check-list x)
         (let* ((xs (%sl-elems x)) (n (length xs))
                (j (%sl-norm-index (if (eq a :%unset) -1 a) n "pop")))
           (%sl-list-replace x (append (subseq xs 0 j) (nthcdr (+ j 1) xs)))
           (nth j xs)))
        ((sl-dict-p x)
         (%sl-check-dict x)
         (let ((cell (%sl-dict-cell x a)))
           (cond (cell (remhash (%sl-key a) (sl-dict-table x)) (cdr cell))
                 ((eq b :%unset) (error "pop: missing key"))
                 (t b))))
        (t (error "~a has no .pop field or method" (%sl-type x)))))

(defun %sl-m-get (d k &optional (default :none))
  (let ((cell (%sl-dict-cell d k))) (if cell (cdr cell) default)))
(defun %sl-m-setdefault (d k &optional (default :none))
  (let ((cell (%sl-dict-cell d k))) (if cell (cdr cell) (%sl-dict-put d k default))))
(defun %sl-m-keys (d) (%sl-list-from (%sl-dict-keys d)))
(defun %sl-m-values (d)
  (let ((acc nil))
    (maphash (lambda (k cell) (push (cdr cell) acc)) (sl-dict-table d))
    (%sl-list-from (nreverse acc))))
(defun %sl-m-items (d)
  (let ((acc nil))
    (maphash (lambda (k cell) (push (%sl-tuple (car cell) (cdr cell)) acc)) (sl-dict-table d))
    (%sl-list-from (nreverse acc))))
(defun %sl-m-update (d &optional (other :%unset))
  (%sl-check-dict d)
  (cond ((eq other :%unset) nil)
        ((sl-dict-p other)
         (maphash (lambda (k cell) (%sl-dict-put d (car cell) (cdr cell))) (sl-dict-table other)))
        (t (dolist (pair (%sl-elems other))
             (let ((kv (%sl-unpack pair 2))) (%sl-dict-put d (aref kv 0) (aref kv 1))))))
  :none)
(defun %sl-m-popitem (d)
  (%sl-check-dict d)
  (let ((keys (%sl-dict-keys d)))
    (if (null keys) (error "popitem: empty dict"))
    (let ((cell (%sl-dict-cell d (car keys))))
      (remhash (%sl-key (car keys)) (sl-dict-table d))
      (%sl-tuple (car cell) (cdr cell)))))

(defun %sl-m-index (x y &optional (start :none) (end :none))
  (if (stringp x)
      (let ((r (%sl-m-find x y start end))) (if (< r 0) (error "substring not found") r))
      (let ((i 0) (found -1))
        (dolist (e (%sl-elems x))
          (if (and (< found 0) (%sl-eq e y)) (setq found i))
          (setq i (+ i 1)))
        (if (< found 0) (error "index: value not in list") found))))

(defun %sl-m-find (s sub &optional (start :none) (end :none))
  (let* ((n (length s)) (lo (%sl-clamp start n 0 n 0)) (hi (%sl-clamp end n 0 n n)))
    (if (> lo hi) -1
        (let ((r (search sub s :start2 lo :end2 hi))) (if r r -1)))))
(defun %sl-m-rfind (s sub &optional (start :none) (end :none))
  (let* ((n (length s)) (lo (%sl-clamp start n 0 n 0)) (hi (%sl-clamp end n 0 n n)))
    (if (> lo hi) -1
        (let ((r (search sub s :start2 lo :end2 hi :from-end t))) (if r r -1)))))
(defun %sl-m-rindex (s sub &optional (start :none) (end :none))
  (let ((r (%sl-m-rfind s sub start end))) (if (< r 0) (error "substring not found") r)))

(defun %sl-m-count (x y &optional (start :none) (end :none))
  (if (stringp x)
      (let* ((n (length x)) (i (%sl-clamp start n 0 n 0)) (hi (%sl-clamp end n 0 n n)) (c 0)
             (step (max 1 (length y))))
        (loop
          (let ((r (if (> i hi) nil (search y x :start2 i :end2 hi))))
            (if (null r) (return c))
            (setq c (+ c 1))
            (setq i (+ r step)))))
      (let ((c 0)) (dolist (e (%sl-elems x)) (if (%sl-eq e y) (setq c (+ c 1)))) c)))

(defun %sl-m-startswith (s p)
  (if (sl-tuple-p p)
      (if (member t (mapcar (lambda (q) (%sl-m-startswith s q)) (%sl-elems p))) t nil)
      (and (>= (length s) (length p)) (string= s p :end1 (length p)))))
(defun %sl-m-endswith (s p)
  (if (sl-tuple-p p)
      (if (member t (mapcar (lambda (q) (%sl-m-endswith s q)) (%sl-elems p))) t nil)
      (and (>= (length s) (length p)) (string= s p :start1 (- (length s) (length p))))))

(defun %sl-m-upper (s) (string-upcase s))
(defun %sl-m-lower (s) (string-downcase s))
(defun %sl-ws-bag (chars)
  (if (eq chars :none) (list #\Space #\Tab #\Newline #\Return) (coerce chars 'list)))
(defun %sl-m-strip (s &optional (chars :none)) (string-trim (%sl-ws-bag chars) s))
(defun %sl-m-lstrip (s &optional (chars :none)) (string-left-trim (%sl-ws-bag chars) s))
(defun %sl-m-rstrip (s &optional (chars :none)) (string-right-trim (%sl-ws-bag chars) s))

(defun %sl-m-join (sep xs)
  (with-output-to-string (s)
    (let ((first t))
      (dolist (x (%sl-elems xs))
        (if (not (stringp x)) (error "join: in list, want string, got ~a" (%sl-type x)))
        (if first (setq first nil) (write-string sep s))
        (write-string x s)))))

(defun %sl-m-replace (s old new &optional (count -1))
  (with-output-to-string (out)
    (let ((i 0) (n (length s)) (c count))
      (loop
        (let ((r (if (= c 0) nil (search old s :start2 i))))
          (if (or (null r) (and (= (length old) 0) (>= i n)))
              (progn (write-string (subseq s i) out) (return nil)))
          (write-string (subseq s i r) out)
          (write-string new out)
          (if (= (length old) 0)
              (progn (write-string (subseq s r (+ r 1)) out) (setq i (+ r 1)))
              (setq i (+ r (length old))))
          (setq c (- c 1)))))))

(defun %sl-split-ws (s)
  (let ((acc nil) (cur nil))
    (dotimes (i (length s))
      (let ((c (char s i)))
        (if (member c (list #\Space #\Tab #\Newline #\Return))
            (if cur (progn (push (coerce (nreverse cur) 'string) acc) (setq cur nil)))
            (push c cur))))
    (if cur (push (coerce (nreverse cur) 'string) acc))
    (nreverse acc)))

(defun %sl-m-split (s &optional (sep :none) (maxsplit :none))
  (if (eq sep :none)
      (%sl-list-from (%sl-split-ws s))
      (let ((acc nil) (i 0) (c (if (eq maxsplit :none) -1 maxsplit)))
        (if (= (length sep) 0) (error "split: empty separator"))
        (loop
          (let ((r (if (= c 0) nil (search sep s :start2 i))))
            (if (null r) (progn (push (subseq s i) acc) (return nil)))
            (push (subseq s i r) acc)
            (setq i (+ r (length sep)))
            (setq c (- c 1))))
        (%sl-list-from (nreverse acc)))))

(defun %sl-m-rsplit (s &optional (sep :none) (maxsplit :none))
  (if (or (eq sep :none) (eq maxsplit :none))
      (%sl-m-split s sep maxsplit)
      (let ((acc nil) (end (length s)) (c maxsplit))
        (if (= (length sep) 0) (error "rsplit: empty separator"))
        (loop
          (let ((r (if (= c 0) nil (search sep s :end2 end :from-end t))))
            (if (null r) (progn (push (subseq s 0 end) acc) (return nil)))
            (push (subseq s (+ r (length sep)) end) acc)
            (setq end r)
            (setq c (- c 1))))
        (%sl-list-from acc))))

(defun %sl-m-partition (s sep)
  (if (= (length sep) 0) (error "partition: empty separator"))
  (let ((r (search sep s)))
    (if r (%sl-tuple (subseq s 0 r) sep (subseq s (+ r (length sep)))) (%sl-tuple s "" ""))))
(defun %sl-m-rpartition (s sep)
  (if (= (length sep) 0) (error "rpartition: empty separator"))
  (let ((r (search sep s :from-end t)))
    (if r (%sl-tuple (subseq s 0 r) sep (subseq s (+ r (length sep)))) (%sl-tuple "" "" s))))

(defun %sl-m-elems (s)
  (let ((acc nil)) (dotimes (i (length s)) (push (subseq s i (+ i 1)) acc)) (%sl-list-from (nreverse acc))))
(defun %sl-m-capitalize (s)
  (if (= (length s) 0) s
      (concatenate 'string (string-upcase (subseq s 0 1)) (string-downcase (subseq s 1)))))
(defun %sl-every-char (s pred)
  (let ((ok (> (length s) 0)))
    (dotimes (i (length s)) (if (not (funcall pred (char s i))) (setq ok nil)))
    ok))
(defun %sl-m-isalpha (s) (%sl-every-char s #'alpha-char-p))
(defun %sl-m-isdigit (s) (%sl-every-char s #'digit-char-p))
(defun %sl-m-isalnum (s) (%sl-every-char s #'alphanumericp))
(defun %sl-m-isspace (s)
  (%sl-every-char s (lambda (c) (if (member c (list #\Space #\Tab #\Newline #\Return)) t nil))))

;;; "{} {0} {name}".format(...)
(defun %sl-m-format (fmt pos kw)
  (with-output-to-string (out)
    (let ((i 0) (n (length fmt)) (auto 0))
      (loop while (< i n)
            do (let ((c (char fmt i)))
                 (cond ((and (char= c #\{) (< (+ i 1) n) (char= (char fmt (+ i 1)) #\{))
                        (write-char #\{ out) (setq i (+ i 2)))
                       ((and (char= c #\}) (< (+ i 1) n) (char= (char fmt (+ i 1)) #\}))
                        (write-char #\} out) (setq i (+ i 2)))
                       ((char= c #\})
                        (error "format: single '}' in format"))
                       ((char= c #\{)
                        (let ((close (position #\} fmt :start i)))
                          (if (null close) (error "format: unmatched '{'"))
                          (let ((name (subseq fmt (+ i 1) close)))
                            (cond ((= (length name) 0)
                                   (if (>= auto (length pos)) (error "format: tuple index out of range"))
                                   (write-string (%sl-b-str (nth auto pos)) out)
                                   (setq auto (+ auto 1)))
                                  ((digit-char-p (char name 0))
                                   (let ((idx (%sl-parse-int name 10)))
                                     (if (>= idx (length pos)) (error "format: tuple index out of range"))
                                     (write-string (%sl-b-str (nth idx pos)) out)))
                                  (t
                                   (let ((found nil) (rest kw))
                                     (loop while rest
                                           do (if (string= (car rest) name)
                                                  (progn (write-string (%sl-b-str (cadr rest)) out)
                                                         (setq found t)))
                                              (setq rest (cddr rest)))
                                     (if (not found) (error "format: keyword ~a not found" name))))))
                          (setq i (+ close 1))))
                       (t (write-char c out) (setq i (+ i 1)))))))))

;;; "%s %d %r" % args
(defun %sl-percent (fmt args)
  (with-output-to-string (out)
    (let ((i 0) (n (length fmt)))
      (loop while (< i n)
            do (let ((c (char fmt i)))
                 (if (char/= c #\%)
                     (progn (write-char c out) (setq i (+ i 1)))
                     (progn
                       (if (>= (+ i 1) n) (error "incomplete format"))
                       (let ((d (char fmt (+ i 1))))
                         (if (char= d #\%)
                             (write-char #\% out)
                             (progn
                               (if (null args) (error "not enough arguments for format string"))
                               (let ((a (car args)))
                                 (setq args (cdr args))
                                 (cond ((char= d #\s) (write-string (%sl-b-str a) out))
                                       ((char= d #\r) (write-string (%sl-b-repr a) out))
                                       ((char= d #\d)
                                        (if (not (numberp a)) (error "%d format requires integer"))
                                        (format out "~d" (if (floatp a) (values (truncate a)) a)))
                                       ((char= d #\x) (format out "~(~x~)" a))
                                       ((char= d #\X) (format out "~:@(~x~)" a))
                                       ((char= d #\o) (format out "~o" a))
                                       (t (error "unsupported format character ~a" d)))))))
                       (setq i (+ i 2))))))
      (if args (error "too many arguments for format string")))))

;;; ---- test harness support ----
(defun %sl-chunk-report (n err)
  (if err (format t "CHUNK ~a ERROR ~a~%" n err) (format t "CHUNK ~a OK~%" n)))
