;;; drive.el --- drive a real SLIME against a SWANK server in batch mode -*- lexical-binding: t -*-
;; Usage: emacs --batch -l drive.el   (SWANK_PORT, DRV_DIR, DRV_STEPS in the environment)

(setq debug-on-error nil)
(defvar drv-slime-dir "@WORK@/dl/slime/slime-2.32")
(add-to-list 'load-path drv-slime-dir)
(add-to-list 'load-path (expand-file-name "contrib" drv-slime-dir))
(require 'slime)
(slime-setup '(slime-fancy))
(setq slime-repl-auto-right-margin nil)
(setq slime-load-failed-fasl 'never)
(setq slime-repl-history-file (expand-file-name "repl-history.eld" (getenv "DRV_DIR")))

(defvar drv-port (string-to-number (getenv "SWANK_PORT")))
(defvar drv-dir (getenv "DRV_DIR"))
(defvar drv-messages '())

(advice-add 'message :around
            (lambda (orig fmt &rest args)
              (when fmt
                (let ((text (apply #'format fmt args)))
                  (push text drv-messages)
                  (princ (format "MSG: %s\n" text) #'external-debugging-output)))
              (apply orig fmt args)))

(defun drv-log (fmt &rest args)
  (princ (concat (apply #'format fmt args) "\n") #'external-debugging-output))

(defun drv-wait (name pred timeout)
  (let ((end (time-add (current-time) (seconds-to-time timeout))))
    (while (not (funcall pred))
      (when (time-less-p end (current-time))
        (drv-log "TIMEOUT waiting for %s" name)
        (throw 'drv-timeout name))
      (accept-process-output nil 0.05))))

(defun drv-top-level-p ()
  (and (not (sldb-get-default-buffer))
       (null (slime-rex-continuations))))

(defun drv-settle (&optional timeout)
  (drv-wait "top level" #'drv-top-level-p (or timeout 30))
  (let ((end (time-add (current-time) (seconds-to-time 0.3))))
    (while (time-less-p (current-time) end)
      (accept-process-output nil 0.05))))

(defun drv-repl (string)
  (drv-log "== REPL %s" string)
  (with-current-buffer (slime-output-buffer)
    (goto-char (point-max))
    (insert string)
    (slime-repl-return))
  (drv-settle))

(defun drv-repl-text ()
  (with-current-buffer (slime-output-buffer)
    (buffer-substring-no-properties (point-min) (point-max))))

(defun drv-source-buffer (name contents)
  (let ((file (expand-file-name name drv-dir)))
    (with-temp-file file (insert contents))
    (let ((buffer (find-file-noselect file)))
      (with-current-buffer buffer
        (lisp-mode)
        (slime-mode 1))
      buffer)))

(defun drv-step (name thunk)
  (drv-log "== STEP %s" name)
  (catch 'drv-timeout
    (condition-case err
        (funcall thunk)
      (error (drv-log "STEP-ERROR %s: %S" name err)))))

(slime-connect "127.0.0.1" drv-port)
(drv-wait "connection" (lambda () (and (slime-connected-p)
                                       (cl-some (lambda (b) (string-prefix-p "*slime-repl" (buffer-name b)))
                                                (buffer-list))))
          60)
(drv-settle)
(drv-log "CONNECTED %s %s" (slime-lisp-implementation-name) (slime-lisp-package))

(defvar drv-steps (split-string (or (getenv "DRV_STEPS") "basic") ","))

(when (member "basic" drv-steps)
  (drv-step "repl-values"
            (lambda ()
              (drv-repl "(+ 1 2)")
              (drv-repl "(progn (format t \"hello~%\") (values 1 \"two\"))")
              (drv-repl "(values)")
              (drv-repl "(princ \"no newline\")")
              (drv-repl "(defvar *drv* 10)")
              (drv-repl "(list *drv* * ** ***)")))
  (drv-step "repl-package"
            (lambda ()
              (drv-repl "(defpackage :drv-pkg (:use :cl) (:export #:hello))")
              (drv-repl "(in-package :drv-pkg)")
              (drv-repl "(defun hello () 'hi)")
              (drv-repl "(list *package* (hello))")
              (drv-repl "(in-package :cl-user)")
              (drv-repl "(drv-pkg:hello)")))
  (drv-step "interactive-eval"
            (lambda ()
              (slime-interactive-eval "(+ 2 3)")
              (drv-settle)
              (slime-interactive-eval "(values 1 2)")
              (drv-settle)
              (slime-interactive-eval "(progn (print 'x) \"str\")")
              (drv-settle)
              (slime-interactive-eval "(values)")
              (drv-settle)
              (with-current-buffer (drv-source-buffer "drv-eval.lisp" "(in-package :drv-pkg)\n\n(* 6 7)\n")
                (goto-char (point-max))
                (slime-eval-last-expression)
                (drv-settle))))
  (drv-step "eval-and-grab-output"
            (lambda ()
              (drv-log "RESULT %S" (slime-eval '(swank:eval-and-grab-output "(progn (princ \"x\") (values 42 43))")))
              (drv-settle)))
  (drv-step "compile-defun"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-compile.lisp"
                                                      "(defun drv-add (a b)\n  (+ a b))\n\n(defun drv-bad ()\n  (drv-undefined-fn 1))\n")
                (goto-char (point-min))
                (forward-char 3)
                (slime-compile-defun)
                (drv-settle)
                (drv-log "NOTES %S" (slime-compiler-notes))
                (goto-char (point-max))
                (backward-char 5)
                (slime-compile-defun)
                (drv-settle)
                (drv-log "NOTES %S" (slime-compiler-notes)))
              (drv-repl "(drv-add 1 2)")))
  (drv-step "compile-file"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-file.lisp"
                                                      "(defun drv-file-fn (x)\n  (* x 2))\n\n(defun drv-file-warn ()\n  (let ((unused 1))\n    (drv-other-undefined)))\n")
                (slime-compile-and-load-file)
                (drv-settle)
                (drv-log "NOTES %S" (slime-compiler-notes)))
              (drv-repl "(drv-file-fn 21)")
              (slime-load-file (expand-file-name "drv-file.lisp" drv-dir))
              (drv-settle)))
  (drv-step "completions"
            (lambda ()
              (drv-log "SIMPLE %S" (slime-eval '(swank:simple-completions "mapc" "COMMON-LISP-USER")))
              (drv-log "SIMPLE2 %S" (slime-eval '(swank:simple-completions "drv-pkg:he" "COMMON-LISP-USER")))
              (drv-log "CPC %S" (slime-eval '(swank:completions "m-v-b" "COMMON-LISP-USER")))
              (drv-log "FUZZY %S" (slime-eval '(swank:fuzzy-completions "mvbind" "COMMON-LISP-USER" :limit 5 :time-limit-in-msec 1500)))
              (with-current-buffer (drv-source-buffer "drv-complete.lisp" "(mapc")
                (goto-char (point-max))
                (completion-at-point)
                (drv-settle)
                (drv-log "BUFFER %S" (buffer-string)))))
  (drv-step "autodoc"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-autodoc.lisp" "(mapcar ")
                (goto-char (point-max))
                (drv-log "AUTODOC1 %S" (slime-autodoc t))
                (drv-settle)
                (drv-log "AUTODOC2 %S" (slime-autodoc t)))
              (drv-log "ARGLIST %S" (slime-eval '(swank:operator-arglist "mapcar" "COMMON-LISP-USER")))
              (drv-log "ARGLIST2 %S" (slime-eval '(swank:operator-arglist "drv-add" "COMMON-LISP-USER")))
              (drv-log "AUTODOC3 %S" (slime-eval '(swank:autodoc '("drv-add" "1" swank::%cursor-marker%) :print-right-margin 80)))))
  (drv-step "describe"
            (lambda ()
              (drv-log "DESCRIBE %S" (slime-eval '(swank:describe-symbol "drv-add")))
              (drv-log "DOC %S" (slime-eval '(swank:documentation-symbol "mapcar")))))
  (drv-step "macroexpand"
            (lambda ()
              (drv-log "MX1 %S" (slime-eval '(swank:swank-macroexpand-1 "(when a b)")))
              (drv-log "MXALL %S" (slime-eval '(swank:swank-macroexpand-all "(when a (unless b c))")))
              (with-current-buffer (drv-source-buffer "drv-mx.lisp" "(when (zerop 0) (print 1))")
                (goto-char (point-min))
                (slime-macroexpand-1)
                (drv-settle))))
  (drv-step "set-package"
            (lambda ()
              (with-current-buffer (slime-output-buffer)
                (slime-repl-set-package "DRV-PKG"))
              (drv-settle)
              (drv-repl "(hello)")
              (drv-repl "(in-package :cl-user)")))
  (drv-step "error"
            (lambda ()
              (drv-repl "(error \"boom ~a\" 1)")
              (drv-log "SLDB %S" (and (sldb-get-default-buffer) t))
              (when (sldb-get-default-buffer)
                (with-current-buffer (sldb-get-default-buffer)
                  (drv-log "SLDB-TEXT %s" (buffer-substring-no-properties (point-min) (min (point-max) 600)))
                  (sldb-quit)))
              (drv-settle)
              (slime-interactive-eval "(car 1)")
              (accept-process-output nil 1)
              (when (sldb-get-default-buffer)
                (with-current-buffer (sldb-get-default-buffer)
                  (sldb-quit)))
              (drv-settle)))
  (drv-step "interrupt"
            (lambda ()
              (with-current-buffer (slime-output-buffer)
                (goto-char (point-max))
                (insert "(loop)")
                (slime-repl-return))
              (accept-process-output nil 1)
              (slime-interrupt)
              (accept-process-output nil 2)
              (drv-log "SLDB %S" (and (sldb-get-default-buffer) t))
              (when (sldb-get-default-buffer)
                (with-current-buffer (sldb-get-default-buffer)
                  (drv-log "SLDB-TEXT %s" (buffer-substring-no-properties (point-min) (min (point-max) 600)))
                  (sldb-quit)))
              (drv-settle)
              (drv-repl "(+ 40 2)"))))

(drv-log "== REPL-BUFFER\n%s\n== END-REPL-BUFFER" (drv-repl-text))
(drv-log "DONE")
(kill-emacs 0)
