              (drv-log "MXALL %S" (slime-eval '(swank:swank-macroexpand-all "(when a (unless b c))")))
              (with-current-buffer (drv-source-buffer "drv-mx.lisp" "(when (zerop 0) (print 1))")
                (goto-char (point-min))
                (slime-macroexpand-1)
                (drv-settle))))
  (drv-step "set-package"
            (lambda ()
              (with-current-buffer (slime-output-buffer)
                (slime-repl-set-package "DRV-PKG"))
              (drv-settle)
              (drv-repl "(hello)")
              (drv-repl "(in-package :cl-user)")))
  (drv-step "error"
            (lambda ()
              (drv-repl "(error \"boom ~a\" 1)")
              (drv-log "SLDB %S" (and (sldb-get-default-buffer) t))
              (when (sldb-get-default-buffer)
                (with-current-buffer (sldb-get-default-buffer)
                  (drv-log "SLDB-TEXT %s" (buffer-substring-no-properties (point-min) (min (point-max) 600)))
                  (sldb-quit)))
              (drv-settle)
              (slime-interactive-eval "(car 1)")
              (accept-process-output nil 1)
              (when (sldb-get-default-buffer)
                (with-current-buffer (sldb-get-default-buffer)
                  (sldb-quit)))
              (drv-settle)))
  (drv-step "interrupt"
            (lambda ()
              (with-current-buffer (slime-output-buffer)
                (goto-char (point-max))
                (insert "(loop)")
                (slime-repl-return))
              (accept-process-output nil 1)
              (slime-interrupt)
              (accept-process-output nil 2)
              (drv-log "SLDB %S" (and (sldb-get-default-buffer) t))
              (when (sldb-get-default-buffer)
                (with-current-buffer (sldb-get-default-buffer)
                  (drv-log "SLDB-TEXT %s" (buffer-substring-no-properties (point-min) (min (point-max) 600)))
                  (sldb-quit)))
              (drv-settle)
              (drv-repl "(+ 40 2)"))))

(defun drv-ev (label form)
  (drv-log "%s %S" label (condition-case err (slime-eval form) (error (list 'ERR err))))
  (drv-settle))

