;;; The SLDB steps: an error, a numbered restart, continue, abort, frames, an interrupt,
;;; a nested level.

(defun drv-sldb-level ()
  (let ((b (sldb-get-default-buffer)))
    (and b (buffer-live-p b) (with-current-buffer b sldb-level))))

(defun drv-wait-sldb (level &optional timeout)
  (drv-wait (format "sldb level %s" level)
            (lambda () (equal (drv-sldb-level) level))
            (or timeout 20))
  (let ((end (time-add (current-time) (seconds-to-time 0.3))))
    (while (time-less-p (current-time) end)
      (accept-process-output nil 0.05))))

(defun drv-sldb-text ()
  (with-current-buffer (sldb-get-default-buffer)
    (buffer-substring-no-properties (point-min) (point-max))))

(defun drv-repl-send (string)
  (drv-log "== REPL-SEND %s" string)
  (with-current-buffer (slime-output-buffer)
    (goto-char (point-max))
    (insert string)
    (slime-repl-return)))

(defun drv-in-sldb (fn)
  (with-current-buffer (sldb-get-default-buffer)
    (funcall fn)))

(defun drv-pause (seconds)
  (let ((end (time-add (current-time) (seconds-to-time seconds))))
    (while (time-less-p (current-time) end)
      (accept-process-output nil 0.05))))

(when (member "sldb" drv-steps)
  (drv-step "sldb-quit"
            (lambda ()
              (drv-repl-send "(error \"boom ~a\" 1)")
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb #'sldb-continue)
              (drv-pause 0.5)
              (drv-in-sldb #'sldb-quit)
              (drv-settle)))
  (drv-step "sldb-restart"
            (lambda ()
              (drv-repl-send "(restart-case (error \"pick ~a\" 2) (use-five () :report \"Return five.\" 5) (use-ten () 10))")
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb (lambda () (sldb-invoke-restart 0)))
              (drv-settle)))
  (drv-step "sldb-continue"
            (lambda ()
              (drv-repl-send "(progn (cerror \"Keep going.\" \"Cerror ~a\" 3) :went-on)")
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb #'sldb-continue)
              (drv-settle)))
  (drv-step "sldb-abort"
            (lambda ()
              (slime-interactive-eval "(car 1)")
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb #'sldb-abort)
              (drv-settle)))
  (drv-step "sldb-frames"
            (lambda ()
              (drv-repl "(defun drv-g (z) (list (error \"deep ~a\" z)))")
              (drv-repl "(defun drv-f (x) (let ((y (* x 2))) (list (drv-g y))))")
              (drv-repl-send "(drv-f 21)")
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (unwind-protect
                  (drv-in-sldb (lambda ()
                                 (drv-log "LOCALS0 %S" (slime-eval '(swank:frame-locals-and-catch-tags 0)))
                                 (drv-log "LOCALS1 %S" (slime-eval '(swank:frame-locals-and-catch-tags 1)))
                                 (drv-log "PKG %S" (slime-eval '(swank:frame-package-name 1)))
                                 (sldb-eval-in-frame 1 "(* x 2)" "COMMON-LISP-USER")
                                 (drv-pause 1)
                                 (drv-log "BT %S" (slime-eval '(swank:backtrace 1 3)))))
                (drv-in-sldb #'sldb-quit))
              (drv-settle)))
  (drv-step "sldb-interrupt"
            (lambda ()
              (drv-repl-send "(loop)")
              (drv-pause 1)
              (slime-interrupt)
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb #'sldb-continue)
              (drv-pause 1)
              (drv-log "AFTER-CONTINUE %S" (drv-sldb-level))
              (slime-interrupt)
              (drv-wait-sldb 1)
              (drv-in-sldb #'sldb-quit)
              (drv-settle)))
  (drv-step "sldb-nested"
            (lambda ()
              (drv-repl-send "(error \"outer\")")
              (drv-wait-sldb 1)
              (drv-repl-send "(error \"inner\")")
              (drv-wait-sldb 2)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb (lambda ()
                             (sldb-invoke-restart
                              (cl-position "Return to sldb level 1." sldb-restarts
                                           :key #'cadr :test #'string=))))
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb #'sldb-quit)
              (drv-settle)
              (drv-repl "(+ 40 2)"))))

;;; The frame steps: a loaded function's frame source, inspecting from SLDB, catch tags,
;;; restarting a frame and returning from one.

(defun drv-fev (label form)
  (drv-log "%s %S" label (condition-case err (slime-eval form) (error (list 'ERR err)))))

(defun drv-frex (label form)
  (slime-rex () (form)
    ((:ok value) (drv-log "%s OK %S" label value))
    ((:abort reason) (drv-log "%s ABORT %S" label reason))))

(when (member "frames" drv-steps)
  (drv-step "frames-setup"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-frames.lisp"
                                                      "(defun drv-xg (z)\n  (list (error \"deep ~a\" z)))\n\n(defun drv-xf (x)\n  (let ((y (* x 2)))\n    (catch 'drv-tag\n      (list (drv-xg y)))))\n")
                (slime-load-file (buffer-file-name))
                (drv-settle))
              (drv-repl "(defvar *drv-xn* 0)")
              (drv-repl "(defun drv-xh (a) (incf *drv-xn*) (if (< *drv-xn* 2) (error \"once ~a\" a) (list :done a *drv-xn*)))")
              (drv-repl "(defun drv-xk (b) (list (drv-xh b)))")
              (drv-repl "(defun drv-xr (c) (list (error \"ret ~a\" c)))")))
  (drv-step "frames-source-inspect"
            (lambda ()
              (drv-repl-send "(drv-xf 21)")
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (unwind-protect
                  (drv-in-sldb (lambda ()
                                 (dotimes (i 4)
                                   (drv-fev (format "SOURCE%d" i) `(swank:frame-source-location ,i)))
                                 (drv-fev "LOCALS0" '(swank:frame-locals-and-catch-tags 0))
                                 (drv-fev "LOCALS1" '(swank:frame-locals-and-catch-tags 1))
                                 (drv-fev "INSPECT-IN-FRAME" '(swank:inspect-in-frame "(list x 1)" 1))
                                 (drv-fev "INSPECT-CONDITION" '(swank:inspect-current-condition))
                                 (drv-fev "INSPECT-VAR" '(swank:inspect-frame-var 1 0))
                                 (drv-fev "INSPECT-QUIT" '(swank:quit-inspector))))
                (drv-in-sldb #'sldb-quit))
              (drv-settle)))
  (drv-step "frames-repl-source"
            (lambda ()
              (drv-repl-send "(drv-xr 1)")
              (drv-wait-sldb 1)
              (unwind-protect
                  (drv-in-sldb (lambda ()
                                 (drv-fev "SOURCE-REPL0" '(swank:frame-source-location 0))
                                 (drv-fev "SOURCE-REPL1" '(swank:frame-source-location 1))
                                 (drv-fev "CANNOT-RETURN" '(swank:sldb-return-from-frame 1 "1"))
                                 (drv-fev "CANNOT-RESTART" '(swank:restart-frame 1))))
                (drv-in-sldb #'sldb-quit))
              (drv-settle)))
  (drv-step "frames-restart"
            (lambda ()
              (drv-repl-send "(drv-xk 7)")
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb (lambda () (drv-frex "RESTART" '(swank:restart-frame 0))))
              (drv-settle)))
  (drv-step "frames-return"
            (lambda ()
              (drv-repl-send "(list (drv-xr 1) :after)")
              (drv-wait-sldb 1)
              (drv-in-sldb (lambda () (drv-frex "RETURN" '(swank:sldb-return-from-frame 0 "(+ 40 2)"))))
              (drv-settle)))
  (drv-step "frames-restart-outer"
            (lambda ()
              (drv-repl "(setq *drv-xn* 0)")
              (drv-repl-send "(drv-xk 9)")
              (drv-wait-sldb 1)
              (drv-in-sldb (lambda () (drv-frex "RESTART-OUTER" '(swank:restart-frame 1))))
              (drv-settle))))

(drv-log "== REPL-BUFFER\n%s\n== END-REPL-BUFFER" (drv-repl-text))
(drv-log "DONE")
(kill-emacs 0)
