(require :sb-introspect)
;; Writes "name (lambda-list)" per fbound external symbol of COMMON-LISP, the lambda list
;; as an editor shows it: parameter names only (no defaults, supplied-p or &aux), every
;; symbol a bare downcased name.
(defun bare (x)
  (cond ((and (symbolp x) x (not (eq x t)) (not (keywordp x))) (intern (symbol-name x) :cl-user))
        ((consp x) (cons (bare (car x)) (bare (cdr x))))
        (t x)))
(defun simplify (ll)
  (let ((out '()) (mode nil))
    (loop for rest on ll
          for item = (car rest)
          do (cond ((member item '(&aux)) (return))
                   ((member item '(&whole &environment)) (setf mode :skip-next))
                   ((member item lambda-list-keywords) (setf mode item) (push item out))
                   ((eq mode :skip-next) (setf mode nil))
                   ((member mode '(&optional &key))
                    (push (let ((name (if (consp item) (car item) item)))
                            (if (consp name) (cadr name) name))
                          out))
                   ((and (null mode) (consp item)) (push (simplify item) out))
                   (t (push item out)))
          finally (unless (listp (cdr (last ll))) nil))
    (let ((dotted (cdr (last ll))))
      (if dotted
          (append (nreverse out) (list '&rest dotted))
          (nreverse out)))))
(let ((rows '()))
  (do-external-symbols (s :cl)
    (when (fboundp s)
      (let ((ll (sb-introspect:function-lambda-list s)))
        (push (cons (symbol-name s) (simplify ll)) rows))))
  (setf rows (sort rows #'string< :key #'car))
  (with-open-file (out (car (last sb-ext:*posix-argv*)) :direction :output :if-exists :supersede)
    (with-standard-io-syntax
      (let ((*package* (find-package :cl-user))
            (*print-readably* nil)
            (*print-case* :downcase))
        (dolist (row rows)
          (format out "~a ~s~%" (string-downcase (car row)) (bare (cdr row))))))))
