(defun emit (n)
  (let ((out (make-string-output-stream)))
    (dotimes (i n) (write-char (code-char (+ 97 (rem i 26))) out))
    (length (get-output-stream-string out))))

(defun emit-push (n)
  (let ((out (make-array 16 :element-type 'character :adjustable t :fill-pointer 0)))
    (dotimes (i n) (vector-push-extend (code-char (+ 97 (rem i 26))) out))
    (length (%normalize-string (subseq out 0 (length out))))))

(defun emit-string (n)
  (let ((out (make-string 16)) (at 0))
    (dotimes (i n)
      (if (>= at (length out))
          (let ((wider (make-string (* 2 (length out)))))
            (replace wider out)
            (setq out wider)))
      (setf (char out at) (code-char (+ 97 (rem i 26))))
      (setq at (+ at 1)))
    (length (%normalize-string (subseq out 0 at)))))

(defun timeit (name thunk)
  (let ((start (get-internal-real-time)))
    (let ((value (funcall thunk)))
      (format t "~a ~a ms ~a~%" name (- (get-internal-real-time) start) value))))

(dotimes (round 2)
  (timeit "write-char x1e6" (lambda () (emit 1000000)))
  (timeit "push-extend x1e6" (lambda () (emit-push 1000000)))
  (timeit "setf-char grow x1e6" (lambda () (emit-string 1000000)))
  (timeit "write-char 30 x 30000" (lambda () (let ((s 0)) (dotimes (k 30000) (setq s (+ s (emit 30)))) s)))
  (timeit "push-extend 30 x 30000" (lambda () (let ((s 0)) (dotimes (k 30000) (setq s (+ s (emit-push 30)))) s)))
  (timeit "setf-char 30 x 30000" (lambda () (let ((s 0)) (dotimes (k 30000) (setq s (+ s (emit-string 30)))) s))))
