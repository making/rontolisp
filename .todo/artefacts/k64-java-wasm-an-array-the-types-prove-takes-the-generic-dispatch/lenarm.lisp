(defun count-declared (v n)
  (declare (type (simple-array t (*)) v))
  (let ((s 0) (r 0))
    (loop while (< r n)
          do (let ((i 0))
               (loop while (< i (length v))
                     do (setq s (logand (+ s i) 1073741823))
                        (setq i (logand (+ i 1) 1073741823))))
             (setq r (logand (+ r 1) 1073741823)))
    s))
(defun count-undeclared (v n)
  (let ((s 0) (r 0))
    (loop while (< r n)
          do (let ((i 0))
               (loop while (< i (length v))
                     do (setq s (logand (+ s i) 1073741823))
                        (setq i (logand (+ i 1) 1073741823))))
             (setq r (logand (+ r 1) 1073741823)))
    s))
(let ((v (make-array 1000 :initial-element 0)) (start (get-internal-real-time)))
  (print (count-declared v 100000))
  (print (- (get-internal-real-time) start))
  (setq start (get-internal-real-time))
  (print (count-undeclared v 100000))
  (print (- (get-internal-real-time) start)))
