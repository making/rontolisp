(defvar *n* 0)
(rontolisp:async-defun late (n ms)
  (rontolisp:await (rontolisp:wait-for ms))
  (format t "late ~a~%" n)
  (finish-output))
(rontolisp:async-defun app (env)
  (setq *n* (+ *n* 1))
  (let ((n *n*) (path (getf env :path-info)))
    (format t "enter ~a ~a~%" n path) (finish-output)
    (cond ((string= path "/slow")
           (rontolisp:await (rontolisp:wait-for 2000))
           (format t "leave ~a~%" n) (finish-output)
           (list 200 nil (list (format nil "slow ~a now ~a" n *n*))))
          ((string= path "/bg")
           (late n 1500)
           (list 200 nil (list (format nil "bg ~a" n))))
          (t (list 200 nil (list (format nil "fast ~a" n)))))))
(rontolisp:http-handler 'app 8080)
