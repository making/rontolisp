(component
  (core module $tm
    (table (export "t") 2 funcref))
  (core instance $ti (instantiate $tm))
  (core type $start (func (param i32)))
  (core func $new (canon thread.new-indirect $start (table $ti "t")))
  (core func $switch (canon thread.switch-to))
  (core func $suspend (canon thread.suspend))
  (core func $later (canon thread.resume-later))
  (core func $index (canon thread.index))
  (core module $m
    (type $start (func (param i32)))
    (import "b" "new" (func $new (param i32 i32) (result i32)))
    (import "b" "switch" (func $switch (param i32) (result i32)))
    (import "b" "later" (func $later (param i32)))
    (import "b" "index" (func $index (result i32)))
    (import "b" "t" (table $t 2 funcref))
    (type $box (struct (field (mut i32))))
    (type $arr (array (mut i32)))
    (global $n (mut i32) (i32.const 0))
    (global $done (mut i32) (i32.const 0))
    (global $main (mut i32) (i32.const 0))
    (func $deep (param $d i32) (param $mine (ref $box))
      (if (i32.eqz (local.get $d))
        (then (drop (call $switch (global.get $main))))
        (else (call $deep (i32.sub (local.get $d) (i32.const 1)) (local.get $mine))))
      (global.set $n (i32.add (global.get $n) (struct.get $box 0 (local.get $mine)))))
    (func $worker (type $start) (param i32)
      (local $i i32)
      (loop $l
        (call $deep (i32.const 20) (struct.new $box (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $l (i32.lt_u (local.get $i) (i32.const ROUNDS))))
      (global.set $done (i32.const 1))
      (call $later (global.get $main)))
    (elem (table $t) (i32.const 0) func $worker)
    (func (export "run") (result i32)
      (local $w i32) (local $junk (ref null $arr))
      (global.set $main (call $index))
      (local.set $w (call $new (i32.const 0) (i32.const 0)))
      (loop $again
        (drop (call $switch (local.get $w)))
        (local.set $junk (array.new $arr (i32.const 0) (i32.const JUNK)))
        (br_if $again (i32.eqz (global.get $done))))
      (global.get $n)))
  (core instance $i (instantiate $m (with "b" (instance
    (export "new" (func $new)) (export "switch" (func $switch)) (export "later" (func $later))
    (export "index" (func $index)) (export "t" (table $ti "t"))))))
  (func (export "run") (result u32) (canon lift (core func $i "run"))))
