;;; drive-sly.el --- drive a real SLY against a Slynk server in batch mode -*- lexical-binding: t -*-
;; Usage: emacs --batch -l drive-sly.el   (SLYNK_PORT, DRV_DIR, DRV_STEPS, DRV_SLY_DIR in the environment)

(setq debug-on-error nil)
(defvar drv-sly-dir (getenv "DRV_SLY_DIR"))
(add-to-list 'load-path drv-sly-dir)
(add-to-list 'load-path (expand-file-name "contrib" drv-sly-dir))
(add-to-list 'load-path (expand-file-name "lib" drv-sly-dir))
(require 'sly)
(sly-setup '(sly-fancy))
(setq sly-mrepl-history-file-name (expand-file-name "mrepl-history" (getenv "DRV_DIR")))
(setq sly-mrepl-pop-sylvester nil)
(setq sly-auto-start nil)

(defvar drv-port (string-to-number (getenv "SLYNK_PORT")))
(defvar drv-dir (getenv "DRV_DIR"))

(advice-add 'message :around
            (lambda (orig fmt &rest args)
              (when fmt
                (let ((text (apply #'format fmt args)))
                  (princ (format "MSG: %s\n" text) #'external-debugging-output)))
              (apply orig fmt args)))

(defun drv-log (fmt &rest args)
  (princ (concat (apply #'format fmt args) "\n") #'external-debugging-output))

(defun drv-wait (name pred timeout)
  (let ((end (time-add (current-time) (seconds-to-time timeout))))
    (while (not (funcall pred))
      (when (time-less-p end (current-time))
        (drv-log "TIMEOUT waiting for %s" name)
        (throw 'drv-timeout name))
      (accept-process-output nil 0.05))))

(defun drv-repl-buffer () (sly-mrepl--find-buffer))

(defun drv-top-level-p ()
  (and (not (sly-db-get-default-buffer))
       (null (sly-rex-continuations))
       (let ((b (drv-repl-buffer)))
         (or (null b) (with-current-buffer b (not (sly-mrepl--busy-p)))))))

(defun drv-settle (&optional timeout)
  (drv-wait "top level" #'drv-top-level-p (or timeout 30))
  (let ((end (time-add (current-time) (seconds-to-time 0.3))))
    (while (time-less-p (current-time) end)
      (accept-process-output nil 0.05))))

(defun drv-repl (string)
  (drv-log "== REPL %s" string)
  (with-current-buffer (drv-repl-buffer)
    (goto-char (point-max))
    (insert string)
    (sly-mrepl-return))
  (drv-settle))

(defun drv-repl-text ()
  (with-current-buffer (drv-repl-buffer)
    (buffer-substring-no-properties (point-min) (point-max))))

(defun drv-source-buffer (name contents)
  (let ((file (expand-file-name name drv-dir)))
    (with-temp-file file (insert contents))
    (let ((buffer (find-file-noselect file)))
      (with-current-buffer buffer
        (lisp-mode)
        (sly-mode 1))
      buffer)))

(defun drv-step (name thunk)
  (drv-log "== STEP %s" name)
  (catch 'drv-timeout
    (condition-case err
        (funcall thunk)
      (error (drv-log "STEP-ERROR %s: %S" name err)))))

(sly-connect "127.0.0.1" drv-port)
(drv-wait "connection" (lambda () (and (sly-connected-p) (drv-repl-buffer))) 60)
(drv-settle)
(drv-log "CONNECTED %s" (sly-lisp-implementation-name))

(defvar drv-steps (split-string (or (getenv "DRV_STEPS") "basic") ","))

(when (member "basic" drv-steps)
  (drv-step "repl-values"
            (lambda ()
              (drv-repl "(+ 1 2)")
              (drv-repl "(progn (format t \"hello~%\") (values 1 \"two\"))")
              (drv-repl "(values)")
              (drv-repl "(princ \"no newline\")")
              (drv-repl "(defvar *drv* 10)")
              (drv-repl "(list *drv* * ** ***)")))
  (drv-step "repl-package"
            (lambda ()
              (drv-repl "(defpackage :drv-pkg (:use :cl) (:export #:hello))")
              (drv-repl "(in-package :drv-pkg)")
              (drv-repl "(defun hello () 'hi)")
              (drv-repl "(list (package-name *package*) (hello))")
              (drv-repl "(in-package :cl-user)")
              (drv-repl "(drv-pkg:hello)")))
  (drv-step "repl-input"
            (lambda ()
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "(list (read-line) 7)")
                (sly-mrepl-return))
              (accept-process-output nil 1)
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "typed")
                (sly-mrepl-return))
              (drv-settle)))
  (drv-step "interactive-eval"
            (lambda ()
              (sly-interactive-eval "(+ 2 3)")
              (drv-settle)
              (sly-interactive-eval "(values 1 2)")
              (drv-settle)
              (sly-interactive-eval "(progn (print 'x) \"str\")")
              (drv-settle)
              (sly-interactive-eval "(values)")
              (drv-settle)
              (with-current-buffer (drv-source-buffer "drv-eval.lisp" "(in-package :drv-pkg)\n\n(* 6 7)\n")
                (goto-char (point-max))
                (sly-eval-last-expression)
                (drv-settle))))
  (drv-step "eval-and-grab-output"
            (lambda ()
              (drv-log "RESULT %S" (sly-eval '(slynk:eval-and-grab-output "(progn (princ \"x\") (values 42 43))")))
              (drv-settle)))
  (drv-step "compile-defun"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-compile.lisp"
                                                      "(defun drv-add (a b)\n  (+ a b))\n\n(defun drv-bad ()\n  (drv-undefined-fn 1))\n")
                (goto-char (point-min))
                (forward-char 3)
                (sly-compile-defun)
                (drv-settle)
                (drv-log "NOTES %S" (sly-compiler-notes))
                (goto-char (point-max))
                (backward-char 5)
                (sly-compile-defun)
                (drv-settle)
                (drv-log "NOTES %S" (sly-compiler-notes)))
              (drv-repl "(drv-add 1 2)")))
  (drv-step "compile-file"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-file.lisp"
                                                      "(defun drv-file-fn (x)\n  (* x 2))\n\n(defun drv-file-warn ()\n  (let ((unused 1))\n    (drv-other-undefined)))\n")
                (sly-compile-and-load-file)
                (drv-settle)
                (drv-log "NOTES %S" (sly-compiler-notes)))
              (drv-repl "(drv-file-fn 21)")
              (sly-load-file (expand-file-name "drv-file.lisp" drv-dir))
              (drv-settle)))
  (drv-step "completions"
            (lambda ()
              (drv-log "SIMPLE %S" (sly-eval '(slynk-completion:simple-completions "mapc" "COMMON-LISP-USER")))
              (drv-log "SIMPLE2 %S" (sly-eval '(slynk-completion:simple-completions "drv-pkg:he" "COMMON-LISP-USER")))
              (drv-log "FLEX %S" (sly-eval '(slynk-completion:flex-completions "mvbind" "COMMON-LISP-USER")))
              (with-current-buffer (drv-source-buffer "drv-complete.lisp" "(drv-ad")
                (goto-char (point-max))
                (completion-at-point)
                (drv-settle)
                (drv-log "BUFFER %S" (buffer-string)))
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "(multiple-value-bi")
                (completion-at-point)
                (drv-settle)
                (drv-log "REPL-INPUT %S" (buffer-substring-no-properties (sly-mrepl--mark) (point-max)))
                (delete-region (sly-mrepl--mark) (point-max)))))
  (drv-step "autodoc"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-autodoc.lisp" "(mapcar ")
                (goto-char (point-max))
                (drv-log "AUTODOC1 %S" (sly-autodoc t))
                (drv-settle)
                (drv-log "AUTODOC2 %S" (sly-autodoc t)))
              (drv-log "ARGLIST %S" (sly-eval '(slynk:operator-arglist "mapcar" "COMMON-LISP-USER")))
              (drv-log "AUTODOC3 %S" (sly-eval '(slynk:autodoc '("drv-add" "1" slynk::%cursor-marker%) :print-right-margin 80)))))
  (drv-step "describe"
            (lambda ()
              (drv-log "DESCRIBE %S" (sly-eval '(slynk:describe-symbol "drv-add")))
              (drv-log "DOC %S" (sly-eval '(slynk:documentation-symbol "mapcar")))))
  (drv-step "macroexpand"
            (lambda ()
              (drv-log "MX1 %S" (sly-eval '(slynk:slynk-macroexpand-1 "(when a b)")))
              (with-current-buffer (drv-source-buffer "drv-mx.lisp" "(when (zerop 0) (print 1))")
                (goto-char (point-min))
                (sly-macroexpand-1)
                (drv-settle))))
  (drv-step "error"
            (lambda ()
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "(error \"boom ~a\" 1)")
                (sly-mrepl-return))
              (accept-process-output nil 2)
              (drv-log "SLY-DB %S" (and (sly-db-get-default-buffer) t))
              (when (sly-db-get-default-buffer)
                (with-current-buffer (sly-db-get-default-buffer)
                  (drv-log "SLY-DB-TEXT %s" (buffer-substring-no-properties (point-min) (min (point-max) 600)))
                  (sly-db-quit)))
              (drv-settle)
              (sly-interactive-eval "(car 1)")
              (accept-process-output nil 1)
              (when (sly-db-get-default-buffer)
                (with-current-buffer (sly-db-get-default-buffer)
                  (sly-db-quit)))
              (drv-settle)
              (drv-repl "(+ 40 2)")))
  (drv-step "interrupt"
            (lambda ()
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "(loop)")
                (sly-mrepl-return))
              (accept-process-output nil 1)
              (with-current-buffer (drv-repl-buffer)
                (sly-interrupt))
              (accept-process-output nil 2)
              (drv-log "SLY-DB %S" (and (sly-db-get-default-buffer) t))
              (when (sly-db-get-default-buffer)
                (with-current-buffer (sly-db-get-default-buffer)
                  (drv-log "SLY-DB-TEXT %s" (buffer-substring-no-properties (point-min) (min (point-max) 600)))
                  (sly-db-quit)))
              (drv-settle)
              (drv-repl "(+ 40 3)"))))


(defun drv-ev (label form)
  (drv-log "%s %S" label (condition-case err (sly-eval form) (error (list 'ERR err))))
  (drv-settle))

(defun drv-sldb-level ()
  (let ((b (sly-db-get-default-buffer)))
    (and b (buffer-live-p b) (with-current-buffer b sly-db-level))))

(defun drv-pause (seconds)
  (let ((end (time-add (current-time) (seconds-to-time seconds))))
    (while (time-less-p (current-time) end)
      (accept-process-output nil 0.05))))

(defun drv-wait-sldb (level &optional timeout)
  (drv-wait (format "sly-db level %s" level)
            (lambda () (equal (drv-sldb-level) level))
            (or timeout 20))
  (drv-pause 0.3))

(defun drv-sldb-text ()
  (with-current-buffer (sly-db-get-default-buffer)
    (buffer-substring-no-properties (point-min) (min (point-max) 900))))

(defun drv-repl-send (string)
  (drv-log "== REPL-SEND %s" string)
  (with-current-buffer (drv-repl-buffer)
    (goto-char (point-max))
    (insert string)
    (sly-mrepl-return)))

(defun drv-in-sldb (fn)
  (with-current-buffer (sly-db-get-default-buffer)
    (funcall fn)))

(when (member "sldb" drv-steps)
  (drv-step "sldb-restart"
            (lambda ()
              (drv-repl-send "(restart-case (error \"pick ~a\" 2) (use-five () :report \"Return five.\" 5) (use-ten () 10))")
              (drv-wait-sldb 1)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb (lambda () (sly-db-invoke-restart 0)))
              (drv-settle)))
  (drv-step "sldb-continue"
            (lambda ()
              (drv-repl-send "(progn (cerror \"Keep going.\" \"Cerror ~a\" 3) :went-on)")
              (drv-wait-sldb 1)
              (drv-in-sldb #'sly-db-continue)
              (drv-settle)))
  (drv-step "sldb-abort"
            (lambda ()
              (sly-interactive-eval "(car 1)")
              (drv-wait-sldb 1)
              (drv-in-sldb #'sly-db-abort)
              (drv-settle)))
  (drv-step "sldb-frames"
            (lambda ()
              (drv-repl "(defun drv-g (z) (list (error \"deep ~a\" z)))")
              (drv-repl "(defun drv-f (x) (let ((y (* x 2))) (list (drv-g y))))")
              (drv-repl-send "(drv-f 21)")
              (drv-wait-sldb 1)
              (unwind-protect
                  (drv-in-sldb (lambda ()
                                 (drv-log "LOCALS0 %S" (sly-eval '(slynk:frame-locals-and-catch-tags 0)))
                                 (drv-log "LOCALS1 %S" (sly-eval '(slynk:frame-locals-and-catch-tags 1)))
                                 (drv-log "PKG %S" (sly-eval '(slynk:frame-package-name 1)))
                                 (sly-db-eval-in-frame 1 "(* x 2)" "COMMON-LISP-USER")
                                 (drv-pause 1)
                                 (drv-log "BT %S" (sly-eval '(slynk:backtrace 1 3)))))
                (drv-in-sldb #'sly-db-quit))
              (drv-settle)))
  (drv-step "sldb-interrupt"
            (lambda ()
              (drv-repl-send "(loop)")
              (drv-pause 1)
              (with-current-buffer (drv-repl-buffer) (sly-interrupt))
              (drv-wait-sldb 1)
              (drv-in-sldb #'sly-db-continue)
              (drv-pause 1)
              (drv-log "AFTER-CONTINUE %S" (drv-sldb-level))
              (with-current-buffer (drv-repl-buffer) (sly-interrupt))
              (drv-wait-sldb 1)
              (drv-in-sldb #'sly-db-quit)
              (drv-settle)))
  (drv-step "sldb-nested"
            (lambda ()
              (drv-repl-send "(error \"outer\")")
              (drv-wait-sldb 1)
              (drv-repl-send "(+ 1 1)")
              (drv-pause 1)
              (drv-repl-send "(error \"inner\")")
              (drv-wait-sldb 2)
              (drv-log "SLDB-TEXT %s" (drv-sldb-text))
              (drv-in-sldb (lambda ()
                             (sly-db-invoke-restart
                              (cl-position "Return to sly-db level 1." sly-db-restarts
                                           :key #'cadr :test #'string=))))
              (drv-wait-sldb 1)
              (drv-in-sldb #'sly-db-quit)
              (drv-settle)
              (drv-repl "(+ 40 2)"))))

(when (member "nav" drv-steps)
  (drv-step "nav-setup"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-nav.lisp"
                                                      "(defvar *drv-var* 1)\n\n(defmacro drv-mac (x)\n  `(list ,x *drv-var*))\n\n(defun drv-callee (a)\n  \"Callee doc.\"\n  (* a 2))\n\n(defun drv-caller (b)\n  (let ((*drv-var* 2))\n    (setq *drv-var* 3)\n    (drv-mac (drv-callee b))))\n\n(defgeneric drv-gen (o))\n\n(defclass drv-point () ((x :initarg :x :accessor drv-point-x) (y :initform 5)))\n\n(defmethod drv-gen ((o drv-point)) (drv-callee 1))\n\n(defstruct drv-st a b)\n")
                (sly-compile-and-load-file)
                (drv-settle))
              (drv-repl "(defun drv-repl-fn () (drv-callee 3))")))
  (drv-step "definitions"
            (lambda ()
              (dolist (name '("drv-callee" "drv-mac" "*drv-var*" "drv-gen" "drv-point" "drv-repl-fn" "mapcar" "no-such-thing"))
                (drv-ev (format "DEFS %s" name) `(slynk:find-definitions-for-emacs ,name)))))
  (drv-step "xref"
            (lambda ()
              (dolist (type '(:calls :calls-who :references :callers :callees))
                (drv-ev (format "XREF %s" type) `(slynk:xref ,type "drv-callee")))
              (drv-ev "XREF references var" '(slynk:xref :references "*drv-var*"))
              (drv-ev "XREFS" '(slynk:xrefs '(:calls :calls-who) "drv-callee"))))
  (drv-step "inspector"
            (lambda ()
              (drv-ev "INSPECT list" '(slynk:eval-for-inspector nil nil 'slynk:init-inspector "(list 1 \"two\" 'three)"))
              (drv-ev "INSPECT nth 1" '(slynk:eval-for-inspector nil nil 'slynk:inspect-nth-part 1))
              (drv-ev "INSPECT pop" '(slynk:eval-for-inspector nil nil 'slynk:inspector-pop))
              (drv-ev "INSPECT quit" '(slynk:eval-for-inspector nil nil 'slynk:quit-inspector))
              (drv-ev "INSPECT hash" (quote (slynk:eval-for-inspector nil nil (quote slynk:init-inspector) "(let ((h (make-hash-table))) (setf (gethash :a h) 1) h)")))
              (sly-inspect "(list 1 2)")
              (drv-settle)
              (drv-log "INSPECTOR-BUFFERS %S" (mapcar #'buffer-name (buffer-list)))))
  (drv-step "entries"
            (lambda ()
              (drv-repl "(list 1 \"two\" 'three)")
              (drv-repl "(values 7 8)")
              (let ((remote (with-current-buffer (drv-repl-buffer) sly-mrepl--remote-channel)))
                (drv-log "REMOTE %S" remote)
                (with-current-buffer (drv-repl-buffer) (drv-ev "ENTRY inspect" `(slynk:eval-for-inspector nil nil 'slynk-mrepl:inspect-entry ,remote 1 0)))
                (with-current-buffer (drv-repl-buffer) (drv-ev "ENTRY inspect 2 1" `(slynk:eval-for-inspector nil nil 'slynk-mrepl:inspect-entry ,remote 2 1)))
                (with-current-buffer (drv-repl-buffer) (drv-ev "ENTRY describe" `(slynk-mrepl:describe-entry ,remote 2 0)))
                (with-current-buffer (drv-repl-buffer) (drv-ev "ENTRY pprint" `(slynk-mrepl:pprint-entry ,remote 1 0))))
              (drv-repl "(list (length #v1) #v2:1 #v2)"))))

(drv-log "== REPL-BUFFER\n%s\n== END-REPL-BUFFER" (drv-repl-text))
(drv-log "DONE")
(kill-emacs 0)
