;;; drive-sly.el --- drive a real SLY against a Slynk server in batch mode -*- lexical-binding: t -*-
;; Usage: emacs --batch -l drive-sly.el   (SLYNK_PORT, DRV_DIR, DRV_STEPS, DRV_SLY_DIR in the environment)

(setq debug-on-error nil)
(defvar drv-sly-dir (getenv "DRV_SLY_DIR"))
(add-to-list 'load-path drv-sly-dir)
(add-to-list 'load-path (expand-file-name "contrib" drv-sly-dir))
(add-to-list 'load-path (expand-file-name "lib" drv-sly-dir))
(require 'sly)
(sly-setup '(sly-fancy))
(setq sly-mrepl-history-file-name (expand-file-name "mrepl-history" (getenv "DRV_DIR")))
(setq sly-mrepl-pop-sylvester nil)
(setq sly-auto-start nil)

(defvar drv-port (string-to-number (getenv "SLYNK_PORT")))
(defvar drv-dir (getenv "DRV_DIR"))

(advice-add 'message :around
            (lambda (orig fmt &rest args)
              (when fmt
                (let ((text (apply #'format fmt args)))
                  (princ (format "MSG: %s\n" text) #'external-debugging-output)))
              (apply orig fmt args)))

(defun drv-log (fmt &rest args)
  (princ (concat (apply #'format fmt args) "\n") #'external-debugging-output))

(defun drv-wait (name pred timeout)
  (let ((end (time-add (current-time) (seconds-to-time timeout))))
    (while (not (funcall pred))
      (when (time-less-p end (current-time))
        (drv-log "TIMEOUT waiting for %s" name)
        (throw 'drv-timeout name))
      (accept-process-output nil 0.05))))

(defun drv-repl-buffer () (sly-mrepl--find-buffer))

(defun drv-top-level-p ()
  (and (not (sly-db-get-default-buffer))
       (null (sly-rex-continuations))
       (let ((b (drv-repl-buffer)))
         (or (null b) (with-current-buffer b (not (sly-mrepl--busy-p)))))))

(defun drv-settle (&optional timeout)
  (drv-wait "top level" #'drv-top-level-p (or timeout 30))
  (let ((end (time-add (current-time) (seconds-to-time 0.3))))
    (while (time-less-p (current-time) end)
      (accept-process-output nil 0.05))))

(defun drv-repl (string)
  (drv-log "== REPL %s" string)
  (with-current-buffer (drv-repl-buffer)
    (goto-char (point-max))
    (insert string)
    (sly-mrepl-return))
  (drv-settle))

(defun drv-repl-text ()
  (with-current-buffer (drv-repl-buffer)
    (buffer-substring-no-properties (point-min) (point-max))))

(defun drv-source-buffer (name contents)
  (let ((file (expand-file-name name drv-dir)))
    (with-temp-file file (insert contents))
    (let ((buffer (find-file-noselect file)))
      (with-current-buffer buffer
        (lisp-mode)
        (sly-mode 1))
      buffer)))

(defun drv-step (name thunk)
  (drv-log "== STEP %s" name)
  (catch 'drv-timeout
    (condition-case err
        (funcall thunk)
      (error (drv-log "STEP-ERROR %s: %S" name err)))))

(sly-connect "127.0.0.1" drv-port)
(drv-wait "connection" (lambda () (and (sly-connected-p) (drv-repl-buffer))) 60)
(drv-settle)
(drv-log "CONNECTED %s" (sly-lisp-implementation-name))

(defvar drv-steps (split-string (or (getenv "DRV_STEPS") "basic") ","))

(when (member "basic" drv-steps)
  (drv-step "repl-values"
            (lambda ()
              (drv-repl "(+ 1 2)")
              (drv-repl "(progn (format t \"hello~%\") (values 1 \"two\"))")
              (drv-repl "(values)")
              (drv-repl "(princ \"no newline\")")
              (drv-repl "(defvar *drv* 10)")
              (drv-repl "(list *drv* * ** ***)")))
  (drv-step "repl-package"
            (lambda ()
              (drv-repl "(defpackage :drv-pkg (:use :cl) (:export #:hello))")
              (drv-repl "(in-package :drv-pkg)")
              (drv-repl "(defun hello () 'hi)")
              (drv-repl "(list (package-name *package*) (hello))")
              (drv-repl "(in-package :cl-user)")
              (drv-repl "(drv-pkg:hello)")))
  (drv-step "repl-input"
            (lambda ()
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "(list (read-line) 7)")
                (sly-mrepl-return))
              (accept-process-output nil 1)
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "typed")
                (sly-mrepl-return))
              (drv-settle)))
  (drv-step "interactive-eval"
            (lambda ()
              (sly-interactive-eval "(+ 2 3)")
              (drv-settle)
              (sly-interactive-eval "(values 1 2)")
              (drv-settle)
              (sly-interactive-eval "(progn (print 'x) \"str\")")
              (drv-settle)
              (sly-interactive-eval "(values)")
              (drv-settle)
              (with-current-buffer (drv-source-buffer "drv-eval.lisp" "(in-package :drv-pkg)\n\n(* 6 7)\n")
                (goto-char (point-max))
                (sly-eval-last-expression)
                (drv-settle))))
  (drv-step "eval-and-grab-output"
            (lambda ()
              (drv-log "RESULT %S" (sly-eval '(slynk:eval-and-grab-output "(progn (princ \"x\") (values 42 43))")))
              (drv-settle)))
  (drv-step "compile-defun"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-compile.lisp"
                                                      "(defun drv-add (a b)\n  (+ a b))\n\n(defun drv-bad ()\n  (drv-undefined-fn 1))\n")
                (goto-char (point-min))
                (forward-char 3)
                (sly-compile-defun)
                (drv-settle)
                (drv-log "NOTES %S" (sly-compiler-notes))
                (goto-char (point-max))
                (backward-char 5)
                (sly-compile-defun)
                (drv-settle)
                (drv-log "NOTES %S" (sly-compiler-notes)))
              (drv-repl "(drv-add 1 2)")))
  (drv-step "compile-file"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-file.lisp"
                                                      "(defun drv-file-fn (x)\n  (* x 2))\n\n(defun drv-file-warn ()\n  (let ((unused 1))\n    (drv-other-undefined)))\n")
                (sly-compile-and-load-file)
                (drv-settle)
                (drv-log "NOTES %S" (sly-compiler-notes)))
              (drv-repl "(drv-file-fn 21)")
              (sly-load-file (expand-file-name "drv-file.lisp" drv-dir))
              (drv-settle)))
  (drv-step "completions"
            (lambda ()
              (drv-log "SIMPLE %S" (sly-eval '(slynk-completion:simple-completions "mapc" "COMMON-LISP-USER")))
              (drv-log "SIMPLE2 %S" (sly-eval '(slynk-completion:simple-completions "drv-pkg:he" "COMMON-LISP-USER")))
              (drv-log "FLEX %S" (sly-eval '(slynk-completion:flex-completions "mvbind" "COMMON-LISP-USER")))
              (with-current-buffer (drv-source-buffer "drv-complete.lisp" "(drv-ad")
                (goto-char (point-max))
                (completion-at-point)
                (drv-settle)
                (drv-log "BUFFER %S" (buffer-string)))
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "(multiple-value-bi")
                (completion-at-point)
                (drv-settle)
                (drv-log "REPL-INPUT %S" (buffer-substring-no-properties (sly-mrepl--mark) (point-max)))
                (delete-region (sly-mrepl--mark) (point-max)))))
  (drv-step "autodoc"
            (lambda ()
              (with-current-buffer (drv-source-buffer "drv-autodoc.lisp" "(mapcar ")
                (goto-char (point-max))
                (drv-log "AUTODOC1 %S" (sly-autodoc t))
                (drv-settle)
                (drv-log "AUTODOC2 %S" (sly-autodoc t)))
              (drv-log "ARGLIST %S" (sly-eval '(slynk:operator-arglist "mapcar" "COMMON-LISP-USER")))
              (drv-log "AUTODOC3 %S" (sly-eval '(slynk:autodoc '("drv-add" "1" slynk::%cursor-marker%) :print-right-margin 80)))))
  (drv-step "describe"
            (lambda ()
              (drv-log "DESCRIBE %S" (sly-eval '(slynk:describe-symbol "drv-add")))
              (drv-log "DOC %S" (sly-eval '(slynk:documentation-symbol "mapcar")))))
  (drv-step "macroexpand"
            (lambda ()
              (drv-log "MX1 %S" (sly-eval '(slynk:slynk-macroexpand-1 "(when a b)")))
              (with-current-buffer (drv-source-buffer "drv-mx.lisp" "(when (zerop 0) (print 1))")
                (goto-char (point-min))
                (sly-macroexpand-1)
                (drv-settle))))
  (drv-step "error"
            (lambda ()
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "(error \"boom ~a\" 1)")
                (sly-mrepl-return))
              (accept-process-output nil 2)
              (drv-log "SLY-DB %S" (and (sly-db-get-default-buffer) t))
              (when (sly-db-get-default-buffer)
                (with-current-buffer (sly-db-get-default-buffer)
                  (drv-log "SLY-DB-TEXT %s" (buffer-substring-no-properties (point-min) (min (point-max) 600)))
                  (sly-db-quit)))
              (drv-settle)
              (sly-interactive-eval "(car 1)")
              (accept-process-output nil 1)
              (when (sly-db-get-default-buffer)
                (with-current-buffer (sly-db-get-default-buffer)
                  (sly-db-quit)))
              (drv-settle)
              (drv-repl "(+ 40 2)")))
  (drv-step "interrupt"
            (lambda ()
              (with-current-buffer (drv-repl-buffer)
                (goto-char (point-max))
                (insert "(loop)")
                (sly-mrepl-return))
              (accept-process-output nil 1)
              (with-current-buffer (drv-repl-buffer)
                (sly-interrupt))
              (accept-process-output nil 2)
              (drv-log "SLY-DB %S" (and (sly-db-get-default-buffer) t))
              (when (sly-db-get-default-buffer)
                (with-current-buffer (sly-db-get-default-buffer)
                  (drv-log "SLY-DB-TEXT %s" (buffer-substring-no-properties (point-min) (min (point-max) 600)))
                  (sly-db-quit)))
              (drv-settle)
              (drv-repl "(+ 40 3)"))))

(drv-log "== REPL-BUFFER\n%s\n== END-REPL-BUFFER" (drv-repl-text))
(drv-log "DONE")
(kill-emacs 0)
