(DEFUN |loop| (|n|) (LET ((|total| :%UNBOUND) (|i| :%UNBOUND)) (SETQ |total| 0) (LET* ((%SL-SEQ1 (RONTOLISP::%STARLARK-B-RANGE |n| :%UNSET 1)) (%SL-ITEMS2 (RONTOLISP::%STARLARK-ITERATE %SL-SEQ1)) (%SL-COUNT3 (LENGTH %SL-ITEMS2)) (%SL-INDEX4 0)) (TAGBODY %SL-TOP5 (IF (< %SL-INDEX4 %SL-COUNT3) (PROGN (SETQ |i| (AREF %SL-ITEMS2 %SL-INDEX4)) (SETQ %SL-INDEX4 (+ %SL-INDEX4 1)) (SETQ |total| (+ |total| (mod |i| 7))) (GO %SL-TOP5)))) (RONTOLISP::%STARLARK-ITERATED %SL-SEQ1)) |total|))
(SETQ %SL-FILE (RONTOLISP::%STARLARK-FILE-BEGIN))
(RONTOLISP::%STARLARK-B-PRINT " " (RONTOLISP::%STARLARK-MAKE-TUPLE (|loop| 30000000)))
(RONTOLISP::%STARLARK-FILE-END %SL-FILE)
