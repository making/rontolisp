(DEFUN |loop| (|n|) (LET ((|total| :%UNBOUND) (|i| :%UNBOUND)) (SETQ |total| 0) (LET* ((%SL-VALUE 0) (%SL-STOP (if (integerp |n|) |n| (error "range: got ~a, want int" (RONTOLISP::%STARLARK-B-TYPE |n|))))) (TAGBODY %SL-TOP5 (IF (< %SL-VALUE %SL-STOP) (PROGN (SETQ |i| %SL-VALUE) (SETQ %SL-VALUE (+ %SL-VALUE 1)) (SETQ |total| (RONTOLISP::%STARLARK-ADD-IN-PLACE |total| (RONTOLISP::%STARLARK-MOD |i| 7))) (GO %SL-TOP5))))) |total|))
(SETQ %SL-FILE (RONTOLISP::%STARLARK-FILE-BEGIN))
(RONTOLISP::%STARLARK-B-PRINT " " (RONTOLISP::%STARLARK-MAKE-TUPLE (|loop| 30000000)))
(RONTOLISP::%STARLARK-FILE-END %SL-FILE)
